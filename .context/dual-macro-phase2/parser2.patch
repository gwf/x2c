+/* Isolated spike: explicit layout for a descriptor-valued source case. */
+List Compiler.try_parse_macro_pattern(Compiler c) {
+  Token saved = c.token;
+  List expression = NULL;
+  if (c.peek(0) == <$>) {
+    Atom name = _name(c);
+    Var stored;
+    if (_try_definition(c, name, 1, stored)) {
+      List cached = c.cache_literal_list(stored);
+      expression = %(expr ("Macro") ${cached.caddr()});
+    }
+  }
+  else if (c.peek(0) == <ident>) {
+    Type type = NULL;
+    List binding = c.sym.lookup(%(${c.token.text}), type);
+    if (binding && type === %("Macro")) {
+      expression = c.resolve_expression(%(expr $type (ident $binding)), c.token);
+      c.next();
+    }
+  }
+  if (!expression || c.peek(0) != <(>) {
+    c.token = saved;
+    return NULL;
+  }
+  c.expect(<(>);
+  Array names = [];
+  if (c.peek(0) != <)>) loop {
+    int sequence = c.peek(0) == <*>;
+    c.expect(sequence ? <*> : <?>);
+    String name = c.token.text;
+    c.expect(<ident>);
+    names.push(Atom.intern(%"${sequence ? "*" : "?"}$name"));
+    if (!c.test(<,>)) break;
+  }
+  c.expect(<)>);
+  List labels = c.cache_literal_list(names.list_free());
+  List callee = c.resolve_expression(%(expr () (ident "Macro_pattern")), saved);
+  return c.resolve_expression(
+    %(expr ("List") (call $callee (args $expression $labels))), saved);
+}
