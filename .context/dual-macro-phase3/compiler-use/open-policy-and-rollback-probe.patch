+List Compiler.prototype_open_expression(Compiler c, Macro template,
+                                        List argument) {
+  SymTxn transaction = c.begin_semantic_transaction();
+  defer transaction.rollback();
+  Map replacements = {}, types = {};
+  foreach (List effect, template.assoc(<effects>).list()) {
+    Var (operation, source, name) = effect;
+    if (operation == Atom.intern("resolve-global-type"))
+      types[source] = c.sym.resolve_key(source);
+    else replacements[source] = c.sym.reference_global(%($name));
+  }
+  List code = template.assoc(<template>);
+  code = _replace_definition_bindings(code, replacements);
+  code = _prototype_open_types(code, types);
+  code = code.search_replace(%(at m-origin ?node), <?node>);
+  List parameters = template.assoc(<parameters>);
+  List parameter = parameters.car();
+  String name = parameter.assoc(<binder>).str()[1:];
+  List slot = %(macro-slot 0 ${Atom.intern(name)});
+  Map retained = {};
+  retained[slot] = argument;
+  retained[%(expr (<macro-expr>) $slot)] = argument;
+  List rows = NULL;
+  foreach (String projection, %("expression" "source" "value")) {
+    Atom binder = Atom.intern(%"?__macro_${projection}_$name");
+    rows = cons(%($binder $slot), rows);
+  }
+  List result;
+  $let(c.prototype_bound_slots, retained)
+    result = c.bind_syntax(code.replace(rows), AST_EXPRESSION, c.return_type);
+  transaction.commit();
+  return result;
+}
