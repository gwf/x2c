+static void _prototype_open_roles(Var value, Map seen, Array effects) {
+  if (value is not <list> || value.is_nil()) return;
+  match (value) case %(ident (!set ?reference (binding ? ?name))): {
+    if (!(reference in seen)) {
+      seen[reference] = 1;
+      effects.push(%(resolve-global $reference $name));
+    }
+  }
+  match (value) case %(decl ?base ?): {
+    if (base is <list> && base.type().is_bare_typedef_name() &&
+        !(base in seen)) {
+      seen[base] = 1;
+      effects.push(%(resolve-global-type $base ${base.car()}));
+    }
+  }
+  foreach (Var child, value.list()) _prototype_open_roles(child, seen, effects);
+}
+
+static Var _prototype_open_types(Var value, Map types) {
+  if (value is not <list> || value.is_nil()) return value;
+  match (value) case %(expr ?type ?content): {
+    if (content.is_binder()) return value;
+    return %(expr () ${_prototype_open_types(content, types)});
+  }
+  match (value) case %(decl ?base ?declarators): {
+    Var resolved;
+    if (types.try_get(base, resolved))
+      return %(decl $resolved ${_prototype_open_types(declarators, types)});
+  }
+  Array items = $auto([]);
+  foreach (Var child, value.list()) items.push(_prototype_open_types(child, types));
+  return items.list();
+}
