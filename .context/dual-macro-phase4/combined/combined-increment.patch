+int Compiler.prototype_equal(Compiler c, Var left, Var right) {
+  if (left is <map> && right is <map>) {
+    Map a = left, b = right;
+    return a.equal(b);
+  }
+  if (left is <list> && right is <list>) {
+    List a = left, b = right;
+    while (a && b) {
+      if (!c.prototype_equal(a.car(), b.car())) return 0;
+      a = a.cdr(); b = b.cdr();
+    }
+    return !a && !b;
+  }
+  return left === right;
+}
