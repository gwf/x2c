+List Compiler.prototype_snapshot(Compiler c) {
+  Array scopes = [];
+  for (int i = 0; i < c.sym.scopes.len(); i++) {
+    SymScope *scope = _semantic_scope(c.sym, i);
+    scopes.push(%(${scope.symbols.copy()} ${scope.bindings.copy()}
+      ${scope.enumerators.copy()}));
+  }
+  return %(${scopes.list()} ${c.names.counters.copy()}
+    ${c.names.adapters.copy()} ${c.names.next_binding}
+    ${c.early_decls.list()} ${c.inits.list()} ${c.origins.list()}
+    ${c.origin} ${c.needs_exception});
 }
 
