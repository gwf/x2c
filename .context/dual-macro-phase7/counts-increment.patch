@@ -1,6 +1,30 @@
 #pragma once
 #include "x2c.x"
 #include "meta.x"
+
+#include <stdlib.h>
+#include <stdio.h>
+static int _p7_counts_enabled;
+static long long _p7_transactions, _p7_extended, _p7_applications;
+static void _p7_counts_report(void) {
+  fprintf(stderr, "DUAL_COUNTS transactions %lld extended %lld applications %lld\n",
+    _p7_transactions, _p7_extended, _p7_applications);
+}
+static int _p7_counts_on(void) {
+  if (!_p7_counts_enabled) {
+    _p7_counts_enabled = getenv("X2C_DUAL_COUNTS") ? 1 : -1;
+    if (_p7_counts_enabled == 1) atexit(_p7_counts_report);
+  }
+  return _p7_counts_enabled == 1;
+}
+void Prototype_count_transaction(int extended) {
+  if (!_p7_counts_on()) return;
+  _p7_transactions++;
+  _p7_extended += !!extended;
+}
+void Prototype_count_application(void) {
+  if (_p7_counts_on()) _p7_applications++;
+}
 
