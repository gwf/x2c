--- a/src/prototype-slots.x
+++ b/src/prototype-slots.x
@@ -1,6 +1,74 @@
 #pragma once
 #include "x2c.x"
 #include "meta.x"
+
+#include <time.h>
+#include <stdlib.h>
+#include <stdio.h>
+
+static long long _profile_inclusive[6], _profile_exclusive[6];
+static long long _profile_calls[6], _profile_started[256];
+static long long _profile_children[256];
+static int _profile_kind[256], _profile_depth, _profile_enabled, _profile_counts_only;
+static long long _profile_transactions;
+static const char *_profile_labels[6] = {
+  "all_snapshot", "extended_snapshot", "bind_slot_checks",
+  "expression_slot_checks", "open_prepare", "empty_span"
+};
+static long long _profile_now(void) {
+  if (_profile_counts_only) return 0;
+  struct timespec now;
+  clock_gettime(CLOCK_MONOTONIC, &now);
+  return (long long) now.tv_sec * 1000000000LL + now.tv_nsec;
+}
+static void _profile_report(void) {
+  fprintf(stderr, "DUAL_PROFILE all_transactions %lld 0 0\n",
+    _profile_transactions);
+  for (int i = 0; i < 6; i++)
+    fprintf(stderr, "DUAL_PROFILE %s %lld %lld %lld\n",
+      _profile_labels[i], _profile_calls[i], _profile_inclusive[i],
+      _profile_exclusive[i]);
+}
+int Prototype_profile_begin(int kind) {
+  if (!_profile_enabled) {
+    _profile_enabled = getenv("X2C_DUAL_PROFILE") ? 1 : -1;
+    if (_profile_enabled == 1) {
+      _profile_counts_only = !strcmp(getenv("X2C_DUAL_PROFILE"), "counts");
+      atexit(_profile_report);
+      if (!_profile_counts_only) {
+        for (int i = 0; i < 10000; i++) {
+          long long start = _profile_now();
+          _profile_inclusive[5] += _profile_now() - start;
+          _profile_calls[5]++;
+        }
+        _profile_exclusive[5] = _profile_inclusive[5];
+      }
+    }
+  }
+  if (_profile_enabled < 0) return -1;
+
+  int slot = _profile_depth++;
+  assert(slot < 256);
+  _profile_kind[slot] = kind;
+  _profile_children[slot] = 0;
+  _profile_started[slot] = _profile_now();
+  return slot;
+}
+void Prototype_profile_transaction(void) {
+  if (getenv("X2C_DUAL_PROFILE")) _profile_transactions++;
+}
+void Prototype_profile_end(int slot) {
+  if (slot < 0) return;
+  long long elapsed = _profile_now() - _profile_started[slot];
+  assert(slot == --_profile_depth);
+  int kind = _profile_kind[slot];
+  _profile_calls[kind]++;
+  _profile_inclusive[kind] += elapsed;
+  _profile_exclusive[kind] += elapsed - _profile_children[slot];
+  if (slot) _profile_children[slot - 1] += elapsed;
+}
+int Prototype_profile_active(int kind) =>
+  _profile_depth && _profile_kind[_profile_depth - 1] == kind;
 
