/*  var-tags.xmacro -- the Var tag ledger and its projections

    Each row gives a tag's dense ID, coarse kind, and encoding fields. The
    fifteen numeric rows carry two more columns, `bits` and `rank`, that
    only Var's conversion policy reads; `bits` is either a literal width or
    the C type whose `sizeof` supplies it. Signedness comes from the tag
    spelling and floating-ness from the kind, so neither is a column.

    lib/common.x projects the unbox accessors, lib/var.x the ID enumerator,
    the info table, the tag set and the decode switch, lib/dispatch.x the
    descriptor count, lib/varconvert.x the numeric table and its tag set,
    and src/type.x the constant rows. Each imports this file because
    compile-time definitions do not cross an `#include`.

    The `meta` functions here read collections, and every importer is below
    `lib/array.x` and `lib/list.x` in the include graph, so none of them has
    those operations by inclusion. `lib/common.x` declares the ones this
    file uses under "the compile-time collection surface", which is why the
    import sits after that block rather than at the top of the file.
*/

meta static List _tag_groups(void) => %(
  (
    (<u8>  "_u8_"  <integer>  0x8002 0x0001 0x0 8 1)
    (<i8>  "_i8_"  <integer>  0x8002 0x0002 0x0 8 1)
    (<u16> "_u16_" <integer>  0x8002 0x0003 0x0 16 2)
    (<i16> "_i16_" <integer>  0x8002 0x0004 0x0 16 2)
    (<u32> "_u32_" <integer>  0x8002 0x0005 0x0 32 3)
    (<i32> "_i32_" <integer>  0x8002 0x0006 0x0 32 3)
    (<f32> "_f32_" <floating> 0x8002 0x0007 0x0 32 7)
  )
  (
    (<u48> "_u48_" <integer>  0x8000 0x0000 0x0 48 4)
    (<i48> "_i48_" <integer>  0x8001 0x0000 0x0 48 4)
    (<p48> "_p48_" <pointer>  0x0000 0x0000 0x0)
    (<f64> "_f64_" <floating> 0x0000 0x0000 0x0 64 8)
  )
  (
    (<long>    "_long_"    <integer>  0x0005 0x0000 0x5 (long) 5)
    (<ulong>   "_ulong_"   <integer>  0x0005 0x0000 0x6 (unsigned long) 5)
    (<llong>   "_llong_"   <integer>  0x0005 0x0000 0x7 (long long) 6)
    (<ullong>  "_ullong_"  <integer>  0x0007 0x0000 0x6 (unsigned long long) 6)
    (<ldouble> "_ldouble_" <floating> 0x0007 0x0000 0x7 (long double) 9)
  )
  (
    (<u8*>      "_u8_p_"      <pointer> 0x0001 0x0000 0x0)
    (<i8*>      "_i8_p_"      <pointer> 0x0002 0x0000 0x0)
    (<u16*>     "_u16_p_"     <pointer> 0x0003 0x0000 0x0)
    (<i16*>     "_i16_p_"     <pointer> 0x0003 0x0000 0x1)
    (<u32*>     "_u32_p_"     <pointer> 0x0004 0x0000 0x0)
    (<i32*>     "_i32_p_"     <pointer> 0x0004 0x0000 0x1)
    (<f32*>     "_f32_p_"     <pointer> 0x0004 0x0000 0x2)
    (<ulong*>   "_ulong_p_"   <pointer> 0x0004 0x0000 0x3)
    (<long*>    "_long_p_"    <pointer> 0x0005 0x0000 0x0)
    (<f64*>     "_f64_p_"     <pointer> 0x0005 0x0000 0x1)
    (<ullong*>  "_ullong_p_"  <pointer> 0x0005 0x0000 0x2)
    (<llong*>   "_llong_p_"   <pointer> 0x0005 0x0000 0x3)
    (<ldouble*> "_ldouble_p_" <pointer> 0x0005 0x0000 0x4)
    (<p48*>     "_p48_p_"     <pointer> 0x0006 0x0000 0x0)
  )
  (
    (<u8**>      "_u8_pp_"      <pointer> 0x0006 0x0000 0x1)
    (<i8**>      "_i8_pp_"      <pointer> 0x0006 0x0000 0x2)
    (<u16**>     "_u16_pp_"     <pointer> 0x0006 0x0000 0x3)
    (<i16**>     "_i16_pp_"     <pointer> 0x0006 0x0000 0x4)
    (<u32**>     "_u32_pp_"     <pointer> 0x0006 0x0000 0x5)
    (<i32**>     "_i32_pp_"     <pointer> 0x0006 0x0000 0x6)
    (<f32**>     "_f32_pp_"     <pointer> 0x0006 0x0000 0x7)
    (<ulong**>   "_ulong_pp_"   <pointer> 0x0007 0x0000 0x0)
    (<long**>    "_long_pp_"    <pointer> 0x0007 0x0000 0x1)
    (<f64**>     "_f64_pp_"     <pointer> 0x0007 0x0000 0x2)
    (<ullong**>  "_ullong_pp_"  <pointer> 0x0007 0x0000 0x3)
    (<llong**>   "_llong_pp_"   <pointer> 0x0007 0x0000 0x4)
    (<ldouble**> "_ldouble_pp_" <pointer> 0x0007 0x0000 0x5)
  )
  (
    (<array>   "_array_"   <object> 0x0008 0x0000 0x0)
    (<block>   "_block_"   <object> 0x0008 0x0000 0x1)
    (<buffer>  "_buffer_"  <object> 0x0008 0x0000 0x2)
    (<bytes>   "_bytes_"   <object> 0x0008 0x0000 0x3)
    (<context> "_context_" <object> 0x0008 0x0000 0x5)
    (<error>   "_error_"   <object> 0x0008 0x0000 0x7)
    (<file>    "_file_"    <object> 0x0009 0x0000 0x0)
    (<func>    "_func_"    <object> 0x0009 0x0000 0x1)
    (<iter>    "_iter_"    <object> 0x0009 0x0000 0x2)
    (<lambda>  "_lambda_"  <object> 0x0009 0x0000 0x3)
    (<list>    "_list_"    <object> 0x0009 0x0000 0x4)
    (<logger>  "_logger_"  <object> 0x0009 0x0000 0x5)
    (<map>     "_map_"     <object> 0x0009 0x0000 0x6)
  )
  (
    (<mutex>  "_mutex_"  <object> 0x000A 0x0000 0x0)
    (<pipe>   "_pipe_"   <object> 0x000A 0x0000 0x1)
    (<proc>   "_proc_"   <object> 0x000A 0x0000 0x2)
    (<regexp> "_regexp_" <object> 0x000A 0x0000 0x3)
    (<rope>   "_rope_"   <object> 0x000A 0x0000 0x4)
    (<scope>  "_scope_"  <object> 0x000A 0x0000 0x5)
    (<slice>  "_slice_"  <object> 0x000A 0x0000 0x6)
    (<socket> "_socket_" <object> 0x000A 0x0000 0x7)
    (<stream> "_stream_" <object> 0x000B 0x0000 0x0)
    (<string> "_string_" <object> 0x000B 0x0000 0x1)
    (<symbol> "_symbol_" <symbol> 0x8004 0x800C 0x0)
    (<tensor> "_tensor_" <object> 0x000B 0x0000 0x3)
    (<thread> "_thread_" <object> 0x000B 0x0000 0x4)
    (<token>  "_token_"  <object> 0x000B 0x0000 0x5)
    (<var>    "_var_"    <object> 0x000B 0x0000 0x6)
  )
  (
    (<array*>   "_array_p_"   <reference> 0x000C 0x0000 0x0)
    (<block*>   "_block_p_"   <reference> 0x000C 0x0000 0x1)
    (<buffer*>  "_buffer_p_"  <reference> 0x000C 0x0000 0x2)
    (<bytes*>   "_bytes_p_"   <reference> 0x000C 0x0000 0x3)
    (<context*> "_context_p_" <reference> 0x000C 0x0000 0x5)
    (<error*>   "_error_p_"   <reference> 0x000C 0x0000 0x7)
    (<file*>    "_file_p_"    <reference> 0x000D 0x0000 0x0)
    (<func*>    "_func_p_"    <reference> 0x000D 0x0000 0x1)
    (<iter*>    "_iter_p_"    <reference> 0x000D 0x0000 0x2)
    (<lambda*>  "_lambda_p_"  <reference> 0x000D 0x0000 0x3)
    (<list*>    "_list_p_"    <reference> 0x000D 0x0000 0x4)
    (<logger*>  "_logger_p_"  <reference> 0x000D 0x0000 0x5)
    (<map*>     "_map_p_"     <reference> 0x000D 0x0000 0x6)
  )
  (
    (<mutex*>  "_mutex_p_"  <reference> 0x000E 0x0000 0x0)
    (<pipe*>   "_pipe_p_"   <reference> 0x000E 0x0000 0x1)
    (<proc*>   "_proc_p_"   <reference> 0x000E 0x0000 0x2)
    (<regexp*> "_regexp_p_" <reference> 0x000E 0x0000 0x3)
    (<rope*>   "_rope_p_"   <reference> 0x000E 0x0000 0x4)
    (<scope*>  "_scope_p_"  <reference> 0x000E 0x0000 0x5)
    (<slice*>  "_slice_p_"  <reference> 0x000E 0x0000 0x6)
    (<socket*> "_socket_p_" <reference> 0x000E 0x0000 0x7)
    (<stream*> "_stream_p_" <reference> 0x000F 0x0000 0x0)
    (<string*> "_string_p_" <reference> 0x000F 0x0000 0x1)
    (<symbol*> "_symbol_p_" <reference> 0x000F 0x0000 0x2)
    (<tensor*> "_tensor_p_" <reference> 0x000F 0x0000 0x3)
    (<thread*> "_thread_p_" <reference> 0x000F 0x0000 0x4)
    (<token*>  "_token_p_"  <reference> 0x000F 0x0000 0x5)
    (<var*>    "_var_p_"    <reference> 0x000F 0x0000 0x6)
  )
  (
    (<nan>  "_nan_"    <floating> 0x8003 0x0001 0x0)
    (<-inf> "_neginf_" <floating> 0x8003 0x0002 0x0)
    (<+inf> "_posinf_" <floating> 0x8003 0x0003 0x0)
    (<void> "_void_"   <void>     0x8003 0xFFFF 0x0)
  )
);

/* A row is `(tag id kind top middle bottom)`, and a numeric row carries
   `bits` and `rank` after it. The ledger is grouped only to keep its source
   readable, so every projection reads one flat sequence. */
meta static List _tag_rows(void) {
  Array rows = [];
  foreach (List group, _tag_groups())
    foreach (Var row, group) rows.push(row);
  return rows;
}

meta static String _tag_id(List row)    => row[1];
meta static Symbol _tag_kind(List row)  => row[2];
meta static int _tag_top(List row)      => row[3];
meta static int _tag_middle(List row)   => row[4];
meta static int _tag_bottom(List row)   => row[5];
meta static int _tag_numeric(List row)  => row.len() > 6;
meta static Var _tag_bits(List row)     => row[6];
meta static int _tag_rank(List row)     => row[7];
meta static int _tag_floating(List row) => _tag_kind(row) == <floating>;
meta static int _tag_unsigned(List row) => row[0].str().startswith("u");

/* The row a tag names. The ledger is this file's own data, so a tag no row
   carries is a mistake in the invocation, and the diagnostic names it. */
meta static List _tag_row(Var tag) {
  List found = %();
  foreach (List row, _tag_rows())
    if (!found && row[0] == tag) found = row;
  if (!found) Meta.diagnostic_fail("unknown Var tag", %(${tag.str()}));
  return found;
}

/* A `Literal` tag argument arrives as its resolved Symbol expression; the
   Symbol itself is the last element of the literal node. */
meta static List _tag_hole_row(List form) {
  Var tag = void;
  match (form) case %(expr ? (literal ? ? ?value)): tag = value;
  return _tag_row(tag);
}

meta static List _tag_top_of(List form) =>
  Meta.literal_int(_tag_top(_tag_hole_row(form)));

meta static List _tag_bottom_of(List form) =>
  Meta.literal_int(_tag_bottom(_tag_hole_row(form)));

/* --- the ID enumerator and the descriptor table -------------------------- */

/* The dense IDs in ledger order, which is what lets a decoded row index
   select a descriptor without a second tag search. */
meta static List _tag_ids(void) {
  Array names = [];
  foreach (List row, _tag_rows()) names.push(Meta.ident(_tag_id(row)));
  return names;
}

meta static List _tag_info_row(List row) =>
  Meta.expr_composite([
    Meta.literal_symbol(row[0]),
    Meta.literal_symbol(_tag_kind(row)),
    Meta.literal_int(_tag_top(row)),
    Meta.literal_int(_tag_middle(row)),
    Meta.literal_int(_tag_bottom(row))]);

/* The table ends in a void row, so a decoded index past the ledger reads a
   descriptor rather than past the array. */
meta static List _tag_info_sentinel(void) =>
  Meta.expr_composite([
    Meta.literal_int(0),
    Meta.literal_symbol(<void>),
    Meta.literal_int(0x8000),
    Meta.literal_int(0),
    Meta.literal_int(0)]);

meta static List _tag_info(void) {
  Array cells = [];
  foreach (List row, _tag_rows()) cells.push(_tag_info_row(row));
  cells.push(_tag_info_sentinel());
  return Meta.expr_composite(cells);
}

meta static int _tag_descriptor(List row) =>
  _tag_kind(row) == <object> || _tag_kind(row) == <symbol>;

meta static List _tag_descriptor_count(void) {
  int count = 0;
  foreach (List row, _tag_rows()) if (_tag_descriptor(row)) count++;
  return Meta.literal_int(count);
}

meta static List _tag_names(void) {
  Array names = [];
  foreach (List row, _tag_rows()) names.push(row[0]);
  return names;
}

/* --- the numeric table --------------------------------------------------- */

meta static List _tag_numeric_rows(void) {
  Array rows = [];
  foreach (List row, _tag_rows()) if (_tag_numeric(row)) rows.push(row);
  return rows;
}

meta static List _tag_numeric_names(void) {
  Array names = [];
  foreach (List row, _tag_numeric_rows()) names.push(row[0]);
  return names;
}

/* A literal width stays a literal; a C type becomes sizeof(T) * CHAR_BIT,
   which is still a constant expression in a static initializer. Any other
   spelling is refused by `Meta.literal_int`, which takes a number. */
meta static List _tag_bits_expr(List row) {
  Var bits = _tag_bits(row);
  /* `bits is <list>` would compile to the `Var.is_row` fast path, which has
     no compile-time meaning, so the tag is read directly. */
  if (bits.tag() == <list>)
    return %(expr () (op *
      (expr (unsigned)
        (sizeof (parens (decl $bits (bindings (bind () ()))))))
      ${Meta.expr_ident(%("CHAR_BIT"))}));
  return Meta.literal_int(bits);
}

meta static List _tag_numeric_row(List row) =>
  Meta.expr_composite([
    Meta.literal_symbol(row[0]),
    Meta.literal_int(_tag_floating(row)),
    Meta.literal_int(_tag_unsigned(row)),
    _tag_bits_expr(row),
    Meta.literal_int(_tag_rank(row))]);

meta static List _tag_numeric_table(void) {
  Array cells = [];
  foreach (List row, _tag_numeric_rows()) cells.push(_tag_numeric_row(row));
  return Meta.expr_composite(cells);
}

/* --- the built-in decoder ------------------------------------------------ */

/* `f64`, `symbol` and `void` are answered before the switch is reached. */
meta static int _tag_decode_row(List row) {
  Var tag = row[0];
  return !(tag == <f64> || tag == <symbol> || tag == <void>);
}

meta static List _tag_decode_rows(void) {
  Array rows = [];
  foreach (List row, _tag_rows()) if (_tag_decode_row(row)) rows.push(row);
  return rows;
}

meta static List _tag_decode_return(List row) =>
  %(return ("VarDecoded")
    ${Meta.expr_call(
        Meta.expr_ident(Meta.ident("_decode_builtin")),
        [Meta.expr_ident(Meta.ident(_tag_id(row))),
         Meta.expr_ident(Meta.ident("value"))])});

/* The label and its return, as the two items a switch body takes. */
meta static List _tag_decode_case(List row, int by_middle) {
  int selector = by_middle ? _tag_middle(row) : _tag_bottom(row);
  return %((case ${Meta.literal_int(selector)})
           ${_tag_decode_return(row)});
}

/* Within one top, an immediate row is told apart by its middle field and
   every other by the low bit or two of its bottom field. */
meta static List _tag_decode_inner(List rows, List middle, List bottom) {
  List first = rows[0];
  int immediate = _tag_top(first) == 0x8002 || _tag_top(first) == 0x8003;
  List selector = bottom;
  if (immediate) selector = middle;
  else if (rows.len() == 2)
    selector = %(expr (unsigned) (op & $bottom ${Meta.literal_int(1)}));
  else if (rows.len() == 4)
    selector = %(expr (unsigned) (op & $bottom ${Meta.literal_int(3)}));
  Array items = [];
  foreach (List row, rows)
    foreach (Var item, _tag_decode_case(row, immediate)) items.push(item);
  List body = items;
  return %(switch $selector (block @body));
}

meta static List _tag_decode_group(List rows, List middle, List bottom) {
  List first = rows[0];
  Array items = [%(case ${Meta.literal_int(_tag_top(first))})];
  if (rows.len() == 1) items.push(_tag_decode_return(first));
  else {
    items.push(_tag_decode_inner(rows, middle, bottom));
    items.push(%(break));
  }
  return items;
}

meta static List _tag_rows_with_top(List rows, Var top) {
  Array group = [];
  foreach (List row, rows) if (_tag_top(row) == top) group.push(row);
  return group;
}

/* One arm per distinct top, in the order the ledger first names it. The
   group is built by a callee rather than in the loop, because a value
   needing a binding cannot sit on a lowered loop's iteration path. */
meta static List _tag_decode(List middle, List bottom) {
  List rows = _tag_decode_rows();
  Array tops = [];
  foreach (List row, rows)
    if (!tops.contains(_tag_top(row))) tops.push(_tag_top(row));
  Array items = [];
  foreach (Var top, tops)
    foreach (Var item, _tag_decode_group(
                         _tag_rows_with_top(rows, top), middle, bottom))
      items.push(item);
  return items;
}

/* --- the rows a statically known tag is tested with ---------------------- */

/* A group of one is selected by its top alone; the decoder narrows a group
   of two or four to the low bit or two of the bottom field. */
meta static int _tag_group_mask(int count) {
  if (count == 1) return 0;
  if (count == 2) return 1;
  if (count == 4) return 3;
  return 7;
}

/* Rows whose decoded form carries a validity clause in `_decode_builtin`,
   and the immediate rows the decoder discriminates by middle rather than
   bottom. Neither is one mask-and-compare, so neither gets a constant row. */
meta static List _tag_validated_ids(void) => %(
  "_long_" "_ulong_" "_llong_" "_ullong_" "_ldouble_" "_array_" "_map_"
  "_u8_" "_i8_" "_u16_" "_i16_" "_nan_" "_neginf_" "_posinf_");

meta static int _tag_constant_row(List row) {
  if (_tag_validated_ids().contains(_tag_id(row))) return 0;
  return _tag_top(row) != 0x8002 && _tag_top(row) != 0x8003;
}

/* A `List` expression built from its elements, which is the entry's value. */
meta static List _tag_list(List items) {
  List built = %(expr ("List") (nil));
  for (int i = items.len() - 1; i >= 0; i--)
    built = %(expr ("List") (cons ${items[i]} $built));
  return built;
}

meta static List _tag_row_entry(List row, List rows) {
  int siblings = 0;
  foreach (List other, rows)
    if (_tag_top(other) == _tag_top(row)) siblings++;
  return %(map-entry ${Meta.literal_symbol(row[0])}
    ${_tag_list([Meta.literal_int(_tag_top(row)),
                 Meta.literal_int(_tag_group_mask(siblings)),
                 Meta.literal_int(_tag_bottom(row))])});
}

meta static List _tag_constant_rows(void) {
  List rows = _tag_decode_rows();
  Array entries = [];
  foreach (List row, rows)
    if (_tag_constant_row(row)) entries.push(_tag_row_entry(row, rows));
  return entries;
}

/* --- what the consuming units write -------------------------------------- */

macro Enumerator $var.tag.ids() => { $(_tag_ids)... }

macro Expression $var.tag.info() => ($(_tag_info))

macro Expression $var.tag.descriptor.count() => ($(_tag_descriptor_count))

macro Expression $var.tag.numeric() => ($(_tag_numeric_table))

// `_x2c.symbol-set` is a private compiler native, and the language reference
// says a component beginning `_` is an implementation detail, so it has no
// `Meta` spelling. These two invocations are the only Lisp that reads the
// ledger, and the names they set come from x2c.
macro Expression $var.tag.symbolset() => ($(_x2c.symbol-set (_tag_names)))

macro Expression $var.tag.numeric.symbolset() => (
  $(_x2c.symbol-set (_tag_numeric_names))
)

macro Statement $var.tag.decode(Expr $middle, Expr $bottom) => {
  $(_tag_decode $middle $bottom)...
}

/* The rows a caller holding a statically known tag can test without
   decoding, as `tag : (top, mask, bottom)`. */
macro Entry $var.tag.constant.rows() => { $(_tag_constant_rows)... }

/* Object rows carry their payload pointer in the low 48 bits with the
   bottom three bits reserved for the row selector, so reading one back is
   the row's top and bottom columns and a mask. */
macro Unit $var.tag.unbox(Type $type, Name $method, Literal $tag) => {
  $type Var.$method(Var);

  /** Extracts the `$type` payload of `value`, or NULL for another tag. */
  inline $type Var.$method(Var value) {
    if (value.u64 >> 48 != $(_tag_top_of $tag) ||
        (value.u64 & 0x7) != $(_tag_bottom_of $tag)) return NULL;
    return ($type) (value.u64 & 0x0000FFFFFFFFFFF8ul);
  }
}
