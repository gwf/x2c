/* regex diagnostic messages. Payload owners retain failure policy. */

macro Expression $reason.unmatched_close() => "unmatched closing parenthesis";
macro Expression $reason.no_repeat() => "nothing to repeat";
macro Expression $reason.repeat_count() => "repetition count too large";
macro Expression $reason.repeat_range() => "repetition range out of order";
macro Expression $reason.missing_close() => "missing closing parenthesis";
macro Expression $reason.group_syntax() => "unknown group syntax";
macro Expression $reason.group_name() => "malformed group name";
macro Expression $reason.unterminated_class() =>
  "unterminated character class";
macro Expression $reason.character_range() => "character range out of order";
macro Expression $reason.trailing_backslash() => "pattern ends in a backslash";
macro Expression $reason.unknown_escape() => "unknown escape";

macro Stmt $error.compile(Expr $why, Expr $pattern, Expr $offset) {
  raise %(malformed (operation "Regex.compile") (reason ${$why})
          (pattern ${$pattern}) (offset ${$offset}));
}

macro Stmt $error.depth(Expr $pattern, Expr $limit) {
  raise %(size-limit (operation "Regex.match") (pattern ${$pattern})
          (reason "a group repeated more times than one match allows")
          (limit ${$limit}));
}
