// Compile-time support for $dedent. The transform runs on the literal's own
// source spelling, which x2c.source.text returns complete with the interior
// newlines and indentation the author typed. _dedent_fold, in
// system-macros.xmacro, is the x2c that reads it; it answers void where the
// spelling has nothing to fold, and the call goes to String.dedent instead.

(defun dedent.expand (node) (let
  ((text (_dedent_fold (x2c.source.text node))))
  (if (null? text)
      (x2c.expr.call (x2c.expr.field node "dedent"))
      (x2c.literal.string text))))

// Location and source text for the diagnostic macros. x2c.invocation.* names
// the caller, so an imported macro still reports where it was written.

(defun macros.location ()
  (string-append
    (x2c.invocation.file) ":" (str (x2c.invocation.line))))
