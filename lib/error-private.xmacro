macro Unit $error.private.types() {
  typedef struct $(x2c.ident "ErrorRegion") {
    Scope values;
    Pool lists;
    Pool strings;
  } $(x2c.ident "ErrorRegion");

  typedef struct $(x2c.ident "ErrorRecord") {
    struct ErrorRegion region;
    List entry;
  } $(x2c.ident "ErrorRecord");

  struct $(x2c.ident "ErrorHandler") {
    struct ErrorHandler *prev;
    struct ErrorHandler *running;
    struct ErrorRegion view;
    ErrorHandlerFn fn;
    Var data;
    int watermark;
    ErrorCatchSite *site;
    Block plans;
    void *target;
    int selected;
    Block capture_values;
    Block retained;
    int detached;
  };
}
