/* Json reading and writing error conditions.
   Reports expand at their existing owners. */

macro Stmt $error.boolean.type(Expr $tag) {
  raise %(bad-types (operation "Json.boolean") (tag ${$tag}));
}

macro Stmt $error.read.file(
  Expr $path, Expr $why, Expr $offset, Expr $line, Expr $column) {
  raise %(malformed (operation "Json.read_file") (path ${$path})
          (why ${$why}) (offset ${$offset})
          (line ${$line}) (column ${$column}));
}

macro Stmt $error.read.text(
  Expr $why, Expr $offset, Expr $line, Expr $column) {
  raise %(malformed (operation "Json.parse") (why ${$why})
          (offset ${$offset}) (line ${$line}) (column ${$column}));
}

macro Stmt $error.write.depth() {
  raise %(size-limit (operation "Var.json")
          (why "nesting exceeds 512 levels"));
}

macro Stmt $error.write.type(Expr $tag) {
  raise %(bad-types (operation "Var.json") (tag ${$tag}));
}

macro Stmt $error.write.key(Expr $tag) {
  raise %(bad-types (operation "Var.json") (want "String object key")
          (tag ${$tag}));
}

macro Stmt $error.write.duplicate(Expr $text) {
  raise %(bad-arg (operation "Var.json") (why "duplicate object name")
          (name ${$text}));
}

macro Stmt $error.write.nonfinite() {
  raise %(conv-range (operation "Var.json")
          (why "JSON has no NaN or infinity"));
}

macro Stmt $error.read.trailing(Expr $reader) =>
  $reader._fail("unexpected text after the value");

macro Stmt $error.read.depth(Expr $reader) =>
  $reader._fail("nesting exceeds 512 levels");

macro Stmt $error.read.end(Expr $reader) =>
  $reader._fail("unexpected end of input");

macro Stmt $error.read.char(Expr $reader) =>
  $reader._fail("unexpected character");

macro Stmt $error.read.key(Expr $reader) =>
  $reader._fail("expected a string key");

macro Expression $reason.read.colon() => "expected ':'";

macro Expression $reason.read.object.sep() => "expected ',' or '}'";

macro Expression $reason.read.array.sep() => "expected ',' or ']'";

macro Stmt $error.read.string.end(Expr $reader) =>
  $reader._fail("unterminated string");

macro Stmt $error.read.control(Expr $reader) =>
  $reader._fail("control character in string");

macro Stmt $error.read.utf8(Expr $reader) =>
  $reader._fail("invalid UTF-8");

macro Stmt $error.read.escape(Expr $reader) =>
  $reader._fail("invalid escape");

macro Stmt $error.read.surrogate(Expr $reader) =>
  $reader._fail("unpaired surrogate");

macro Stmt $error.read.nul(Expr $reader) =>
  $reader._fail("U+0000 cannot appear in a String");

macro Stmt $error.read.unicode(Expr $reader) =>
  $reader._fail("invalid \\u escape");

macro Stmt $error.read.number(Expr $reader) =>
  $reader._fail("invalid number");

macro Stmt $error.read.range(Expr $reader) =>
  $reader._fail("number out of range");
