/* Json reading and writing error conditions.
   Reports expand at their existing owners. */

macro Statement $_json_error_boolean_type(Expr $tag) {
  raise %(bad-types (operation "Json.boolean") (tag ${$tag}));
}

macro Statement $_json_error_read_file(
  Expr $path, Expr $why, Expr $offset, Expr $line, Expr $column) {
  raise %(bad-arg (operation "Json.read_file") (path ${$path})
          (why ${$why}) (offset ${$offset})
          (line ${$line}) (column ${$column}));
}

macro Statement $_json_error_read_text(
  Expr $why, Expr $offset, Expr $line, Expr $column) {
  raise %(bad-arg (operation "Json.parse") (why ${$why})
          (offset ${$offset}) (line ${$line}) (column ${$column}));
}

macro Statement $_json_error_write_depth() {
  raise %(size-limit (operation "Var.json")
          (why "nesting exceeds 512 levels"));
}

macro Statement $_json_error_write_type(Expr $tag) {
  raise %(bad-types (operation "Var.json") (tag ${$tag}));
}

macro Statement $_json_error_write_key(Expr $tag) {
  raise %(bad-types (operation "Var.json") (want "String object key")
          (tag ${$tag}));
}

macro Statement $_json_error_write_duplicate(Expr $text) {
  raise %(bad-arg (operation "Var.json") (why "duplicate object name")
          (name ${$text}));
}

macro Statement $_json_error_write_nonfinite() {
  raise %(conv-range (operation "Var.json")
          (why "JSON has no NaN or infinity"));
}

macro Statement $_json_error_read_trailing(Expr $reader) {
  $reader._fail("unexpected text after the value");
}

macro Statement $_json_error_read_depth(Expr $reader) {
  $reader._fail("nesting exceeds 512 levels");
}

macro Statement $_json_error_read_end(Expr $reader) {
  $reader._fail("unexpected end of input");
}

macro Statement $_json_error_read_char(Expr $reader) {
  $reader._fail("unexpected character");
}

macro Statement $_json_error_read_key(Expr $reader) {
  $reader._fail("expected a string key");
}

macro Expression $_json_error_read_colon() => "expected ':'";

macro Expression $_json_error_read_object_sep() => "expected ',' or '}'";

macro Expression $_json_error_read_array_sep() => "expected ',' or ']'";

macro Statement $_json_error_read_string_end(Expr $reader) {
  $reader._fail("unterminated string");
}

macro Statement $_json_error_read_control(Expr $reader) {
  $reader._fail("control character in string");
}

macro Statement $_json_error_read_utf8(Expr $reader) {
  $reader._fail("invalid UTF-8");
}

macro Statement $_json_error_read_escape(Expr $reader) {
  $reader._fail("invalid escape");
}

macro Statement $_json_error_read_surrogate(Expr $reader) {
  $reader._fail("unpaired surrogate");
}

macro Statement $_json_error_read_nul(Expr $reader) {
  $reader._fail("U+0000 cannot appear in a String");
}

macro Statement $_json_error_read_unicode(Expr $reader) {
  $reader._fail("invalid \\u escape");
}

macro Statement $_json_error_read_number(Expr $reader) {
  $reader._fail("invalid number");
}

macro Statement $_json_error_read_range(Expr $reader) {
  $reader._fail("number out of range");
}

$(defun _json.error.call (key arguments)
  (let ((row (assoc key '(
      ("boolean.type" _json_error_boolean_type)
      ("read.file" _json_error_read_file)
      ("read.text" _json_error_read_text)
      ("write.depth" _json_error_write_depth)
      ("write.type" _json_error_write_type)
      ("write.key" _json_error_write_key)
      ("write.duplicate" _json_error_write_duplicate)
      ("write.nonfinite" _json_error_write_nonfinite)
      ("read.trailing" _json_error_read_trailing)
      ("read.depth" _json_error_read_depth)
      ("read.end" _json_error_read_end)
      ("read.char" _json_error_read_char)
      ("read.key" _json_error_read_key)
      ("read.colon" _json_error_read_colon)
      ("read.object.sep" _json_error_read_object_sep)
      ("read.array.sep" _json_error_read_array_sep)
      ("read.string.end" _json_error_read_string_end)
      ("read.control" _json_error_read_control)
      ("read.utf8" _json_error_read_utf8)
      ("read.escape" _json_error_read_escape)
      ("read.surrogate" _json_error_read_surrogate)
      ("read.nul" _json_error_read_nul)
      ("read.unicode" _json_error_read_unicode)
      ("read.number" _json_error_read_number)
      ("read.range" _json_error_read_range)))))
    (if row
      (_x2c.tpl-call (cadr row) arguments)
      (x2c.diagnostic.fail
        (string-append "unknown json error '" key "'") '()))))

macro Statement $json.error(Literal $key, Expr $arguments...) {
  $(list (_json.error.call (x2c.literal.value $key) $arguments))...
}

macro Expression $json.reason(Literal $key, Expr $arguments...) =>
  $(_json.error.call (x2c.literal.value $key) $arguments);
