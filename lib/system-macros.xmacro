// System macros that remove boilerplate C leaves to every caller.
// Import this file to use them: $(import "system-macros.xmacro")

$(import "system-macros.xlisp")

/* The width of the leading spaces and tabs `line` was written with. */
meta static int _dedent_width(String line) {
  int length = line.len(), width = 0;
  while (width < length && (line[width] == ' ' || line[width] == '\t'))
    width++;
  return width;
}

meta static int _dedent_blank(String line) =>
  _dedent_width(line) == line.len();

/* Removes the indentation the first line carries from the front of every
   line. An opening blank line belongs to the quote rather than the text, and
   so does the content of a trailing whitespace-only line, which carries the
   closing quote's own indentation. */
meta static String _dedent_apply(String text) {
  int width = _dedent_width(text);
  if (width < text.len() && text[width] == '\n') {
    text = text.getslice(width + 1, text.len(), 1);
    width = _dedent_width(text);
  }
  String prefix = text.getslice(0, width, 1);
  Array lines = [];
  foreach (Var line, text.split("\n"))
    lines.push(String.remove_prefix(line, prefix));
  if (lines.len() > 1 && _dedent_blank(lines[-1])) lines[-1] = "";
  return lines.join("\n");
}

/* Dedents the text the literal `source` was written as, or answers `void`
   where there is none to fold. The fold is exact only when the spelling
   carries no escape and no interpolation hole, which is how a dedented block
   is normally written; every other spelling keeps its meaning by going to
   String.dedent at run time. */
meta static Var _dedent_fold(String source) {
  int length = source.len(), open = 0;
  if (length >= 3 && source.startswith("%\""))
    open = 2;
  else if (length >= 2 && source.startswith("\""))
    open = 1;
  if (open == 0 || !source.endswith("\"")) return void;
  String body = source.getslice(open, length - 1, 1);
  if (body.contains("\\") || body.contains("$")) return void;
  return _dedent_apply(body);
}

/* Normalizes the indentation a block of text was written with. The literal
   is dedented during translation when its spelling carries no escape and no
   interpolation hole; every other form calls String.dedent at run time, so
   both spellings mean the same thing. */
macro Expression $dedent(Expr $text) => ($(dedent.expand $text))

/* Reports how long the following statement took on stderr. The caller
   includes <time.h>. The stop clock and the report run from a `defer`, so
   they still run when the decorated statement is a function body that
   returns or a body a raise transfers out of. */
macro Decorator $time(Statement $target, Literal $label)
  using $started, $stopped, $elapsed => {
  {
    struct timespec $started, $stopped;
    clock_gettime(CLOCK_MONOTONIC, &$started);
    defer {
      clock_gettime(CLOCK_MONOTONIC, &$stopped);
      double $elapsed =
        ($stopped.tv_sec - $started.tv_sec) * 1000.0 +
        ($stopped.tv_nsec - $started.tv_nsec) / 1000000.0;
      Stderr.printf("[time] %s %.3f ms\n", $label, $elapsed);
    }
    $target
  }
}

meta static int _cases_label(List item) {
  match (item) {
    case %(at ? (case ?)): return 1;
    case %(at ? (default)): return 1;
  }
  return 0;
}

meta static int _cases_transfers(List item) {
  match (item) {
    case %(at ? (break)): return 1;
    case %(at ? (continue)): return 1;
    case %(at ? (goto ?)): return 1;
    case %(at ? (return ? ?)): return 1;
    case %(at ? (return ?)): return 1;
  }
  return 0;
}

meta static List _cases_split(List items, int labelled) {
  if (!items) return %();
  List item = items.car();
  if (_cases_label(item))
    return %($item @{_cases_split(items.cdr(), 1)});
  if (!labelled)
    return %($item @{_cases_split(items.cdr(), 0)});
  Array run = [];
  while (items && !_cases_label(items.car())) {
    run.push(items.car());
    items = items.cdr();
  }
  if (!_cases_transfers(run[-1])) run.push(%(break));
  return %((block @run) @{_cases_split(items, 0)});
}

meta static List _cases_switch(List condition, List body) =>
  %((switch $condition (block @{_cases_split(body.cdr(), 0)})));

/* Gives every case run its own block and its own break. Deliberate
   fallthrough is written by nesting an ordinary switch. */
macro Decorator $switch(Block $body, Expr $condition) => {
  $(_cases_switch $condition $body)...
}

/* Marks a path that is not written yet. Reaching it raises `<invariant>`
   naming the note and the source line the macro was written on. */
macro Statement $todo(Expr $note) => {
  raise %(invariant (note ${$note})
    (at ${$(x2c.literal.string (macros.location))}));
}

/* Marks a path the surrounding logic excludes. */
macro Statement $unreachable() => {
  raise %(invariant (note "unreachable")
    (at ${$(x2c.literal.string (macros.location))}));
}

/* Checks an invariant and reports the failing expression as it was written.
   Unlike C `assert` this transfers to a catch and is not compiled out. */
macro Statement $assert(Expr $check) => {
  {
    if (!($check)) {
      raise %(invariant
        (check ${$(x2c.literal.string (x2c.source.text $check))})
        (at ${$(x2c.literal.string (macros.location))}));
    }
  }
}
