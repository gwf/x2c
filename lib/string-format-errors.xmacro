/* string-format diagnostic messages. Payload owners retain failure policy. */

macro Expression $format.reason.excess_values() =>
  "excess values";

macro Expression $format.reason.missing_value() =>
  "missing value";

macro Expression $format.reason.incomplete() =>
  "incomplete conversion";

macro Expression $format.reason.width_range() =>
  "width exceeds int range";

macro Expression $format.reason.missing_star() =>
  "missing star value";

macro Expression $format.reason.length() =>
  "unsupported length modifier";

macro Expression $format.reason.positional() =>
  "positional formats are unsupported";

macro Expression $format.reason.conversion() =>
  "unsupported conversion";

macro Expression $format.reason.integer_length() =>
  "unsupported integer length";

macro Expression $format.reason.floating_length() =>
  "unsupported floating length";

macro Expression $format.reason.wide_text() =>
  "wide strings and characters are unsupported";

macro Expression $format.reason.flag() =>
  "unsupported flag for conversion";

macro Expression $format.reason.character_precision() =>
  "unsupported precision for %c";

macro Expression $format.reason.character_nul() =>
  "%c cannot produce an embedded NUL";

macro Expression $format.reason.string() =>
  "string conversion failed";

macro Expression $format.reason.value() =>
  "value conversion failed";

macro Expression $format.reason.range(Expr $label) =>
  %"${$label} exceeds int range";
