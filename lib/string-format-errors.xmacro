/* string-format diagnostic messages. Payload owners retain failure policy. */

macro Expression $reason.excess_values() => "excess values";
macro Expression $reason.missing_value() => "missing value";
macro Expression $reason.incomplete() => "incomplete conversion";
macro Expression $reason.width_range() => "width exceeds int range";
macro Expression $reason.missing_star() => "missing star value";
macro Expression $reason.length() => "unsupported length modifier";
macro Expression $reason.positional() => "positional formats are unsupported";
macro Expression $reason.conversion() => "unsupported conversion";
macro Expression $reason.integer_length() => "unsupported integer length";
macro Expression $reason.floating_length() => "unsupported floating length";
macro Expression $reason.wide_text() =>
  "wide strings and characters are unsupported";
macro Expression $reason.flag() => "unsupported flag for conversion";
macro Expression $reason.character_precision() =>
  "unsupported precision for %c";
macro Expression $reason.character_nul() =>
  "%c cannot produce an embedded NUL";
macro Expression $reason.string() => "string conversion failed";
macro Expression $reason.value() => "value conversion failed";
macro Expression $reason.range(Expr $label) => %"${$label} exceeds int range";
