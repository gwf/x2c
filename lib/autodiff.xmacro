/*  autodiff.xmacro -- dual-number families for forward-mode differentiation

    Copyright (c) 2026 Gary William Flake

    `$ad.dual` gives one caller-declared struct the arithmetic of a dual
    number: `value` carries the primal and `tangent` carries its derivative
    along one direction. Every operation is an ordinary protocol row, so a
    dual value uses `+ - * / <` and dotted calls such as `x.sin()` directly.

    The scalar type is a hole. Instantiating the family over its own result
    makes the next order of derivative a distinct C type, so a nested
    derivative cannot confuse its perturbation with an outer one.

    `$ad.forward()` and `$ad.reverse()` decorate a `double` function and emit
    a sibling next to it: `f_dot` carries a tangent through the same
    statements, and `f_grad` records the forward sweep on a typed array tape
    and accumulates adjoints in reverse. Both read the typed AST, so `int`
    control flow is copied and only `double` arithmetic is differentiated.
*/

/** Generates the dual-number members of `$D` over the scalar type `$S`.

    `$D` is a complete typedef `struct { $S value; $S tangent; }` declared
    before the invocation. `$d` names the `Var` converters (`Var.$d`,
    `$S.$d`) and `$tag` is the fresh Var tag. The remaining holes spell the
    scalar primitives the family lifts: for `double` they are the C library
    functions, and for a dual scalar they are that family's methods.
*/
macro Unit $ad.dual(
  Type $D, Name $d, Literal $tag, Type $S,
  Expr $sin, Expr $cos, Expr $exp, Expr $log, Expr $sqrt, Expr $tanh
) => {
  Var $D.var($D value) {
    $D *boxed = Scope.malloc(sizeof($D));
    *boxed = value;
    return Var.new($tag, boxed);
  }

  $D Var.$d(Var value) => *($D *) value.pointer();

  $D $S.$d($S value) {
    $D result = { value };
    return result;
  }

  $D $D.add($D a, $D b) {
    $D result = { a.value + b.value, a.tangent + b.tangent };
    return result;
  }

  $D $D.sub($D a, $D b) {
    $D result = { a.value - b.value, a.tangent - b.tangent };
    return result;
  }

  $D $D.mul($D a, $D b) {
    $D result = {
      a.value * b.value, a.tangent * b.value + a.value * b.tangent
    };
    return result;
  }

  $D $D.div($D a, $D b) {
    $D result = {
      a.value / b.value,
      (a.tangent * b.value - a.value * b.tangent) / (b.value * b.value)
    };
    return result;
  }

  $D $D.neg($D a) {
    $D result = { -a.value, -a.tangent };
    return result;
  }

  int $D.compare($D a, $D b) =>
    a.value < b.value ? -1 : a.value > b.value;

  $D $D.sin($D a) {
    $D result = { $sin(a.value), $cos(a.value) * a.tangent };
    return result;
  }

  $D $D.cos($D a) {
    $D result = { $cos(a.value), -($sin(a.value) * a.tangent) };
    return result;
  }

  $D $D.exp($D a) {
    $S value = $exp(a.value);
    $D result = { value, value * a.tangent };
    return result;
  }

  $D $D.log($D a) {
    $D result = { $log(a.value), a.tangent / a.value };
    return result;
  }

  $D $D.sqrt($D a) {
    $S value = $sqrt(a.value);
    $D result = { value, a.tangent / (value + value) };
    return result;
  }

  $D $D.tanh($D a) {
    $S value = $tanh(a.value);
    $D result = { value, a.tangent - a.tangent * value * value };
    return result;
  }

  $D $D.fabs($D a) {
    $S zero = 0.0;
    $D result = { a.value, a.tangent };
    if (a.value < zero) {
      result.value = -a.value;
      result.tangent = -a.tangent;
    }
    return result;
  }

  /* exp(b log a): defined for a positive base, unlike C `pow`. */
  $D $D.pow($D a, $D b) {
    $S logarithm = $log(a.value);
    $S value = $exp(b.value * logarithm);
    $D result = {
      value,
      value * (b.tangent * logarithm + b.value * a.tangent / a.value)
    };
    return result;
  }

  protocol Var($D);
}

/* Compile-time support shared by both transformations. Constructed syntax
   uses spelled names, which the compiler rebinds and retypes after the
   expansion, so copied subtrees drop their binding records first. */

$(defun ad._dot (name) (string-append name "_dot"))
$(defun ad._bar (name) (string-append name "_bar"))
$(defun ad._grad (name) (string-append name "_grad"))

$(defun ad._unbind (form)
  (cond ((not (list? form)) form)
        ((null? form) form)
        ((and (eq? (car form) 'binding) (= (length form) 3))
         (list (car (cddr form))))
        ((and (eq? (car form) 'at) (= (length form) 3))
         (ad._unbind (car (cddr form))))
        (true (map ad._unbind form))))

$(defun ad._fail (message form)
  (x2c.diagnostic.fail (string-append "ad: " message) (list (repr form))))

$(defun ad._lit (text) `(expr (double) (literal (double) ,text)))
$(defun ad._int (text) `(expr (int) (literal (int) ,text)))
$(defun ad._zero () (ad._lit "0.0"))
$(defun ad._zero? (e) (equal? e (ad._zero)))
$(defun ad._one? (e) (equal? e (ad._lit "1.0")))
$(defun ad._id (name) `(expr () (ident (,name))))
$(defun ad._parens (e) `(expr () (parens ,e)))
$(defun ad._raw (op a b) (ad._parens `(expr () (op ,op ,a ,b))))
$(defun ad._neg (a) (if (ad._zero? a) a (ad._parens `(expr () (op - ,a)))))
$(defun ad._add (a b)
  (cond ((ad._zero? a) b)
        ((ad._zero? b) a)
        (true (ad._raw '+ a b))))
$(defun ad._sub (a b)
  (cond ((ad._zero? b) a)
        ((ad._zero? a) (ad._neg b))
        (true (ad._raw '- a b))))
$(defun ad._mul (a b)
  (cond ((or (ad._zero? a) (ad._zero? b)) (ad._zero))
        ((ad._one? a) b)
        ((ad._one? b) a)
        (true (ad._raw '* a b))))
$(defun ad._div (a b)
  (cond ((ad._zero? a) a)
        ((ad._one? b) a)
        (true (ad._raw '/ a b))))
$(defun ad._call (name args)
  `(expr () (call (expr () (ident (,name))) (args ,@args))))
$(defun ad._cast (type e)
  `(expr () (cast (decl ,type (bindings (bind () ()))) ,e)))
$(defun ad._stmnt (e) `(stmnt ,e))
$(defun ad._assign (name value)
  (ad._stmnt `(expr () (op = ,(ad._id name) ,value))))
$(defun ad._accum (name value)
  (ad._stmnt `(expr () (op += ,(ad._id name) ,value))))
$(defun ad._declare (type name init)
  (if init
      `(declare ,type (bindings (op = (bind (,name) ()) ,init)))
      `(declare ,type (bindings (bind (,name) ())))))
$(defun ad._double? (e) (match e '(expr (double) ?)))
$(defun ad._double-type? (type) (equal? type '(double)))
$(defun ad._zero-of (type)
  (if (ad._double-type? type) (ad._zero) (ad._int "0")))
$(defun ad._concat (lists) (foldl append '() lists))
$(defun ad._zip (f a b)
  (if (or (null? a) (null? b)) '()
      (cons (f (car a) (car b)) (ad._zip f (cdr a) (cdr b)))))

/* Every entry names a primitive and one partial derivative per argument.
   Each partial receives the unbound argument list. */
$(defun ad._select (test a b) `(expr () (parens (expr () (op ? ,test ,a ,b)))))
$(defun ad._less (a b) `(expr () (op < ,a ,b)))
$(defun ad._less-eq (a b) `(expr () (op <= ,a ,b)))
$(defun ad._square (a) (ad._mul a a))
$(defun ad._recip (e) (ad._div (ad._lit "1.0") e))
$(defun ad._plus-one (e) (ad._add (ad._lit "1.0") e))
$(defun ad._minus-one (e) (ad._sub (ad._lit "1.0") e))
$(defun ad._sum-squares (a)
  (ad._add (ad._square (car a)) (ad._square (cadr a))))
$(def ad._primitives (list
  (list "sin" (lambda (a) (ad._call "cos" a)))
  (list "cos" (lambda (a) (ad._neg (ad._call "sin" a))))
  (list "tan" (lambda (a) (ad._recip (ad._square (ad._call "cos" a)))))
  (list "asin" (lambda (a)
    (ad._recip (ad._call "sqrt" (list (ad._minus-one (ad._square (car a))))))))
  (list "acos" (lambda (a)
    (ad._neg (ad._recip
      (ad._call "sqrt" (list (ad._minus-one (ad._square (car a)))))))))
  (list "atan" (lambda (a) (ad._recip (ad._plus-one (ad._square (car a))))))
  (list "atan2"
    (lambda (a) (ad._div (cadr a) (ad._sum-squares a)))
    (lambda (a) (ad._neg (ad._div (car a) (ad._sum-squares a)))))
  (list "sinh" (lambda (a) (ad._call "cosh" a)))
  (list "cosh" (lambda (a) (ad._call "sinh" a)))
  (list "tanh" (lambda (a) (ad._minus-one (ad._square (ad._call "tanh" a)))))
  (list "asinh" (lambda (a)
    (ad._recip (ad._call "sqrt" (list (ad._plus-one (ad._square (car a))))))))
  (list "acosh" (lambda (a)
    (ad._recip (ad._call "sqrt"
      (list (ad._sub (ad._square (car a)) (ad._lit "1.0")))))))
  (list "atanh" (lambda (a) (ad._recip (ad._minus-one (ad._square (car a))))))
  (list "exp" (lambda (a) (ad._call "exp" a)))
  (list "exp2" (lambda (a)
    (ad._mul (ad._call "exp2" a) (ad._lit "0.6931471805599453"))))
  (list "expm1" (lambda (a) (ad._call "exp" a)))
  (list "log" (lambda (a) (ad._recip (car a))))
  (list "log2" (lambda (a)
    (ad._recip (ad._mul (car a) (ad._lit "0.6931471805599453")))))
  (list "log10" (lambda (a)
    (ad._recip (ad._mul (car a) (ad._lit "2.302585092994046")))))
  (list "log1p" (lambda (a) (ad._recip (ad._plus-one (car a)))))
  (list "sqrt" (lambda (a) (ad._div (ad._lit "0.5") (ad._call "sqrt" a))))
  (list "cbrt" (lambda (a)
    (ad._recip (ad._mul (ad._lit "3.0") (ad._square (ad._call "cbrt" a))))))
  (list "hypot"
    (lambda (a) (ad._div (car a) (ad._call "hypot" a)))
    (lambda (a) (ad._div (cadr a) (ad._call "hypot" a))))
  (list "fabs" (lambda (a)
    (ad._select (ad._less (car a) (ad._lit "0.0"))
                (ad._lit "-1.0") (ad._lit "1.0"))))
  (list "fmin"
    (lambda (a) (ad._select (ad._less-eq (car a) (cadr a))
                            (ad._lit "1.0") (ad._lit "0.0")))
    (lambda (a) (ad._select (ad._less (cadr a) (car a))
                            (ad._lit "1.0") (ad._lit "0.0"))))
  (list "fmax"
    (lambda (a) (ad._select (ad._less-eq (cadr a) (car a))
                            (ad._lit "1.0") (ad._lit "0.0")))
    (lambda (a) (ad._select (ad._less (car a) (cadr a))
                            (ad._lit "1.0") (ad._lit "0.0"))))
  (list "pow"
    (lambda (a)
      (ad._mul (cadr a)
               (ad._call "pow"
                         (list (car a) (ad._sub (cadr a) (ad._lit "1.0"))))))
    (lambda (a)
      (ad._mul (ad._call "pow" a) (ad._call "log" (list (car a))))))))

$(def ad._forward-siblings '())
$(def ad._reverse-siblings '())

/* Differentiable names are the `double` parameters and every plain `double`
   declaration in the body. Other `double` identifiers are constants. */
$(defun ad._double-spec? (type)
  (or (equal? type '(double)) (equal? type '(const double))))
$(defun ad._declared-doubles (form)
  (match-case form
    ((declare ?type (bindings *decls))
     (if (ad._double-spec? ?type) (ad._declarator-names *decls) '()))
    ((decl ?type (bindings *decls))
     (if (ad._double-spec? ?type) (ad._declarator-names *decls) '()))
    (else (if (list? form)
              (ad._concat (map ad._declared-doubles form))
              '()))))

$(defun ad._param-doubles (params)
  (ad._concat (map (lambda (p)
    (match-case p
      ((param (double) (bind (binding ? ?n) ())) (list ?n))
      (else '()))) params)))

$(defun ad._param-names (params)
  (map (lambda (p)
    (match-case p
      ((param ? (bind (binding ? ?n) ?)) ?n)
      (else (ad._fail "unsupported parameter" p)))) params))

$(defun ad._check-result (spec fn)
  (if (eq? (last spec) 'double) nil
      (ad._fail "function must return double" fn)))

/* Assignment forms are normalized to `v = v OP rhs` so one rule covers
   `=`, compound assignment, and increments. Returns (name rhs) or nil. */
$(defun ad._compound (op)
  (cond ((eq? op '+=) '+)
        ((eq? op '-=) '-)
        ((eq? op '*=) '*)
        ((eq? op '/=) '/)
        (true nil)))
$(defun ad._var-name (e)
  (match-case e
    ((expr ? (ident (binding ? ?n))) ?n)
    ((expr ? (ident (?n))) (if (string? ?n) ?n nil))
    (else nil)))
$(defun ad._one-of (target)
  (if (ad._double? target) (ad._lit "1.0") (ad._int "1")))
$(defun ad._typed (e op a b) (list 'expr (cadr e) (list 'op op a b)))
$(defun ad._step (e op target)
  (let ((n (ad._var-name target)))
    (if n (list n (ad._typed e op target (ad._one-of target))) nil)))
$(defun ad._update (e)
  (match-case e
    ((expr ? (op = ?target ?rhs))
     (let ((n (ad._var-name ?target))) (if n (list n ?rhs) nil)))
    ((expr ? (op ?o ?target ?rhs))
     (let ((n (ad._var-name ?target)) (op (ad._compound ?o)))
       (if (and n op) (list n (ad._typed e op ?target ?rhs)) nil)))
    ((expr ? (op ++ ?target)) (ad._step e '+ ?target))
    ((expr ? (op -- ?target)) (ad._step e '- ?target))
    ((expr ? (postfix ++ ?target)) (ad._step e '+ ?target))
    ((expr ? (postfix -- ?target)) (ad._step e '- ?target))
    (else nil)))

/* An assignment nested inside a larger expression would escape the
   statement rules, so expressions are checked before they are copied. */
$(defun ad._mutates? (form)
  (cond ((not (list? form)) nil)
        ((null? form) nil)
        ((and (eq? (car form) 'op)
              (member (cadr form) '(= += -= *= /= %= ++ --))
              (match (car (cddr form)) '(expr ? ?)))
         true)
        ((and (eq? (car form) 'postfix) (member (cadr form) '(++ --))) true)
        (true (foldl (lambda (acc x) (or acc (ad._mutates? x))) nil form))))
$(defun ad._pure (e)
  (if (ad._mutates? e) (ad._fail "assignment inside an expression" e) e))

/* Forward mode: the tangent of an expression under `names`. */
$(defun ad._tangent (e names)
  (if (not (ad._double? e)) (ad._zero)
    (match-case e
      ((expr ? (literal ? ?)) (ad._zero))
      ((expr ? (ident ?))
       (let ((n (ad._var-name e)))
         (if (and n (member n names)) (ad._id (ad._dot n)) (ad._zero))))
      ((expr ? (parens ?a)) (ad._tangent ?a names))
      ((expr ? (cast ? ?a)) (ad._tangent ?a names))
      ((expr ? (op - ?a)) (ad._neg (ad._tangent ?a names)))
      ((expr ? (op + ?a)) (ad._tangent ?a names))
      ((expr ? (op ?o ?c ?a ?b))
       (if (eq? ?o '?)
           `(expr () (op ? ,(ad._unbind (ad._pure ?c))
              ,(ad._tangent ?a names) ,(ad._tangent ?b names)))
           (ad._fail "unsupported expression" e)))
      ((expr ? (op ?o ?a ?b))
       (let ((da (ad._tangent ?a names)) (db (ad._tangent ?b names))
             (a (ad._unbind ?a)) (b (ad._unbind ?b)))
         (cond ((eq? ?o '+) (ad._add da db))
               ((eq? ?o '-) (ad._sub da db))
               ((eq? ?o '*) (ad._add (ad._mul da b) (ad._mul a db)))
               ((eq? ?o '/)
                (ad._div (ad._sub (ad._mul da b) (ad._mul a db))
                         (ad._mul b b)))
               (true (ad._fail "unsupported operator" e)))))
      ((expr ? (call (expr ?ft (ident (binding ? ?name))) (args *args)))
       (ad._call-tangent ?name ?ft *args names))
      (else (ad._fail "unsupported expression" e)))))

$(defun ad._call-tangent (name ftype args names)
  (let ((prim (assoc name ad._primitives))
        (unbound (map ad._unbind args))
        (tangents (map (lambda (a) (ad._tangent a names)) args)))
    (cond (prim
           (foldl ad._add (ad._zero)
             (ad._zip (lambda (partial da) (ad._mul da (partial unbound)))
                      (cdr prim) tangents)))
          ((member name ad._forward-siblings)
           (ad._call (ad._dot name)
                     (ad._dot-args (cadr (car ftype)) unbound tangents)))
          (true (ad._fail "call to a function without a derivative" name)))))

$(defun ad._dot-args (ptypes args tangents)
  (if (null? args) '()
    (let ((rest (ad._dot-args (cdr ptypes) (cdr args) (cdr tangents))))
      (if (ad._double-type? (car ptypes))
          (cons (car args) (cons (car tangents) rest))
          (cons (car args) rest)))))

$(defun ad._fwd-params (params)
  (ad._concat (map (lambda (p)
    (match-case p
      ((param (double) (bind (binding ? ?n) ()))
       (list `(param (double) (bind (,?n) ()))
             `(param (double) (bind (,(ad._dot ?n)) ()))))
      (else (list (ad._unbind p))))) params)))

$(defun ad._fwd-body (s names)
  (match-case s
    ((block *items) `(block ,@(ad._fwd-items *items names)))
    (else `(block ,@(ad._fwd-item s names)))))
$(defun ad._fwd-items (items names)
  (ad._concat (map (lambda (s) (ad._fwd-item s names)) items)))

$(defun ad._fwd-decl (d names)
  (match-case d
    ((op = (bind (binding ? ?n) ()) ?init)
     (list (ad._declare '(double) (ad._dot ?n)
                        (ad._tangent (ad._pure ?init) names))))
    ((bind (binding ? ?n) ())
     (list (ad._declare '(double) (ad._dot ?n) (ad._zero))))
    (else (ad._fail "unsupported declarator" d))))

$(defun ad._fwd-update (s update names)
  (cond ((not update) (list (ad._unbind (ad._pure s))))
        ((member (car update) names)
         (list (ad._assign (ad._dot (car update))
                           (ad._tangent (ad._pure (cadr update)) names))
               (ad._unbind s)))
        (true (begin (ad._pure (cadr update)) (list (ad._unbind s))))))

$(defun ad._fwd-item (s names)
  (match-case s
    ((at ? ?node) (ad._fwd-item ?node names))
    ((declare ?type (bindings *decls))
     (if (ad._double-spec? ?type)
         (cons (ad._unbind s)
               (ad._concat (map (lambda (d) (ad._fwd-decl d names)) *decls)))
         (list (ad._unbind (ad._pure s)))))
    ((stmnt ?e) (ad._fwd-update s (ad._update ?e) names))
    ((if ?c ?then)
     (list `(if ,(ad._unbind (ad._pure ?c)) ,(ad._fwd-body ?then names))))
    ((if ?c ?then ?else)
     (list `(if ,(ad._unbind (ad._pure ?c)) ,(ad._fwd-body ?then names)
              ,(ad._fwd-body ?else names))))
    ((while ?c ?body)
     (list `(while ,(ad._unbind (ad._pure ?c)) ,(ad._fwd-body ?body names))))
    ((do ?body ?c)
     (list `(do ,(ad._fwd-body ?body names) ,(ad._unbind (ad._pure ?c)))))
    ((for ?init ?c ?step ?body) (ad._fwd-for ?init ?c ?step ?body names))
    ((block *items) (list `(block ,@(ad._fwd-items *items names))))
    ((return (double) ?e)
     (list `(return (double) ,(ad._tangent (ad._pure ?e) names))))
    ((return ? ?) (ad._fail "return must produce double" s))
    ((empty) '())
    ((break) (list s))
    ((continue) (list s))
    (else (ad._fail "unsupported statement" s))))

/* A `for` that declares a double needs its tangent declared beside it, so
   the loop becomes a block: the declarations, then a `for` without them. */
$(defun ad._fwd-for (init c step body names)
  (match-case init
    ((decl ?type (bindings *decls))
     (if (ad._double-spec? ?type)
         (list `(block
                  ,@(ad._fwd-item `(declare ,?type (bindings ,@*decls)) names)
                  (for () ,(ad._unbind (ad._pure c)) ,(ad._unbind step)
                    ,(ad._fwd-body body names))))
         (list `(for ,(ad._unbind init) ,(ad._unbind (ad._pure c))
                  ,(ad._unbind step) ,(ad._fwd-body body names)))))
    (else (list `(for ,(ad._unbind init) ,(ad._unbind (ad._pure c))
                   ,(ad._unbind step) ,(ad._fwd-body body names))))))

$(defun ad._forward-function (spec name params body)
  (let ((names (append (ad._param-doubles params)
                       (ad._declared-doubles body))))
    `(function ,spec
       (bind (,(ad._dot name)) ((fnmod (params ,@(ad._fwd-params params)))))
       ,(ad._fwd-body body names))))

$(defun ad.forward (fn)
  (if (not (list? fn)) '()
    (match-case fn
      ((function ?spec (bind (binding ? ?name) ((fnmod (params *params))))
         ?body)
       (begin
         (ad._check-result ?spec fn)
         (def ad._forward-siblings (cons ?name ad._forward-siblings))
         (list (ad._forward-function ?spec ?name *params ?body))))
      (else (ad._fail "expected a function definition" fn)))))

/* Reverse mode. The forward sweep runs the original statements, pushing
   each overwritten value and each control decision onto a typed array
   tape. The reverse sweep pops them back in order, so every adjoint reads
   the values the forward sweep saw. Locals are hoisted to the function
   head because a body declared inside a loop must outlive its iteration.

   Control flow is recorded as exit codes. Each loop iteration ends by
   pushing 0, or the code of the `break` or `continue` that left it; each
   `return` pushes its own code before jumping to the reverse sweep. The
   reverse of a region reads the code and runs the reverse of exactly the
   statements that executed, which is computed statically for every exit.

   Each item yields a triple (forward reverse exits). `forward` and
   `reverse` are statement lists, `reverse` already in reverse order for
   an item that completed. `exits` lists (code kind pruned) for every exit
   inside the item, where `pruned` is the reverse of the part of the item
   that ran before that exit. A loop consumes its `break` and `continue`
   exits; the function consumes `return`. */

$(def ad._locals '())
$(def ad._counter 0)
$(def ad._loop-step '())
$(defun ad._local (type name)
  (begin
    (if (assoc name ad._locals) (ad._fail "duplicate local name" name) nil)
    (def ad._locals (cons (list name type) ad._locals))
    name))
$(defun ad._fresh (stem type)
  (begin
    (def ad._counter (+ ad._counter 1))
    (ad._local type (string-append stem (str ad._counter)))))
$(defun ad._code ()
  (begin
    (def ad._counter (+ ad._counter 1))
    (string-append (str ad._counter) ".0")))
$(defun ad._local-type (name)
  (let ((entry (assoc name ad._locals)))
    (if entry (cadr entry)
        (ad._fail "assignment to an undeclared name" name))))

$(defun ad._push (e)
  (ad._stmnt (ad._call "ArrayDbl_push" (list (ad._id "_ad_tape") e))))
$(defun ad._pop () (ad._call "ArrayDbl_take_last" (list (ad._id "_ad_tape"))))
$(defun ad._restore (name type)
  (ad._assign name
              (if (ad._double-type? type) (ad._pop)
                  (ad._cast type (ad._pop)))))
$(defun ad._triple (fwd rev exits) (list fwd rev exits))
$(defun ad._none () (ad._triple '() '() '()))
$(defun ad._fwd-of (t) (car t))
$(defun ad._rev-of (t) (cadr t))
$(defun ad._exits-of (t) (car (cddr t)))
$(defun ad._exit (code kind pruned) (list code kind pruned))
$(defun ad._exit-code (x) (car x))
$(defun ad._exit-kind (x) (cadr x))
$(defun ad._exit-pruned (x) (car (cddr x)))
$(defun ad._with-pruned (x pruned)
  (ad._exit (ad._exit-code x) (ad._exit-kind x) pruned))

/* Sequencing: an exit inside item i has run items 1..i-1 completely. */
$(defun ad._sequence (triples)
  (ad._sequence-from triples '() '() '()))
$(defun ad._sequence-from (triples fwd rev exits)
  (if (null? triples) (ad._triple fwd rev exits)
    (let ((t (car triples)))
      (ad._sequence-from (cdr triples)
        (append fwd (ad._fwd-of t))
        (append (ad._rev-of t) rev)
        (append exits
          (map (lambda (x)
                 (ad._with-pruned x (append (ad._exit-pruned x) rev)))
               (ad._exits-of t)))))))

/* Adjoint statements for `e` scaled by `seed`. */
$(defun ad._adjoint (e seed names)
  (if (not (ad._double? e)) '()
    (match-case e
      ((expr ? (literal ? ?)) '())
      ((expr ? (ident ?))
       (let ((n (ad._var-name e)))
         (if (and n (member n names))
             (list (ad._accum (ad._bar n) seed))
             '())))
      ((expr ? (parens ?a)) (ad._adjoint ?a seed names))
      ((expr ? (cast ? ?a)) (ad._adjoint ?a seed names))
      ((expr ? (op - ?a)) (ad._adjoint ?a (ad._neg seed) names))
      ((expr ? (op + ?a)) (ad._adjoint ?a seed names))
      ((expr ? (op ?o ?c ?a ?b))
       (if (eq? ?o '?)
           (list `(if ,(ad._unbind ?c)
                    (block ,@(ad._adjoint ?a seed names))
                    (block ,@(ad._adjoint ?b seed names))))
           (ad._fail "unsupported expression" e)))
      ((expr ? (op ?o ?a ?b)) (ad._binary-adjoint ?o ?a ?b seed names))
      ((expr ? (call (expr ?ft (ident (binding ? ?name))) (args *args)))
       (ad._call-adjoint ?name ?ft *args seed names))
      (else (ad._fail "unsupported expression" e)))))

$(defun ad._binary-adjoint (op x y seed names)
  (let ((a (ad._unbind x)) (b (ad._unbind y)))
    (cond ((eq? op '+)
           (append (ad._adjoint x seed names) (ad._adjoint y seed names)))
          ((eq? op '-)
           (append (ad._adjoint x seed names)
                   (ad._adjoint y (ad._neg seed) names)))
          ((eq? op '*)
           (append (ad._adjoint x (ad._mul seed b) names)
                   (ad._adjoint y (ad._mul seed a) names)))
          ((eq? op '/)
           (append (ad._adjoint x (ad._div seed b) names)
                   (ad._adjoint y (ad._neg (ad._div (ad._mul seed a)
                                                    (ad._mul b b)))
                                names)))
          (true (ad._fail "unsupported operator" op)))))

$(defun ad._call-adjoint (name ftype args seed names)
  (let ((prim (assoc name ad._primitives)) (unbound (map ad._unbind args)))
    (cond (prim
           (ad._concat (ad._zip (lambda (partial arg)
             (ad._adjoint arg (ad._mul seed (partial unbound)) names))
             (cdr prim) args)))
          ((member name ad._reverse-siblings)
           (ad._sibling-adjoint name (cadr (car ftype)) args unbound seed
                                names))
          (true (ad._fail "call to a function without a gradient" name)))))

/* A gradient sibling recomputes its primal into a scratch local and fills
   one partial slot per `double` argument. */
$(defun ad._sibling-adjoint (name ptypes args unbound seed names)
  (let ((slots (ad._grad-slots ptypes args))
        (value (ad._fresh "_ad_call" '(double))))
    (cons (ad._assign value
            (ad._call (ad._grad name)
              (append unbound
                      (map (lambda (s) `(expr () (op & ,(ad._id (car s)))))
                           slots))))
          (ad._concat (map (lambda (s)
            (ad._adjoint (cadr s) (ad._mul seed (ad._id (car s))) names))
            slots)))))

$(defun ad._grad-slots (ptypes args)
  (if (null? args) '()
    (let ((rest (ad._grad-slots (cdr ptypes) (cdr args))))
      (if (ad._double-type? (car ptypes))
          (cons (list (ad._fresh "_ad_partial" '(double)) (car args)) rest)
          rest))))

$(defun ad._rev-items (items names)
  (ad._sequence (map (lambda (s) (ad._rev-item s names)) items)))
$(defun ad._rev-body (s names)
  (match-case s
    ((block *items) (ad._rev-items *items names))
    (else (ad._rev-item s names))))

$(defun ad._rev-assign (name rhs names)
  (let ((type (ad._local-type name)) (value (ad._unbind (ad._pure rhs))))
    (ad._triple
      (list (ad._push (ad._id name)) (ad._assign name value))
      (if (and (ad._double-type? type) (member name names))
          (append (list (ad._restore name type)
                        (ad._assign "_ad_seed" (ad._id (ad._bar name)))
                        (ad._assign (ad._bar name) (ad._zero)))
                  (ad._adjoint rhs (ad._id "_ad_seed") names))
          (list (ad._restore name type)))
      '())))

$(defun ad._rev-decl (type d names)
  (begin
    (if (and (list? type) (member 'const type))
        (ad._fail "const locals are not supported in reverse mode" d)
        nil)
    (match-case d
      ((op = (bind (binding ? ?n) ()) ?init)
       (begin (ad._local type ?n) (ad._rev-assign ?n ?init names)))
      ((bind (binding ? ?n) ()) (begin (ad._local type ?n) (ad._none)))
      (else (ad._fail "unsupported declarator" d)))))

$(defun ad._rev-optional (s names)
  (if s (ad._rev-item s names) (ad._none)))

/* Branches push their flag after the body so a completed `if` pops it
   first; an exit inside a branch never pushes, and its pruned reverse
   knows the branch statically. */
$(defun ad._rev-if (c then else names)
  (let ((t (ad._rev-body then names))
        (e (if else (ad._rev-body else names) (ad._none))))
    (ad._triple
      (list `(if ,(ad._unbind (ad._pure c))
               (block ,@(ad._fwd-of t) ,(ad._push (ad._lit "1.0")))
               (block ,@(ad._fwd-of e) ,(ad._push (ad._lit "0.0")))))
      (list `(if (expr () (op != ,(ad._pop) ,(ad._lit "0.0")))
               (block ,@(ad._rev-of t))
               (block ,@(ad._rev-of e))))
      (append (ad._exits-of t) (ad._exits-of e)))))

$(defun ad._code-is (code)
  `(expr () (op == ,(ad._id "_ad_code") ,(ad._lit code))))

/* The dispatch after popping one iteration's exit code. */
$(defun ad._dispatch (normal exits)
  (foldl (lambda (chain x)
           `(if ,(ad._code-is (ad._exit-code x))
              (block ,@(ad._exit-pruned x)) ,chain))
         `(block ,@normal)
         (reverse exits)))

$(defun ad._loop-exit? (x)
  (or (eq? (ad._exit-kind x) 'break) (eq? (ad._exit-kind x) 'continue)))

/* A loop iteration: count, body, step, then the normal code. `continue`
   also runs the step, so its pruned reverse begins with the step's. */
$(defun ad._loop-parts (c body step names)
  (let* ((saved ad._loop-step)
         (s (begin (def ad._loop-step '()) (ad._rev-optional step names)))
         (b (begin (def ad._loop-step (ad._fwd-of s))
                   (ad._rev-body body names)))
         (restored (def ad._loop-step saved))
         (n (ad._fresh "_ad_trip" '(int)))
         (own (filter ad._loop-exit? (ad._exits-of b)))
         (through (filter (lambda (x) (not (ad._loop-exit? x)))
                          (ad._exits-of b)))
         (iteration (append (list (ad._count n '+))
                            (ad._fwd-of b) (ad._fwd-of s)
                            (list (ad._push (ad._lit "0.0")))))
         (dispatch (list (ad._assign "_ad_code" (ad._pop))
                         (ad._dispatch (append (ad._rev-of s) (ad._rev-of b))
                           (map (lambda (x)
                                  (if (eq? (ad._exit-kind x) 'continue)
                                      (ad._with-pruned x
                                        (append (ad._rev-of s)
                                                (ad._exit-pruned x)))
                                      x))
                                own))
                         (ad._count n '-))))
    (list n iteration dispatch through (ad._unbind (ad._pure c)))))

$(defun ad._count (n op)
  (ad._assign n (ad._raw op (ad._id n) (ad._int "1"))))
$(defun ad._items (body)
  (match-case body ((block *items) *items) (else (list body))))
$(defun ad._countdown (n dispatch)
  `(while (expr () (op > ,(ad._id n) ,(ad._int "0"))) (block ,@dispatch)))

$(defun ad._rev-loop (init c step body names)
  (let* ((head (ad._rev-optional init names))
         (parts (ad._loop-parts c body step names))
         (n (car parts)) (iteration (cadr parts))
         (dispatch (car (cddr parts))) (through (cadr (cddr parts)))
         (condition (car (cddr (cddr parts))))
         (loop (ad._triple
                 (list (ad._assign n (ad._int "0"))
                       `(while ,condition (block ,@iteration))
                       (ad._push (ad._id n)))
                 (list (ad._restore n '(int)) (ad._countdown n dispatch))
                 (map (lambda (x)
                        (ad._with-pruned x
                          (append (ad._exit-pruned x)
                                  (list (ad._count n '-)
                                        (ad._countdown n dispatch)))))
                      through))))
    (ad._sequence (list head loop))))

/* `do` runs its body once before testing: a flag makes it a `while`. */
$(defun ad._rev-do (body c names)
  (let ((first (ad._fresh "_ad_first" '(int))))
    (ad._sequence (list
      (ad._triple (list (ad._assign first (ad._int "1"))) '() '())
      (ad._loop nil `(expr (int) (op || (expr (int) (ident (,first))) ,c))
                    nil `(block ,(ad._assign first (ad._int "0")) ,body)
                    names)))))

/* Checkpointed loops record nothing while running. Every `block`
   iterations the variables the loop assigns are pushed, and the reverse
   restores each block from its snapshot, replays it with recording, and
   reverses the replay. Memory is one snapshot per block plus one block's
   tape, at the cost of running the loop twice. */
$(defun ad._assigned (form acc)
  (cond ((not (list? form)) acc)
        ((null? form) acc)
        (true
         (let ((update (if (match form '(expr ? ?)) (ad._update form) nil)))
           (if (and update (not (member (car update) acc)))
               (ad._assigned (cdr form) (cons (car update) acc))
               (foldl (lambda (a x) (ad._assigned x a)) acc form))))))
$(defun ad._declared-names (form acc)
  (match-case form
    ((declare ? (bindings *decls)) (append (ad._declarator-names *decls) acc))
    ((decl ? (bindings *decls)) (append (ad._declarator-names *decls) acc))
    (else (if (list? form)
              (foldl (lambda (a x) (ad._declared-names x a)) acc form)
              acc))))
$(defun ad._declarator-names (decls)
  (ad._concat (map (lambda (d)
    (match-case d
      ((op = (bind (binding ? ?n) ()) ?) (list ?n))
      ((bind (binding ? ?n) ()) (list ?n))
      (else '()))) decls)))
$(defun ad._rev-loop-checkpointed (init c step body names block)
  (let* ((head (ad._rev-optional init names))
         (parts (ad._loop-parts c body step names))
         (n (car parts)) (iteration (cadr parts))
         (dispatch (car (cddr parts))) (through (cadr (cddr parts)))
         (condition (car (cddr (cddr parts))))
         (inner (ad._declared-names (list body step) '()))
         (state (filter (lambda (v) (not (member v inner)))
                        (ad._assigned (list body step) '())))
         (total (ad._fresh "_ad_total" '(int)))
         (blocks (ad._fresh "_ad_blocks" '(int)))
         (remaining (ad._fresh "_ad_remaining" '(int)))
         (replay (ad._fresh "_ad_replay" '(int)))
         (size (ad._int block))
         (snapshot (map (lambda (v) (ad._push (ad._id v))) state))
         (recover (map (lambda (v) (ad._restore v (ad._local-type v)))
                       (reverse state))))
    (begin
    (if through
        (ad._fail "a checkpointed loop cannot contain return" body)
        nil)
    (ad._sequence (list head
      (ad._triple
        (list (ad._assign total (ad._int "0"))
              (ad._assign blocks (ad._int "0"))
              `(for () ,condition ,(if step (ad._unbind step) '())
                 (block
                   (if (expr () (op == (expr () (op % ,(ad._id total) ,size))
                                    ,(ad._int "0")))
                     (block ,@snapshot ,(ad._count blocks '+)))
                   ,(ad._count total '+)
                   ,@(ad._unbind (ad._items body))))
              (ad._push (ad._id total))
              (ad._push (ad._id blocks)))
        (list (ad._restore blocks '(int))
              (ad._restore total '(int))
              `(while (expr () (op > ,(ad._id blocks) ,(ad._int "0")))
                 (block
                   ,@recover
                   ,(ad._assign remaining
                      (ad._raw '- (ad._id total)
                        (ad._raw '* (ad._raw '- (ad._id blocks) (ad._int "1"))
                                 size)))
                   ,(ad._assign replay (ad._int "0"))
                   ,(ad._assign n (ad._int "0"))
                   (while (expr () (op < ,(ad._id replay) ,(ad._id remaining)))
                     (block ,(ad._count replay '+) ,@iteration))
                   ,(ad._countdown n dispatch)
                   ,(ad._assign total
                      (ad._raw '- (ad._id total) (ad._id remaining)))
                   ,(ad._count blocks '-))))
        '()))))))

$(def ad._checkpoint nil)
$(defun ad._loop (init c step body names)
  (if ad._checkpoint
      (ad._rev-loop-checkpointed init c step body names ad._checkpoint)
      (ad._rev-loop init c step body names)))

$(defun ad._rev-item (s names)
  (match-case s
    ((at ? ?node) (ad._rev-item ?node names))
    ((declare ?type (bindings *decls))
     (ad._sequence (map (lambda (d) (ad._rev-decl ?type d names)) *decls)))
    ((decl ?type (bindings *decls))
     (ad._sequence (map (lambda (d) (ad._rev-decl ?type d names)) *decls)))
    ((stmnt ?e)
     (let ((update (ad._update ?e)))
       (if update
           (ad._rev-assign (car update) (cadr update) names)
           (ad._triple (list (ad._unbind (ad._pure s))) '() '()))))
    ((expr ? ?) (ad._rev-item `(stmnt ,s) names))
    ((if ?c ?then) (ad._rev-if ?c ?then nil names))
    ((if ?c ?then ?else) (ad._rev-if ?c ?then ?else names))
    ((while ?c ?body) (ad._loop nil ?c nil ?body names))
    ((do ?body ?c) (ad._rev-do ?body ?c names))
    ((for ?init ?c ?step ?body) (ad._loop ?init ?c ?step ?body names))
    ((block *items) (ad._rev-items *items names))
    ((break)
     (let ((code (ad._code)))
       (ad._triple (list (ad._push (ad._lit code)) s) '()
                   (list (ad._exit code 'break '())))))
    ((continue)
     (let ((code (ad._code)))
       (ad._triple (append ad._loop-step
                           (list (ad._push (ad._lit code)) s))
                   '() (list (ad._exit code 'continue '())))))
    ((return (double) ?e)
     (let ((code (ad._code)))
       (ad._triple
         (list (ad._assign "_ad_result" (ad._unbind (ad._pure ?e)))
               (ad._push (ad._lit code))
               '(goto ("_ad_reverse")))
         '()
         (list (ad._exit code 'return
                         (ad._adjoint ?e (ad._lit "1.0") names))))))
    ((return ? ?) (ad._fail "return must produce double" s))
    ((empty) (ad._none))
    (else (ad._fail "unsupported statement in reverse mode" s))))

$(defun ad._grad-params (params)
  (append (map ad._unbind params)
    (ad._concat (map (lambda (p)
      (match-case p
        ((param (double) (bind (binding ? ?n) ()))
         (list `(param (double) (bind (,(ad._grad ?n)) (*)))))
        (else '()))) params))))

$(defun ad._param-locals (params)
  (map (lambda (p)
    (match-case p
      ((param ?type (bind (binding ? ?n) ())) (list ?n ?type))
      (else (ad._fail "unsupported parameter" p)))) params))

$(defun ad._write-slot (n)
  (ad._stmnt `(expr () (op = (expr () (op * ,(ad._id (ad._grad n))))
                            ,(ad._id (ad._bar n))))))

$(defun ad._reverse-function (spec name params items)
  (let* ((inputs (ad._param-doubles params))
         (names (append inputs (ad._declared-doubles `(block ,@items))))
         (sweep (ad._rev-items items names))
         (returns (filter (lambda (x) (eq? (ad._exit-kind x) 'return))
                          (ad._exits-of sweep)))
         (stray (filter (lambda (x) (not (eq? (ad._exit-kind x) 'return)))
                        (ad._exits-of sweep)))
         (hoisted (filter (lambda (l)
                            (not (member (car l) (ad._param-names params))))
                          (reverse ad._locals))))
    (begin
    (if stray (ad._fail "break or continue outside a loop" name) nil)
    (if (null? returns) (ad._fail "function has no return" name) nil)
    `(function ,spec
       (bind (,(ad._grad name)) ((fnmod (params ,@(ad._grad-params params)))))
       (block
         ,(ad._declare '("ArrayDbl") "_ad_tape" (ad._call "ArrayDbl_new" '()))
         ,(ad._declare '(double) "_ad_result" (ad._zero))
         ,(ad._declare '(double) "_ad_seed" (ad._zero))
         ,(ad._declare '(double) "_ad_code" (ad._zero))
         ,@(map (lambda (l) (ad._declare (cadr l) (car l)
                                         (ad._zero-of (cadr l))))
                hoisted)
         ,@(map (lambda (n) (ad._declare '(double) (ad._bar n) (ad._zero)))
                names)
         ,@(ad._fwd-of sweep)
         (label ("_ad_reverse"))
         ,(ad._assign "_ad_code" (ad._pop))
         ,(ad._dispatch '() returns)
         ,@(map ad._write-slot inputs)
         ,(ad._stmnt (ad._call "ArrayDbl_free" (list (ad._id "_ad_tape"))))
         (return (double) ,(ad._id "_ad_result")))))))

$(defun ad._literal-text (form)
  (match-case form
    ((expr ? (literal ? ?text)) ?text)
    ((expr (macro-expr) ?inner) (ad._literal-text ?inner))
    (else (ad._fail "expected an integer literal" form))))

$(defun ad._reverse-with (fn checkpoint)
  (if (not (list? fn)) '()
    (match-case fn
      ((function ?spec (bind (binding ? ?name) ((fnmod (params *params))))
         (block *items))
       (begin
         (ad._check-result ?spec fn)
         (def ad._reverse-siblings (cons ?name ad._reverse-siblings))
         (def ad._locals (ad._param-locals *params))
         (def ad._counter 0)
         (def ad._loop-step '())
         (def ad._checkpoint checkpoint)
         (list (ad._reverse-function ?spec ?name *params *items))))
      (else (ad._fail "expected a function definition" fn)))))

$(defun ad.reverse (fn) (ad._reverse-with fn nil))
$(defun ad.checkpoint (fn block)
  (ad._reverse-with fn (if (list? block) (ad._literal-text block) nil)))

/** Emits `NAME_dot` beside a `double` function: every `double` parameter `p`
    is followed by `p_dot`, and the result is the directional derivative.
    Statements, `if`, loops, casts, the primitives in `ad._primitives`, and
    calls to earlier `$ad.forward()` functions are supported; anything else
    is a diagnostic at the invocation.
*/
macro Decorator $ad.forward(Unit $fn) => {
  $fn
  $(ad.forward $fn)...
}

/** Emits `NAME_grad` beside a `double` function: the original parameters
    are followed by one `double *p_grad` per `double` parameter, the result
    is the primal value, and each gradient slot receives d result / d p. The
    unit must include `typed-array.x` for the tape. Every local is hoisted, so
    names must be unique within the function. Loops, `break`, `continue`,
    and `return` anywhere in the body replay from recorded exit codes.
*/
macro Decorator $ad.reverse(Unit $fn) => {
  $fn
  $(ad.reverse $fn)...
}

/** Like `$ad.reverse()`, but every loop runs without recording and pushes a
    snapshot of the variables it assigns once per `$block` iterations; the
    reverse sweep replays each block from its snapshot with recording and
    then reverses it. Tape memory is bounded by one block plus one snapshot
    per block, and the loop runs twice. A checkpointed loop cannot contain
    `return`.
*/
macro Decorator $ad.checkpoint(Unit $fn, Literal $block) => {
  $fn
  $(ad.checkpoint $fn $block)...
}

/** Emits both `NAME_dot` and `NAME_grad`. Decorators cannot stack when each
    produces several items, so this is the spelling for a function that
    needs both derivatives.
*/
macro Decorator $ad.both(Unit $fn) => {
  $fn
  $(append (ad.forward $fn) (ad.reverse $fn))...
}
