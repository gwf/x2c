/* Lisp session error conditions. Runtime operands retain their original
   detail types, order and source helper ownership. */

macro Statement $_lisp_session_error_callback_absent(Expr $operation) {
  raise %(bad-state (operation ${$operation}) (why "no session"));
}

macro Statement $_lisp_session_error_callback_wrong(Expr $operation) {
  raise %(bad-state (operation ${$operation}) (why "wrong session"));
}

macro Statement $_lisp_session_error_entry_null(Expr $operation) {
  raise %(bad-arg (operation ${$operation}));
}

macro Statement $_lisp_session_error_global_args() {
  raise %(bad-arg (operation "Lisp.set_global"));
}

macro Statement $_lisp_session_error_global_frozen() {
  raise %(bad-state (operation "Lisp.set_global") (why "frozen"));
}

macro Statement $_lisp_session_error_global_inherited(Expr $name) {
  raise %(bad-state (operation "Lisp.set_global") (why "inherited")
          (name ${$name}));
}

macro Statement $_lisp_session_error_bind_args() {
  raise %(bad-arg (operation "Lisp.bind"));
}

macro Statement $_lisp_session_error_source_callable(Expr $callable) {
  raise %(bad-types (operation "lisp_source_function") (want "Lambda")
          (actual ${$callable.kind()}));
}

macro Statement $lisp.session.error(Literal $key, Expr $arguments...) {
  $(let* ((key (x2c.literal.value $key))
          (row (assoc key '(
        ("callback.absent" _lisp_session_error_callback_absent)
        ("callback.wrong" _lisp_session_error_callback_wrong)
        ("entry.null" _lisp_session_error_entry_null)
        ("global.args" _lisp_session_error_global_args)
        ("global.frozen" _lisp_session_error_global_frozen)
        ("global.inherited" _lisp_session_error_global_inherited)
        ("bind.args" _lisp_session_error_bind_args)
        ("source.callable" _lisp_session_error_source_callable)))))
    (if row
      (list (_x2c.tpl-call (cadr row) $arguments))
      (x2c.diagnostic.fail
        (string-append "unknown Lisp session error '" key "'") '())))...
}
