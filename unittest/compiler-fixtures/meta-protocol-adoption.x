#include "x2c.x"

/* A `meta` adoption exposes the conformance's witnesses to the generated
   native target inventory, whether written or generated by a macro. An
   iterator operation binds its native form as `NAME_into`, and `NAME`
   allocates the destination a call omits. A callback operation binds
   through its adapter, so the inventory leaves it out. */
typedef struct Bag { List items; } *Bag;
Iter Bag.iter(Bag bag, Iter dest) => bag.items.iter(dest);
meta protocol Iter(Bag);

typedef struct Box { List items; } *Box;
Iter Box.iter(Box box, Iter dest) => box.items.iter(dest);
macro Unit $mark(Type $t) {
  meta protocol Iter($t);
}
$mark(Box);

$(defun probe.row (name rows)
   (cond ((null? rows) nil)
         ((equal? (car (car rows)) name) (car rows))
         (true (probe.row name (cdr rows)))))
macro Expression $target(Expr $name) =>
  $(repr (probe.row (x2c.literal.value $name)
                          (_x2c.native-meta.targets)));

meta Var twice(Var value) => value * 2;

meta int heads(int offset) {
  struct Iter source, head;
  return range(1, 9, 1).map(twice).head(2).sum().int() * 10 +
         range(1, 9, 1, &source).head(3 + offset, &head).count();
}

int main(int argc, char **argv) {
  (void) argv;
  printf("%s\n%s\n%s\n%s\n%s\n%s\n%s\n", $target("Bag_iter"),
         $target("Box_iter"), $target("List_iter"), $target("File_iter"),
         $target("Iter_head"), $target("Iter_map"), $target("fabs"));
  printf("%d %d\n", $heads(0), heads(argc - 1));
  return 0;
}
