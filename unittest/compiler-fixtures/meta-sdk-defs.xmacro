/*  meta-sdk-defs.xmacro -- macro implementations written in x2c

    Each macro body below does nothing but call a `meta` function, and the
    `meta` functions do the work through `Meta`, the compiler surface
    `lib/meta.x` declares. Before that surface existed the same bodies had to
    be written in compile-time Lisp, because `x2c.type.fields`,
    `x2c.expr.field` and the rest were reachable only from there.

    A parameter declared `TypeInfo` receives the description of its argument's
    type, which the compiler computes at the `$` call, so reading the fields
    of a struct asks the compiler nothing. The consuming unit calls only
    `ms_label` at run time, so its definition is the only one in the
    generated C. See `plans/meta-functions.md`.
*/

/* The named fields of a struct-typed expression, in declaration order. The
   answer is in the symbol table, not in the syntax the macro received, so
   the compiler sends it as the `TypeInfo` argument. */
meta static List ms_fields(TypeInfo type) => type.assoc(<fields>);

/* One field-read expression per field, through the receiver the caller
   wrote, so the generated code is ordinary typed access. */
meta static List ms_field_reads(List receiver, TypeInfo type) {
  Array reads = [];
  foreach (List field, ms_fields(type))
    reads.push(x2c_expr_field(receiver, field.car()));
  return reads;
}

/* `{ p.x, p.y, p.z }`, built from the fields rather than written out. */
meta static List ms_reads(List receiver, TypeInfo type) =>
  x2c_expr_composite(ms_field_reads(receiver, type));

/* `ms_total(p.x, p.y, p.z)`, a call the unit defines the callee for. */
meta static List ms_total_call(List receiver, TypeInfo type) =>
  x2c_expr_call(
    x2c_expr_ident(x2c_ident("ms_total")), ms_field_reads(receiver, type));

/* The field names as one comma-joined String literal. */
meta static List ms_names(TypeInfo type) {
  Array names = [];
  foreach (List field, ms_fields(type)) names.push(field.car());
  return x2c_literal_string(String.join(", ", names));
}

meta static List ms_count(TypeInfo type) =>
  x2c_literal_int(ms_fields(type).len());

/* The spelling the developer wrote, which only the source text answers.
   A `Source` argument carries that text with the captured syntax. */
meta static List ms_spelling(Source node) =>
  x2c_literal_string(x2c_source_text(node));

/* A `meta` function that reaches no `Meta` operation, so it keeps both of
   its forms the way M1 and M2 left it. */
meta static String ms_label(String name, int n) => %"$name-$n";

macro Expression $probe.reads(Expr $value) => $ms_reads($value, $value);

macro Expression $probe.total(Expr $value) => $ms_total_call($value, $value);

macro Expression $probe.names(Expr $value) => $ms_names($value);

macro Expression $probe.count(Expr $value) => $ms_count($value);

macro Expression $probe.spelling(Expr $value) => $ms_spelling($value);
