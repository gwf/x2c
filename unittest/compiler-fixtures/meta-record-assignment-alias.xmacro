/* meta-record-assignment-alias.xmacro -- the meta functions
   meta-record-assignment-alias.x imports. */

meta int assignment_alias(void) {
  struct AssignmentPoint a = { .x = 1 }, b = { .x = 2 };
  int *field = &a.x;
  a = b;
  return *field * 10 + a.x;
}

meta int pointer_identity(void) {
  struct AssignmentPoint record = { .x = 7 };
  int *alias = &record.x;
  struct AssignmentPointer holder = { .field = &record.x };
  Var boxed = &record.x;
  Var same = &record.x;
  return (&record.x == &record.x) +
         10 * (&record == &record) +
         100 * (alias == &record.x) +
         1000 * (holder.field == &record.x) +
         10000 * (boxed == same);
}
