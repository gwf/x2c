/* The custom Var tag registry holds 32 rows. Filling them with classes
   leaves none for the runtime types that register later, and the
   exhaustion must name the budget instead of the next type to ask. */
#include "x2c.x"

class P00 struct { int x; } *;
class P01 struct { int x; } *;
class P02 struct { int x; } *;
class P03 struct { int x; } *;
class P04 struct { int x; } *;
class P05 struct { int x; } *;
class P06 struct { int x; } *;
class P07 struct { int x; } *;
class P08 struct { int x; } *;
class P09 struct { int x; } *;
class P10 struct { int x; } *;
class P11 struct { int x; } *;
class P12 struct { int x; } *;
class P13 struct { int x; } *;
class P14 struct { int x; } *;
class P15 struct { int x; } *;
class P16 struct { int x; } *;
class P17 struct { int x; } *;
class P18 struct { int x; } *;
class P19 struct { int x; } *;
class P20 struct { int x; } *;
class P21 struct { int x; } *;
class P22 struct { int x; } *;
class P23 struct { int x; } *;
class P24 struct { int x; } *;
class P25 struct { int x; } *;
class P26 struct { int x; } *;
class P27 struct { int x; } *;
class P28 struct { int x; } *;
class P29 struct { int x; } *;
class P30 struct { int x; } *;
class P31 struct { int x; } *;

int main(void) {
  printf("registration succeeded\n");
  return 0;
}
