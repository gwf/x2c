// Macros in the indentation syntax, selected by the .xp extension.
$(defun indent-offset () 2)

macro Expression $indent.answer(Expr $base) =>
  $base + $(indent-offset)

macro Decorator $indent.range(
  Stmt $body,
  Name $index,
  Expr $start,
  Expr $stop
):
  do:
    int begin = $start, end = $stop
    for (int $index = begin; $index < end; $index++): $body

macro Stmt $indent.swap(Expr $left, Expr $right):
  $(x2c.syntax.type $left) temporary = $left
  $left = $right
  $right = temporary

macro Decorator $indent.fallback(Stmt $target, Expr $fallback):
  do:
    $target
    return $fallback

macro Stmt $indent.sequence(Stmt @rows):
  @rows

macro Stmt $indent.generated(Stmt $row):
  @indent.sequence($row)
  @(list $row)
