macro Statement $test.scoped() => {
  Scope.retain();
  defer Scope.release();
}

macro Statement $test.run(Name $function) => {
  TestHarness_run($(x2c.binding.spelling $function), $function);
}

macro Statement $test.suite(Name $suite) => {
  TestSuite_begin($(x2c.binding.spelling $suite));
  $suite();
}

macro Expression $test.incrementing_lambda(Name $binding) => (
  %!() using &$binding => ++$binding
)

macro Expression $test.block_lambda(Expr $bias) => (
  %!(int value) => {
    int result = value + $bias;
    if (result) return result;
    return;
  }
)
