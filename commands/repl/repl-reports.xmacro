/* REPL command-boundary messages. The client retains status handling. */

macro Stmt $report.repl.usage(Expr $synopsis) {
  fprintf(stderr, "usage: %s\n", $synopsis);
}

macro Stmt $report.repl.function(Expr $name) {
  fprintf(stderr, "not a session function: %s\n", $name);
}

macro Stmt $report.repl.command(Expr $command) {
  fprintf(stderr, "unknown command: %s\n", $command);
}

macro Stmt $report.repl.incomplete() {
  fputs("incomplete input at EOF\n", stderr);
}
