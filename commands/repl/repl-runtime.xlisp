// Ordinary Lisp support for interpreted REPL submissions.
// A value reaching a C scalar type carries that type's `Var` tag, so every
// later operation applies the usual arithmetic conversions the way C does.
// `Var.convert` is the conversion: integer narrowing keeps low bits,
// floating to integer truncates toward zero, and an integer widens. A
// Symbol is stored with its own tag even when C selects an integer arm.
(defun C.conv (v tag)
  (Var.convert (if (eq? (Var.tag v) 'symbol) (Var.integer v) v) tag))

// C compares after the usual arithmetic conversions, which `_binary`'s
// arithmetic already performs, so the tag of a sum names the common type.
// The lowering emits this only where the two operand types differ. An
// infinite or NaN sum carries its own tag, which is no conversion target;
// its order is the same in double.
(defun C.compare (a op b)
  (let* ((sum (Var.tag (_binary a '+ b)))
         (tag (if (member sum '(+inf -inf nan)) 'f64 sum)))
    (_binary (C.conv a tag) op (C.conv b tag))))

// x2c truth: nil is false, a number is false at zero, a C pointer is false
// at the null address, and anything else is true. The zero reaches the
// value's own type first: `eq?` compares a `Var` by identity, so a `double`
// zero is not the `int` zero it was tested against.
(defun C.nonzero? (a) (not (eq? (C.compare a '!= 0) 0)))

(defun C.true? (a)
  (cond ((eq? a (C.void)) nil)
        ((null? a) nil)
        ((number? a) (C.nonzero? a))
        ((eq? (Var.kind a) 'pointer) (not (eq? (Var.truth a) 0)))
        (true true)))

(defun C.not (a) (if (C.true? a) 0 1))

// C negation keeps the operand's type. A floating zero is multiplied by -1 in
// its own type, since `0 - 0.0` is `+0.0` where C gives `-0.0`.
(defun C.neg (a)
  (if (eq? (Var.kind a) 'floating)
      (if (C.true? a) (_binary 0 '- a) (_binary (C.conv -1 (Var.tag a)) '* a))
      (_binary 0 '- a)))

// A value reaching `bool` is 0 or 1, and reads as the int C promotes it to.
(defun C.bool (a) (if (C.true? a) 1 0))

(defmacro C.and (a b) `(if (C.true? ,a) (if (C.true? ,b) 1 0) 0))
(defmacro C.or (a b) `(if (C.true? ,a) 1 (if (C.true? ,b) 1 0)))
(defmacro C.ternary (test a b) `(if (C.true? ,test) ,a ,b))

// An evaluator cell holds one raw Var, so terminal `void` never enters an
// ordinary collection.
(def C.void repl.native.lisp_void)
(def C.cell repl.native.lisp_cell)
// The same native retagger boxes a numeric Symbol code at that destination.
(def C.address repl.native.lisp_address)
(def C.load repl.native.lisp_load)
(def C.store repl.native.lisp_store)

// A C object whose address matters lives in native bytes, and its slot holds
// the pointer native code would box. The lowering supplies each layout,
// offset, and size; see `lisp_peek` in repl-runtime.x. A record reads as its
// own address, and assigning one copies into the bytes it already has.
(def C.bytes repl.native.lisp_bytes)
(defun C.array (layout values) (repl.native.lisp_array layout values))
(def C.at repl.native.lisp_at)
(def C.copy repl.native.lisp_copy)
(def C.zero repl.native.lisp_zero)
(def C.peek repl.native.lisp_peek)
(def C.poke repl.native.lisp_poke)
(def C.record.result repl.native.lisp_record_result)
(def C.session-copy repl.native.lisp_session_copy)
(def C.source-function repl.native.lisp_source_function)
// Cleanup runs on ordinary exits and raises. An exhausted evaluation budget
// prevents further interpreted code, including this cleanup.
(defun C.unwind (body cleanup arguments)
  (repl.native.lisp_unwind body cleanup arguments))

(defun C.new (size tag layout value)
  (let ((object (C.at (C.bytes size) 0 tag)))
    (begin (C.poke object 0 layout value) object)))

(defun C.index (p i size layout)
  (C.peek p (* i size) layout))
(defun C.index.set (p i size layout value)
  (C.poke p (* i size) layout value))

// Persistent submission values, keyed by compiler binding id. The table
// belongs to this interpreter; records hold their own session-owned bytes.

(defun C.gread (id)
  (if (eq? (Map.contains C._globals id) 0) 0
      (Map.getindex C._globals id)))

(defun C.gwrite (id value)
  (Map.setindex C._globals id
    (if (eq? (Var_is_wide value) 0) value (C.session-copy value 0))))
(defun C.grecord.write (id value size)
  (if (eq? (Map.contains C._globals id) 0)
      (C.gwrite id (C.session-copy value size))
      (C.copy (Map.getindex C._globals id) value size)))

// The library operations a lowered call resolves against, under the names
// the typed AST already uses.
(def List_cons cons)
(def List_cddr cddr)
(def List_str str)
(def List_repr repr)
(def List_len length)
(def List_reverse reverse)
// Absence stays `void`; the evaluator transports it outside ordinary Lists.
(def List_getindex List.getindex)
(defun List_caar (xs)
  (let ((head (List_getindex xs 0)))
    (if (eq? head (C.void)) head (List_getindex head 0))))
(defun List_cadr (xs) (List_getindex xs 1))
(defun List_caddr (xs) (List_getindex xs 2))
(def List_last List.last)
(def List_assoc List.assoc)
(def List_get List.get)
(def List_array List.array)
(def List_sort List.sort)
(def List_match match)
(def List_search search)
(defun List_equal (a b) (if (equal? a b) 1 0))
(defun List_contains (xs v) (if (member v xs) 1 0))
(def List_map (bind "List_map" nil))
(def List_filter (bind "List_filter" nil))
(def List_any (bind "List_any" nil))
(def List_all (bind "List_all" nil))
(def List_map2 (bind "List_map2" nil))
(def List_sort_by (bind "List_sort_by" nil))
(def List_sort_with (bind "List_sort_with" nil))
(def List_zip_with (bind "List_zip_with" nil))
(def List_foldl (bind "List_foldl" nil))
(def List_find (bind "List_find" nil))

// `foreach` expands to a `try_next` loop whose cursor and outputs are C
// objects, so each step is the native operation writing through them. The
// expansion reaches meta code in any unit, so these bind here rather than
// from a prototype the unit may not include.
(def List_try_next (bind "List_try_next" nil))
(def Array_try_next (bind "Array_try_next" nil))
(def Map_try_next (bind "Map_try_next" nil))
(def String_try_next (bind "String_try_next" nil))
(def Split_try_next (bind "Split_try_next" nil))
(def Iter_try_next (bind "Iter_try_next" nil))

(def Array_new Array.new)
(def Array_len Array.len)
(def Array_push Array.push)
(def Array_getindex Array.getindex)
(def Array_setindex Array.setindex)
(def Array_list Array.list)
(def Array_str str)
(def Array_repr repr)
(def Array_map (bind "Array_map" nil))
(def Array_map2 (bind "Array_map2" nil))
(def Array_sort_by (bind "Array_sort_by" nil))
(def Array_sort_with (bind "Array_sort_with" nil))
(def Array_foldl (bind "Array_foldl" nil))
(def Array_take_last Array.take_last)
(def Array_shift Array.shift)
(def Array_remove Array.remove)
(def Array_insert Array.insert)

// A map literal builds its entries in one expression, the way an array
// literal does, so the lowering needs no statement sequence. The flat list
// alternates key and value in source order, so a repeated key keeps the
// last entry the way the braced form reads.
(defun Map_of (flat) (_map_fill (Map.new) flat))
(defun _map_fill (m flat)
  (if (null? flat) m
      (begin (Map.setindex m (car flat) (car (cdr flat)))
             (_map_fill m (cdr (cdr flat))))))

(def Map_new Map.new)
(def Map_get Map.get)
(def Map_getindex Map_get)
(def Map_setindex Map.setindex)
(def Map_del Map.del)
(def Map_str str)
(def Map_repr repr)

(def String_map (bind "String_map" nil))
(def String_filter (bind "String_filter" nil))

// A lowered iterator call binds on first use from its `meta` declaration in
// lib/iter.x or lib/protocols.x, through `C.iterator.call`. These rows bind
// through their adapters in lib/lisp.x.
(defun Iter_init (destination object callable state)
  ((bind "Iter_init" nil) destination object callable state))
(def Iter_any (bind "Iter_any" nil))
(def Iter_all (bind "Iter_all" nil))
(def Iter_foldl (bind "Iter_foldl" nil))
(def Iter_find (bind "Iter_find" nil))

(def String_lstrip String.lstrip)
(def String_rstrip String.rstrip)

(def String_getindex String.getindex)
(def String_str str)
(def String_repr repr)
(def String_add String.add)
(def String_strip String.strip)
(defun String_new (text) text)
(defun String_equal (a b) (if (equal? a b) 1 0))

