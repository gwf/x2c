// Source Func values retain the native signature and carrier contract.
(defun C.func.new (adapter signature)
  (repl.native.lisp_func_new adapter signature))
(defun C.func.arguments (count)
  (repl.native.lisp_func_arguments count))
(defun C.func.value (argv index value)
  (repl.native.lisp_func_value argv index value))
(defun C.func.reference (argv index address source)
  (repl.native.lisp_func_reference argv index address source))
(defun C.func.invalid (fn index source)
  (repl.native.lisp_func_invalid fn index source))
(defun C.func.reference-type (fn count index)
  (repl.native.x2c_func_reference_type fn count index))
(defun C.func.reference-argument (fn argv index type)
  (repl.native.x2c_func_reference_argument fn argv index type))
(defun C.func.declared-reference-argument (fn argv index declared type)
  (repl.native.x2c_func_declared_reference_argument
   fn argv index declared type))
(defun C.func.value-argument (fn argv index tag)
  (repl.native.x2c_func_value_argument fn argv index tag))
(defun C.func.pointer-argument (fn argv index)
  (repl.native.x2c_func_pointer_argument fn argv index))
(defun C.func.apply (fn count argv)
  ((bind "Func_apply" nil) fn count argv))
(defun Func_signature (fn) ((bind "Func_signature" nil) fn))
(defun Var_new (tag value) (repl.native.lisp_box tag value))
(defun Func_var (v) v)
(defun Var_func (v) v)

