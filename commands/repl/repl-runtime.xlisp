(defun Var_box_long_long (v) (C.conv v 'llong))
(defun Var_box_ulong_long (v) (C.conv v 'ullong))
(defun Var_box_long_double (v) (C.conv v 'ldouble))
(defun char_var (v) (C.conv v 'i8))
(defun uchar_var (v) (C.conv v 'u8))
(defun short_var (v) (C.conv v 'i16))
