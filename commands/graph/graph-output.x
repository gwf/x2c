#pragma once
#include "system-macros.x"

/*  graph-output.x -- command help display */

macro Stmt $output.graph.usage(Expr $out) {
  $out.printf(
    "%s",
    $dedent(%"
    Usage:
      x2c graph snapshot <output> [<build-option>...] [<file>...]
      x2c graph status <snapshot>
      x2c graph query <snapshot> <query-file>
      x2c graph serve <snapshot>
      x2c graph diff <before> <after>
      x2c graph graph|digest [-I <dir>] <file>...
      x2c graph clones [--min-size <n>] [-I <dir>] <file>...
      x2c graph datasets <output> [-I <dir>] <src-file>... -- <lib-file>...
                         [-- <command-file>...]
      x2c graph architecture [-I <dir>] <file>...
      x2c graph structure <unit> [-I <dir>] <file>...
      x2c graph between <left> <right> [-I <dir>] <file>...
      x2c graph focus <name> [-I <dir>] <file>...
      x2c graph field <type> <field> [-I <dir>] <file>...
      x2c graph field-sites <type> <field> [-I <dir>] <file>...
      x2c graph sites <name> [-I <dir>] <file>...
      x2c graph walks [-I <dir>] <file>...
      x2c graph tail-calls [-I <dir>] <file>...
      x2c graph loop-allocations [--all] [-I <dir>] <file>...
      x2c graph lifetime-escapes [-I <dir>] <file>...
      x2c graph certify --root <name> [--root <name>...] [--contracts <file>]
                        [-I <dir>] <file>...
      x2c graph allocation-returns <name> [-I <dir>] <file>...
      x2c graph flows <producer> <consumer> [-I <dir>] <file>...
      x2c graph compare <left> <right> <target>... -- [-I <dir>] <file>...

    Inspect x2c source graphs: save and query snapshots of a build, or
    analyze source files directly.

    Options:
      -h, --help                  Show help and exit
    "));
}
