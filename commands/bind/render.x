/*  render.x -- package text for a surveyed header

    Copyright (c) 2026 Gary William Flake.

    Produces the generated region of a package's entry unit, a new entry
    unit around it, the header shim, the Makefile, and the README stub.
    Lines stay within 79 columns unless one C type is longer.
*/

#pragma once
#include "system-macros.x"
#include "survey.x"

/** The package a binding writes: its name, the bound header's absolute
    path, the shim that includes it, the output directory, and the native
    include directories and libraries that consumers need.
*/
typedef struct BindRequest {
  String package, header, shim;
  Path out_dir;
  List include_dirs, libraries;
} *BindRequest;

/** Opens the generated region of a package entry unit. */
const String bind_begin = "/* x2c bind: begin generated raw tier */";

/** Closes the generated region of a package entry unit. */
const String bind_end = "/* x2c bind: end generated raw tier */";

/** Returns the generated region of the entry unit, markers included. */
String Survey.region(Survey s, BindRequest request) {
  Buffer out = Buffer.new(0);
  out.printf(
    $dedent(%"
    %s
    /*  Generated by `x2c bind` from %s. Rerun it to refresh
        this region, and write the ordinary x2c surface after the end marker. */

    #include \"%s\"
    "),
    bind_begin, Path.basename(request.header), request.shim);
  if (s.releases) out.write("#include \"cleanup.x\"\n");
  _typedefs(s, out);
  _adoptions(s, out);
  _method_groups(s, out);
  out.printf("%s\n", bind_end);
  return out;
}

/** Returns `text` with its generated region replaced by `region`, or NULL
    when `text` lacks either marker.
*/
String Survey.replace_region(String text, String region) {
  int begin = text.find(bind_begin), end = text.find(bind_end);
  if (begin < 0 || end < begin) return NULL;
  int after = end + bind_end.len();
  if (after < text.len() && text[after] == '\n') after++;
  return %"$(text[:begin])$(region)$(text[after:text.len()])";
}

/** Returns a new entry unit: a module header, the region, and a label for
    the ordinary x2c surface.
*/
String Survey.entry_unit(Survey s, BindRequest request) =>
  String.printf(
    $dedent(%"
    /*  %s.x -- the %s package

        The ordinary x2c surface follows the generated raw tier.
    */

    %s
    // ordinary x2c surface
    "),
    request.package, request.package, s.region(request));

/** Returns the header shim, which includes the real header once. */
String Survey.shim(Survey s, BindRequest request) {
  String header = Path.basename(request.header);
  return String.printf(
    $dedent(%"
    /* %s -- the complete raw C interface of %s. */

    #pragma once

    #include <%s>

    /* A pinned package rejects other versions here, as
       packages/sqlite/src/sqlite-3.h does. */
    "),
    request.shim, header, header);
}

/** Returns the package Makefile. */
String Survey.makefile(Survey s, BindRequest request) {
  Buffer out = Buffer.new(0);
  out.printf(
    $dedent(%"
    PACKAGE := %s
    include ../package.mk

    # Generated by x2c bind: the native include directories and libraries
    # that the package and its consumers need.
    PACKAGE_C_FLAGS := --c-include-dir src"), request.package);
  _include_flags(out, request.include_dirs);
  out.write("\nPACKAGE_LINK :=");
  _include_flags(out, request.include_dirs);
  foreach (String library in request.libraries) out.printf(" -l%s", library);
  out.write("\n");
  return out;
}

/** Returns the README stub: what was generated and what remains. */
String Survey.readme(Survey s, BindRequest request) {
  Buffer out = Buffer.new(0);
  _readme_generated(s, request, out);
  _readme_inventory(s, out);
  out.write(
    $dedent(%"
    ## Still to write

    1. Pin the dependency: `dependency.json`, `headers.sha256`, `LICENSES/`,
       and the version check in the shim. Rename the shim after the version.
    2. Check `PACKAGE_LINK` in the `Makefile` against the native build profile.
    3. Check that each release accepts NULL, since `auto` releases the value it
       saved even when acquisition returned NULL.
    4. List the tasks a developer brings to this library, and write the ordinary
       x2c surface after the region: errors, Strings, collections, and
       iteration. Generated parameters are positional (the receiver's initial,
       `arg1`, ...) because collection records parameter types without names.
    5. Write `tests/` and `examples/`, as described in `packages/AGENTS.md`.
    "));
  return out;
}

// region

static void _typedefs(Survey s, Buffer out) {
  foreach (String c_type in _sorted_keys(s.handles)) {
    String release = s.releases.getdefault(c_type, NULL);
    out.printf(
      "\n/** Names a native `%s` pointer as a method receiver.", c_type);
    if (release) out.printf("\n    `auto` releases it with `%s`.\n", release);
    out.printf(
      "%s*/\ntypedef %s *%s;\n", release ? "" : " ", c_type,
      s.handles[c_type]);
  }
}

static void _adoptions(Survey s, Buffer out) {
  if (!s.releases) return;
  out.write("\n");
  foreach (String c_type in _sorted_keys(s.releases))
    out.printf(
      "$cleanup.by(%s, %s);\n", s.handles[c_type], s.releases[c_type]);
}

static void _method_groups(Survey s, Buffer out) {
  String group = NULL;
  foreach (List row in s.methods) {
    String c_type = row[0], function = row[2];
    if (c_type != group) {
      group = c_type;
      out.printf(
        "\n// %s: functions whose first argument is a `%s *`\n",
        s.handles[c_type], c_type);
    }
    out.printf(
      "\n/** Calls `%s` on this handle. */\n%s\n", function,
      _method(s, c_type, row[1], function, row[3]));
  }
  if (s.methods) out.write("\n");
}

/* One inline forwarding method: the C declaration through the handle
   types, with the receiver named by its type's initial and positional
   names after it, and a body that passes them on.
   Inline methods reach the generated header, so a program compiles and
   links only the C functions it calls. */
static String _method(
  Survey s, String c_type, String method, String function, Type type) {
  List parameters = NULL, result = NULL;
  Survey.signature(type, parameters, result);
  String handle = s.handles[c_type];
  Array spelled = [], names = [];
  foreach (List parameter in parameters) {
    spelled.push(names ? s.through_handles(parameter) : $(handle));
    names.push(names ? %"arg$(names.len())" : handle[:1].lower());
  }
  Type method_type =
    cons(%(func $(spelled.list())), s.through_handles(result));
  String name = %"$(handle).$(method)";
  String declaration = %"inline $(s.declaration(method_type, name, names))";
  String call = %"$(function)($(names.join(", ")))";
  if (declaration.len() + call.len() + 5 <= 79)
    return %"$(declaration) => $(call);";
  return %"$(_wrap(declaration)) =>\n  $(_wrap(call));";
}

/* Wraps a declaration or call that exceeds 76 columns, leaving room for
   ` =>` or the `;` and indent around it. The first line ends after the
   opening parenthesis, and the outermost arguments fill two-space
   continuation lines. One argument longer than a line stays whole. */
static String _wrap(String text) {
  int open = text.find("(");
  if (text.len() <= 76) return text;
  Buffer out = Buffer.new(0);
  out.write_len(text, open + 1);
  String line = NULL;
  foreach (String piece in _arguments(text[open + 1:text.len()])) {
    if (line && line.len() + 1 + piece.len() <= 76) line = %"$line $piece";
    else {
      if (line) out.write(line);
      out.write("\n");
      line = %"  $piece";
    }
  }
  out.write(line);
  return out;
}

/* Splits an argument list after its opening parenthesis at the outermost
   commas, keeping each comma, and the close, with the argument before it. */
static List _arguments(String text) {
  Array pieces = [];
  int depth = 0, start = 0;
  for (int i = 0; i < text.len(); i++) {
    char c = text[i];
    if (c == '(') depth++;
    else if (c == ')') depth--;
    else if (c == ',' && !depth) {
      pieces.push(text[start:i + 1]);
      start = i + 2;
    }
  }
  pieces.push(text[start:text.len()]);
  return pieces;
}

static void _include_flags(Buffer out, List dirs) {
  foreach (String dir in dirs) out.printf(" --c-include-dir %s", dir);
}

static Array _sorted_keys(Map map) {
  Array keys = map.keys();
  return keys.sort();
}

// readme stub

static void _readme_generated(Survey s, BindRequest request, Buffer out) {
  String header = Path.basename(request.header);
  String intro = String.printf(
    "This package skeleton was generated by `x2c bind` from `%s`. Its raw "
    "tier is complete; its ordinary x2c surface is not written yet.\n",
    header);
  String shim = String.printf(
    "- `src/%s` includes the real `%s`. Every function, type, enum, and "
    "macro constant in the header stays available under its C name.",
    request.shim, header);
  String entry = String.printf(
    "- `src/%s.x`, between the `x2c bind` markers, names %d handle types, "
    "forwards %d functions as methods on them, and adopts `Cleanup` for %d.",
    request.package, s.handles.len(), s.methods.len(), s.releases.len());
  out.printf("# %s\n\n", request.package);
  _fill(out, "", intro);
  out.write("## Generated\n\n");
  _fill(out, "  ", shim);
  _fill(out, "  ", entry);
  _fill(out, "  ", "- `Makefile` builds the package with `../package.mk`.\n");
  _handle_table(s, out);
  _fill(
    out, "",
    "A method passes its arguments to the C function unchanged. A `T *` "
    "argument or result whose `T` is a handle's C type is spelled with the "
    "handle type. Declaration `auto` releases a handle that a C function "
    "fills through an out-parameter, as in `auto Handle h = NULL;` followed "
    "by the call that receives `&h`.\n");
}

static void _readme_inventory(Survey s, Buffer out) {
  _name_list(out, "Functions without a handle receiver remain C calls", s.raw);
  Array skipped = [];
  foreach (List row in s.skipped) skipped.push(%"`$(row[0])` ($(row[1]))");
  _name_list(out, "Functions not forwarded", skipped);
  _name_list(out, "Enums", s.enums);
  String constants = String.printf(
    "The header declares %d enumeration constants. Macro constants are "
    "expanded before collection, so they are not counted. Both remain "
    "available through the header. Collection does not record deprecation "
    "or availability attributes. Methods are inline, so a program links "
    "only the functions it calls, but the C compiler warns about a method "
    "that forwards a deprecated function; delete such methods if they are "
    "not wanted.\n",
    s.constants);
  _fill(out, "", constants);
}

static void _handle_table(Survey s, Buffer out) {
  if (!s.handles) return;
  out.write(
    $dedent(%"
    | C type | x2c handle | Methods | Release |
    | --- | --- | --- | --- |
    "));
  foreach (String c_type in _sorted_keys(s.handles)) {
    int count = 0;
    foreach (List row in s.methods) if (row[0] == c_type) count++;
    String release = s.releases.getdefault(c_type, NULL);
    out.printf(
      "| `%s` | `%s` | %d | %s |\n", c_type, s.handles[c_type], count,
      release ? %"`$(release)`" : "none found");
  }
  out.write("\n");
}

static void _name_list(Buffer out, String title, List names) {
  if (!names) return;
  Array quoted = [];
  foreach (String name in names)
    quoted.push(name.startswith("`") ? name : %"`$(name)`");
  _fill(
    out, "",
    String.printf("%s (%d): %s.\n", title, names.len(), quoted.join(", ")));
}

/* Writes `text` filled to 79 columns, then a newline. Continuation lines
   start with `indent`. */
static void _fill(Buffer out, String indent, String text) {
  int column = 0;
  foreach (String word in text.split(" ")) {
    if (column && column + 1 + word.len() > 79) {
      out.write("\n");
      if (indent) out.write(indent);
      column = indent.len();
    }
    else if (column) {
      out.write(" ");
      column++;
    }
    out.write(word);
    column += word.len();
  }
  out.write("\n");
}
