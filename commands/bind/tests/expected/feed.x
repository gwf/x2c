/** Names a native `feed_item` pointer as a method receiver.
    `auto` releases it with `free`.
*/
typedef feed_item *FeedItem;

/** Names a native `feed_parser` pointer as a method receiver.
    `auto` releases it with `close`.
*/
typedef feed_parser *FeedParser;

$cleanup.by(FeedItem, free);
$cleanup.by(FeedParser, close);

// FeedItem: functions whose first argument is a `feed_item *`

/** Calls `feed_item_free` on this handle. */
inline void FeedItem.free(FeedItem f) => feed_item_free(f);

/** Calls `feed_item_parser` on this handle. */
inline FeedParser FeedItem.parser(FeedItem f) => feed_item_parser(f);

/** Calls `feed_item_title` on this handle. */
inline const char *FeedItem.title(FeedItem f) => feed_item_title(f);

// FeedParser: functions whose first argument is a `feed_parser *`

/** Calls `feed_close` on this handle. */
inline void FeedParser.close(FeedParser f) => feed_close(f);

/** Calls `feed_count` on this handle. */
inline int FeedParser.count(FeedParser f) => feed_count(f);

/** Calls `feed_item_new` on this handle. */
inline int FeedParser.item_new(FeedParser f, int arg1, FeedItem *arg2) =>
  feed_item_new(f, arg1, arg2);

/** Calls `feed_next` on this handle. */
inline int FeedParser.next(FeedParser f, const char **arg1, size_t *arg2) =>
  feed_next(f, arg1, arg2);

/** Calls `feed_scan` on this handle. */
inline int FeedParser.scan(FeedParser f, feed_visitor arg1, void *arg2) =>
  feed_scan(f, arg1, arg2);

/** Calls `feed_stats_read` on this handle. */
inline int FeedParser.stats_read(FeedParser f, feed_stats *arg1) =>
  feed_stats_read(f, arg1);

