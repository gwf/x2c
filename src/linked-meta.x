  "parse.hole.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected macro hole name after '$'",
      $c.token, NULL);
  },
  "parse.hole.unknown-kind" :
  macro Statement(Expr $c, Expr $spelling) {
    $c.report_error(
      <parse>, %"unknown macro hole kind '${$spelling}'",
      $c.token, NULL);
  },
  "parse.hole.untyped" :
  macro Statement(
    Expr $c, Expr $hole_spelling, Expr $origin) {
    $c.report_error(
      <parse>, %"macro hole '${$hole_spelling}' has no inferred kind",
      $origin, %("annotate holes used only by compile-time Lisp"));
  },

  "parse.import.local" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected a local name after 'as'",
      $c.token, NULL);
  },
  "parse.import.member" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected a package member name after 'with'",
      $c.token, NULL);
  },
  "parse.import.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected a quoted package name after 'import'",
      $c.token, NULL);
  },

  "parse.index.unsupported" :
  macro Statement(
    Expr $c, Expr $receiver_type, Expr $origin) {
    $c.report_error(
      <parse>, $receiver_type.is_typedef_name()
      ? %"type ${$receiver_type} does not support getindex"
      : %"type ${$receiver_type} does not support indexing",
      $origin, %());
  },

  "parse.init.duplicate" :
  macro Statement(Expr $c, Expr $name) {
    $c.report_error(
      <parse>, "translation unit has more than one type initializer",
      $c.token, %( "initializer:" ${$name} ));
  },
  "parse.init.incomplete" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>,
      "managed initializer requires a complete block-local initializer",
      NULL, NULL);
  },

  "parse.insert.name" :
  macro Statement(Expr $c, Expr $sigil) {
    {
      String message = %"expected identifier after '${$sigil}'";
      String hint = $sigil == <@>
        ? "use '@{...}' to splice an expression"
        : "use '${...}' to insert an expression";
      $c.report_error(<parse>, message, $c.token, %($hint));
    }
  },

  "parse.is.pointer" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "pointer type after 'is' must be parenthesized",
      $origin, %("write value is (T *)"));
  },

  "parse.keyword.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "keyword alias requires an identifier",
      $c.token, NULL);
  },

  "parse.lifecycle.signature" :
  macro Statement(
    Expr $c, Expr $role, Expr $name) {
    {
      String message = $role == "initializer"
        ? "type initializer must have signature void TYPE.initialize(void)"
        : "type shutdown must have signature void TYPE.shutdown(void)";
      $c.report_error(<parse>, message, $c.token, %("${$role}: ${$name}"));
    }
  },

  "parse.lisp.unclosed" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "unterminated compile-time Lisp form",
      $origin, NULL);
  },

  "parse.macro.braced-body" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "braced macro body requires Statement, Block, Field, Entry, " +
    "Enumerator, Unit, or non-Expression Decorator result",
      $c.token, NULL);
  },
  "parse.macro.extra-args" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro invocation has too many arguments",
      $c.token, NULL);
  },
  "parse.macro.kind" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected macro result kind before '$'",
      $c.token, NULL);
  },
  "parse.macro.kind-order" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro result kind belongs after 'macro', before the '$' name",
      $c.token, NULL);
  },
  "parse.macro.member" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro method declaration requires a member name",
      $c.token, NULL);
  },
  "parse.macro.missing-args" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro invocation has too few arguments",
      $c.token, NULL);
  },
  "parse.macro.name" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, $c.peek(1) == <ident>
        ? "expected macro name component after '.'"
        : "expected macro name after '$'",
      $origin, NULL);
  },
  "parse.macro.paren-body" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "parenthesized macro body requires Expression result or target",
      $c.token, NULL);
  },
  "parse.macro.reserved" :
