/*  linked-meta.x -- shipped `meta` code compiled into the compiler

    Generated by tools/gen-linked-meta.sh; do not edit. Bodied `meta`
    functions and initialized static values from shipped source
    modules appear without their `meta` markers,
    so their functions and initializers execute as native code.
    `Compiler.bind_linked_meta` binds an included definition to its
    copy when its definition hashes agree, and a prelude component's
    definition always. Public
    functions with a run-time form bind to their ordinary provider's
    definitions and have no copy here.
*/

#pragma once

#include "x2c.x"
#include "channel.x"
#include "common.x"
#include "lisp-bindings.x"
#include "list-selectors.x"
#include "native-scalar-types.x"
#include "rewrite.x"
#include "system-macros.x"
#include "thread.x"
#include "var-tags.x"
#include "var/var.x"
#include "fields.x"
#include "grammar.x"
#include "operator-ledger.x"

/* --- lib/channel.x ------------------------------------------------------- */

static Code _new_empty(Code code) {
  if (code ~= $channel.new.empty())
    return $!Channel{ Channel.new(<var>, 0) };
  return code;
}

static Code _new_one(Code code) {
  if (code ~= $channel.new.one(?value))
    return $!Channel{ Channel.new($value, void) };
  return code;
}

/* --- lib/common.x -------------------------------------------------------- */

static Symbol _literal_tag(List tag) {
  if (tag ~= %(expr ? (literal ? ? ?key))) return key;
  return 0;
}

static int _var_tag_top(List tag) => (int) Var_tag_top(_literal_tag(tag));

static int _var_tag_bottom(List tag) =>
  (int) Var_tag_bottom(_literal_tag(tag));

/* --- lib/lisp-bindings.x ------------------------------------------------- */

static List _lisp_native_declarations(void) =>
  %((preproc "extern Map lisp_native_targets(void);"));

/* --- lib/list-selectors.x ------------------------------------------------ */

static List _selector_chain(String spelling, List value) {
  for (int i = spelling.len() - 2; i >= 1; i--)
    value = spelling[i] == 'a' ? $!( car($value) ) : $!( cdr($value) );
  return value;
}

static List _selector_double(List steps) {
  if (!steps) return NULL;
  String rest = steps.car(), a = %"a$rest", d = %"d$rest";
  return $(a, d, @(_selector_double(steps.cdr())));
}

static List _selector_middles(void) {
  List level = %(""), middles = NULL;
  for (int length = 1; length <= 4; length++) {
    level = _selector_double(level);
    if (length > 1) middles = middles.append(level);
  }
  return middles;
}

static List _selector_units(List middles, Macro car, Macro cdr) {
  if (!middles) return NULL;
  String middle = middles.car();
  List rest = _selector_units(middles.cdr(), car, cdr);
  if (middle in %("aa" "ad" "dd" "add")) return rest;
  String name = %"c$(middle)r";
  return $(middle.startswith("a") ? car(name) : cdr(name), @rest);
}

static List _selector_definitions(Macro car, Macro cdr) =>
  _selector_units(_selector_middles(), car, cdr);

/* --- lib/native-scalar-types.x ------------------------------------------- */

List _scalar_access_record(Type type) {
  String name = "_native_scalar_access";
  foreach (Symbol word in (List) type) name = %"$(name)_$word";
  return x2c_ident(name);
}

/* --- lib/rewrite.x ------------------------------------------------------- */

/** Registers the decorated translator with its pattern and hole patterns. */
Code register_rewrite(Code function, Code pattern, List holes) {
  Macro shape = pattern.value();
  Array patterns = [];
  foreach (Code hole in holes) patterns.push(hole.value());
  return function.register_rewrite(shape, patterns.list_free());
}

/* --- lib/system-macros.x ------------------------------------------------- */

List _dedent_expand(Source text) {
  String source = Code.source_text(text);
  int length = source.len(), open = 0;
  if (length >= 3 && source.startswith("%\""))
    open = 2;
  else if (length >= 2 && source.startswith("\""))
    open = 1;
  if (open == 0 || !source.endswith("\"") || "\\" in source ||
      "$" in source)
    return $!( $(text.assoc(<syntax>)).dedent() );
  String body = source.getslice(open, length - 1, 1);
  return $!String{ $(body.dedent()) };
}

List _macros_location(void) =>
  $!String{ $(x2c_invocation_file() + ":" + x2c_invocation_line().str()) };

List _macros_source(Source code) =>
  $!String{ $(Code.source_text(code)) };

/* --- lib/thread.x -------------------------------------------------------- */

static Code _batch_without_callback(Code code) {
  if (code ~= $thread.run.jobs(?jobs))
    return $!void{ Thread.run($jobs, NULL) };
  return code;
}

/* --- lib/var-tags.x ------------------------------------------------------ */

List _tag_decode_group(List rows, Map counts, int top) {
  int immediate = top == 0x8002 || top == 0x8003;
  int mask = _tag_group_mask(counts.getdefault(top, 0));
  Array ids = [];
  for (int i = 0; i < 8; i++)
    ids.push($!( _invalid_ ));
  foreach (List row in rows) {
    if (_tag_top(row) != top) continue;
    int selector = immediate ? _tag_middle(row) : _tag_bottom(row) & mask;
    ids[selector] = %(expr () (ident $(x2c_ident(_tag_id(row)))));
  }
  return $!( { $mask, $immediate, { @(ids.list_free()) } } );
}

List _tag_decode_groups(void) {
  List rows = _tag_decode_rows();
  Map counts = _tag_sibling_counts(rows);
  Array groups = [];
  for (int group = 0; group < 32; group++)
    groups.push(_tag_decode_group(rows, counts, _tag_group_top(group)));
  return $!( { @(groups.list_free()) } );
}

List _tag_id_checks(void) {
  Array checks = [];
  int index = 0;
  foreach (List row in _tag_rows()) {
    checks.push(
      $!Unit{
        _Static_assert(
          $(x2c_ident(_tag_id(row))) == $index,
          "TagId matches the var tag ledger");
      });
    index++;
  }
  return checks;
}

/* --- lib/var/var.x ------------------------------------------------------- */

static List _update_rows(void) => %(
  (char    (i8 "Var_box_i8" "Var_integer" (() (char))))
  (schar   (i8 "Var_box_i8" "Var_integer" ((char) (signed char))))
  (u8      (u8 "Var_box_u8" "Var_integer" (() ("uchar"))))
  (i16     (i16 "Var_box_i16" "Var_integer" (() (short))))
  (u16     (u16 "Var_box_u16" "Var_integer" (() ("ushort"))))
  (i32     (i32 "Var_box_i32_bits" "Var_integer" ((unsigned) (int))))
  (u32     (u32 "Var_box_u32" "Var_integer" (() ("uint"))))
  (long    (long "Var_box_long" "Var_long_value" (() ())))
  (ulong   (ulong "Var_box_ulong" "Var_ulong_value" (() ())))
  (llong   (llong "Var_box_long_long" "Var_long_long_value" (() ())))
  (ullong  (ullong "Var_box_ulong_long" "Var_ulong_long_value" (() ())))
  (f32     (f32 "Var_box_f32" "Var_decode_f32" (() ())))
  (f64     (f64 "Var_box_f64" "Var_decode_f64" (() ())))
  (ldouble (ldouble "Var_box_long_double" "Var_long_double_value" (() ())))
);

static List _update_row(List id) {
  match (id)
    case %(expr ? (literal ? ? ?key)): return _update_rows().assoc(key);
  return %();
}

static Symbol _update_tag(List id)     => _update_row(id)[0];

static String _update_boxer(List id)   => _update_row(id)[1];

static String _update_decoder(List id) => _update_row(id)[2];

static List _update_cast_in(List id)  => _update_row(id)[3].car();

static List _update_cast_out(List id) => _update_row(id)[3].cdr().car();

static List _update_box(List id, List lhs) {
  List value = $!($lhs[0]);
  Type into = _update_cast_in(id);
  if (into) value = $!(($into)$value);
  return $!($(x2c_ident(_update_boxer(id)))($value));
}

static List _update_decode(List id, List value) {
  List decoded = $!($(x2c_ident(_update_decoder(id)))($value));
  Type back = _update_cast_out(id);
  if (back) return $!(($back)$decoded);
  return decoded;
}

static List _update_operation(Var function) {
  String spelling = Code.binding_spelling(function);
  return $!(String){ String.new($spelling) };
}

/* --- src/components/bracket-access.x ------------------------------------- */

static int _collection_family(Code base) {
  Type type = base.type();
  return type.is_named("Array") ? 1 : type.is_named("Map") ? 2 : 0;
}

/** Calls the getter bracket admission selected. */
Code access_read(Code code) {
  if (code ~= $indexed(?base, ?key)) {
    Type type = base.cadr(), result = code.cadr();
    Code getter = type.getter();
    if (!getter)
      $fail.access_read(NULL, type);
    return $!($result){ $getter($base, $key) };
  }
  return code;
}

static Code _participant_store(
  Code code, Code base, Code key, Code value) {
  Type type = base.cadr();
  if (type.is_named("String"))
    $fail.access_string_store(NULL);
  Code setter = type.protocol_member("setindex");
  if (!setter)
    $fail.access_store(NULL, type);
  return setter.call_in_order($(base, key, value), code.cadr());
}

static Code _participant_update(
  Code code, Code base, Code key, Symbol op, Code value) {
  Type type = base.cadr();
  Code member = type.protocol_member(value ? "updateindex" : "postfixindex");
  if (!member)
    $fail.access_update(NULL, type, value);
  List operation = $!Symbol{ $op };
  List arguments = value
    ? $(base, key, operation, value) : $(base, key, operation);
  return member.call_in_order(arguments, code.cadr());
}

/** Selects the adopted collection setter for indexed assignment, or a
    participant's `setindex` member.
*/
Code access_store(Code code) {
  if (code ~= $x2c.collection.store(?base, ?key, ?value)) {
    Code receiver = base;
    Code setter = _collection_family(base)
      ? receiver.type().protocol_member("setindex") : NULL;
    if (setter) return $!Var{ $setter($base, $key, $value) };
    return _participant_store(code, base, key, value);
  }
  return code;
}

static Code _access_update(
  Code code, Code base, Code key, Code value, Symbol op) {
  int family = _collection_family(base);
  if (!family || !base.type().protocol_member("updateindex"))
    return _participant_update(code, base, key, op, value);
  Type type = value.type();
  if (!type.is_named("Var") && !type.numeric() &&
      !(op == <+> && type.is_text())) {
    $fail.access_operand(NULL, op, type);
  }
  if (family == 1) return $!Var{ Array_updateindex($base, $key, $op, $value) };
  return $!Var{ Map_updateindex($base, $key, $op, $value) };
}

/** Selects collection compound updates and checks accepted operands, or a
    participant's `updateindex` member.
*/
Code access_update(Code code) {
  match (code) {
    case $x2c.collection.add(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"+">);
    case $x2c.collection.subtract(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"-">);
    case $x2c.collection.multiply(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"*">);
    case $x2c.collection.divide(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"/">);
    case $x2c.collection.remainder(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"%">);
    case $x2c.collection.and(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"&">);
    case $x2c.collection.or(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"|">);
    case $x2c.collection.xor(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"^">);
    case $x2c.collection.left(?base, ?key, ?value):
      return _access_update(code, base, key, value, <"<<">);
    case $x2c.collection.right(?base, ?key, ?value):
      return _access_update(code, base, key, value, <">>">);
  }
  return code;
}

static Code _access_step(Code code, Code base, Code key, Symbol op) {
  if (!_collection_family(base))
    return _participant_update(code, base, key, op, $!int{ 1 });
  return _access_update(code, base, key, $!int{ 1 }, op);
}

/** Stores and returns the incremented or decremented element. */
Code access_prefix(Code code) {
  match (code) {
    case $x2c.collection.increment(?base, ?key):
      return _access_step(code, base, key, <+>);
    case $x2c.collection.decrement(?base, ?key):
      return _access_step(code, base, key, <->);
  }
  return code;
}

/** Stores the updated element and returns its previous value. */
Code access_postfix(Code code) {
  Code base, key;
  Symbol op;
  match (code) {
    case $x2c.collection.postincrement(?b, ?k):
      { base = b; key = k; op = <++>; }
    case $x2c.collection.postdecrement(?b, ?k):
      { base = b; key = k; op = <-->; }
    default: return code;
  }
  int family = _collection_family(base);
  if (!family || !base.type().protocol_member("postfixindex"))
    return _participant_update(code, base, key, op, NULL);
  if (family == 1) return $!Var{ Array_postfixindex($base, $key, $op) };
  return $!Var{ Map_postfixindex($base, $key, $op) };
}

/* --- src/components/delegate-members.x ----------------------------------- */

static String _delegate_type_name(Type type) {
  List base = type_base_suffix(type);
  if (base ~= %((!or struct union)
           (!or ?tag (!not (*)) (gensym ? ?) (binding ? ?))))
    return tag.str();
  return base.car().str();
}

static String _delegate_path(Type type, List fields, String member) {
  Array parts = [_delegate_type_name(type)];
  foreach (String field in fields) parts.push(field);
  if (member) parts.push(member);
  return ".".join(parts.list_free());
}

static void _delegate_fail_packages(
  Type outer, Type type, String member, List fields, List packages) {
  Array notes = [%"delegate path: $(_delegate_path(outer, fields, NULL))"];
  foreach (String package in packages) notes.push(%"package: '$package'");
  String method = %"$(_delegate_type_name(type)).$member";
  x2c_diagnostic_fail_at(
    NULL, <type>,
    %"method '$method' is provided by multiple imported packages",
    notes.list_free());
}

static void _delegate_search(
  Type outer, String member, Type receiver, List reverse, List seen,
  Array found, List &cycle) {
  Type aggregate = receiver.aggregate();
  if (!aggregate) return;
  if (aggregate in seen) {
    if (!cycle) cycle = reverse.reverse();
    return;
  }
  seen = cons(aggregate, seen);
  foreach (List row in aggregate.marked_fields(<delegate>)) {
    String name = row.car();
    Type type = receiver.resolve_member(name, 0).caddr();
    List path = cons(name, reverse);
    List resolution = type.resolve_member(member, 1);
    match (resolution) {
      case %(method ?binding ?):
        found.push($(path.reverse(), binding));
      case %(ambiguous *packages):
        _delegate_fail_packages(outer, type, member, path.reverse(), packages);
    }
    if (!resolution)
      _delegate_search(outer, member, type, path, seen, found, cycle);
  }
}

static void _delegate_fail_ambiguous(
  Type outer, String member, List paths) {
  Array notes = [];
  foreach (List path in paths) {
    String spelling = Code.binding_spelling(path.cadr());
    String description = _delegate_path(outer, path.car(), member);
    notes.push(%"delegate path: $description -> $spelling");
  }
  String method = %"$(_delegate_type_name(outer)).$member";
  x2c_diagnostic_fail_at(
    NULL, <type>, %"method '$method' has multiple delegate paths",
    notes.list_free());
}

static void _delegate_fail_cycle(Type outer, String member, List fields) {
  String method = %"$(_delegate_type_name(outer)).$member";
  x2c_diagnostic_fail_at(
    NULL, <type>, %"delegation cycle resolving $method",
    %("delegate path: $(_delegate_path(outer, fields, NULL))"));
}

static List _delegate_fields(Type outer, String member) {
  Array found = [];
  List cycle = NULL;
  _delegate_search(outer, member, outer, NULL, NULL, found, cycle);
  List paths = found.list_free();
  if (paths && paths.cdr()) _delegate_fail_ambiguous(outer, member, paths);
  if (!paths && cycle) _delegate_fail_cycle(outer, member, cycle);
  return paths ? paths.car().car() : NULL;
}

/** Rebuilds a call that finds no member on its receiver through the one
    delegate field path that provides the method.
*/
Code delegate_member(Code code) {
  if (code ~= $x2c.delegate.call(?receiver, ?member, *arguments)) {
    String name = Code.binding_spelling(member);
    List fields = _delegate_fields(receiver.cadr(), name);
    if (!fields) return code;
    Code callee = receiver;
    foreach (String step in fields.append($(name)))
      callee = %(expr () (op . $callee ($step)));
    return %(expr () (call $callee (args @arguments)));
  }
  return code;
}

/* --- src/components/destructuring.x -------------------------------------- */

static Code _destructure_list(Code source) {
  Code converted =
    source.type().numeric() ? NULL : source.convert(%("List"));
  if (!converted || !converted.type().is_named("List"))
    $fail.destructure_list_source(NULL);
  return converted;
}

static List _destructure_read(Atom values, Code source) =>
  %(declare ("List")
     (bindings (op = (bind $values ()) $(_destructure_list(source)))));

static Code _destructure_element(Atom values, int index) {
  String position = %"$index";
  return %(expr ("Var")
           (getindex (expr ("List") (ident $values))
                     (literal (int) $position)));
}

static List _destructure_writes(List targets, Atom values) {
  Array writes = [];
  int index = 0;
  foreach (Code target in targets) {
    Type type = target.cadr();
    Code element = _destructure_element(values, index++);
    writes.push(%(stmnt $($!($type){ $target = $element })));
  }
  return writes.list_free();
}

static Code _destructure_bound(List code, Atom values, Atom result) {
  List names = %((new-name $values "destructure"));
  if (result) names = cons(%(new-name $result "destructure_result"), names);
  return Code.bound(code, names);
}

/** Declares the names of `T (a, b) = source;` and then reads the source
    into them, or declares each target of `(T1 a, T2 b) = source;`
    initialized from its element.
*/
Code destructure_declaration(Code node) {
  Atom values = Atom.intern("?__destructure");
  match (node) {
    case %(dstrdecl (params *parameters) ?source): {
      Array items = [_destructure_read(values, source)];
      int index = 0;
      foreach (List parameter in parameters)
        if (parameter ~= %(param ?base ?declarator)) {
          Code element = _destructure_element(values, index++);
          items.push(%(declare $base (bindings (op = $declarator $element))));
        }
      return _destructure_bound(%(seq @(items.list_free())), values, NULL);
    }
    case %(dstrdecl ?(Type type) (targets *names) ?source): {
      Array declarators = [], targets = [];
      foreach (List name in names) {
        declarators.push(%(bind $name ()));
        targets.push(%(expr $type (ident $name)));
      }
      return _destructure_bound(
        %(seq (declare $type (bindings @(declarators.list_free())))
              $(_destructure_read(values, source))
              @(_destructure_writes(targets.list_free(), values))),
        values, NULL);
    }
  }
  return node;
}

/** Reads the source of `(a, b) = source;` into its targets in a block. */
Code destructure_statement(Code node) {
  if (node ~= %(stmnt (expr ? (dstrasgn (targets *targets) ?source)))) {
    Atom values = Atom.intern("?__destructure");
    return _destructure_bound(
      %(block $(_destructure_read(values, source))
              @(_destructure_writes(targets, values))),
      values, NULL);
  }
  return node;
}

/** Reads the source of `(a, b) = source` into its targets, and keeps the
    source in a result local as the expression's value.
*/
Code destructure_value(Code node) {
  if (node ~= %(expr ?(Type type) (dstrasgn (targets *targets) ?source))) {
    Atom values = Atom.intern("?__destructure");
    Atom result = Atom.intern("?__destructure_result");
    (List base, List modifiers) = type.parts();
    Code kept = %(expr $type (ident $result));
    List block = %(block
      (declare $base (bindings (op = (bind $result $modifiers) $source)))
      $(_destructure_read(values, kept))
      @(_destructure_writes(targets, values))
      (stmnt $kept));
    return _destructure_bound(
      %(expr $type (parens $block)), values, result);
  }
  return node;
}

/* --- src/components/dynamic-operators.x ---------------------------------- */

static int _dynamic_operand(Type type, int text) =>
  type.is_named("Var") || (text ? type.is_text() : !!type.numeric());

/** Boxes both operands of an arithmetic, shift, or bitwise operator for
    `Var.binary`, after rejecting an operand that is neither a number nor,
    for `+` beside text, text. The call is returned lowered, because an
    operator chain applies this rule once for each term and binding would
    search the whole remaining chain each time.
*/
Code dynamic_binary(Code code) {
  if (code ~= %(expr ? (op ?(Symbol op) ?left ?right))) {
    Code lhs = left, rhs = right;
    Type left_type = lhs.cadr(), right_type = rhs.cadr();
    int text = op == <+> && _dynamic_operand(left_type, 1) &&
      _dynamic_operand(right_type, 1);
    if (!text && (!_dynamic_operand(left_type, 0) ||
                  !_dynamic_operand(right_type, 0))) {
      $fail.operators_numeric_operands(NULL, left_type, right_type, op);
    }
    Code left_var = lhs.convert(%("Var")), right_var = rhs.convert(%("Var"));
    return Code.lowered($!Var{ Var_binary($left_var, $op, $right_var) }, NULL);
  }
  return code;
}

static Symbol _dynamic_operation(Symbol assignment) {
  foreach (List row in %((<+=> <+>) (<-=> <->) (<*=> <*>) (</=> </>)
                       (<%=> <%>) (<"<<="> <"<<">) (<">>="> <">>">)
                       (<&=> <&>) (<^=> <^>) (<|=> <|>)))
    if (row.car() == assignment) return row.cadr();
  return 0;
}

static Code _dynamic_update(
  Type type, Code target, Symbol op, Code value, String helper) {
  Type target_type = target.cadr(), address_type = %(* @target_type);
  List address = %(expr $address_type (op & (parens $target)));
  List operation = $!Symbol{ $op };
  List call = value
    ? %(call $helper (args $address $operation $value))
    : %(call $helper (args $address $operation));
  return Code.lowered(%(expr $type $call), NULL);
}

static String _dynamic_helper(Type type) {
  if (type.is_named("Var")) return "x2c_var_update_volatile";
  Type scalar = type.numeric();
  if (scalar ~= %(enum *)) $fail.operators_enum_target(NULL);
  String helper = type.update_helper();
  if (!helper) $fail.operators_numeric_target(NULL, type);
  return helper;
}

/** Updates a `Var` or numeric lvalue with a `Var` or numeric operand
    through the update helper of its storage.
*/
Code dynamic_compound(Code code) {
  if (code ~= %(expr ? (op ?(Symbol op) ?left ?right))) {
    Code target = left, rhs = right;
    Type type = target.cadr(), right_type = rhs.cadr();
    Symbol operation = _dynamic_operation(op);
    if (type ~= %((bitfield *) *))
      $fail.operators_bitfield_target(NULL);
    if (!right_type.is_named("Var") && !right_type.numeric() &&
        !(operation == <+> && right_type.is_text()))
      $fail.operators_operand(NULL, operation, right_type);
    String helper = _dynamic_helper(type);
    return _dynamic_update(
      type, target, operation, rhs.convert(%("Var")), helper);
  }
  return code;
}

/** Adds or subtracts one through the `Var` update helpers; the postfix
    forms return the value before the change.
*/
Code dynamic_change(Code code) {
  match (code) {
    case %(expr ? (op ?(Symbol op) ?(Code target))): {
      Code one = $!int{ 1 };
      return _dynamic_update(
        target.cadr(), target, op == <++> ? <+> : <->,
        one.convert(%("Var")), "x2c_var_update_volatile");
    }
    case %(expr ? (postfix ?(Symbol op) ?(Code target))):
      return _dynamic_update(
        target.cadr(), target, op, NULL, "x2c_var_postfix_volatile");
  }
  return code;
}

/** Rejects a unary numeric operator on a `Var`. */
Code dynamic_unary(Code code) {
  x2c_diagnostic_fail_at(
    NULL, <xform>, "dynamic unary numeric operators are not supported",
    %("use Var.binary with an explicit numeric operand"));
  return code;
}

/* --- src/components/lambda-functions.x ----------------------------------- */

static List _lambda_cell_name(List binding, Map cells) {
  (Var name, Type type) = cells[binding];
  if (name is <list>) return name;
  List fresh = x2c_binding_fresh("lambda_cell");
  cells[binding] = $(fresh, type);
  return fresh;
}

static Code _lambda_cell_read(Var node, Map cells) {
  Var cell;
  if (node ~= %(expr ?(Type read) (ident ?binding)) &&
      cells.try_get(binding, cell)) {
    Type type = cell.list().cadr();
    List name = _lambda_cell_name(binding, cells);
    if (read.car() == <&>) return %(expr $read (ident $name));
    Type pointer = cons(<*>, type);
    return %(expr $type
             (parens (expr $type (op * (expr $pointer (ident $name))))));
  }
  return NULL;
}

static Code _lambda_cell(List name, Type type, Code value) {
  Type bytes = %(* void), pointer = cons(<*>, type), literal = type;
  Code allocated = $!($bytes){ Scope_malloc(sizeof($type)) };
  if (value) {
    if (!(type ~= %((dim *) *)) &&
        !(value ~= %(expr ? (composite ?)))) {
      literal = cons(%(dim $($!int{ 1 })), type);
      value = value.convert(type);
    }
    if (!(value ~= %(expr ? (composite ?))))
      value = %(expr $literal (composite (commas $value)));
    allocated = $!($bytes){
      Scope_memdup((const void *)&($literal)$value, sizeof($type))
    };
  }
  (List base, List modifiers) = pointer.parts();
  return %(declare $base
    (bindings (op = (bind $name $modifiers) $allocated)));
}

static Code _lambda_declared_cell(List binding, Code value, Map cells) {
  Var cell;
  if (!cells.try_get(binding, cell)) return NULL;
  Type type = cell.list().cadr();
  return _lambda_cell(_lambda_cell_name(binding, cells), type, value);
}

static Code _lambda_copied_cell(List binding, Map cells) {
  Var cell;
  if (!cells.try_get(binding, cell)) return NULL;
  Type type = cell.list().cadr();
  Code value = %(expr $type (ident $binding));
  return _lambda_cell(
    _lambda_cell_name(binding, cells), type, value);
}

static List _lambda_targets(List node) {
  Array targets = [];
  match (node) {
    case %(dstrdecl (params *params) ?):
      foreach (List param in params)
        if (param ~= %(param ? (bind ?binding ?))) targets.push(binding);
    case %(dstrdecl ? (targets *names) ?): return names;
  }
  return targets.list_free();
}

static List _lambda_kept_items(
  Array items, List original, Map declaring) {
  Array out = [], run = [];
  foreach (List item in items) {
    if (item === original.car()) run.push(item);
    else {
      if (run.len()) out.push(Code.lowered(%(seq @(run.list())), NULL));
      run.truncate(0);
      out.push(item in declaring ? item : Code.lowered(item, NULL));
    }
    original = original.cdr();
  }
  if (run.len()) out.push(Code.lowered(%(seq @(run.list())), NULL));
  return out.list_free();
}

static int _lambda_mentions(Var item, Map cells) {
  List node;
  $ast.walk(item, node)
    if (node.car() === <binding> && node in cells) return 1;
  return 0;
}

static Var _lambda_declare_cells(List node, Map cells) {
  Array items = [];
  int celled = 0;
  match (node) {
    case %(declare ?base (bindings *bindings)):
      foreach (List item in bindings) {
        Code cell = NULL;
        match (item) {
          case %(bind ?binding *):
            cell = _lambda_declared_cell(binding, NULL, cells);
          case %(op = (bind ?binding *) ?value):
            cell = _lambda_declared_cell(binding, value, cells);
        }
        celled |= !!cell;
        items.push(
          cell ? cell : Code.lowered(%(declare $base (bindings $item)), NULL));
      }
    case %(dstrdecl *): {
      items.push(Code.lowered(node, NULL));
      foreach (List binding in _lambda_targets(node)) {
        Code copy = _lambda_copied_cell(binding, cells);
        if (copy) items.push(copy);
        celled |= !!copy;
      }
    }
    case %(for (decl ?base ?bindings) ?test ?next ?body): {
      Code declaration =
        _lambda_declare_cells(%(declare $base $bindings), cells);
      if (declaration ~= %(seq *initial))
        return %(block @initial
                 $(Code.lowered(%(for () $test $next $body), NULL)));
    }
  }
  return celled ? %(seq @(items.list_free())) : node;
}

static Var _lambda_rebuild(Var ast, List none, Map cells, Map declaring) {
  Array pending = [ast], modes = [0], done = [];
  while (pending.len()) {
    Var node = pending.take_last();
    int mode = modes.take_last().int();
    if (mode == 1) {
      int first = done.len() - node.list().len(), index = first;
      Array parts = [];
      int changed = 0, declares = 0;
      foreach (Var part in node.list()) {
        changed |= done[index] !== part;
        declares |= cells && done[index] in declaring;
        parts.push(done[index++]);
      }
      done.truncate(first);
      List rebuilt = changed ? parts.list_free() : node;
      Var result = rebuilt;
      if (cells) result = _lambda_declare_cells(rebuilt, cells);
      if (result !== rebuilt || declares) {
        if (result === rebuilt && rebuilt.car() == <block>) {
          List kept = _lambda_kept_items(
            rebuilt.cdr(), node.cdr(), declaring);
          result = cons(<block>, kept);
        }
        declaring[result] = 1;
      }
      done.push(result);
      continue;
    }
    Code read = cells && !mode ? _lambda_cell_read(node, cells) : NULL;
    if (mode || node is not <list> || node.is_nil()) done.push(node);
    else if (none && node.list() === %(return)) done.push(none);
    else if (read) done.push(read);
    else {
      Array parts = [];
      foreach (Var part in node.list()) parts.push(part);
      int body = node.list().car() == <lambda> ? parts.len() - 1 : -1;
      pending.push(node);
      modes.push(1);
      for (int i = parts.len() - 1; i >= 0; i--) {
        pending.push(parts[i]);
        modes.push(i == body ? 2 : 0);
      }
    }
  }
  return done[0];
}

static List _lambda_returning(List items, List none) {
  List node;
  $ast.walk(items, node) {
    if (node === %(return))
      return _lambda_rebuild(items, none, NULL, NULL);
    if (node.car() == <lambda>) continue;
  }
  return items;
}

static List _lambda_items(Code body) {
  if (body ~= %(block *items))
    return $(
      @(_lambda_returning(items, Ast.return_none())), Ast.return_none());
  List items = body ~= %(expr (void) ?)
    ? %((stmnt $body) $(Ast.return_none()))
    : %((stmnt (return $(body.convert(%("Var"))))));
  if (x2c_enclosing(<statement>) ~= %(at ?origin ?))
    return %((at $origin $(items.car())) @(items.cdr()));
  return items;
}

static List _lambda_params(List params) {
  Array out = [];
  foreach (List param in params)
    match (param) {
      case %(binding ? ?): out.push(%(param ("Var") (bind $param ())));
      default: out.push(param);
    }
  return out.list_free();
}

static List _lambda_closure_params(
  List params, List reads, List captures) {
  Array out = [];
  foreach (List param in _lambda_params(params)) {
    Type read = reads.car().list().car();
    reads = reads.cdr();
    if (param ~= %(param ? (bind ?binding (& *)))) {
      Type reference = cons(<&>, read.cdr());
      (List base, List modifiers) = reference.parts();
      param = %(param $base (bind $binding $modifiers));
    }
    out.push(param);
  }
  foreach (List capture in captures)
    if (capture ~= %(capture ?binding ?(Type type) ?)) {
      (List base, List modifiers) = type.parts();
      out.push(%(param $base (bind $binding $modifiers)));
    }
  return out.list_free();
}

static Code _lambda_function(List name, List params, Code body) {
  if (!params) params = %((param (void) (bind () ())));
  List lowered = Code.lowered(%(seq @(_lambda_items(body))), NULL);
  return %(function (static "Var") (bind $name ((fnmod (params @params))))
           (block $lowered));
}

/** Lifts the noncapturing lambda `node` to a static function, whose name
    is its value.
*/
Code lambda_lift(Code node) {
  match (node) case %(expr ?type $($lambda_expression(?body, *params))): {
    List name = x2c_binding_fresh("lambda");
    x2c_place(
      %(unit-support), _lambda_function(name, _lambda_params(params), body));
    return Code.bound(%(expr $type (ident $name)), NULL);
  }
  return node;
}

static int _lambda_in_public_inline(void) {
  if (x2c_enclosing(<function>) ~= %(function ?(Type type) *))
    return type ~= %(* inline *) && !(type ~= %(* static *));
  return 0;
}

static String _lambda_bridge_role(void) {
  if (x2c_enclosing(<unit>) ~=
      %(expr ? (segments (segexp (expr ? (literal ? ?(String path)))))))
    return %"func_from_capture_$("%08x".printf(path.hash()))";
  return "func_from_capture";
}

static List _lambda_field(int index) => x2c_ident(%"c$index");

static List _lambda_member(int index) => $(%"c$index");

static Type _lambda_field_type(Type type) {
  if (type.car() == <&>) return cons(<*>, type.cdr());
  return type.resolve().car() == <struct> ? type : %("Var");
}

static Code _lambda_record(List context, List types) {
  Array fields = [];
  foreach (Type type in types) {
    (List base, List modifiers) = type.parts();
    List name = _lambda_member(fields.len());
    fields.push(%(declare $base (bindings (bind $name $modifiers))));
  }
  return Code.bound(
    %(typedef (static struct $context (fields @(fields.list_free())))
       (bindings (bind $context ()))),
    NULL);
}

static Code _lambda_adapter(
  List adapter, List closure, List argv, List lifted, List context,
  List params, List reads, List captures, List declared) {
  Type pointer = %(* const struct $context);
  Code record = %(expr $pointer (ident ("record")));
  Array items = [], arguments = [];
  foreach (List read in reads) {
    (Type type, Code value) = read;
    List name = $(%"a$(items.len())");
    (List base, List modifiers) = type.parts();
    items.push(
      %(declare $base (bindings (op = (bind $name $modifiers) $value))));
    Code local = %(expr $type (ident $name));
    match (params.car()) {
      case %(param ? (bind ? (& *))):
        arguments.push(%(expr $(type.cdr()) (op * $local)));
      default: arguments.push(local);
    }
    params = params.cdr();
  }
  Code context_read = %(expr (* const void)
    (call (expr ((func (("Func"))) * const void) (ident ("Func_context")))
      (args (expr ("Func") (ident $closure)))));
  items.push(
    %(declare (const struct $context)
       (bindings (op = (bind ("record") (*))
                      (expr $pointer (cast $pointer $context_read))))));
  int index = 0;
  foreach (List capture in captures) {
    Type type = capture.caddr(), stored = _lambda_field_type(type);
    Code field = %(expr (const @stored)
                    (op -> $record $(_lambda_member(index++))));
    arguments.push(
      type.car() == <&> ? %(expr $(type.cdr()) (op * $field)) : field);
  }
  Code call = %(expr ("Var")
    (call (expr ((func $declared) "Var") (ident $lifted))
      (args @(arguments.list_free()))));
  items.push(%(return $call));
  return Code.bound(
    %(function (static "Var")
       (bind $adapter
         ((fnmod (params (param ("Func") (bind $closure ()))
                         (param (const "FuncArg") (bind $argv (*)))))))
       (block @(items.list_free()))),
    NULL);
}

static Code _lambda_bridge(
  List bridge, List adapter, List context, Code signature, List types) {
  List record = x2c_ident("record");
  Array parameters = [], fields = [];
  foreach (Type type in types) {
    (List base, List modifiers) = type.parts();
    List field = _lambda_field(fields.len());
    parameters.push(%(param $base (bind $field $modifiers)));
    fields.push($!( $field ));
  }
  List declared = parameters.list_free(), values = fields.list_free();
  Code made = %(expr ("FuncAdapter") (ident $adapter));
  return $!Unit{
    Func $bridge(@declared) {
      struct $context $record = { @values };
      return Func.new_context($made, $signature, &$record, sizeof $record);
    }
  };
}

static Code _lambda_value(
  List adapter, List context, Code signature, List captures) {
  Array setup = [], values = [], types = [];
  foreach (List capture in captures)
    if (capture ~= %(capture ? ?(Type type) ?(Code value))) {
      Type stored = _lambda_field_type(type);
      (List base, List modifiers) = stored.parts();
      List local = x2c_binding_fresh("lambda_capture_value");
      Code converted = value.convert(stored);
      setup.push(
        %(declare $base
          (bindings (op = (bind $local $modifiers) $converted))));
      values.push(%(expr $stored (ident $local)));
      types.push(stored);
    }
  List initial = values.list_free();
  Code made = NULL;
  if (_lambda_in_public_inline()) {
    List bridge = x2c_binding_fresh(_lambda_bridge_role());
    x2c_place(
      %(unit-support),
      _lambda_bridge(bridge, adapter, context, signature, types.list_free()));
    made = %(expr ("Func") (call (expr () (ident $bridge)) (args @initial)));
  }
  else {
    List storage = x2c_binding_fresh("lambda_context");
    Type type = %(struct $context);
    Code record = %(expr $type (ident $storage));
    Code initial_record = %(expr $type (composite (commas @initial)));
    setup.push(
      %(declare $type (bindings (op = (bind $storage ()) $initial_record))));
    made = %(expr ("Func") (call "Func_new_context" (args
      (expr () (ident $adapter)) $signature
      (expr (* @type) (op & $record)) (expr ("size_t") (sizeof $record)))));
  }
  return %(expr ("Func")
           (parens (block @(setup.list_free()) (stmnt $made))));
}

/** Lifts the capturing lambda `node` to a static function of its
    parameters and captures, and answers a `Func` of a record of the
    captured values and addresses.
*/
Code lambda_closure(Code node) {
  match (node)
    case %(expr ? $($lambda_captured(?body, *captures, *params))): {
      if (params == %((param (void) (bind () ())))) params = NULL;
      List lifted = x2c_binding_fresh("lambda");
      List adapter = x2c_binding_fresh("lambda");
      List closure = x2c_binding_fresh("lambda_closure");
      List argv = x2c_binding_fresh("lambda_argv");
      List context = x2c_binding_fresh("lambda_context");
      List adapted = Code.func_parameters(
        params, %(expr ("Func") (ident $closure)),
        %(expr (* const "FuncArg") (ident $argv)));
      List reads = adapted.cdr();
      Array fields = [];
      foreach (List capture in captures)
        fields.push(_lambda_field_type(capture.caddr()));
      Code record_type = _lambda_record(context, fields.list_free());
      List declared = _lambda_closure_params(params, reads, captures);
      Code function = _lambda_function(lifted, declared, body);
      Code adapter_function = _lambda_adapter(
        adapter, closure, argv, lifted, context, params, reads, captures,
        declared);
      x2c_place(%(unit-support), record_type);
      x2c_place(%(unit-support), function);
      x2c_place(%(unit-support), adapter_function);
      Code value = _lambda_value(adapter, context, adapted.car(), captures);
      return Code.bound(value, NULL);
    }
  return node;
}

static List _lambda_designated(Var value) {
  for (;;) {
    match (value) {
      case %(expr ? ?inner): value = inner;
      case %(parens ?inner): value = inner;
      case %(index (!set ?base (expr ((dim *) *) ?)) ?): value = base;
      case %(op . ?base *): value = base;
      case %(ident (!set ?binding (binding ? ?))): return binding;
      default: return NULL;
    }
  }
}

static Map _lambda_shared(List params, List items) {
  Map declared = {}, shared = {}, cells = {};
  foreach (List param in params)
    if (param ~= %(param ? (bind ?binding *))) declared[binding] = 1;
  List node;
  $ast.walk(items, node) match (node) {
    case %(declare (!set ?base (* static *)) *): continue;
    case %(bind ?binding *): declared[binding] = 1;
    case %(dstrdecl *):
      foreach (List binding in _lambda_targets(node)) declared[binding] = 1;
    case %(lambda *parts): {
      foreach (List part in parts)
        if (part ~= %(captures *rows))
          foreach (List row in rows)
            if (row ~= %(capture ? (& *type) (expr ? (op & ?target)))) {
              List binding = _lambda_designated(target);
              if (binding) shared[binding] = type;
            }
      continue;
    }
  }
  foreach ((List binding, Type type) in shared)
    if (declared.contains(binding)) cells[binding] = $(0, type);
  return cells;
}

/** Moves each local and parameter of the function `node` that a lambda in
    its body shares by reference into a Scope cell, so the binding outlives
    the call: a parameter is copied into its cell at entry, a local is
    declared as its cell, and every read goes through the cell. A lifted
    lambda's function moves its own. The function binds again only its
    cells and the statements that hold them; its other statements are kept
    as they are bound.
*/
Code lambda_cells(Code node) {
  match (node)
    case %(function ?type
           (!set ?declarator (bind ? ((fnmod (params *params))))) ?): {
      List items = Code.body(node);
      Map cells = _lambda_shared(params, items);
      if (!cells.len()) return node;
      Array entry = [];
      foreach (List param in params)
        if (param ~= %(param ? (bind ?binding *))) {
          Code cell = _lambda_copied_cell(binding, cells);
          if (cell) entry.push(cell);
        }
      Map declaring = {};
      Array body = [];
      foreach (List item in items)
        body.push(
          _lambda_mentions(item, cells)
            ? _lambda_rebuild(item, NULL, cells, declaring) : item);
      List kept = _lambda_kept_items(body, items, declaring);
      return %(function $type $declarator
               (block @(entry.list_free()) @kept));
    }
  return node;
}

/* --- src/components/pattern-match.x -------------------------------------- */

static void _match_flush(Buffer b, Array out) {
  if (b.len()) {
    out.push(b.str());
    b.clear();
  }
}

static void _match_place(Buffer b, Array out, Var node) {
  _match_flush(b, out);
  out.push(node);
}

static List _match_items(Array out) {
  Array items = [], run = [];
  foreach (Var piece in out) {
    if (piece ~= %(preproc ?)) {
      if (run.len()) items.push(cons(" ", run));
      run.clear();
      items.push(piece);
      continue;
    }
    run.push(piece);
  }
  if (run.len()) items.push(cons(" ", run));
  return items.list_free();
}

static int _match_nesting(String text) {
  String directive = text.strip(" \t").remove_prefix("#").strip(" \t");
  if (directive.startswith("endif")) return -1;
  return directive.startswith("if");
}

static String _match_cursor(int depth) =>
  depth ? %"_x2c_gensym_match_cursor$depth" : "_x2c_gensym_match_cursor";

static Symbol _match_head(Var value) {
  if (value is not <list> || !value.list()) return 0;
  Var head = value.list().car();
  if (head is not <symbol> || head == <x2c-dyn> || head.is_binder() ||
      head.is_match_op())
    return 0;
  return head;
}

static List _match_binders(Var value) {
  MatchCaptureLayout layout = MatchCaptureLayout.analyze(value);
  List binders = layout.definite_list();
  layout.free();
  return binders;
}

static Symbol _match_capture_tag(Var element, Var &binder) {
  if ((element ~= %((!quote !is) ?name type ?(Symbol tag))) &&
      tag != <x2c-dyn> && tag != <varray> && tag != <vmap>) {
    binder = name;
    return tag;
  }
  return 0;
}

static void _match_and(Buffer b, int &testing) {
  b.write(testing ? " && " : " if (");
  testing = 1;
}

static int _match_bind(
  Buffer b, Var binder, String cell, Array seen, Array binders, int &testing,
  int &braces) {
  int list = binder.is_list_binder();
  if (binders != NULL) {
    int slot = binders.find(binder);
    if (slot < 0) return 0;
    _match_and(b, testing);
    b.printf(
      "(_x2c_gensym_match_values[%d] = %s%s%s, 1)",
      slot, list ? "List_var(" : "", cell, list ? ")" : "");
    return 1;
  }
  if (testing) {
    b.write(") {");
    braces++;
    testing = 0;
  }
  b.printf(
    " %s _x2c_gensym_match_%s_%d = %s;",
    list ? "List" : "Var", list ? "list" : "value", seen.len() - 1, cell);
  return 1;
}

static int _match_element(
  Buffer b, Var part, String cell, Array seen, Array binders, int &testing,
  int &braces) {
  Var binder = part;
  Symbol tag = part is <list> ? _match_capture_tag(part, binder) : 0;
  if (tag) {
    _match_and(b, testing);
    b.printf("Var_is(%s, %lu)", cell, (unsigned long) tag);
    part = binder;
  }
  Var literal = part;
  match (part) case %((!quote !quote) ?(Symbol quoted)): {
    literal = quoted;
    _match_and(b, testing);
    b.printf("%s.u64 == %lluULL", cell, (unsigned long long) literal.u64);
    return 0;
  }
  if (part == <?>) return 0;
  if (part.is_atom_binder() && !(part in seen)) {
    seen.push(part);
    return _match_bind(b, part, cell, seen, binders, testing, braces) ? 0 : -1;
  }
  List list = part is <list> ? part.list() : NULL;
  if (part.is_binder() || part.is_match_op() || part == <x2c-dyn> ||
      (list && list.car().is_match_op()))
    return -1;
  if (part is <list> && binders != NULL) return 1;
  if (part is not <symbol> && !list) return binders != NULL ? -1 : 2;
  Symbol tested = <list>;
  _match_and(b, testing);
  if (list) b.printf("Var_is(%s, %lu)", cell, (unsigned long) tested);
  else b.printf("%s.u64 == %lluULL", cell, (unsigned long long) literal.u64);
  return !!list;
}

static int _match_nested(
  Buffer b, Array out, List pattern, Var value, Array binders, int &depths) {
  int viewed = binders != NULL;
  if ((!viewed &&
       !(pattern ~= %(expr ? (!or (cache ?) (expr ? (cache ?)))))) ||
      value is not <list>)
    return -1;
  _match_flush(b, out);
  Array rests = [], paths = [], seen = [];
  int mark = out.len(), testing = viewed, braces = 0, step = 0;
  int deepest = 0;
  List rest = value;
  String path = "";
  if (!viewed)
    b.write(" _x2c_gensym_match_cursor = _x2c_gensym_match_expr;");
  for (;;) {
    int levels = rests.len();
    String cursor = _match_cursor(levels);
    Var part = rest ? rest.car() : NULL;
    if (rest && !part.is_list_binder()) {
      String cell = %"$cursor->car";
      _match_and(b, testing);
      b.write(cursor);
      step = _match_element(b, part, cell, seen, binders, testing, braces);
      if (step == 1) {
        _match_and(b, testing);
        String next = _match_cursor(levels + 1);
        if (viewed) b.printf("Macro_case_enter(%s, &%s)", cell, next);
        else b.printf("(%s = Var_list_payload(%s), 1)", next, cell);
        rests.push(rest);
        paths.push(path);
        if (levels >= deepest) deepest = levels + 1;
        rest = part;
        path = path + "->car)";
        continue;
      }
      if (step == 2) {
        _match_and(b, testing);
        b.printf("Var_equal(%s, ", cell);
        for (int level = levels; level; level--) b.write("Var_list_payload(");
        _match_place(b, out, pattern);
        if (path) b.write(path);
        b.write("->car)");
      }
    }
    else {
      if (!rest) {
        _match_and(b, testing);
        b.printf("!%s", cursor);
      }
      else if (rest.cdr() || part in seen) step = -1;
      else if (part != <*>) {
        seen.push(part);
        if (!_match_bind(b, part, cursor, seen, binders, testing, braces))
          step = -1;
      }
      if (step < 0 || !levels) break;
      rest = rests.take_last();
      path = paths.take_last();
      cursor = _match_cursor(levels - 1);
    }
    if (step < 0) break;
    _match_and(b, testing);
    b.printf("(%s = %s->cdr, 1)", cursor, cursor);
    rest = rest.cdr();
    path = path + "->cdr";
  }
  if (viewed && seen.len() < binders.len()) step = -1;
  if (step < 0) {
    while (out.len() > mark) out.take_last();
    b.clear();
    return -1;
  }
  if (testing && !viewed) {
    b.write(") {");
    braces++;
  }
  if (deepest > depths) depths = deepest;
  return braces;
}

static void _match_captures(Buffer b, List binders) {
  int index = 0;
  foreach (Atom binder in binders) {
    int list = binder.is_list_binder();
    b.printf(
      " %s _x2c_gensym_match_%s_%d = %s_x2c_gensym_match_values[%d]%s;",
      list ? "List" : "Var", list ? "list" : "value", index,
      list ? "Var_list_payload(" : "", index, list ? ")" : "");
    index++;
  }
}

static int _match_viewed(
  Buffer b, Array out, List template, List labels, Code shape, List binders,
  int &depths) {
  Var derived = shape.pattern_value();
  int statement = 0;
  match (derived) case %((!quote !or) ?single (seq ?again)): {
    Symbol head = _match_head(single);
    if (head && head != <seq> && single.equal(again)) {
      derived = single;
      statement = 1;
    }
  }
  Buffer tests = Buffer.new(0);
  if (_match_nested(tests, [], NULL, derived, binders, depths) < 0)
    return -1;
  b.write(" { int _x2c_gensym_match_root = ");
  Symbol head = _match_head(derived);
  if (head && !(head in %(at src seq)))
    b.printf(
      "Macro_case_start(_x2c_gensym_match_expr, %lluULL, "
      "&_x2c_gensym_match_cursor); if (_x2c_gensym_match_root < 0) "
      "_x2c_gensym_match_root = ",
      (unsigned long long) head);
  b.write("Macro_case_root(_x2c_gensym_match_expr, ");
  _match_place(b, out, template);
  b.write(", ");
  _match_place(b, out, labels);
  b.printf(
    ", %d, &_x2c_gensym_match_cursor, &_x2c_gensym_match_capture); "
    "if (_x2c_gensym_match_root == 1 || (_x2c_gensym_match_root == 2%s)) {",
    statement, tests.str_free());
  return 2;
}

static int _match_test(
  Buffer b, Array out, List pattern, List binders, int &sites, int &depths) {
  match (pattern)
    case %(expr ? (call (expr ? (ident (binding ? (!or "Macro_case_pattern"
                                                     "Macro_case_shape"))))
                        (args ?template ?labels *shape))): {
      int braces = shape
        ? _match_viewed(b, out, template, labels, shape.car(), binders, depths)
        : -1;
      if (braces >= 0) return braces;
      int site = sites++;
      b.printf(
        " static MacroCaseSite _x2c_gensym_macro_site_%d; "
        "if (Macro_case_capture_at(&_x2c_gensym_macro_site_%d, "
        "_x2c_gensym_match_expr, ",
        site, site);
      _match_place(b, out, template);
      b.write(", ");
      _match_place(b, out, labels);
      b.write(", &_x2c_gensym_match_capture)) {");
      return 1;
    }
  if (((Code) pattern).is_static_pattern()) {
    int site = sites++;
    b.printf(
      " static MatchCaptureSite _x2c_gensym_match_site_%d; "
      "if (x2c_match_site_try_capture(&_x2c_gensym_match_site_%d, ",
      site, site);
  }
  else b.write(" if (x2c_match_try_capture(");
  b.write("_x2c_gensym_match_expr, List_var(");
  _match_place(b, out, pattern);
  b.write("), &_x2c_gensym_match_capture)) {");
  return 1;
}

static void _match_body(Buffer b, Array out, List body, int braces) {
  int finish = 1;
  match (body) case %(guarded ?inner): {
    body = inner;
    finish = 0;
  }
  _match_place(b, out, body);
  if (finish) b.write(" break;");
  while (braces--) b.write(" }");
}

static String _match_label(Symbol head, Array heads, int &labelling) {
  if (!labelling) return NULL;
  if (!head) {
    labelling = 0;
    return " default: ;";
  }
  if (head in heads) return NULL;
  heads.push(head);
  Var literal = head;
  return %" case $((unsigned long long) literal.u64)ULL: ;";
}

static String _match_locals(int depths, int values) {
  Buffer b = Buffer.new(0);
  b.write(";");
  for (int depth = 0; depth <= depths; depth++) {
    b.write(depth ? ", " : " List ");
    b.write(_match_cursor(depth));
  }
  if (depths >= 0) b.write(";");
  if (values > 0)
    b.printf(
      " Var _x2c_gensym_match_values[%d]; "
      "MatchCaptureBuffer _x2c_gensym_match_capture = "
      "{ .values = _x2c_gensym_match_values, .capacity = %d };",
      values, values);
  else if (!values)
    b.write(" MatchCaptureBuffer _x2c_gensym_match_capture = { 0 };");
  return b.str_free();
}

static Code _match_lowered(Code subject, List rows) {
  Buffer b = Buffer.new(0);
  Array out = [], heads = [];
  int labelling = 1, opening = 0, depth = 0, sites = 0;
  int depths = -1, values = -1;
  int dynamic = subject.type().is_named("Var");
  foreach (List row in rows) {
    if (row ~= %(preproc ?(String text))) {
      int nesting = _match_nesting(text);
      _match_place(b, out, row);
      if (nesting > 0 && !depth) opening = out.len() - 1;
      depth += nesting;
      continue;
    }
    List (pattern, body) = row;
    int otherwise = pattern.car() == <*>;
    Var value = otherwise ? %() : ((Code) pattern).pattern_value();
    String label = _match_label(_match_head(value), heads, labelling);
    if (label && depth) out.insert(opening++, label);
    else if (label) b.write(label);
    int guarded = dynamic && !otherwise;
    if (guarded) b.write(" if (!_x2c_gensym_match_none) {");
    int braces =
      otherwise ? 0 : _match_nested(b, out, pattern, value, NULL, depths);
    if (braces < 0) {
      List binders = _match_binders(value);
      if (binders.len() > values) values = binders.len();
      braces = _match_test(b, out, pattern, binders, sites, depths);
      _match_captures(b, binders);
    }
    _match_body(b, out, body, braces + guarded);
  }
  if (labelling) b.write(" default: break;");
  _match_flush(b, out);
  String selector = heads.len()
    ? "_x2c_gensym_match_expr ? _x2c_gensym_match_expr->car.u64 : 0" : "0";
  List items = _match_items(out);
  String locals = _match_locals(depths, values);
  List prologue = dynamic
    ? _match_dynamic_read(subject, locals)
    : $("List _x2c_gensym_match_expr =", subject.convert(%("List")), locals);
  return Code.lowered(
    %(block $prologue
            (switch (expr ("uint64_t") ($selector)) (block @items))), NULL);
}

static List _match_dynamic_read(Code subject, String locals) {
  Symbol list = <list>;
  String tested = "; int _x2c_gensym_match_none = "
    "!Var_is(_x2c_gensym_match_var, %lu);"
    .printf((unsigned long) list);
  return $(
    "Var _x2c_gensym_match_var =", subject, tested,
    "List _x2c_gensym_match_expr = Var_list_payload(_x2c_gensym_match_var)",
    locals);
}

/** Lowers the bound match `node` to C text around its subject, patterns,
    and bodies.
*/
Code match_lowering(Code node) {
  match (node) case $matched(?subject, *rows):
    return _match_lowered(subject, rows);
  return node;
}

static Code _match_condition(Code subject, List pattern, List body) {
  Buffer b = Buffer.new(0);
  Array out = [];
  int sites = 0, depths = -1, values = -1;
  int dynamic = subject.type().is_named("Var");
  if (dynamic) b.write(" if (!_x2c_gensym_match_none) {");
  int braces = _match_nested(
    b, out, pattern, ((Code) pattern).pattern_value(), NULL, depths);
  if (braces < 0) {
    List binders = _match_binders(((Code) pattern).pattern_value());
    values = binders.len();
    braces = _match_test(b, out, pattern, binders, sites, depths);
    _match_captures(b, binders);
  }
  _match_place(b, out, body);
  braces += dynamic;
  while (braces--) b.write(" }");
  _match_flush(b, out);
  String locals = _match_locals(depths, values);
  List prologue = dynamic ? _match_dynamic_read(subject, locals)
    : $("List _x2c_gensym_match_expr =", subject.convert(%("List")), locals);
  return Code.lowered(%(block $prologue @(_match_items(out))), NULL);
}

/** Lowers a pattern condition through the ordinary match tests. */
Code match_condition_lowering(Code node) {
  match (node) case %(match-if ?subject (?pattern ?body)):
    return _match_condition(subject, pattern, body);
  return node;
}

/* --- src/components/printf-format.x -------------------------------------- */

static int _printf_is_var(Code value) => value.type().is_named("Var");

static void _printf_fail(Code call, String message) {
  if (call ~= %(expr ? (call ?callee *)))
    x2c_diagnostic_fail_at(
      call, <xform>, message,
      %("printf-family call: $(Code.binding_spelling(callee))"));
}

static int _printf_valid(String length, int conversion) {
  if (strchr("diouxXn", conversion)) return length != "L";
  if (strchr("fFeEgGaA", conversion))
    return length == "" || length == "l" || length == "L";
  if (conversion == 'c' || conversion == 's')
    return length == "" || length == "l";
  return conversion == 'p' && length == "";
}

static Type _printf_type(String length, int conversion) {
  if (strchr("fFeEgGaA", conversion))
    return length == "L" ? %(long double) : %(double);
  if (conversion == 'c') return length == "" ? %(int) : NULL;
  if (!strchr("diouxX", conversion)) return NULL;
  int is_signed = conversion == 'd' || conversion == 'i';
  switch (length) {
    case "hh": case "h": return %(int);
    case "": return is_signed ? %(int) : %(unsigned);
    case "l": return is_signed ? %(long) : %(unsigned long);
    case "ll": return is_signed ? %(long long) : %(unsigned long long);
  }
  return NULL;
}

static Code _printf_read(Code value, String length, int conversion) {
  if (!_printf_is_var(value)) return value;
  if (conversion == 's' && length == "")
    return %(expr ("String") (call "Var_str" (args $value)));
  Type type = _printf_type(length, conversion);
  return type ? value.convert(type) : NULL;
}

static void _printf_position(Code call, const char *at) {
  while (isdigit(*at)) at++;
  if (*at == '$')
    $fail.printf_position(call);
}

static void _printf_count(
  Code call, const char *&at, Array arguments, int &next) {
  if (*at != '*') {
    while (isdigit(*at)) at++;
    return;
  }
  _printf_position(call, ++at);
  if (next >= arguments.len())
    $fail.printf_missing_count(call);
  Code value = arguments[next];
  if (_printf_is_var(value)) arguments[next] = value.convert(%(int));
  next++;
}

static String _printf_length(const char *&at) {
  const char *start = at;
  if (*at && strchr("hljztL", *at))
    at += (*at == 'h' || *at == 'l') && at[1] == *at ? 2 : 1;
  return String.new_len(start, (int) (at - start));
}

static void _printf_conversion(
  Code call, const char *&at, Array arguments, int &next) {
  _printf_position(call, at);
  while (*at && strchr("-+ #0", *at)) at++;
  _printf_count(call, at, arguments, next);
  if (*at == '.') {
    at++;
    _printf_count(call, at, arguments, next);
  }
  String length = _printf_length(at);
  if (!*at) $fail.printf_incomplete(call);
  int conversion = *at++;
  String spec = "%%%c".printf(conversion);
  if (!_printf_valid(length, conversion))
    $fail.printf_conversion(call, spec);
  if (next >= arguments.len())
    $fail.printf_missing_argument(call, spec);
  Code read = _printf_read(arguments[next], length, conversion);
  if (!read)
    $fail.printf_native_argument(call, spec);
  arguments[next++] = read;
}

static void _printf_scan(
  Code call, const char *at, Array arguments, int &next) {
  while (*at) {
    int ch = *at++;
    if (ch == '\\' && *at) at++;
    if (ch != '%') continue;
    if (!*at) $fail.printf_incomplete(call);
    if (*at == '%') at++;
    else _printf_conversion(call, at, arguments, next);
  }
}

static Code _printf_lowered(Code code, Code format, List values) {
  int has_var = 0;
  foreach (Code value in values) has_var |= _printf_is_var(value);
  if (!has_var) return code;
  String spelling = format.format();
  if (!spelling)
    $fail.printf_static_format(code);
  if (code ~= %(expr ?type (call ?callee (args *given)))) {
    Array arguments = given;
    int next = given.len() - values.len();
    _printf_scan(code, spelling[1:spelling.len() - 1], arguments, next);
    for (; next < arguments.len(); next++)
      if (_printf_is_var(arguments[next]))
        $fail.printf_unused_argument(code);
    return %(expr $type (call $callee (args @(arguments.list_free()))));
  }
  return code;
}

static Code _printf_library(Code code, Code format, List values) {
  if (code ~= %(expr ? (call (expr () ?) ?)))
    return _printf_lowered(code, format, values);
  return code;
}

/** Reads the Var values a printf-family call's static format consumes. */
Code printf_values(Code code) {
  match (code) {
    case $x2c.printf.format(?f, *v): return _printf_library(code, f, v);
    case $x2c.fprintf.format(?, ?f, *v): return _printf_library(code, f, v);
    case $x2c.sprintf.format(?, ?f, *v): return _printf_library(code, f, v);
    case $x2c.snprintf.format(?, ?, ?f, *v):
      return _printf_library(code, f, v);
    case $x2c.string_printf.format(?f, *v): return _printf_lowered(code, f, v);
    case $x2c.file_printf.format(?, ?f, *v):
      return _printf_lowered(code, f, v);
    case $x2c.buffer_printf.format(?, ?f, *v):
      return _printf_lowered(code, f, v);
  }
  return code;
}

/* --- src/components/protocol-adapters.x ---------------------------------- */

static List _protocol_forward(
  Type target, String source, Type template, String binder, String convert) {
  List templates = template.car().list().cadr();
  Array params = [], arguments = [];
  int index = 0;
  foreach (Type type in target.car().list().cadr()) {
    List name = x2c_ident(%"a$(index++)");
    params.push($!Param{ $type $name });
    Code argument = $!( $name );
    if (templates.car() == $(binder))
      argument = $!( $(x2c_ident(convert))($argument) );
    if (type == %(....))
      argument = %(expr ("List") (splice $argument));
    arguments.push(argument);
    templates = templates.cdr();
  }
  return $(params.list_free(), x2c_ident(source), arguments.list_free());
}

static Code _protocol_function(List declared, List name, List forward) {
  List params = forward.car(), args = forward.caddr();
  Code callee = forward.cadr();
  return $!Unit{ $declared $name(@params) { return $callee(@args); } };
}

static int _protocol_renders(String member, Type participant) {
  if (!(member in %("str" "repr" "write_str" "write_repr"))) return 0;
  if (Type.resolve(participant) ~= %((!or struct union) *)) return 1;
  return 0;
}

static Code _protocol_guarded(
  String member, List name, Type result, List forward) {
  List params = forward.car(), args = forward.caddr();
  Code callee = forward.cadr();
  Code value = x2c_ident("a0");
  Code fallback = member == "str" || member == "repr"
    ? $!( Var_pointer_string($value) )
    : $!( Var_write_pointer_repr($value, $(x2c_ident("a1"))) );
  return $!Unit{
    static inline $result $name(@params) {
      RenderPath render_path;
      if (!RenderPath_enter(&render_path, Var_pointer($value)))
        return $fallback;
      defer RenderPath_leave(&render_path);
      return $callee(@args);
    }
  };
}

static Code _protocol_prototype(List name, Type expected) {
  Array params = [];
  foreach (Type type in expected.car().list().cadr()) {
    (List base, List modifiers) = type.parts();
    params.push(%(param $base (bind () $modifiers)));
  }
  Type result = expected.cdr();
  List declared = params.list_free();
  return $!Unit{ $result $name(@declared); };
}

static void _protocol_descriptor(List descriptor, List slots) {
  if (descriptor ~= %(?(List methods) ?(String name) ?(Symbol var_tag)
      ?(Symbol area) *explicit)) {
    Code table = %(expr ("VarMethods") (ident $methods));
    List init = %(unit-init $area);
    x2c_place(%(unit-support), $!Unit{ static VarMethods $methods; });
    /* A table with no slots stays zero, which avoids an empty
       initializer that C accepts only from C23 on. */
    if (slots) x2c_place(init, $!{ $table = (VarMethods){ @slots }; });
    Code text = %(expr ("String") (call "String_new" (args
      (expr (* char) (literal (* char) $(%"\"$name\""))))));
    if (explicit) {
      Code tag = $!Symbol{ $(explicit.car()) };
      x2c_place(
        init, $!{ x2c_register_tagged_descriptor($tag, $text, $table); });
      return;
    }
    Code symbol = %(expr ("Symbol") (literal ("Symbol") $name $var_tag));
    if (area == <protocol>) {
      x2c_place(
        init, $!{ x2c_register_builtin_descriptor($symbol, $table); });
      return;
    }
    x2c_place(
      init, $!{
        if (!x2c_register_builtin_descriptor($symbol, $table))
          x2c_register_descriptor($text, $table);
      });
  }
}

/** Places the forwarding members, descriptor thunks, method table, and
    descriptor registration of one conformance.
*/
Code protocol_conformance(Code node) {
  if (node ~= %(conform ? ?(Type participant) ?(String forward)
      ?(String reverse) ?(String binder) ?descriptor (*rows))) {
    Array slots = [];
    foreach (List row in rows)
      if (row ~= %(?(String member) ? ?(String source) ?(Type expected)
          ?(Type template) *parts))
        foreach (List part in parts) match (part) {
          case %(default ?(List name) ?(Symbol storage)): {
            List declared = storage == <static>
              ? %(static inline @(expected.cdr()))
              : expected.cdr();
            List forwarded = _protocol_forward(
              expected, source, template, binder, forward);
            Code adapter =
              _protocol_function(declared, name, forwarded);
            x2c_place(%(unit-support), adapter);
          }
          case %(inherited ?(List name) ?(Type owner_expected)): {
            source = Code.binding_spelling(name);
            expected = owner_expected;
            x2c_place(%(unit-support), _protocol_prototype(name, expected));
          }
          case %(thunk ?(List name) ?(Type erased)): {
            Type result = erased.cdr();
            List declared = %(static inline @result);
            List forwarded = _protocol_forward(
              erased, source, template, binder, reverse);
            Code thunk = _protocol_renders(member, participant)
              ? _protocol_guarded(member, name, result, forwarded)
              : _protocol_function(declared, name, forwarded);
            x2c_place(%(unit-support), thunk);
            slots.push(%(dotinit ($member) (expr $erased (ident $name))));
          }
        }
    _protocol_descriptor(descriptor, slots.list_free());
    return %(seq);
  }
  return node;
}

/* --- src/components/raise.x ---------------------------------------------- */

static int _raise_immutable(Type type) {
  if (!type) return 0;
  foreach (String name in %("Var" "String" "List" "Symbol" "Atom"))
    if (type.is_named(name)) return 1;
  return type.numeric() != NULL;
}

static Code _raise_value(Code value) {
  value = value.promoted();
  if (value ~= %(expr ?matched ?)) {
    Type type = matched;
    if (_raise_immutable(type)) return value;
    $report.raise_mutable_detail(NULL, type);
  }
  return $!Var{ Var_null() };
}

/** Converts a raise's code and details, or declines a raise whose parts
    already have their types.
*/
Code raise_lowering(Code node) {
  if (node ~= $raised(?code, *details)) {
    Code symbol = ((Code) code).convert(%("Symbol"));
    int changed = symbol != code, index = 0;
    Array converted = [];
    foreach (Code detail in details) {
      Code part = index++ & 1 ? _raise_value(detail) : detail;
      Code value = part.convert(%("Var"));
      if (value != part) changed = 1;
      converted.push(value);
    }
    if (changed)
      return Code.lowered(
        %(raise $symbol (args @(converted.list_free()))), NULL);
  }
  return node;
}

/* --- src/components/string-switch.x -------------------------------------- */

static String _string_case_bytes(String spelling) {
  const char *p = spelling;
  String bytes = "\"";
  while ((p = strchr(p, '"'))) {
    const char *start = ++p;
    while (*p != '"') p += *p == '\\' ? 2 : 1;
    bytes += String.new_len(start, p - start).unescape();
    p++;
  }
  return bytes + "\"";
}

static int _string_case_text(Type type) =>
  type ~= %((!or (dim *) (!quote *)) char) ||
  type ~= %((!or (dim *) (!quote *)) const char);

static String _string_case_key(List label) {
  match (label) {
    case %(expr ? $($grouped(?inner))): return _string_case_key(inner);
    case %(expr ? (literal ?type ?text)): {
      String spelling = text;
      if (_string_case_text(type))
        return "\"" in spelling ? _string_case_bytes(spelling) : spelling;
    }
  }
  return NULL;
}

static List _string_case_index(
  List label, Map indices, Array labels, List site) {
  String key = _string_case_key(label);
  if (!key) {
    $report.string_switch_case(site);
    return label;
  }
  if (!(key in indices)) {
    labels.push(label);
    indices[key] = labels.len();
  }
  int index = indices[key];
  return $!int{ $index };
}

static Var _string_cases(
  Var node, Map indices, Array labels, List site) {
  if (node is not <list> || node.is_nil()) return node;
  match (node) {
    case %((!or expr switch match) *): return node;
    case %(at ? ?inner):
      return %(at $(node.cadr())
               $(_string_cases(inner, indices, labels, node)));
    case %(case ?label):
      return %(case $(_string_case_index(label, indices, labels, site)));
  }
  Var child;
  $ast.rewrite_children(
    node, child, _string_cases(child, indices, labels, site));
}

static Code _string_switch_helper(Type type, List labels) {
  List key = %(string-switch $type $labels);
  List name = x2c_binding_for(key, "string_switch"), s = x2c_ident("s");
  Array tests = [];
  int index = 0;
  foreach (List label in labels) {
    List value = $!int{ $(++index) };
    tests.push($!{ if ($s == $label) return $value; });
  }
  List body = tests.list_free();
  x2c_place(
    %(unit-support $key),
    $!Unit{ static int $name($type $s) { @body return 0; } });
  Type callable = %((func ($type)) int);
  return $!($callable){ $name };
}

/** Lowers a switch on a String to an integer switch on its selector's
    index among the labels it owns, or declines another switch.
*/
Code string_switch_lowering(Code node) {
  if (node ~= $switched(?selector, ?body)) {
    Type type = selector.cadr();
    if (!type.is_named("String")) return node;
    Map indices = {};
    Array labels = [];
    List numbered = _string_cases(body, indices, labels, NULL);
    Code helper = _string_switch_helper(type, labels.list_free());
    return Code.lowered(
      %(switch $($!int{ $helper($selector) }) $numbered), NULL);
  }
  return node;
}

/* --- src/components/try-catch.x ------------------------------------------ */

static int _try_arm_exits(List arm) {
  if (arm ~= %(code-value ? ?statement ?)) {
    Code lowered = statement;
    return lowered.exits();
  }
  return 0;
}

List _x2c_try_catch_cases(List selected, List arms) {
  Array cases = [];
  int index = 0, exits = 1;
  foreach (List arm in arms) {
    cases.push($!{ if ($selected == $index) $arm });
    index++;
    exits &= _try_arm_exits(arm);
  }
  if (exits) cases.push($!{ __builtin_unreachable(); });
  return cases.list_free();
}

List _x2c_try_exits_placement(List exits) {
  Atom token = Atom.intern("?__try_cleanup");
  if (exits ~= %(code-value ? ?statements ?))
    return Code.lowered(statements, %((cleanup $token $statements)));
  return NULL;
}

static Var _try_finalizer_label(Var value, List &at) {
  Array pending = [value], around = [at];
  Var found = NULL;
  while (!found && pending.len()) {
    Var current = pending.take_last();
    List here = around.take_last();
    if (current is not <list> || current.is_nil()) continue;
    List node = current;
    match (node) {
      case %(function *): continue;
      case %(at ? ?wrapped): {
        pending.push(wrapped);
        around.push(node);
        continue;
      }
      case %(label ?name *): {
        found = name;
        at = here;
        continue;
      }
    }
    foreach (Var child in node) {
      pending.push(child);
      around.push(here);
    }
  }
  pending.free();
  around.free();
  return found;
}

static void _try_check_label(List finalizer) {
  List at = finalizer;
  Var label = _try_finalizer_label(finalizer, at);
  if (!label) return;
  $fail.try_finalizer_label(at, label);
}

static List _try_frame_address(Atom frame) {
  Type type = %(("ExceptionFrame")), pointer = %(* ("ExceptionFrame"));
  return %(expr $pointer (op & (expr $type (ident $frame))));
}

static List _try_departure(Atom frame) {
  List address = _try_frame_address(frame);
  return $!{
    x2c_exception_mark_handled($address);
    x2c_exception_leave($address);
  };
}

static List _try_exits(Atom frame, List handle, Atom finalizer) {
  List before = NULL;
  if (handle) {
    List handler = %(expr (("ErrorHandler")) (ident $handle));
    List close = $!{ x2c_error_catch_close($handler); $handler = NULL; };
    before = $(close);
  }
  List address = _try_frame_address(frame);
  if (finalizer)
    return $!{
      if (x2c_exception_claim($address)) {
        @before
        $finalizer
      }
      x2c_exception_leave($address);
    };
  return $!{ @before x2c_exception_leave($address); };
}

static List _try_catch_clause(List handle, List records, Array rows) {
  if (!records) return NULL;
  String state = "ERROR_CATCH_PENDING";
  Array arms = [], patterns = [];
  foreach (List record in records) {
    Code pattern = record.car();
    if (pattern) {
      if (!pattern.is_static_pattern()) state = "ERROR_CATCH_TRANSIENT";
      patterns.push(pattern);
    }
    Atom arm = Atom.intern(%"?__try_arm_$(arms.len())");
    rows.push(%(region $arm $(record.cadr())));
    arms.push(arm);
  }
  return $(handle, state, arms.list_free(), @(patterns.list_free()));
}

static List _try_catch_handle(List node) {
  if (node ~= %(try ? (catchcases ? ?handle) ?)) return handle;
  return NULL;
}

static Code _try_landing(
  Code node, List body, List arms, List finalizer) {
  _try_check_label(finalizer);
  Atom frame = Atom.intern("?__exception_frame");
  Atom exits = Atom.intern("?__try_exits");
  Atom lowered = Atom.intern("?__try_body");
  Atom finished = NULL;
  List handle = arms ? _try_catch_handle(node) : NULL;
  Array rows = [%(new-name $frame "exception_frame")];
  if (finalizer) {
    Atom departure = Atom.intern("?__try_departure");
    finished = Atom.intern("?__try_finalizer");
    rows.push(%(exits $departure $(_try_departure(frame))));
    rows.push(%(region $finished $finalizer));
  }
  rows.push(%(exits $exits $(_try_exits(frame, handle, finished))));
  rows.push(%(region $lowered $body));
  List clause = _try_catch_clause(handle, arms, rows);
  Macro shape = $x2c.try.frame;
  List code = shape(frame, clause, lowered, exits);
  return Code.lowered(%(landing $code $(rows.list_free())), NULL);
}

/** Lowers the parsed try `node` to its landing form. */
Code try_lowering(Code node) {
  match (node) {
    case $caught(?body, ?finalizer, *arms):
      return _try_landing(node, body, arms, finalizer);
    case $tried(?body, ?finalizer):
      return _try_landing(node, body, NULL, finalizer);
  }
  return node;
}

/* --- src/operator-ledger.x ----------------------------------------------- */

static List _operator_rows(void) => %(
  (<||>       1 0        0         0)
  (<&&>       2 0        0         0)
  (<|>        3 <|=>     0         0)
  (<^>        4 <^=>     0         0)
  (<&>        5 <&=>     0         0)
  (<~=>       6 0        0         0)
  (<"==">     6 0        <equal>   0)
  (<!=>       6 0        <equal>   1)
  (<"===">    6 0        0         0)
  (<!==>      6 0        0         0)
  (<"<">      7 0        <compare> 1)
  (<"<=">     7 0        <compare> 1)
  (<">">      7 0        <compare> 1)
  (<">=">     7 0        <compare> 1)
  (<in>       7 0        0         0)
  (<"<<">     8 <"<<=">  0         0)
  (<">>">     8 <">>=">  0         0)
  (<+>        9 <+=>     <add>     0)
  (<->        9 <-=>     <sub>     0)
  (<*>       10 <*=>     <mul>     0)
  (</>       10 </=>     <div>     0)
  (<%>       10 <%=>     <mod>     0)
);

static List _operator_cases(int key, int value, int derived) {
  Array cases = [];
  foreach (List row in _operator_rows()) {
    if (!row[key] || !row[value]) continue;
    if (derived >= 0 && row[4] != derived) continue;
    Symbol label = row[key];
    Var result = row[value];
    cases.push($!{ case $label: return $result; });
  }
  return cases.list_free();
}

/* --- the linked inventory ------------------------------------------------ */

macro Stmt $linked.row(Expr $rows, Expr $name, Expr $function) {
  $rows[$name] = (Func) $function;
}

