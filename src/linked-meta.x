      %"expected '${$type}'",
      $c.token, NULL);
  },
  "parse.token.malformed" :
  macro Statement(Expr $c, Expr $site, Expr $status) {
    $c.report_error(
      <parse>,
      $status == <indent> ? "inconsistent indentation" : "invalid token",
      $site, NULL);
  },

