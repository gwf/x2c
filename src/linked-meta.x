/*  linked-meta.x -- shipped `meta` code compiled into the compiler

    Generated by tools/gen-linked-meta.sh; do not edit. Each bodied
    `meta` definition of lib/meta.x and of the imported `.xmacro`
    files appears here without its `meta` marker, so it runs as
    native code instead of through the Lisp lowering.
    `Compiler.bind_linked_meta` binds an imported definition to its
    copy only when the two texts hash the same, so a compiler built
    before a `.xmacro` edit stages the edited definition. The
    lib/meta.x builders with a run-time form bind to the runtime's
    own definitions and have no copy here.
*/

#pragma once

#include "x2c.x"
#include "meta.x"

/* --- lib/meta.x ---------------------------------------------------------- */

/** Returns the expression `receiver.name`. */
List x2c_expr_field(List receiver, String name) {
  List checked = x2c_ident(name);
  return %(expr () (op . $receiver (${checked[1]})));
}

/** Returns `expression` cast to `type`, which is a declared type rather
    than syntax. A generator needs it where the value it holds and the
    parameter it reaches differ in width or sign. */
List x2c_expr_cast(List type, List expression) {
  List parts = x2c_type_parts(type);
  return %(expr $type
    (cast (decl ${parts[0]} (bindings (bind () ${parts[1]}))) $expression));
}

/** Declares `name` with `type` and an optional initializer. */
List x2c_decl_make(List type, Var name, List initializer) {
  List parts = x2c_type_parts(type);
  List binding = %(bind ($name) ${parts[1]});
  if (initializer) binding = %(op = $binding $initializer);
  return %(declare ${parts[0]} (bindings $binding));
}

/** Returns a parameter named `name` with `type`. */
List x2c_param_make(List type, Var name) {
  List parts = x2c_type_parts(type);
  return %(param ${parts[0]} (bind ($name) ${parts[1]}));
}

static Var _meta_initializer(List node) {
  match (node) {
    case %(expr ? (literal ? ?text)): return text;
    case %(?text): return text;
  }
  return node;
}

static void _meta_fail(String message, Var value) {
  x2c_diagnostic_fail(message, %("value: ${value.repr()}"));
}

static List _meta_member(List node) {
  match (node) {
    case %(op = (?name) ?value):
      return %($name ${_meta_initializer(value)});
    case %(?name): return %($name ());
  }
  _meta_fail("x2c.type.members found an unreadable member", node);
  return %();
}

/** Returns enum members as `(name value)` rows in declaration order.
    An implicit value is nil; a literal value retains its spelling. */
List x2c_type_members(List type) {
  List resolved = x2c_type_resolve(type);
  if (resolved.car() != <enum>)
    _meta_fail("x2c.type.members requires an enum Type", type);
  List members = resolved.reverse().car();
  List rows = %();
  foreach (List member, members) rows = cons(_meta_member(member), rows);
  return rows.reverse();
}

/* --- src/error-reports.xmacro -------------------------------------------- */

static Map _error_report_rows(void) => {

  "cache.init.cycle" :
  macro Statement(Expr $c, Expr $origin, Expr $notes) {
    $c.report_error(
      <cache>, "file-static x2c initializer dependency cycle",
      $origin, $notes);
  },

  "driver.cpp.failed" :
  macro Statement(Expr $c, Expr $site, Expr $status) {
    $c.report_error(
      <driver>,
      "failed to run C preprocessor",
      $site, %("stage: preprocess" "status: ${$status}"));
  },

  "driver.include.read" :
  macro Statement(Expr $c, Expr $target, Expr $path) {
    $c.report_error(
      <driver>,
      "cannot read include",
      $c.token, %("stage: collect" "include: ${$target}" "path: ${$path}"));
  },

  "driver.indent.symbols" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <driver>,
      "indented units use the default symbol collection",
      $site, %("the host preprocessor does not keep the indentation, so"
      "--cpp-symbols, --live-symbols, and the --dump-cpp modes cannot read"
      "an indented unit"));
  },

  "driver.input.read" :
  macro Statement(Expr $c, Expr $filename) {
    $c.report_error(
      <driver>,
      "cannot read input file",
      NULL, %("stage: driver" "file: ${$filename}" "reason: cannot open"));
  },

  "driver.module.compiler" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $module) {
    $c.report_error(
      <driver>,
      %"package '${$name}' was built by another compiler; rebuild it",
      $site, %("module: ${$module}"));
  },
  "driver.module.platform" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $module) {
    $c.report_error(
      <driver>,
      "native modules are not supported on this platform",
      $site, %("package: ${$name}" "module: ${$module}"));
  },

  "driver.package.prefix" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $spelling, Expr $unit, Expr $fix) {
    $c.report_error(
      <driver>,
      %"package '${$name}' exposes unprefixed top-level declaration '${$spelling}'",
      $site, %( "'${$unit}' is x2c source outside the package; include it ${$fix}" ));
  },
  "driver.package.read" :
  macro Statement(
    Expr $c, Expr $site, Expr $package, Expr $entry) {
    $c.report_error(
      <driver>,
      %"cannot read package '${$package.package}'",
      $site, %( "path: ${$entry}" ));
  },
  "driver.package.unknown" :
  macro Statement(Expr $c, Expr $site, Expr $name) {
    $c.report_error(
      <driver>,
      %"unknown package '${$name}'",
      $site, %( "searched: <root>/${$name}/src/${$name}.x, <root>/${$name}/${$name}.x" ));
  },

  "driver.runtime.read" :
  macro Statement(Expr $c, Expr $runtime) {
    $c.report_error(
      <driver>,
      "cannot read runtime source",
      $c.token, %("path: ${$runtime}"));
  },

  "driver.script.symbols" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <driver>,
      "script units use the default symbol collection",
      $site, %("the host preprocessor reads the #! line as C, so --cpp-symbols,"
      "--live-symbols, and the --dump-cpp modes cannot read a script"));
  },

  "emit.file.write" :
  macro Statement(Expr $c, Expr $failure) {
    {
      String reason = String.new(strerror((int) $failure.assoc(<"errno">)));
      $c.report_error(
        <emit>, "failed to write generated file",
        $c.token, %("file: ${$failure.assoc(<path>)}" "reason: $reason"));
    }
  },

  "emit.interface.write" :
  macro Statement(Expr $c) {
    $c.report_error(
      <emit>,
      "failed to write interface file",
      NULL, NULL);
  },

  "emit.static.switch" :
  macro Statement(Expr $c) {
    {
      String note = "place the declaration before the switch "
                  + "or within one case block";
      $c.report_error(
        <emit>, "switch cannot bypass dynamic static initialization",
        NULL, %($note));
    }
  },

  "macro.adapter.pointer" :
  macro Statement(Expr $c, Expr $type, Expr $origin) {
    $c.report_error(
      <macro>, "typed callback adapter target must name a function pointer",
      $origin, $type ? %("target type: ${$type.repr()}") : NULL);
  },
  "macro.adapter.typedef" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "typed callback adapter target must be a typedef name",
      $origin, NULL);
  },

  "macro.argument.constant" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "explicit meta call cannot be resolved",
      $site, %("an argument must be a constant, captured syntax, or a meta call"));
  },
  "macro.argument.contract" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "macro argument has no parsing contract",
      $c.token, NULL);
  },

  "macro.builtin.form" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "unexpected form in built-in macro source",
      $c.token, NULL);
  },

  "macro.call.binding" :
  macro Statement(Expr $c, Expr $site, Expr $name) {
    $c.report_error(
      <macro>,
      "explicit meta call cannot be resolved",
      $site, %("no binding for ${$name}"));
  },
  "macro.call.deferred" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "this meta call is left for the translation",
      $site, NULL);
  },
  "macro.call.depth" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "explicit meta call was stopped",
      $site, %("reason: its compile-time form nested too deep"));
  },
  "macro.call.target" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "explicit meta call cannot be resolved",
      $site, %("only a call to a meta function runs at compile time"));
  },

  "macro.decorator.expr" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"decorator '${$spelling}' requires a following expression",
      $origin, %(${$definition_note}));
  },
  "macro.decorator.position" :
  macro Statement(
    Expr $c, Expr $name, Expr $kind, Expr $origin) {
    $c.report_error(
      <macro>,
      %"decorator '${$name}' targets ${$kind} syntax and cannot be used here",
      $origin, NULL);
  },
  "macro.decorator.semicolon" :
  macro Statement(
    Expr $c, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, "decorator application must not end with ';'",
      $origin, %(${$definition_note}));
  },
  "macro.decorator.target" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"decorator '${$spelling}' requires a following target",
      $origin, %(${$definition_note}));
  },

  "macro.expansion.count" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "macro expansion count exceeds 10000",
      $origin, NULL);
  },
  "macro.expansion.depth" :
  macro Statement(
    Expr $c, Expr $origin, Expr $definition_note, Expr $first_note) {
    {
      String first_note = %"first expansion: ${$first_note}";
      $c.report_error(
        <macro>, "macro expansion depth exceeds 64", $origin,
        %(${$definition_note} $first_note));
    }
  },
  "macro.expansion.recursive" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin,
    Expr $definition_note, Expr $shown) {
    $c.report_error(
      <macro>, %"identical recursive expansion of '${$spelling}'",
      $origin, %(${$definition_note} "input: ${$shown.repr()}"));
  },

  "macro.function.install" :
  macro Statement(Expr $c, Expr $site, Expr $cause) {
    $c.report_error(
      <macro>,
      "this meta function could not be installed",
      $site, %("reason: ${$cause.repr()}"));
  },
  "macro.function.only" :
  macro Statement(Expr $c, Expr $site, Expr $name) {
    $c.report_error(
      <macro>,
      %"'${$name}' can only be called at compile time",
      $site, %("reason: it reaches a compiler operation, so no unit emits a"
      "definition for it; call it from a macro or another meta"
      "function"));
  },
  "macro.function.unavailable" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $why) {
    $c.report_error(
      <macro>,
      "this function cannot run at compile time",
      $site, %("function: ${$name}" "reason: ${$why}"));
  },

  "macro.helper.stopped" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $reason) {
    $c.report_error(
      <macro>,
      "this meta call stopped the compile-time helper",
      $site, %("function: ${$name}" "reason: ${$reason}"));
  },
  "macro.helper.timeout" :
  macro Statement(
    Expr $c, Expr $site, Expr $limit, Expr $name) {
    $c.report_error(
      <macro>,
      "%s%g s".printf("this meta call ran longer than ", $limit),
      $site, %("function: ${$name}" "set X2C_META_TIMEOUT to a larger limit in seconds, or 0 for none"));
  },

  "macro.import.collision" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"imported macro '${$spelling}' collides with a visible macro",
      $origin, %(${$definition_note}
        "import: ${$c.display_path($c.import_src)}"));
  },
  "macro.import.cycle" :
  macro Statement(Expr $c, Expr $path, Expr $origin) {
    {
      String display = $c.display_path($path);
      Array notes = [ %"import: $display" ];
      Array parents = $c.import_stack;
      for (int i = 0; i < parents.len(); i++) {
        Var parent = parents[i];
        notes.push(%"from: ${$c.display_path(parent)}");
      }
      $c.report_error(
        <macro>, "compile-time import cycle", $origin, notes.list_free());
    }
  },
  "macro.import.extension" :
  macro Statement(
    Expr $c, Expr $origin, Expr $path_note) {
    $c.report_error(
      <macro>, "compile-time import requires .xlisp or .xmacro",
      $origin, $path_note);
  },
  "macro.import.form" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "unexpected form in macro import",
      $c.token, NULL);
  },

  "macro.keyword.builtin" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "built-in keyword alias cannot be replaced",
      $origin, NULL);
  },
  "macro.keyword.internal" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"keyword alias cannot name internal macro kind '${$spelling}'",
      $origin, %(${$definition_note}));
  },

  "macro.lisp.expr" :
  macro Statement(Expr $c, Expr $origin, Expr $value) {
    $c.report_error(
      <macro>, "compile-time Lisp result cannot fill an expression slot",
      $origin, %( "value:" ${$value.repr()} ));
  },
  "macro.lisp.failed" :
  macro Statement(
    Expr $c, Expr $origin, Expr $source, Expr $error) {
    {
      String form_note = %"form: ${$source}",
        error_note = %"error: ${$error.repr()}";
      $c.report_error(
        <macro>, "compile-time Lisp evaluation failed", $origin,
        %($form_note $error_note));
    }
  },

  "macro.local.result" :
  macro Statement(
    Expr $c, Expr $result_spelling, Expr $origin) {
    $c.report_error(
      <macro>, %"local macros cannot have ${$result_spelling} results",
      $origin, NULL);
  },
  "macro.local.target" :
  macro Statement(Expr $c, Expr $target, Expr $origin) {
    $c.report_error(
      <macro>, %"local decorators cannot target ${$target} syntax",
      $origin, NULL);
  },

  "macro.name.with" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "'with' cannot be a local macro name",
      $origin, NULL);
  },

  "macro.protocol.invalid" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "constructed protocol syntax is invalid",
      $c.token, NULL);
  },

  "macro.result.expr" :
  macro Statement(
    Expr $c, Expr $kind, Expr $spelling, Expr $origin, Expr $definition_note) {
    {
      String subject = $kind == <decorator>
        ? %"decorator '${$spelling}'"
        : %"macro '${$spelling}'";
      $c.report_error(
        <macro>, %"$subject cannot be invoked in an expression", $origin,
        $kind == <decorator> ? %(${$definition_note}) : NULL);
    }
  },
  "macro.result.position" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $result,
    Expr $description, Expr $origin) {
    {
      String message =
        %"macro '${$spelling}' has result kind ${$result} and cannot be " +
        %"invoked at ${$description}";
      $c.report_error(<macro>, message, $origin, NULL);
    }
  },

  "parse.alias.body" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias declaration cannot have a body",
      $c.token, NULL);
  },
  "parse.alias.identifier" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias native target must be a direct identifier",
      $c.token, NULL);
  },
  "parse.alias.name" :
