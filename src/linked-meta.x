  $linked.row(rows, "x2c_function_body", x2c_function_body);
  $linked.row(rows, "x2c_parameters_arguments", x2c_parameters_arguments);
  return rows;
}

/** Returns the hash of each linked copy's definition text by name. */
Map linked_meta_hashes(void) => $x2c_meta_definition_hashes();
