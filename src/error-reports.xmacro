  "parse.package.bound" :
  macro Statement(
    Expr $c, Expr $site, Expr $kind, Expr $local, Expr $bound) {
    $c.report_error(
      <parse>,
      %"package ${$kind} '${$local}' is already bound",
      $site, %( "bound to: ${$bound}" ));
