  },

  "parse.slice.zero" :
  macro Statement(Expr $c) {
    $c.report_error(<parse>, "slice step cannot be zero", $c.token, %());
  },

  "parse.splice.expr" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "sequence insertion is not legal in an expression slot",
      $c.token, NULL);
  },
  "parse.splice.position" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "sequence insertion is not legal in this syntax slot",
