/* Compiler error templates. Keys have at most three short components;
   prefer ref, expr, decl, sig, param, init, and ctor to long spellings.
   Captures are runtime expressions. Categories remain diagnostic codes. */

meta static Map _error_report_rows = {

  "cache.init.cycle" :
  macro Statement(Expr $c, Expr $origin, Expr $notes) {
    $c.report_error(
      <cache>, "file-static x2c initializer dependency cycle",
      $origin, $notes);
  },

  "driver.cpp.failed" :
  macro Statement(Expr $c, Expr $site, Expr $status) {
    $c.report_error(
      <driver>,
      "failed to run C preprocessor",
      $site, %("stage: preprocess" "status: ${$status}"));
  },

  "driver.include.read" :
  macro Statement(Expr $c, Expr $target, Expr $path) {
    $c.report_error(
      <driver>,
      "cannot read include",
      $c.token, %("stage: collect" "include: ${$target}" "path: ${$path}"));
  },

  "driver.indent.symbols" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <driver>,
      "indented units use the default symbol collection",
      $site, %("the host preprocessor does not keep the indentation, so"
      "--cpp-symbols, --live-symbols, and the --dump-cpp modes cannot read"
      "an indented unit"));
  },

  "driver.input.read" :
  macro Statement(Expr $c, Expr $filename) {
    $c.report_error(
      <driver>,
      "cannot read input file",
      NULL, %("stage: driver" "file: ${$filename}" "reason: cannot open"));
  },

  "driver.module.compiler" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $module) {
    $c.report_error(
      <driver>,
      %"package '${$name}' was built by another compiler; rebuild it",
      $site, %("module: ${$module}"));
  },
  "driver.module.platform" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $module) {
    $c.report_error(
      <driver>,
      "native modules are not supported on this platform",
      $site, %("package: ${$name}" "module: ${$module}"));
  },

  "driver.package.prefix" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $spelling, Expr $unit, Expr $fix) {
    $c.report_error(
      <driver>,
      %"package '${$name}' exposes unprefixed top-level declaration '${$spelling}'",
      $site, %( "'${$unit}' is x2c source outside the package; include it ${$fix}" ));
  },
  "driver.package.read" :
  macro Statement(
    Expr $c, Expr $site, Expr $package, Expr $entry) {
    $c.report_error(
      <driver>,
      %"cannot read package '${$package.package}'",
      $site, %( "path: ${$entry}" ));
  },
  "driver.package.unknown" :
  macro Statement(Expr $c, Expr $site, Expr $name) {
    $c.report_error(
      <driver>,
      %"unknown package '${$name}'",
      $site, %( "searched: <root>/${$name}/src/${$name}.x, <root>/${$name}/${$name}.x" ));
  },

  "driver.runtime.read" :
  macro Statement(Expr $c, Expr $runtime) {
    $c.report_error(
      <driver>,
      "cannot read runtime source",
      $c.token, %("path: ${$runtime}"));
  },

  "driver.script.symbols" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <driver>,
      "script units use the default symbol collection",
      $site, %("the host preprocessor reads the #! line as C, so --cpp-symbols,"
      "--live-symbols, and the --dump-cpp modes cannot read a script"));
  },

  "emit.file.write" :
  macro Statement(Expr $c, Expr $failure) {
    {
      String reason = String.new(strerror((int) $failure.assoc(<"errno">)));
      $c.report_error(
        <emit>, "failed to write generated file",
        $c.token, %("file: ${$failure.assoc(<path>)}" "reason: $reason"));
    }
  },

  "emit.interface.write" :
  macro Statement(Expr $c) {
    $c.report_error(
      <emit>,
      "failed to write interface file",
      NULL, NULL);
  },

  "emit.static.switch" :
  macro Statement(Expr $c) {
    {
      String note = "place the declaration before the switch "
                  + "or within one case block";
      $c.report_error(
        <emit>, "switch cannot bypass dynamic static initialization",
        NULL, %($note));
    }
  },

  "macro.adapter.pointer" :
  macro Statement(Expr $c, Expr $type, Expr $origin) {
    $c.report_error(
      <macro>, "typed callback adapter target must name a function pointer",
      $origin, $type ? %("target type: ${$type.repr()}") : NULL);
  },
  "macro.adapter.typedef" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "typed callback adapter target must be a typedef name",
      $origin, NULL);
  },

  "macro.argument.constant" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "explicit meta call cannot be resolved",
      $site, %("an argument must be a constant, captured syntax, or a meta call"));
  },
  "macro.argument.contract" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "macro argument has no parsing contract",
      $c.token, NULL);
  },

  "macro.builtin.form" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "unexpected form in built-in macro source",
      $c.token, NULL);
  },

  "macro.call.binding" :
  macro Statement(Expr $c, Expr $site, Expr $name) {
    $c.report_error(
      <macro>,
      "explicit meta call cannot be resolved",
      $site, %("no binding for ${$name}"));
  },
  "macro.call.deferred" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "this meta call is left for the translation",
      $site, NULL);
  },
  "macro.call.depth" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "explicit meta call was stopped",
      $site, %("reason: its compile-time form nested too deep"));
  },
  "macro.call.target" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <macro>,
      "explicit meta call cannot be resolved",
      $site, %("only a call to a meta function runs at compile time"));
  },

  "macro.decorator.expr" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"decorator '${$spelling}' requires a following expression",
      $origin, %(${$definition_note}));
  },
  "macro.decorator.position" :
  macro Statement(
    Expr $c, Expr $name, Expr $kind, Expr $origin) {
    $c.report_error(
      <macro>,
      %"decorator '${$name}' targets ${$kind} syntax and cannot be used here",
      $origin, NULL);
  },
  "macro.decorator.semicolon" :
  macro Statement(
    Expr $c, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, "decorator application must not end with ';'",
      $origin, %(${$definition_note}));
  },
  "macro.decorator.target" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"decorator '${$spelling}' requires a following target",
      $origin, %(${$definition_note}));
  },

  "macro.expansion.count" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "macro expansion count exceeds 10000",
      $origin, NULL);
  },
  "macro.expansion.depth" :
  macro Statement(
    Expr $c, Expr $origin, Expr $definition_note, Expr $first_note) {
    {
      String first_note = %"first expansion: ${$first_note}";
      $c.report_error(
        <macro>, "macro expansion depth exceeds 64", $origin,
        %(${$definition_note} $first_note));
    }
  },
  "macro.expansion.recursive" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin,
    Expr $definition_note, Expr $shown) {
    $c.report_error(
      <macro>, %"identical recursive expansion of '${$spelling}'",
      $origin, %(${$definition_note} "input: ${$shown.repr()}"));
  },

  "macro.function.install" :
  macro Statement(Expr $c, Expr $site, Expr $cause) {
    $c.report_error(
      <macro>,
      "this meta function could not be installed",
      $site, %("reason: ${$cause.repr()}"));
  },
  "macro.function.only" :
  macro Statement(Expr $c, Expr $site, Expr $name) {
    $c.report_error(
      <macro>,
      %"'${$name}' can only be called at compile time",
      $site, %("reason: it reaches a compiler operation, so no unit emits a"
      "definition for it; call it from a macro or another meta"
      "function"));
  },
  "macro.function.unavailable" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $why) {
    $c.report_error(
      <macro>,
      "this function cannot run at compile time",
      $site, %("function: ${$name}" "reason: ${$why}"));
  },

  "macro.helper.stopped" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $reason) {
    $c.report_error(
      <macro>,
      "this meta call stopped the compile-time helper",
      $site, %("function: ${$name}" "reason: ${$reason}"));
  },
  "macro.helper.timeout" :
  macro Statement(
    Expr $c, Expr $site, Expr $limit, Expr $name) {
    $c.report_error(
      <macro>,
      "%s%g s".printf("this meta call ran longer than ", $limit),
      $site, %("function: ${$name}" "set X2C_META_TIMEOUT to a larger limit in seconds, or 0 for none"));
  },

  "macro.import.collision" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"imported macro '${$spelling}' collides with a visible macro",
      $origin, %(${$definition_note}
        "import: ${$c.display_path($c.import_src)}"));
  },
  "macro.import.cycle" :
  macro Statement(Expr $c, Expr $path, Expr $origin) {
    {
      String display = $c.display_path($path);
      Array notes = [ %"import: $display" ];
      Array parents = $c.import_stack;
      for (int i = 0; i < parents.len(); i++) {
        Var parent = parents[i];
        notes.push(%"from: ${$c.display_path(parent)}");
      }
      $c.report_error(
        <macro>, "compile-time import cycle", $origin, notes.list_free());
    }
  },
  "macro.import.extension" :
  macro Statement(
    Expr $c, Expr $origin, Expr $path_note) {
    $c.report_error(
      <macro>, "compile-time import requires .xlisp or .xmacro",
      $origin, $path_note);
  },
  "macro.import.form" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "unexpected form in macro import",
      $c.token, NULL);
  },

  "macro.keyword.builtin" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "built-in keyword alias cannot be replaced",
      $origin, NULL);
  },
  "macro.keyword.internal" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $definition_note) {
    $c.report_error(
      <macro>, %"keyword alias cannot name internal macro kind '${$spelling}'",
      $origin, %(${$definition_note}));
  },

  "macro.lisp.expr" :
  macro Statement(Expr $c, Expr $origin, Expr $value) {
    $c.report_error(
      <macro>, "compile-time Lisp result cannot fill an expression slot",
      $origin, %( "value:" ${$value.repr()} ));
  },
  "macro.lisp.failed" :
  macro Statement(
    Expr $c, Expr $origin, Expr $source, Expr $error) {
    {
      String form_note = %"form: ${$source}",
        error_note = %"error: ${$error.repr()}";
      $c.report_error(
        <macro>, "compile-time Lisp evaluation failed", $origin,
        %($form_note $error_note));
    }
  },

  "macro.local.result" :
  macro Statement(
    Expr $c, Expr $result_spelling, Expr $origin) {
    $c.report_error(
      <macro>, %"local macros cannot have ${$result_spelling} results",
      $origin, NULL);
  },
  "macro.local.target" :
  macro Statement(Expr $c, Expr $target, Expr $origin) {
    $c.report_error(
      <macro>, %"local decorators cannot target ${$target} syntax",
      $origin, NULL);
  },

  "macro.name.with" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <macro>, "'with' cannot be a local macro name",
      $origin, NULL);
  },

  "macro.protocol.invalid" :
  macro Statement(Expr $c) {
    $c.report_error(
      <macro>, "constructed protocol syntax is invalid",
      $c.token, NULL);
  },

  "macro.result.expr" :
  macro Statement(
    Expr $c, Expr $kind, Expr $spelling, Expr $origin, Expr $definition_note) {
    {
      String subject = $kind == <decorator>
        ? %"decorator '${$spelling}'"
        : %"macro '${$spelling}'";
      $c.report_error(
        <macro>, %"$subject cannot be invoked in an expression", $origin,
        $kind == <decorator> ? %(${$definition_note}) : NULL);
    }
  },
  "macro.result.position" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $result,
    Expr $description, Expr $origin) {
    {
      String message =
        %"macro '${$spelling}' has result kind ${$result} and cannot be " +
        %"invoked at ${$description}";
      $c.report_error(<macro>, message, $origin, NULL);
    }
  },

  "parse.alias.body" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias declaration cannot have a body",
      $c.token, NULL);
  },
  "parse.alias.identifier" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias native target must be a direct identifier",
      $c.token, NULL);
  },
  "parse.alias.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected an alias identifier after 'as'",
      $c.token, NULL);
  },
  "parse.alias.self" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias cannot name itself",
      $c.token, NULL);
  },
  "parse.alias.storage" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias has invalid storage class",
      $c.token, %("allowed storage: static or inline"));
  },
  "parse.alias.target" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias target must be one direct function declaration",
      $c.token, NULL);
  },
  "parse.alias.variadic" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "foreign alias cannot be variadic",
      $c.token, NULL);
  },

  "parse.atom.expected" :
  macro Statement(Expr $c, Expr $kind) {
    $c.report_error(
      <parse>, "expected atomic expression",
      $c.token, %( "token:" ${$c.token.text} "kind:" ${$kind.str()} ));
  },

  "parse.attribute.packed" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "packed attributes are unsupported",
      $origin, NULL);
  },

  "parse.binder.name" :
  macro Statement(Expr $c, Expr $atom) {
    $c.report_error(
      <parse>, "invalid match binder name",
      $c.token, %( "binder-name:" ${$atom.str()} ));
  },

  "parse.body.expected" :
  macro Statement(Expr $c, Expr $unexpected) {
    $c.report_error(
      <parse>, "expected ';', '{', or '=>'",
      $c.token, %("token:" ${$c.token.text} "symbol:" ${$unexpected.str()}));
  },

  "parse.brace.missing" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <parse>,
      "missing '}'",
      $site, %( "'{' opened here" ));
  },
  "parse.brace.unexpected" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <parse>,
      "unexpected '}'",
      $site, %("encountered '}' without matching '{'"));
  },

  "parse.catch.default" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "catch default arm must be last",
      $c.token, %("move catch: after every filtered arm"));
  },
  "parse.catch.detail" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "catch filter detail must be '*' or '(key pattern)'",
      $origin, %("wrap keyed detail patterns in parentheses"));
  },
  "parse.catch.pattern" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "catch filter requires a %() pattern literal",
      $c.token, %("use catch %(code (key pattern)...):"));
  },

  "parse.decl.bound" :
  macro Statement(Expr $c, Expr $exact) {
    $c.report_error(
      <parse>, %"declaration '${$exact}' is already bound",
      $c.token, %("prior binding: '${$exact}'"));
  },
  "parse.decl.function" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "Decl macro argument cannot be a function declaration",
      $c.token, NULL);
  },
  "parse.decl.typedef" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "Decl macro argument cannot be a typedef",
      $c.token, NULL);
  },

  "parse.decorator.kind" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "decorator first parameter has invalid target kind",
      $origin, %("expected Expression, Function, Statement, Block, Field,"
        "Unit, or NamedType"));
  },
  "parse.decorator.singular" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "decorator target parameter must be singular",
      $origin, NULL);
  },
  "parse.decorator.target" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "decorator requires a first target parameter",
      $origin, NULL);
  },
  "parse.decorator.top" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "top-level decorators are not supported",
      $c.token, %( "module initialization: void TYPE.initialize(void)" ));
  },

  "parse.delegate.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "delegate field requires a name",
      $c.token, NULL);
  },

  "parse.destructure.init" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "destructuring declaration requires an initializer",
      $c.token, NULL);
  },
  "parse.destructure.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected identifier in destructuring declaration",
      $c.token, %("destructuring targets must be simple identifiers"));
  },
  "parse.destructure.target" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "unsupported destructuring assignment target",
      $c.token, %("destructuring targets must be simple identifiers"));
  },

  "parse.dimension.close" :
  macro Statement(
    Expr $c, Expr $expr, Expr $unexpected) {
    $c.report_error(
      <parse>, "expected ']'",
      $c.token, %("dimension:" ${$expr.str()} "symbol:" ${$unexpected.str()}));
  },

  "parse.enum.bound" :
  macro Statement(Expr $c, Expr $spelling, Expr $origin) {
    $c.report_error(
      <parse>, %"enumerator '${$spelling}' is already bound in this scope",
      $origin, %("prior binding: '${$spelling}'"));
  },
  "parse.enum.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected enumerator identifier",
      $c.token, NULL);
  },

  "parse.function.body" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "Function macro argument requires a function body",
      $c.token, NULL);
  },
  "parse.function.row" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "a function definition cannot share a declaration row",
      $c.token, NULL);
  },

  "parse.hole.ambiguous" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin, Expr $first, Expr $also) {
    $c.report_error(
      <parse>, %"macro hole '${$spelling}' has ambiguous kind",
      $origin, %("first: ${$first}"
        "also: ${$also}"));
  },
  "parse.hole.cardinality" :
  macro Statement(
    Expr $c, Expr $sequence, Expr $spelling, Expr $origin) {
    {
      String message = $sequence
        ? %"singular macro hole '${$spelling}' cannot be spliced"
        : %"sequence macro hole '${$spelling}' requires '...'";
      $c.report_error(<parse>, message, $origin, NULL);
    }
  },
  "parse.hole.duplicate" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin) {
    $c.report_error(
      <parse>, %"duplicate macro hole '${$spelling}'",
      $origin, NULL);
  },
  "parse.hole.final" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "sequence macro hole must be the final argument",
      $c.token, NULL);
  },
  "parse.hole.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected macro hole name after '$'",
      $c.token, NULL);
  },
  "parse.hole.unknown-kind" :
  macro Statement(Expr $c, Expr $spelling) {
    $c.report_error(
      <parse>, %"unknown macro hole kind '${$spelling}'",
      $c.token, NULL);
  },
  "parse.hole.untyped" :
  macro Statement(
    Expr $c, Expr $hole_spelling, Expr $origin) {
    $c.report_error(
      <parse>, %"macro hole '${$hole_spelling}' has no inferred kind",
      $origin, %("annotate holes used only by compile-time Lisp"));
  },

  "parse.import.local" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected a local name after 'as'",
      $c.token, NULL);
  },
  "parse.import.member" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected a package member name after 'with'",
      $c.token, NULL);
  },
  "parse.import.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected a quoted package name after 'import'",
      $c.token, NULL);
  },

  "parse.index.unsupported" :
  macro Statement(
    Expr $c, Expr $receiver_type, Expr $origin) {
    $c.report_error(
      <parse>, $receiver_type.is_typedef_name()
      ? %"type ${$receiver_type} does not support getindex"
      : %"type ${$receiver_type} does not support indexing",
      $origin, %());
  },

  "parse.init.duplicate" :
  macro Statement(Expr $c, Expr $name) {
    $c.report_error(
      <parse>, "translation unit has more than one type initializer",
      $c.token, %( "initializer:" ${$name} ));
  },
  "parse.init.incomplete" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>,
      "managed initializer requires a complete block-local initializer",
      NULL, NULL);
  },

  "parse.insert.name" :
  macro Statement(Expr $c, Expr $sigil) {
    {
      String message = %"expected identifier after '${$sigil}'";
      String hint = $sigil == <@>
        ? "use '@{...}' to splice an expression"
        : "use '${...}' to insert an expression";
      $c.report_error(<parse>, message, $c.token, %($hint));
    }
  },

  "parse.is.pointer" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "pointer type after 'is' must be parenthesized",
      $origin, %("write value is (T *)"));
  },

  "parse.keyword.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "keyword alias requires an identifier",
      $c.token, NULL);
  },

  "parse.lifecycle.signature" :
  macro Statement(
    Expr $c, Expr $role, Expr $name) {
    {
      String message = $role == "initializer"
        ? "type initializer must have signature void TYPE.initialize(void)"
        : "type shutdown must have signature void TYPE.shutdown(void)";
      $c.report_error(<parse>, message, $c.token, %("${$role}: ${$name}"));
    }
  },

  "parse.lisp.unclosed" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "unterminated compile-time Lisp form",
      $origin, NULL);
  },

  "parse.macro.braced-body" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "braced macro body requires Statement, Block, Field, Entry, " +
    "Enumerator, Unit, or non-Expression Decorator result",
      $c.token, NULL);
  },
  "parse.macro.extra-args" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro invocation has too many arguments",
      $c.token, NULL);
  },
  "parse.macro.kind" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected macro result kind before '$'",
      $c.token, NULL);
  },
  "parse.macro.kind-order" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro result kind belongs after 'macro', before the '$' name",
      $c.token, NULL);
  },
  "parse.macro.member" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro method declaration requires a member name",
      $c.token, NULL);
  },
  "parse.macro.missing-args" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro invocation has too few arguments",
      $c.token, NULL);
  },
  "parse.macro.name" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, $c.peek(1) == <ident>
        ? "expected macro name component after '.'"
        : "expected macro name after '$'",
      $origin, NULL);
  },
  "parse.macro.paren-body" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "parenthesized macro body requires Expression result or target",
      $c.token, NULL);
  },
  "parse.macro.reserved" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin) {
    $c.report_error(
      <parse>, %"macro name '${$spelling}' is reserved",
      $origin, %("x2c.* is reserved for compiler facilities"));
  },
  "parse.macro.result" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "macro definition requires a result kind before '$'",
      $c.token, %("write the result kind between 'macro' and the macro name"));
  },
  "parse.macro.unbound" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin) {
    $c.report_error(
      <parse>, %"unknown or forward-referenced macro '${$spelling}'",
      $origin, NULL);
  },
  "parse.macro.unknown-kind" :
  macro Statement(
    Expr $c, Expr $spelling, Expr $origin) {
    $c.report_error(
      <parse>, %"unknown macro result kind '${$spelling}'",
      $origin, NULL);
  },

  "parse.managed.storage" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "managed initializer requires automatic local storage",
      $origin, NULL);
  },

  "parse.map.entry" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(<parse>, "expected one Map entry", $origin, NULL);
  },

  "parse.match.arm" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected 'case' or 'default' in match statement",
      $c.token, %( "token:" ${$c.token.text} ));
  },
  "parse.match.default" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "match default arm must be last",
      $c.token, %("move default after every case arm"));
  },
  "parse.match.pattern" :
  macro Statement(
    Expr $c, Expr $origin, Expr $pattern) {
    $c.report_error(
      <parse>, "match case pattern must be a %() list literal",
      $origin, %( "pattern:" ${$pattern.repr()} ));
  },

  "parse.member.ident" :
  macro Statement(Expr $c, Expr $op, Expr $lhs) {
    {
      List notes = %("token:" ${$c.token.text});
      if ($lhs) notes = cons(%("lhs expr:" ${$lhs.str()}), notes);
      String msg = %"expected identifier after '${$op}'";
      $c.report_error(<parse>, msg, $c.token, notes);
    }
  },

  "parse.meta.constructed" :
  macro Statement(
    Expr $c, Expr $name, Expr $origin) {
    $c.report_error(
      <parse>, %"meta function '${$name}' cannot be produced by a macro",
      $origin, %( "move it to a source file and call it from the macro" ));
  },
  "parse.meta.decl" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <parse>,
      "meta requires a function or one initialized static value",
      $site, NULL);
  },
  "parse.meta.function" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "a native meta declaration must be a function",
      $origin, NULL);
  },
  "parse.meta.name" :
  macro Statement(Expr $c, Expr $site) {
    $c.report_error(
      <parse>,
      "native meta function requires one direct name",
      $site, NULL);
  },
  "parse.meta.storage" :
  macro Statement(Expr $c, Expr $site, Expr $name) {
    $c.report_error(
      <parse>,
      "a meta value must have file-static storage",
      $site, %("declaration: '${$name}'"));
  },

  "parse.method.member" :
  macro Statement(Expr $c, Expr $owner) {
    $c.report_error(
      <parse>, "expected method name after dot",
      $c.token, %( "typedef:" ${$owner} "token:" ${$c.token.text}  ));
  },
  "parse.method.name" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected method name",
      $c.token, NULL);
  },

  "parse.name.identifier" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "Name macro argument requires an identifier",
      $c.token, NULL);
  },
