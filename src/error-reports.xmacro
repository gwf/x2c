    {
      String first = %"first: ${$first_location}";
      String second = %"second: ${$second_location}";
      $c.report_error(
        <protocol>, %"conflicting protocol declarations for ${$base.repr()}",
        $c.token, %($first $second));
    }
  },

  "protocol.managed.cleanup" :
  macro Statement(
    Expr $c, Expr $origin, Expr $type) {
    $c.report_error(
      <protocol>, "managed initializer requires Cleanup participation",
      $origin, %("type: ${$type.repr()}"));
  },

  "protocol.member.duplicate" :
  macro Statement(Expr $c, Expr $name) {
    $c.report_error(
      <protocol>, %"duplicate protocol member '${$name}'",
