  "type.is.array" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>, "array type cannot be used after operator 'is'",
      $origin, %("array types have no supported Var tag"));
  },
  "type.is.enum" :
  macro Statement(Expr $c, Expr $target, Expr $origin) {
    {
      String note =
        "enum values box as the shared i32 family and retain no enum identity";
      $c.report_error(
        <type>, %"enum type ${$target.repr()} cannot be tested with 'is'",
        $origin, %($note));
    }
  },
  "type.is.function" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>, "function type cannot be used after operator 'is'",
      $origin, %("function types have no supported Var tag"));
  },
  "type.is.selector" :
  macro Statement(Expr $c, Expr $type, Expr $origin) {
    $c.report_error(
      <type>, "operator 'is' requires a type or Symbol on the right",
      $origin, %("operand type: ${$type.repr()}"));
  },
  "type.is.tag" :
  macro Statement(Expr $c, Expr $target, Expr $origin) {
    $c.report_error(
      <type>,
      %"type ${$target.repr()} has no supported Var tag for operator 'is'",
      $origin, NULL);
  },
  "type.is.var" :
  macro Statement(Expr $c, Expr $type, Expr $origin) {
    $c.report_error(
      <type>, "operator 'is' requires Var on the left",
      $origin, %("operand type: ${$type.repr()}"));
  },

  "type.matmul.missing" :
  macro Statement(
    Expr $c, Expr $lhs_type, Expr $rhs_type, Expr $origin) {
    $c.report_error(
      <type>, "operator '@' requires an implemented matmul member",
      $origin,
      %("left type: ${$lhs_type.repr()} right type: ${$rhs_type.repr()}"));
  },

  "type.meta.lifetime" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $signature) {
    $c.report_error(
      <type>,
      "unproved native meta lifetime",
      $site, %("name: ${$name}" "signature: ${$signature.repr()}"
      "it might return or keep its argument; ownership cannot be inferred"));
  },
  "type.meta.signature" :
  macro Statement(Expr $c, Expr $site, Expr $n) {
    $c.report_error(
      <type>,
      "native meta function declaration does not match its target",
      $site, %("name: ${$n.name}" "signature: ${$n.signature.repr()}"));
  },

  "type.method.arity" :
  macro Statement(
    Expr $c, Expr $parameters, Expr $arguments, Expr $origin) {
    $c.report_error(
      <type>, %"method takes ${List.len($parameters) - 1} argument${
            List.len($parameters) == 2 ? "" : "s"}, not ${
            $arguments.len() - 1}",
      $origin, NULL);
  },
  "type.method.missing" :
  macro Statement(
    Expr $c, Expr $type, Expr $name, Expr $origin) {
    $c.report_error(
      <type>, %"type ${$type.repr()} has no method ${$name}",
      $origin, NULL);
  },
  "type.method.owner" :
  macro Statement(Expr $c) {
    $c.report_error(
      <type>, "method name has no concrete owner",
      $c.token, NULL);
  },
  "type.method.packages" :
  macro Statement(
    Expr $c, Expr $type, Expr $member, Expr $origin, Expr $notes) {
    $c.report_error(
      <type>,
      %"method '${$type}.${$member}' is provided by multiple imported packages",
      $origin, $notes);
  },

  "type.neg.unsupported" :
  macro Statement(Expr $c, Expr $type, Expr $origin) {
    $c.report_error(
      <type>, "unary '-' requires a numeric type or implemented neg",
      $origin, %("operand type: ${$type.repr()}"));
  },

  "type.number.range" :
  macro Statement(Expr $c, Expr $text) {
    $c.report_error(
      <type>, "numeric literal is outside the supported scalar range",
      $c.token, %( "literal:" ${$text} ));
  },

  "type.operand.untyped" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>, "operand has no x2c type beside a protocol participant",
      $origin,
      %("a preprocessor macro has no type here: cast it, or bind its value to a local"));
  },

  "type.optional-ref.access" :
  macro Statement(Expr $c) {
    $c.report_error(
      <type>, "check optional reference before accessing its value",
      $c.token, NULL);
  },
  "type.optional-ref.assign" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>, "check optional reference before assigning its value",
      $origin, NULL);
  },
  "type.optional-ref.index" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>, "check optional reference before indexing its value",
      $origin, NULL);
  },
  "type.optional-ref.unchecked" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>, "check optional reference before using its value",
      $origin, NULL);
  },

  "type.pointer.address" :
  macro Statement(Expr $c, Expr $type, Expr $target) {
    $c.report_error(
      <type>,
      %"cannot pass ${$type.repr()} where ${$target.repr()} is expected",
      NULL, %("write &value to pass its address"));
  },
  "type.pointer.integer" :
  macro Statement(
    Expr $c, Expr $integer, Expr $target) {
    {
      String message =
        %"cannot convert the integer ${$integer} to pointer type ${$target.repr()}";
      List hint =
        %( "only a zero integer constant expression converts to a pointer" );
      $c.report_error(<type>, message, NULL, hint);
    }
  },
  "type.pointer.unrelated" :
  macro Statement(
    Expr $c, Expr $source, Expr $target) {
    {
      String message =
        %"cannot convert ${$source.repr()} to ${$target.repr()}";
      $c.report_error(
        <type>, message,
        NULL,
        %("the pointer types are unrelated: cast the expression to say so on purpose"));
    }
  },

  "type.qualifier.dropped" :
  macro Statement(
    Expr $c, Expr $source, Expr $destination) {
    {
      String message =
        %"cannot convert ${$source.repr()} to ${$destination.repr()}";
      $c.report_error(
        <type>, message,
        NULL,
        %("the target drops a type qualifier the source declares: spell the qualifier in the target, or copy the value"));
    }
  },

  "type.receiver.address" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>, "method pointer receiver requires an addressable value",
      $origin, %("bind the value to an object before calling the method"));
  },
  "type.receiver.pointer" :
  macro Statement(
    Expr $c, Expr $type, Expr $declared, Expr $origin) {
    $c.report_error(
      <type>,
      %"method receiver ${$type.repr()} is a pointer to ${$declared.repr()}",
      $origin, %("'.' reaches one pointer level; write (*receiver).method()"));
  },

  "type.ref.address" :
  macro Statement(Expr $c) {
    $c.report_error(
      <type>, "reference argument must name an addressable object",
      NULL, NULL);
  },
  "type.ref.lvalue" :
  macro Statement(Expr $c, Expr $type, Expr $target) {
    $c.report_error(
      <type>,
      %"cannot pass ${$type.repr()} where ${$target.repr()} is expected",
      NULL,
      %("pass an lvalue of the referenced type; write *p for a pointer"));
  },
  "type.ref.null" :
  macro Statement(Expr $c, Expr $target) {
    $c.report_error(
      <type>,
      %"cannot pass a null pointer where ${$target.repr()} is expected",
      NULL, %("a reference argument must name an object"));
  },

  "type.scalar.invalid" :
  macro Statement(Expr $c, Expr $source, Expr $origin) {
    $c.report_error(
      <type>, $source ? %"invalid scalar type ${$source}"
                   : "expected scalar type",
      $origin, NULL);
  },

  "type.script.local" :
  macro Statement(Expr $c, Expr $name) {
    $c.report_error(
      <type>,
      %"'${$name}' is declared among the script's statements",
      NULL, %("functions cannot see those locals;"
      "declare it static to share it"));
  },

  "type.typedef.crossing" :
  macro Statement(
    Expr $c, Expr $source, Expr $target) {
    {
      String message =
        %"cannot convert ${$source.repr()} to ${$target.repr()}";
      $c.report_error(
        <type>, message,
        NULL,
        %("the names share one C type but not one meaning: declare the converter ${$source.car()}_${$target.car().str().lower()}, or cast the expression to say so on purpose"));
    }
  },
  "type.typedef.depth" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <type>,
      %"typedef chain too deep (possible cycle) resolving ${$origin.repr()}",
      NULL, NULL);
  },

  "type.var.address" :
  macro Statement(Expr $c, Expr $target) {
    $c.report_error(
      <type>, %"cannot convert Var to ${$target.repr()}",
      NULL,
      %("write &value for its address, or value.pointer() to unbox a stored pointer"));
  },
  "type.var.convert" :
  macro Statement(Expr $c, Expr $target) {
    {
      String message = %"cannot convert Var to type ${$target.repr()}";
      $c.report_error(<type>, message, NULL, NULL);
    }
  },
  "type.var.loss" :
  macro Statement(Expr $c, Expr $type) {
    {
      String message = %"cannot convert ${$type.repr()} to Var without loss";
      $c.report_error(<type>, message, NULL, NULL);
    }
  },
  "type.var.unresolved" :
  macro Statement(Expr $c) {
    {
      String message = "cannot convert an unresolved expression to Var";
      $c.report_error(
        <type>, message,
        NULL, %("give the expression a declared x2c type before boxing it"));
    }
  },

  "xform.compound.bitfield" :
  macro Statement(Expr $c) {
    $c.report_error(
      <xform>, "dynamic compound assignment cannot target a bitfield",
      NULL, NULL);
  },
  "xform.compound.enum" :
  macro Statement(Expr $c) {
    $c.report_error(
      <xform>, "dynamic compound assignment cannot target an enum",
      NULL, NULL);
  },
  "xform.compound.lvalue" :
  macro Statement(Expr $c, Expr $lhs_type) {
    {
      String details = %"left type: ${$lhs_type.repr()}";
      $c.report_error(
        <xform>, "dynamic compound assignment requires a numeric lvalue",
        NULL, %($details));
    }
  },
  "xform.compound.operand" :
  macro Statement(
    Expr $c, Expr $op, Expr $rhs_type) {
    {
      String details = %"right type: ${$rhs_type.repr()}";
      $c.report_error(
        <xform>, $op == <+>
          ? "dynamic += requires a numeric, Var, or String operand"
          : "dynamic compound assignment requires a numeric or Var operand",
        NULL, %($details));
    }
  },

  "xform.container.compound" :
  macro Statement(Expr $c, Expr $lhs_type) {
    {
      String type = $lhs_type.repr();
      $c.report_error(
        <xform>, %"container type $type does not support compound assignment",
        NULL, %("update an indexed element instead"));
    }
  },

  "xform.index.assignment" :
  macro Statement(Expr $c, Expr $type) {
    $c.report_error(
      <xform>, %"type ${$type} does not support bracket assignment",
      NULL, NULL);
  },
  "xform.index.copy" :
  macro Statement(Expr $c, Expr $type) {
    $c.report_error(
      <xform>, %"type ${$type} does not support bracket assignment",
      NULL, %("use an explicit copy-producing method where available"));
  },
  "xform.index.operand" :
  macro Statement(Expr $c, Expr $op, Expr $rhs_type) {
    {
      String details = %"right type: ${$rhs_type.repr()}";
      String message = $op == <+>
        ? "indexed += requires a numeric, Var, or String operand"
        : "indexed compound assignment requires a numeric or Var operand";
      $c.report_error(<xform>, message, NULL, %($details));
    }
  },
  "xform.index.unsupported" :
  macro Statement(Expr $c, Expr $type) {
    $c.report_error(
      <xform>, %"type ${$type} does not support bracket indexing",
      NULL, NULL);
  },
  "xform.index.update" :
  macro Statement(
    Expr $c, Expr $base_type, Expr $postfix) {
    {
      String type = $base_type.repr();
      String message = $postfix
        ? %"type $type does not support indexed increment or decrement"
        : %"type $type does not support indexed compound assignment";
      $c.report_error(<xform>, message, NULL, NULL);
    }
  },

  "xform.numeric.operands" :
  macro Statement(
    Expr $c, Expr $op, Expr $lhs_type, Expr $rhs_type) {
    {
      String left_type = $lhs_type.repr(), right_type = $rhs_type.repr();
      String details =
        %"operator: ${$op} left type: $left_type right type: $right_type";
      $c.report_error(
        <xform>, "dynamic numeric operators require numeric operands",
        NULL, %($details));
    }
  },

  "xform.slice.assignment" :
  macro Statement(Expr $c) {
    $c.report_error(
      <xform>, "slice expressions are not assignable",
      NULL, %("call the collection's setslice method explicitly"));
  },
  "xform.slice.unsupported" :
  macro Statement(
    Expr $c, Expr $type, Expr $notes) {
    $c.report_error(
      <xform>, %"type ${$type} does not support slicing",
      NULL, $notes);
  },

  "xform.string.assignment" :
  macro Statement(Expr $c) {
    {
      String note = "String is immutable: use the copy-producing " +
                    "String.withindex, or bind a char * to write a " +
                    "transient String.malloc buffer";
      $c.report_error(
        <xform>, "String does not support bracket assignment",
        NULL, %($note));
    }
  },
  "xform.string.compound" :
  macro Statement(Expr $c) {
    $c.report_error(
      <xform>, "String compound assignment supports only String +=",
      NULL, NULL);
  },

  "xform.unary.dynamic" :
  macro Statement(Expr $c) {
    $c.report_error(
      <xform>, "dynamic unary numeric operators are not supported",
      NULL, %("use Var.binary with an explicit numeric operand"));
  }
};

meta static List _error_report_expand(
  List compiler, String key, List arguments) {
  Map rows = _error_report_rows;
  Var value = rows[key];
  if (value is void)
    x2c_diagnostic_fail(%"unknown error report '$key'", %());
  Macro selected = value;
  if (arguments.len() + 1 != selected.assoc(<parameters>).list().len())
    x2c_diagnostic_fail(%"wrong argument count for error report '$key'", %());
  return %(${Macro_apply(selected, %($compiler @arguments))});
}

macro Statement $report(Expr $compiler, Literal $key, Expr $arguments...) {
  $(_error_report_expand $compiler (x2c.literal.value $key) $arguments)...
}
