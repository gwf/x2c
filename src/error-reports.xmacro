  },
  "protocol.member.function" :
  macro Statement(Expr $c, Expr $name) {
    $c.report_error(
      <protocol>, "protocol member must be a function",
      $c.token, %("member:" ${$name}));
  },
  "protocol.member.owner" :
  macro Statement(Expr $c, Expr $participant) {
    $c.report_error(
      <protocol>, "protocol member must be owned by its participant",
