  },

  "parse.statement.single" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected one statement",
      $c.token, NULL);
  },

  "parse.static.dependency" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $target) {
    $c.report_error(
      <parse>,
      %"file-static x2c initializer depends on non-static '${$name}'",
      $site, $target ? %("initializer: ${$target}") : NULL);
  },

  "parse.string.segment" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected string segment",
      $c.token, NULL);
  },

  "parse.symbol.bare" :
  macro Statement(
    Expr $c, Expr $owner, Expr $detail, Expr $origin) {
    {
      String label = $owner == <raise> ? "raise" : "catch filter";
      String role = $detail ? "detail key" : "code";
      String hint = $owner == <raise>
        ? "use raise %(code (key value)...);"
        : "use catch %(code (key pattern)...):";
      $c.report_error(
        <parse>, %"$label $role must be a bare Symbol", $origin, %($hint));
    }
  },
  "parse.symbol.duplicate" :
  macro Statement(
    Expr $c, Expr $origin, Expr $symbol) {
    $c.report_error(
      <parse>, "duplicate Symbol in symbol set",
      $origin, %("symbol:" ${$symbol.repr()}));
  },
  "parse.symbol.literal" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "symbol-set entries must be literal Symbols",
      $origin, %("use %<<foo bar>>"));
  },
  "parse.symbol.truncated" :
  macro Statement(
    Expr $c, Expr $origin, Expr $spelling, Expr $lossy) {
    $c.report_error(
      <parse>, "Symbol literal does not round-trip",
      $origin, %("source spelling: ${$spelling}"
        "encoded spelling: ${$lossy}"));
  },

  "parse.syntax.expected" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected syntax",
      $c.token, NULL);
