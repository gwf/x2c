  macro Statement(
    Expr $c, Expr $site, Expr $kind, Expr $local) {
    $c.report_error(
      <parse>,
      %"package ${$kind} '${$local}' collides with a declared name",
      $site, NULL);
  },
  "parse.package.identifier" :
  macro Statement(Expr $c, Expr $origin) {
    $c.report_error(
      <parse>, "package name must be a C identifier",
      $origin, NULL);
  },
  "parse.package.member" :
  macro Statement(
    Expr $c, Expr $site, Expr $name, Expr $member) {
    $c.report_error(
      <parse>,
      %"package '${$name}' has no public name '${$member}'",
      $site, NULL);
  },

  "parse.param.ident" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "expected identifier in parameter list",
      $c.token, NULL);
  },

  "parse.params.close" :
  macro Statement(
    Expr $c, Expr $params, Expr $unexpected) {
    $c.report_error(
      <parse>, "expected ')'",
      $c.token, %("parameters:" ${$params.str()}
        "symbol:" ${$unexpected.str()}));
  },
  "parse.params.empty" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "empty parameter list; use (void)",
      $c.token, NULL);
  },

  "parse.paren.unclosed" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "missing closing parenthesis",
      $c.token, NULL);
  },

  "parse.raise.payload" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>, "raise requires a %() payload literal",
      $c.token, %("use raise %(code (key value)...);"));
  },

  "parse.script.main" :
  macro Statement(Expr $c) {
    $c.report_error(
      <parse>,
      "a script that defines main cannot have top-level statements",
      $c.token, %("move the statement into main, or remove main so the statements run"));
  },

  "parse.shutdown.duplicate" :
  macro Statement(Expr $c, Expr $name) {
    $c.report_error(
      <parse>, "translation unit has more than one type shutdown",
