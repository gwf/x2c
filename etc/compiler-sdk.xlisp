// x2c compile-time Lisp SDK
(defun _x2c.fail (message value) (x2c.diagnostic.fail
  message (list (string-append "value: " (repr value)))))

// The Lisp boundary retains its argument checks around the shared bodies.
(defun x2c.literal.string (value) (if (string? value)
  (x2c_literal_string value)
  (_x2c.fail "x2c.literal.string requires a String" value)))
(defun x2c.literal.int (value) (if (number? value)
  (x2c_literal_int value)
  (_x2c.fail "x2c.literal.int requires a number" value)))
(defun x2c.literal.symbol (value) (if (symbol? value)
  (x2c_literal_symbol value)
  (_x2c.fail "x2c.literal.symbol requires a Symbol" value)))

// The x2c spelling takes its arguments as one List; the Lisp one spreads them.
(defun x2c.expr.call (callee . arguments) (x2c_expr_call callee arguments))
