// Native Lisp binding entry points. The algorithms are compiler functions
// (src/builtins.x) under `_x2c.binding_*`; state starts at macro installation.

(defun lisp.native.call (name . arguments)
  (_x2c.binding_call name arguments))
(def lisp.binding.name _x2c.binding_name)
(defun lisp.binding.rows-for (group)
  (_x2c.binding_rows_for group lisp.binding.rows))
(defun lisp.binding.record (group name function)
  (begin
    (def lisp.binding.rows
      (_x2c.binding_record group name function lisp.binding.rows
                           lisp.binding.sealed))
    nil))
(def lisp.binding.call _x2c.binding_statement)
(defun lisp.binding.install (lisp group)
  (let* ((group-name (x2c.binding.spelling group))
         (rows (_x2c.binding_install_rows group-name lisp.binding.rows)))
    (begin
      (if (member group-name lisp.binding.sealed) nil
        (def lisp.binding.sealed (cons group-name lisp.binding.sealed)))
      (_x2c.binding_statements lisp rows))))
(def lisp.native._target _x2c.binding_target)
(def lisp.native.target _x2c.binding_target_row)
(def lisp.native.targets _x2c.binding_targets)

// Compiler-backed meta methods share the same native target boundary.
(defun lisp.compiler.target? (row)
  (or (not (eq? (String.startswith (car row) "x2c_") 0))
      (eq? (car row) "Type_is_named")
      (eq? (car row) "Type_numeric")
      (eq? (car row) "Type_is_text")
      (eq? (car row) "Type_protocol_member")
      (eq? (car row) "Type_aggregate")
      (eq? (car row) "Type_marked_fields")
      (eq? (car row) "Type_resolve_member")
      (eq? (car row) "Code_type")
      (eq? (car row) "Code_value")
      (eq? (car row) "Code_exits")
      (eq? (car row) "Code_is_static_pattern")
      (eq? (car row) "Code_convert")
      (eq? (car row) "Code_format")
      (eq? (car row) "Code_register_rewrite")
      (eq? (car row) "Code_register_marked_rewrite")
      (eq? (car row) "Code_register_after_initialization")))
