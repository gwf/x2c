// Native Lisp binding entry points. The algorithms are compiler functions
// (src/builtins.x) under `_x2c.binding_*`.

(def lisp.native.targets _x2c.binding_targets)

// The compiler supplies the bodyless `meta` prototypes of `lib/meta.x`: its
// `x2c_` functions and the methods of `Code` and `Type`.
(defun lisp.compiler.target? (row)
  (or (not (eq? (String.startswith (car row) "x2c_") 0))
      (not (eq? (String.startswith (car row) "Code_") 0))
      (not (eq? (String.startswith (car row) "Type_") 0))))
