// Compound selectors use raw slots so exhaustion keeps `void` distinct from
// `nil`. The source declarations remain in the optional list-selectors module.
(defun _selector_car (value)
  (if (= (Var.is_void value) 1) value (car value)))
(defun _selector_cdr (value)
  (if (= (Var.is_void value) 1) nil (cdr value)))
(defun _selector_caaaar (value)
  (_selector_car
    (_selector_car (_selector_car (_selector_car value)))))
(defun _selector_caaadr (value)
  (_selector_car
    (_selector_car (_selector_car (_selector_cdr value)))))
(defun _selector_caaar (value)
  (_selector_car
    (_selector_car (_selector_car value))))
(defun _selector_caadar (value)
  (_selector_car
    (_selector_car (_selector_cdr (_selector_car value)))))
(defun _selector_caaddr (value)
  (_selector_car
    (_selector_car (_selector_cdr (_selector_cdr value)))))
(defun _selector_caadr (value)
  (_selector_car
    (_selector_car (_selector_cdr value))))
(defun _selector_cadaar (value)
  (_selector_car
    (_selector_cdr (_selector_car (_selector_car value)))))
(defun _selector_cadadr (value)
  (_selector_car
    (_selector_cdr (_selector_car (_selector_cdr value)))))
(defun _selector_cadar (value)
  (_selector_car
    (_selector_cdr (_selector_car value))))
(defun _selector_caddar (value)
  (_selector_car
    (_selector_cdr (_selector_cdr (_selector_car value)))))
(defun _selector_cadddr (value)
  (_selector_car
    (_selector_cdr (_selector_cdr (_selector_cdr value)))))
(defun _selector_cdaaar (value)
  (_selector_cdr
    (_selector_car (_selector_car (_selector_car value)))))
(defun _selector_cdaadr (value)
  (_selector_cdr
    (_selector_car (_selector_car (_selector_cdr value)))))
(defun _selector_cdaar (value)
  (_selector_cdr
    (_selector_car (_selector_car value))))
(defun _selector_cdadar (value)
  (_selector_cdr
    (_selector_car (_selector_cdr (_selector_car value)))))
(defun _selector_cdaddr (value)
  (_selector_cdr
    (_selector_car (_selector_cdr (_selector_cdr value)))))
(defun _selector_cdadr (value)
  (_selector_cdr
    (_selector_car (_selector_cdr value))))
(defun _selector_cdar (value)
  (_selector_cdr
    (_selector_car value)))
(defun _selector_cddaar (value)
  (_selector_cdr
    (_selector_cdr (_selector_car (_selector_car value)))))
(defun _selector_cddadr (value)
  (_selector_cdr
    (_selector_cdr (_selector_car (_selector_cdr value)))))
(defun _selector_cddar (value)
  (_selector_cdr
    (_selector_cdr (_selector_car value))))
(defun _selector_cdddar (value)
  (_selector_cdr
    (_selector_cdr (_selector_cdr (_selector_car value)))))
(def List.caaaar _selector_caaaar)
(def List.caaadr _selector_caaadr)
(def List.caaar _selector_caaar)
(def List.caadar _selector_caadar)
(def List.caaddr _selector_caaddr)
(def List.caadr _selector_caadr)
(def List.cadaar _selector_cadaar)
(def List.cadadr _selector_cadadr)
(def List.cadar _selector_cadar)
(def List.caddar _selector_caddar)
(def List.cadddr _selector_cadddr)
(def List.cdaaar _selector_cdaaar)
(def List.cdaadr _selector_cdaadr)
