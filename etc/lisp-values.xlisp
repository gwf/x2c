(def String.add           (bind "String_add" nil))
(def String.lower         (bind "String_lower" nil))
(def String.strip (bind "lisp_string_strip" nil))
(def String.upper         (bind "String_upper" nil))
(def String.capitalize    (bind "String_capitalize" nil))
(def String.repeat        (bind "String_repeat" nil))
(def String.replace       (bind "String_replace" nil))
(def String.join          (bind "String_join" nil))
(def String.split         (bind "String_split" nil))
(def String.split_lines   (bind "String_split_lines" nil))
(def String.partition     (bind "String_partition" nil))
