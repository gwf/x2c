  Var.symbol Var.char Var.short Var.int Var.long Var.long_long Var.unsigned
  Var.ushort Var.uchar Var.uint Var.ulong Var.ulong_long Var.float Var.double
  Var.long_double Var.long_value Var.ulong_value Var.long_long_value
  Var.ulong_long_value Var.long_double_value Var.compare Var.contains
  Var.hash Var.same Var.is_atom Var.is_atom_binder Var.is_binder
  Var.is_list_binder Var.is_match_op Var.is_floating Var.is_integer
  Var.is_pointer Var.is_reference Var.is_object Var.is_wide Var.is_nil
  Var.add Var.sub Var.mul Var.div Var.mod Var.neg Var.truth Var.setindex
  Var.updateindex Var.postfixindex Var.listchar Var.listshort Var.listint
  Var.listfloat Var.listdbl Var.liststring Var.listsymbol Var.cdddr
  Var.cddddr Var.json Var.pretty_json Var.clone_wide Var.getindex Var.null)
(_natives Symbol.len Symbol.str Symbol.compare Symbol.first Symbol.last)
(def Symbol.new_len (bind "_lisp_symbol_new_len" nil))
(def Symbol.parse   (bind "_lisp_symbol_parse" nil))

// A compound selector `List.cxxr` or `Var.cxxr` applies the car and cdr
// steps its name spells, right to left. The steps read raw slots so
// exhaustion keeps `void` distinct from `nil`. The source declarations
// remain in the optional list-selectors module.
(defun _selector_car (value)
  (if (= (Var.is_void value) 1) value (car value)))
(defun _selector_cdr (value)
  (if (= (Var.is_void value) 1) nil (cdr value)))
(defun _selector_steps (spelling index last)
  (cond ((= index last) 'value)
        (true
          (cons (cond ((equal? (substring spelling index (+ index 1)) "a")
                       '_selector_car)
                      (true '_selector_cdr))
                (cons (_selector_steps spelling (+ index 1) last) nil)))))
(defmacro _selectors (. names)
  (cons 'begin
        (_list_map
          names
          (lambda (name)
            `(def ,name
               (lambda (value)
                 ,(_selector_steps
                    (str name)
                    (+ (String.find (str name) ".") 2)
                    (- (string-length (str name)) 1))))))))
(_selectors List.caaaar List.caaadr List.caaar List.caadar List.caaddr
  List.caadr List.cadaar List.cadadr List.cadar List.caddar List.cadddr
  List.cdaaar List.cdaadr List.cdaar List.cdadar List.cdaddr List.cdadr
  List.cdar List.cddaar List.cddadr List.cddar List.cdddar)
(_selectors Var.caaaar Var.caaadr Var.caaar Var.caadar Var.caaddr Var.caadr
  Var.cadaar Var.cadadr Var.cadar Var.caddar Var.cadddr Var.cdaaar
  Var.cdaadr Var.cdaar Var.cdadar Var.cdaddr Var.cdadr Var.cdar Var.cddaar
  Var.cddadr Var.cddar Var.cdddar)
