// x2c value operations for Lisp.
// Load etc/init.xlisp first. The compiler loads this layer into every
// compile-time Lisp session; an embedding program loads it by name.
//
// A Lisp value is an x2c Var: a Lisp list is a List, a Lisp string is a
// String, a quoted name is a Symbol. These names are the library's own
// operations over those types, so a macro and the program it generates
// compute with the same List, String, Map, and Array.
//
// The Lisp core keeps its own spellings for cons-cell and text work:
// `car`, `cdr`, `cons`, `length`, `reverse`, `string-append`, `substring`,
// `lower`, `str`, and `repr` are unchanged and reach the same code.

// List

(def List.getindex (bind "List_getindex" nil))
(def List.last     (bind "List_last" nil))
(def List.index    (bind "List_index" nil))
(def List.contains (bind "List_contains" nil))
(def List.assoc    (bind "List_assoc" nil))
(def List.get      (bind "List_get" nil))
(def List.array    (bind "List_array" nil))
(def List.sort     (bind "List_sort" nil))

// Array

(def Array.new       (bind "Array_new" nil))
(def Array.len       (bind "Array_len" nil))
(def Array.push      (bind "Array_push" nil))
(def Array.getindex  (bind "Array_getindex" nil))
(def Array.setindex  (bind "Array_setindex" nil))
(def Array.take_last (bind "Array_take_last" nil))
(def Array.shift     (bind "Array_shift" nil))
(def Array.unshift   (bind "Array_unshift" nil))
(def Array.insert    (bind "Array_insert" nil))
(def Array.remove    (bind "Array_remove" nil))
(def Array.find      (bind "Array_find" nil))
(def Array.contains  (bind "Array_contains" nil))
(def Array.count     (bind "Array_count" nil))
(def Array.join      (bind "Array_join" nil))
(def Array.list      (bind "Array_list" nil))
(defun Array.map (a fn) (List.array (map fn (Array.list a))))

