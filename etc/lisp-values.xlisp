(def Map.len        (bind "Map_len" nil))
(def Map.get        (bind "Map_get" nil))
(def Map.getindex   (bind "Map_getindex" nil))
(def Map.setindex   (bind "Map_setindex" nil))
(def Map.contains   (bind "Map_contains" nil))
(def Map.del        (bind "Map_del" nil))
(def Map.getdefault (bind "Map_getdefault" nil))
(def Map.setdefault (bind "Map_setdefault" nil))
(def Map.list       (bind "Map_list" nil))

