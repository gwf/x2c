// The runtime a compile-time x2c function calls once `src/comptime.x` has
// translated it to Lisp. Load etc/init.xlisp and etc/lisp-values.xlisp
// first; the compiler loads this into every compile-time Lisp session.
//
// A lowered function is ordinary Lisp: its locals are lambda parameters and
// its calls are direct. These are the few operations it still needs, plus
// the library names its calls resolve against.

// A value reaching a C scalar type carries that type's `Var` tag, so every
// later operation applies the usual arithmetic conversions the way C does.
// `Var.convert` is the conversion: integer narrowing keeps low bits,
// floating to integer truncates toward zero, and an integer widens.
(defun C.conv (v tag) (Var.convert v tag))

// C compares after the usual arithmetic conversions, which `_binary`'s
// arithmetic already performs, so the tag of a sum names the common type.
// The lowering emits this only where the two operand types differ.
(defun C.compare (a op b)
  (let ((tag (Var.tag (_binary a '+ b))))
    (_binary (C.conv a tag) op (C.conv b tag))))

// x2c truth: nil is false, a number is false at zero, a C pointer is false
// at the null address, and anything else is true. The zero reaches the
// value's own type first: `eq?` compares a `Var` by identity, so a `double`
// zero is not the `int` zero it was tested against.
(defun C.nonzero? (a) (not (eq? (C.compare a '!= 0) 0)))

(defun C.true? (a)
  (cond ((eq? a (C.void)) nil)
        ((null? a) nil)
        ((number? a) (C.nonzero? a))
        ((eq? (Var.kind a) 'pointer) (not (eq? (Var.truth a) 0)))
        (true true)))

(defun C.not (a) (if (C.true? a) 0 1))

// A value reaching `bool` is 0 or 1, and reads as the int C promotes it to.
(defun C.bool (a) (if (C.true? a) 1 0))

(defmacro C.and (a b) `(if (C.true? ,a) (if (C.true? ,b) 1 0) 0))
(defmacro C.or (a b) `(if (C.true? ,a) 1 (if (C.true? ,b) 1 0)))
(defmacro C.ternary (test a b) `(if (C.true? ,test) ,a ,b))

// An evaluator cell holds one raw Var, so terminal `void` never enters an
// ordinary collection.
(def C.void (bind "lisp_void" nil))
(def C.cell (bind "lisp_cell" nil))
// The same native retagger boxes a numeric Symbol code at that destination.
(def C.address (bind "lisp_address" nil))
(def C.load (bind "lisp_load" nil))
(def C.store (bind "lisp_store" nil))

// A C object whose address matters lives in native bytes, and its slot holds
// the pointer native code would box. The lowering supplies each layout,
// offset, and size; see `lisp_peek` in lib/lisp.x. A record reads as its
// own address, and assigning one copies into the bytes it already has.
(def C.bytes (bind "lisp_bytes" nil))
(def C.at (bind "lisp_at" nil))
(def C.copy (bind "lisp_copy" nil))
(def C.zero (bind "lisp_zero" nil))
(def C.peek (bind "lisp_peek" nil))
(def C.poke (bind "lisp_poke" nil))
(def C.record.result (bind "lisp_record_result" nil))
(def C.session-copy (bind "lisp_session_copy" nil))
(def C.source-function (bind "lisp_source_function" nil))

(defun C.new (size tag layout value)
  (let ((object (C.at (C.bytes size) 0 tag)))
    (begin (C.poke object 0 layout value) object)))

// `p[i]` through a pointer. A pointer can hold a local C array, which is an
// `Array`; any other pointer addresses native bytes, and element `i` is
// `size` bytes apart from the next, as in C.
(defun C.index (p i size layout)
  (if (eq? (type p) 'array) (Array.getindex p i)
      (C.peek p (* i size) layout)))
(defun C.index.set (p i size layout value)
  (if (eq? (type p) 'array) (Array.setindex p i value)
      (C.poke p (* i size) layout value)))

// File-scope state, keyed by binding id. A unit-level initializer is not
// part of the function, so an unwritten global reads as zero. The table
// belongs to one translation unit, so the session that translates the unit
// defines it rather than the shared library session. A record the table
// holds lives in session bytes of its own.

(defun C.gread (id)
  (if (eq? (Map.contains C._globals id) 0) 0
      (Map.getindex C._globals id)))

(defun C.gwrite (id value) (Map.setindex C._globals id value))
(defun C.grecord.write (id value size)
  (if (eq? (Map.contains C._globals id) 0)
      (C.gwrite id (C.session-copy value size))
      (C.copy (Map.getindex C._globals id) value size)))

// An advertised meta value is an object in session bytes, separate from
// compiler-only state, so its address is an ordinary typed pointer.
(defun C.mgdefine (id object) (Map.setindex C._meta_globals id object))
(defun C.mgaddress (id) (Map.getindex C._meta_globals id))

