// Absence stays `void`; the evaluator transports it outside ordinary Lists.
(def List_getindex List.getindex)
(defun List_caar (xs)
  (let ((head (List_getindex xs 0)))
    (if (eq? head (C.void)) head (List_getindex head 0))))
(defun List_cadr (xs) (List_getindex xs 1))
(defun List_caddr (xs) (List_getindex xs 2))
