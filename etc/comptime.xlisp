// The runtime a compile-time x2c function calls once `src/comptime.x` has
// translated it to Lisp. Load etc/init.xlisp and etc/lisp-values.xlisp
// first; the compiler loads this into every compile-time Lisp session.
//
// A lowered function is ordinary Lisp: its locals are lambda parameters and
// its calls are direct. These are the few operations it still needs, plus
// the library names its calls resolve against.

// A value reaching a C scalar type carries that type's `Var` tag, so every
// later operation applies the usual arithmetic conversions the way C does.
// `Var.convert` is the conversion: integer narrowing keeps low bits,
// floating to integer truncates toward zero, and an integer widens.
(defun C.conv (v tag) (Var.convert v tag))

// C compares after the usual arithmetic conversions, which `_binary`'s
// arithmetic already performs, so the tag of a sum names the common type.
// The lowering emits this only where the two operand types differ.
(defun C.compare (a op b)
  (let ((tag (Var.tag (_binary a '+ b))))
    (_binary (C.conv a tag) op (C.conv b tag))))

// x2c truth: nil is false, a number is false at zero, anything else true.
// The zero reaches the value's own type first: `eq?` compares a `Var` by
// identity, so a `double` zero is not the `int` zero it was tested against.
(defun C.nonzero? (a) (not (eq? (C.compare a '!= 0) 0)))

(defun C.true? (a)
  (cond ((null? a) nil)
        ((number? a) (C.nonzero? a))
        (true true)))

(defun C.not (a) (if (C.true? a) 0 1))

(defmacro C.and (a b) `(if (C.true? ,a) (if (C.true? ,b) 1 0) 0))
(defmacro C.or (a b) `(if (C.true? ,a) 1 (if (C.true? ,b) 1 0)))
(defmacro C.ternary (test a b) `(if (C.true? ,test) ,a ,b))

// A local whose address is taken lives in a one-slot Array, so a call can
// write through it the way an out-parameter does in C.
(defun C.cell (v) (let ((box (Array.new))) (begin (Array.push box v) box)))
(defun C.load (box) (Array.getindex box 0))
(defun C.store (box v) (Array.setindex box 0 v))

// File-scope state, keyed by binding id. A unit-level initializer is not
// part of the function, so an unwritten global reads as zero. The table
// belongs to one translation unit, so the session that translates the unit
// defines it rather than the shared library session.

(defun C.gread (id)
  (if (eq? (Map.contains C._globals id) 0) 0
      (Map.getindex C._globals id)))

(defun C.gwrite (id value) (Map.setindex C._globals id value))

// The library operations a lowered call resolves against, under the names
// the typed AST already uses.
(def List_cons cons)
(def List_cddr cddr)
(def List_str str)
(def List_repr repr)
(def List_len length)
(def List_reverse reverse)
(def List_index List.index)
// These return `void` for an absent element, which has no Lisp value, so
// each answers nil the way an absent Lisp lookup does.
// A negative index counts from the end, as `List.getindex` does.
(defun List_getindex (xs i)
  (let ((n (if (< i 0) (+ (length xs) i) i)))
    (cond ((< n 0) ())
          ((null? xs) ())
          ((eq? n 0) (car xs))
          (true (List_getindex (cdr xs) (- n 1))))))
(defun List_caar (xs) (List_getindex (List_getindex xs 0) 0))
(defun List_cadr (xs) (List_getindex xs 1))
(defun List_caddr (xs) (List_getindex xs 2))
(defun List_last (xs) (if (null? xs) () (car (reverse xs))))
(defun List_assoc (xs key) (let ((p (assoc key xs))) (if p (cadr p) ())))
// `List.get` routes an integer key to the index and every other key to the
// association. A key's kind decides that, so a float looks up an
// association the way it does at run time.
(defun List_get (xs key)
  (if (eq? (Var.kind key) (Var.kind 0))
      (List_getindex xs key)
      (List_assoc xs key)))
(def List_array List.array)
(def List_sort List.sort)
(def List_match match)
(def List_search search)
(defun List_equal (a b) (if (equal? a b) 1 0))
(defun List_contains (xs v) (if (member v xs) 1 0))
(defun List_map (xs fn) (map fn xs))
(defun List_filter (xs fn) (filter fn xs))

// `foreach` expands to a `try_next` loop over three cells: the container,
// an integer or List cursor, and one output per name. Each shim below
// answers the same shape its x2c operation does, and none of them reads
// past the end, where the container would answer `void`.
(defun List_try_next (xs cursor out)
  (let ((rest (C.load cursor)))
    (if (null? rest) 0
        (begin (C.store out (car rest)) (C.store cursor (cdr rest)) 1))))

(defun Array_try_next (a cursor out)
  (let ((i (C.load cursor)))
    (if (>= i (Array.len a)) 0
        (begin (C.store out (Array.getindex a i))
               (C.store cursor (+ i 1))
               1))))

// A `Map` has no positional cursor, so the entries `Map.list` answers are
// walked as a List. The x2c cursor starts at the integer zero, which is how
// the first call tells a fresh walk from a partly consumed one.
(defun Map_try_next (m cursor key val)
  (let ((entries (let ((held (C.load cursor)))
                   (if (number? held) (Map.list m) held))))
    (if (null? entries) 0
        (begin (C.store key (car (car entries)))
               (C.store val (cadr (car entries)))
               (C.store cursor (cdr entries))
               1))))

(def Array_new Array.new)
(def Array_len Array.len)
(def Array_push Array.push)
// Out of range these answer `void`, which has no Lisp value, so the index
// is checked here and an absent element reads as nil. A negative index
// counts from the end, as `Array.getindex` documents.
(defun _array_index (a i)
  (let ((n (Array.len a))) (if (< i 0) (+ n i) i)))
(defun _array_holds (a j) (and (>= j 0) (< j (Array.len a))))
(defun Array_getindex (a i)
  (let ((j (_array_index a i)))
    (if (_array_holds a j) (Array.getindex a j) ())))
(defun Array_setindex (a i v)
  (let ((j (_array_index a i)))
    (if (_array_holds a j) (Array.setindex a j v) ())))
(def Array_list Array.list)
(def Array_str str)
(def Array_repr repr)
(def Array_map Array.map)
(def Array_join Array.join)
(def Array_find Array.find)
(def Array_contains Array.contains)
(def Array_count Array.count)
// `Array.unshift` answers the element it inserted, and refuses a `void` one
// by raising, so it never answers `void` itself.
(def Array_unshift Array.unshift)

// These four answer `void` where there is no such element, so each checks
// its range first and an absent element reads as nil. `Array.len` answers an
// unsigned length, so a length is compared rather than subtracted from.
(defun Array_take_last (a) (if (> (Array.len a) 0) (Array.take_last a) ()))
(defun Array_shift (a) (if (> (Array.len a) 0) (Array.shift a) ()))
(defun Array_remove (a i)
  (let ((j (_array_index a i)))
    (if (_array_holds a j) (Array.remove a j) ())))
// An insertion may also land past the last element, so its range is one
// wider than a read's and `-1` appends. `Array.insert` normalizes a negative
// index itself, so an accepted one is passed through as written.
(defun Array_insert (a i v)
  (if (< i 0)
      (if (<= (- 0 i) (+ (Array.len a) 1)) (Array.insert a i v) ())
      (if (<= i (Array.len a)) (Array.insert a i v) ())))

// A map literal builds its entries in one expression, the way an array
// literal does, so the lowering needs no statement sequence. The flat list
// alternates key and value in source order, so a repeated key keeps the
// last entry the way the braced form reads.
(defun Map_of (flat) (_map_fill (Map.new) flat))
(defun _map_fill (m flat)
  (if (null? flat) m
      (begin (Map.setindex m (car flat) (car (cdr flat)))
             (_map_fill m (cdr (cdr flat))))))

(def Map_new Map.new)
(def Map_len Map.len)
(defun Map_get (m k) (if (eq? (Map.contains m k) 0) () (Map.getindex m k)))
// `Map.getindex` is `Map.get` in every respect, including the `void` an
// absent key answers, so it reads back the same way.
(def Map_getindex Map_get)
(def Map_setindex Map.setindex)
(def Map_contains Map.contains)
// `Map.del` answers the removed value, or `void` when the key was absent.
(defun Map_del (m k) (if (eq? (Map.contains m k) 0) () (Map.del m k)))
(def Map_getdefault Map.getdefault)
(def Map_setdefault Map.setdefault)
(def Map_list Map.list)
(def Map_str str)
(def Map_repr repr)

