// The runtime a compile-time x2c function calls once `src/comptime.x` has
// translated it to Lisp. Load etc/init.xlisp and etc/lisp-values.xlisp
// first; the compiler loads this into every compile-time Lisp session.
//
// A lowered function is ordinary Lisp: its locals are lambda parameters and
// its calls are direct. These are the few operations it still needs, plus
// the library names its calls resolve against.

// x2c truth: nil is false, a number is false at zero, anything else true.
// The lowering inlines the numeric case and calls this for the rest.
(defun C.true? (a)
  (cond ((null? a) nil)
        ((number? a) (not (eq? a 0)))
        (true true)))

(defun C.not (a) (if (C.true? a) 0 1))

(defmacro C.and (a b) `(if (C.true? ,a) (if (C.true? ,b) 1 0) 0))
(defmacro C.or (a b) `(if (C.true? ,a) 1 (if (C.true? ,b) 1 0)))
(defmacro C.ternary (test a b) `(if (C.true? ,test) ,a ,b))

// A local whose address is taken lives in a one-slot Array, so a call can
// write through it the way an out-parameter does in C.
(defun C.cell (v) (let ((box (Array.new))) (begin (Array.push box v) box)))
(defun C.load (box) (Array.getindex box 0))
(defun C.store (box v) (Array.setindex box 0 v))

// File-scope state, keyed by binding id. A unit-level initializer is not
// part of the function, so an unwritten global reads as zero.
(def C._globals (Map.new))

(defun C.gread (id)
  (if (eq? (Map.contains C._globals id) 0) 0
      (Map.getindex C._globals id)))

(defun C.gwrite (id value) (Map.setindex C._globals id value))

// The library operations a lowered call resolves against, under the names
// the typed AST already uses.
(def List_len length)
(def Var_car car)
(def List_car car)
(def Var_cdr cdr)
(def List_cdr cdr)
(def Var_cons cons)
(def List_reverse reverse)
(def List_index List.index)
// These return `void` for an absent element, which has no Lisp value, so
// each answers nil the way an absent Lisp lookup does.
(defun List_getindex (xs i)
  (cond ((null? xs) ())
        ((eq? i 0) (car xs))
        (true (List_getindex (cdr xs) (- i 1)))))
(defun List_last (xs) (if (null? xs) () (car (reverse xs))))
(defun List_get (xs key) (let ((p (assoc key xs))) (if p (cadr p) ())))
(defun List_assoc (xs key) (let ((p (assoc key xs))) (if p (cadr p) ())))
(def List_array List.array)
(def List_sort List.sort)
(def List_match match)
(def List_search search)
(defun List_equal (a b) (if (equal? a b) 1 0))
(defun List_contains (xs v) (if (member v xs) 1 0))
(defun List_map (xs fn) (map fn xs))
(defun List_filter (xs fn) (filter fn xs))

// `foreach` expands to a `try_next` loop over three cells: the container,
// an integer or List cursor, and one output per name. Each shim below
// answers the same shape its x2c operation does, and none of them reads
// past the end, where the container would answer `void`.
(defun List_try_next (xs cursor out)
  (let ((rest (C.load cursor)))
    (if (null? rest) 0
        (begin (C.store out (car rest)) (C.store cursor (cdr rest)) 1))))

(defun Array_try_next (a cursor out)
  (let ((i (C.load cursor)))
    (if (>= i (Array.len a)) 0
        (begin (C.store out (Array.getindex a i))
               (C.store cursor (+ i 1))
               1))))

// A `Map` has no positional cursor, so the entries `Map.list` answers are
// walked as a List. The x2c cursor starts at the integer zero, which is how
// the first call tells a fresh walk from a partly consumed one.
(defun Map_try_next (m cursor key val)
  (let ((entries (let ((held (C.load cursor)))
                   (if (number? held) (Map.list m) held))))
    (if (null? entries) 0
        (begin (C.store key (car (car entries)))
               (C.store val (cadr (car entries)))
               (C.store cursor (cdr entries))
               1))))

(def Array_new Array.new)
(def Array_len Array.len)
(def Array_push Array.push)
// Out of range these answer `void`, which has no Lisp value, so the index
// is checked here and an absent element reads as nil. A negative index
// counts from the end, as `Array.getindex` documents.
(defun _array_index (a i)
  (let ((n (Array.len a))) (if (< i 0) (+ n i) i)))
(defun _array_holds (a j) (and (>= j 0) (< j (Array.len a))))
(defun Array_getindex (a i)
  (let ((j (_array_index a i)))
    (if (_array_holds a j) (Array.getindex a j) ())))
(defun Array_setindex (a i v)
  (let ((j (_array_index a i)))
    (if (_array_holds a j) (Array.setindex a j v) ())))
(def Array_list Array.list)
(def Array_join Array.join)
(def Array_find Array.find)
(def Array_contains Array.contains)
(def Array_count Array.count)
// `Array.unshift` answers the element it inserted, and refuses a `void` one
// by raising, so it never answers `void` itself.
(def Array_unshift Array.unshift)

// These four answer `void` where there is no such element, so each checks
// its range first and an absent element reads as nil. `Array.len` answers an
// unsigned length, so a length is compared rather than subtracted from.
(defun Array_take_last (a) (if (> (Array.len a) 0) (Array.take_last a) ()))
(defun Array_shift (a) (if (> (Array.len a) 0) (Array.shift a) ()))
(defun Array_remove (a i)
  (let ((j (_array_index a i)))
    (if (_array_holds a j) (Array.remove a j) ())))
// An insertion may also land past the last element, so its range is one
// wider than a read's and `-1` appends. `Array.insert` normalizes a negative
// index itself, so an accepted one is passed through as written.
(defun Array_insert (a i v)
  (if (< i 0)
      (if (<= (- 0 i) (+ (Array.len a) 1)) (Array.insert a i v) ())
      (if (<= i (Array.len a)) (Array.insert a i v) ())))

// A map literal builds its entries in one expression, the way an array
// literal does, so the lowering needs no statement sequence. The flat list
// alternates key and value in source order, so a repeated key keeps the
// last entry the way the braced form reads.
(defun Map_of (flat) (_map_fill (Map.new) flat))
(defun _map_fill (m flat)
  (if (null? flat) m
      (begin (Map.setindex m (car flat) (car (cdr flat)))
             (_map_fill m (cdr (cdr flat))))))

(def Map_new Map.new)
(def Map_len Map.len)
(defun Map_get (m k) (if (eq? (Map.contains m k) 0) () (Map.getindex m k)))
// `Map.getindex` is `Map.get` in every respect, including the `void` an
// absent key answers, so it reads back the same way.
(def Map_getindex Map_get)
(def Map_setindex Map.setindex)
(def Map_contains Map.contains)
// `Map.del` answers the removed value, or `void` when the key was absent.
(defun Map_del (m k) (if (eq? (Map.contains m k) 0) () (Map.del m k)))
(def Map_getdefault Map.getdefault)
(def Map_setdefault Map.setdefault)
(def Map_list Map.list)

(def String_getindex String.getindex)
(def String_len String.len)
(def String_add String.add)
(def String_lower String.lower)
(def String_upper String.upper)
(def String_find String.find)
(def String_contains String.contains)
(def String_startswith String.startswith)
(def String_endswith String.endswith)
(def String_getslice String.getslice)
(def String_replace String.replace)
(def String_join String.join)
(def String_split String.split)
(def String_split_lines String.split_lines)
(def String_partition String.partition)
(def String_rpartition String.rpartition)
(def String_find_all String.find_all)
(def String_rfind String.rfind)
(def String_count String.count)
(def String_capitalize String.capitalize)
(def String_repeat String.repeat)
(def String_remove_prefix String.remove_prefix)
(def String_remove_suffix String.remove_suffix)
(def String_escape String.escape)
(def String_unescape String.unescape)
(defun String_new (text) text)
(defun String_equal (a b) (if (equal? a b) 1 0))

(def Symbol_str Symbol.str)
(def Var_tag Var.tag)
(def Var_parse Var.parse)
(def Var_convert Var.convert)
(defun Var_integer (v) v)
(defun Var_floating (v) v)
(defun Var_is (v tag) (if (eq? (type v) tag) 1 0))
(defun Var_equal (a b) (if (equal? a b) 1 0))
(def int_str str)
(def long_str str)
(def double_str str)
(def Var_str str)
(defun int_var (v) v)
(defun long_var (v) v)
(defun double_var (v) v)
(defun String_var (v) v)
(defun List_var (v) v)
(defun Var_list (v) v)
(defun Array_var (v) v)
(defun Map_var (v) v)

// A compile-time `Func` is the Lisp lambda the lowering produced, which
// already is a value, so boxing it and reading it back are both the
// identity. `src/comptime.x` collapses the call itself.
(defun Func_var (v) v)
(defun Var_func (v) v)

// The compiler surface `lib/meta.x` declares, under the names the typed AST
// uses for `Meta.operation`. Each row forwards to the operation the compiler
// already binds, and each is a `defun` rather than a `def` because the
// natives are bound into the session after this file is read, so a `def`
// would capture an unbound name.
//
// These operations exist only inside a compiler, so a `meta` function that
// reaches one has no runtime form; `src/comptime.x` derives that from the
// `Meta_` namespace and the compiler emits no definition for it.
//
// None of them answers `void` for an absent result. Where there is no
// answer they answer nil, and where the request is wrong they reject, which
// reaches the developer as a diagnostic at the macro invocation.

(defun Meta_ident (spelling) (x2c.ident spelling))
(defun Meta_literal_string (value) (x2c.literal.string value))
(defun Meta_literal_int (value) (x2c.literal.int value))
(defun Meta_literal_symbol (value) (x2c.literal.symbol value))

(defun Meta_expr_ident (name) (x2c.expr.ident name))
(defun Meta_expr_index (base subscript) (x2c.expr.index base subscript))
(defun Meta_expr_field (receiver name) (x2c.expr.field receiver name))
// `x2c.expr.call` takes its arguments as a rest parameter, which x2c cannot
// spell in a prototype, so the x2c surface takes the `List` and this spreads
// it the way the Lisp caller does.
(defun Meta_expr_call (callee arguments)
  (apply x2c.expr.call (cons callee arguments)))
(defun Meta_expr_composite (items) (x2c.expr.composite items))
(defun Meta_expr_cast (type expression) (x2c.expr.cast type expression))

(defun Meta_source_text (syntax) (x2c.source.text syntax))
(defun Meta_binding_spelling (syntax) (x2c.binding.spelling syntax))
(defun Meta_syntax_type (value) (x2c.syntax.type value))
(defun Meta_cache_value (node) (x2c.cache.value node))

(defun Meta_function_name (function) (x2c.function.name function))
(defun Meta_function_parameter (function wanted)
  (x2c.function.parameter function wanted))
(defun Meta_function_body (function) (x2c.function.body function))
(defun Meta_parameters_arguments (value) (x2c.parameters.arguments value))

(defun Meta_type_fields (value) (x2c.type.fields value))
(defun Meta_type_layout (value) (x2c.type.layout value))
(defun Meta_type_parts (value) (x2c.type.parts value))
(defun Meta_type_resolve (value) (x2c.type.resolve value))
// This answers a Lisp truth value, and the x2c surface returns `int`, whose
// test the lowering inlines as a comparison against zero. Nil compares
// unequal to zero, so the answer is normalized here instead.
(defun Meta_type_value (value) (if (x2c.type.value? value) 1 0))
(defun Meta_type_tag_name (name) (x2c.type.tag-name name))
(defun Meta_type_reverse_name (base participant)
  (x2c.type.reverse-name base participant))
(defun Meta_method_resolve (type name) (x2c.method.resolve type name))

(defun Meta_invocation_file () (x2c.invocation.file))
(defun Meta_invocation_line () (x2c.invocation.line))
(defun Meta_invocation_column () (x2c.invocation.column))
(defun Meta_embed_text (path) (x2c.embed.text path))

(defun Meta_diagnostic_fail (message notes)
  (x2c.diagnostic.fail message notes))
