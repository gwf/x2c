(def Symbol_len Symbol.len)
(def Symbol_compare Symbol.compare)
(def Symbol_repr repr)
(def Symbol_str Symbol.str)
(def Var_tag Var.tag)
(def Var_kind Var.kind)
(def Var_caar List_caar)
(def Var_cadr List_cadr)
(def Var_cddr cddr)
(def Var_caddr List_caddr)
(def Var_parse Var.parse)
(def Var_convert Var.convert)
(def Var_integer Var.integer)
(def Var_floating Var.floating)
(defun Var_is (v tag) (if (eq? (type v) tag) 1 0))
(defun Var_equal (a b) (if (equal? a b) 1 0))
(def int_str str)
(def long_str str)
(def double_str str)
(defun int_var (v) v)
(defun long_var (v) v)
(defun double_var (v) v)
(defun Symbol_var (v) v)
(defun String_var (v) v)
(defun Var_list (v) v)
(defun Array_var (v) v)
(defun Map_var (v) v)

// A compile-time `Func` is the Lisp lambda the lowering produced, which
// already is a value, so boxing it and reading it back are both the
// identity. `src/comptime.x` collapses the call itself.
(defun Func_var (v) v)
(defun Var_func (v) v)

// Preserve printed syntax in meta diagnostics.
(def Var_repr repr)

// The compiler surface `lib/meta.x` declares needs no forwarding: an
// `x2c_<path>` call lowers to the `x2c.<path>` operation the compiler binds,
// each `_` becoming a `.`. Two operations cannot be reached that way, and
// these are the adapters for them. Each is a `defun` rather than a `def`
// because the natives are bound into the session after this file is read, so
// a `def` would capture an unbound name.
//
// None of the compiler operations answers `void` for an absent result. Where
// there is no answer they answer nil, and where the request is wrong they
// reject, which reaches the developer as a diagnostic at the macro
// invocation.

// The Lisp spelling keeps its rest parameter around the shared meta body.
(defun x2c.expr.call (callee . arguments)
  (x2c_expr_call callee arguments))

// `x2c.type.value?` answers a Lisp truth value and the x2c surface returns
// `int`, whose test the lowering inlines as a comparison against zero. Nil
// compares unequal to zero, so the answer is normalized here.
(defun _x2c.type.value-int (value) (if (x2c.type.value? value) 1 0))

