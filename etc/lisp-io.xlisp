// Optional layer for x2c Lisp: path-level file operations and a few small
// list algorithms. Load etc/init.xlisp first; nothing loads this layer
// implicitly.

(def read-file (bind "lisp_read_file" nil))
(def write-file (bind "lisp_write_file" nil))

(def sort (bind "List_sort" nil))
(def List_sort sort)

(defun fib (value)
  (if (or (= value 0) (= value 1))
      value
      (+ (fib (- value 2)) (fib (- value 1)))))

(defun subst (replacement target tree)
  (if (atom? tree)
      (if (equal? tree target) replacement tree)
      (cons (subst replacement target (car tree))
            (subst replacement target (cdr tree)))))
