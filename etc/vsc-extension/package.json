{
  "name": "x2c-syntax",
  "displayName": "x2c - C with batteries",
  "description": "x2c syntax highlighting, compiler diagnostics, definitions, and type hover.",
  "version": "0.3.0",
  "publisher": "x2c-lang",
  "author": {
    "name": "Gary William Flake"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "preview": true,
  "engines": {
    "vscode": "^1.60.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "x2c",
    "c",
    "programming language",
    "syntax highlighting"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gwf/x2c.git",
    "directory": "etc/vsc-extension"
  },
  "homepage": "https://x2c-lang.dev",
  "bugs": {
    "url": "https://github.com/gwf/x2c/issues"
  },
  "qna": false,
  "pricing": "Free",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": {
      "supported": true
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "x2c",
        "aliases": [
          "x2c",
          "X2C"
        ],
        "extensions": [
          ".xc",
          ".xh",
          ".x2c",
          ".x",
          ".xmacro"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "x2c-lisp",
        "aliases": [
          "x2c Lisp",
          "X2C Lisp"
        ],
        "extensions": [
          ".xlisp"
        ],
        "configuration": "./lisp-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "x2c",
        "scopeName": "source.x2c",
        "path": "./syntaxes/x2c.tmLanguage.json"
      },
      {
        "language": "x2c-lisp",
        "scopeName": "source.x2c.lisp",
        "path": "./syntaxes/x2c-lisp.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "x2c",
      "properties": {
        "x2c.semantic.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable compiler diagnostics, definitions, and hover in trusted local workspaces.",
          "scope": "resource"
        },
        "x2c.semantic.workerPath": {
          "type": "string",
          "default": "x2c-editor-worker",
          "description": "Explicit compatibility path to a standalone worker; ignored when compilerPath is set.",
          "deprecationMessage": "Use x2c.semantic.compilerPath with a current x2c compiler.",
          "scope": "resource"
        },
        "x2c.semantic.arguments": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Ordinary x2c command and arguments for analysis, such as [\"build\", \"--target\", \"app\"]. Empty selects the discovered project or the current file.",
          "scope": "resource"
        },
        "x2c.semantic.compilerPath": {
          "type": "string",
          "default": "",
          "description": "Path to the x2c compiler. Otherwise use trusted workspace ./x2c, then x2c on PATH.",
          "scope": "resource"
        }
      }
    }
  },
  "scripts": {
    "build": "vsce package",
    "test": "node --test test/*.test.js && vscode-tmgrammar-test 'test/**/*.test.x' 'test/**/*.test.xlisp'"
  },
  "devDependencies": {
    "@vscode/vsce": "3.9.2",
    "vscode-tmgrammar-test": "0.1.3"
  },
  "icon": "images/icon.png",
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:x2c"
  ]
}
