// Compiler-only primitive forwarding; native operations bind after loading.
(def lisp_string string?)
(defun builtin_foreach_reference (name) (_x2c.function.reference name))
(defun builtin_foreach_parameters (type) (x2c.type.parameters type))
(defun builtin_foreach_return (type) (x2c.type.return type))
(defun builtin_foreach_pointer (type) (x2c.type.pointer? type))
(defun builtin_foreach_integral (type) (x2c.type.integral? type))
(defun builtin_foreach_element (type) (x2c.type.element type))
(defun builtin_foreach_unique (name) (_x2c.name.unique name))
(defun builtin_foreach_complete (expression)
  (_x2c.foreach.complete-iter-chain expression))
(defun builtin_foreach_collection (expression)
  (_x2c.foreach.string-collection expression))
(defun builtin_foreach_bindings (declaration) (_x2c.declaration.bindings declaration))
(defun builtin_foreach_protocol (type protocol member)
  (x2c.protocol.member type protocol member))
(def List_append append)
(defun builtin_class_pointer (type) (x2c.type.pointer? type))
(defun builtin_class_element (type) (x2c.type.element type))
(defun builtin_class_location () (_x2c.invocation.location))
(defun builtin_class_field (receiver member) (x2c.expr.field receiver member))
(defun builtin_class_cast (type value) (x2c.expr.cast type value))
(defun builtin_class_declaration (type name value) (x2c.decl.make type name value))
(defun builtin_class_parameter (type name) (x2c.param.make type name))

// Generated algorithms belong here.

(def scope.expand builtin_scope_expand)
(def foreach.expand builtin_foreach_expand)

(def class.expand builtin_class_expand)
(def class.defaults builtin_class_defaults)
(def class.initializer builtin_class_initializer)
(def class.write-fields builtin_class_write_fields)
