// These callbacks run before the Func runtime is installed. They read
// through private names so a session that redefines car, cdr, or cons
// keeps them working.
(def List_car car)
(def List_cdr cdr)
(def Var_cons cons)
(def List_reverse reverse)
(defun _filter-onto (keep values kept)
  (if (equal? values nil) (List_reverse kept)
      (_filter-onto keep (List_cdr values)
                    (if (equal? (keep (List_car values)) nil) kept
                        (Var_cons (List_car values) kept)))))
(defun filter (keep values) (_filter-onto keep values nil))
(defun _map-onto (procedure values mapped)
  (if (equal? values nil) (List_reverse mapped)
      (_map-onto procedure (List_cdr values)
                 (Var_cons (procedure (List_car values)) mapped))))
(defun map (procedure values) (_map-onto procedure values nil))
(defun foldl (procedure initial values)
  (if (equal? values nil) initial
      (foldl procedure (procedure initial (List_car values))
             (List_cdr values))))
(def reduce foldl)

// File operations and recursive list algorithms

(def read-file (bind "lisp_read_file" nil))
(def write-file (bind "lisp_write_file" nil))

(def sort (bind "List_sort" nil))
(def List_sort sort)

(defun fib (value)
  (if (or (= value 0) (= value 1))
      value
      (+ (fib (- value 2)) (fib (- value 1)))))

(defun subst (replacement target tree)
  (if (atom? tree)
      (if (equal? tree target) replacement tree)
      (cons (subst replacement target (car tree))
            (subst replacement target (cdr tree)))))

// x2c value operations
//
// A Lisp value is an x2c Var: a Lisp list is a List, a Lisp string is a
// String, a quoted name is a Symbol. These names are the library's own
// operations over those types, so a macro and the program it generates
// compute with the same List, String, Map, and Array.
//
// The Lisp core keeps its own spellings for cons-cell and text work:
// `car`, `cdr`, `cons`, `length`, `reverse`, `string-append`, `substring`,
// `lower`, `str`, and `repr` are unchanged and reach the same code.

// Each `Owner.member` named here binds the library operation
// `Owner_member`; the few that bind another native are defined by hand.
// A Lisp macro expands again at each call, so the generators below call
// `cond` and native operations rather than `if`, `let`, or `map`.
(def _list_map (bind "List_map" nil))
(def _string_replace (bind "String_replace" nil))
(defmacro _natives (. names)
  (cons 'begin
        (_list_map
          names
          (lambda (name)
            `(def ,name (bind ,(_string_replace (str name) "." "_") nil))))))

// An iterator operation takes its destination last. A call that omits it
// gets a fresh Iter, allocated in the current Scope; a call with explicit
// storage passes it. The REPL binds lowered iterator calls the same way.
(defun C.iterator.call (explicit arity)
  (let ((fresh (bind "Iter_new" nil)))
    (lambda (. arguments)
      (apply explicit
             (if (eq? (length arguments) arity)
                 (append arguments (list (fresh)))
                 arguments)))))

