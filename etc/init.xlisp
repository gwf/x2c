// x2c Lisp standard environment

(def nil ())
(def true 'true)
(def false nil)

// Native value and list boundary

(def car (bind "Var_car" nil))
(def cdr (bind "Var_cdr" nil))
(def cons (bind "Var_cons" nil))
(def atom? (bind "lisp_atom" nil))
(def pair? (bind "lisp_pair" nil))
(def list? (bind "lisp_list" nil))
(def eq? (bind "lisp_eq" nil))
(def type (bind "lisp_type" nil))
(def number? (bind "lisp_number" nil))
(def string? (bind "lisp_string" nil))
(def symbol? (bind "lisp_symbol" nil))
(def procedure? (bind "lisp_procedure" nil))
(def reverse (bind "List_reverse" nil))
(def length (bind "List_len" nil))
(def _match (bind "List_match" nil))
(def match-replace (bind "lisp_match_replace" nil))
(def search (bind "List_search" nil))
(def _search-replace (bind "List_search_replace" nil))

// Native number and text boundary

(def _add (bind "lisp_add" nil))
(def _binary (bind "Var_binary" nil))
(def _compare (bind "lisp_compare" nil))
(def str (bind "lisp_str" nil))
(def repr (bind "lisp_repr" nil))
(def string-length (bind "String_len" nil))
(def _string-append (bind "lisp_string_append" nil))
(def substring (bind "lisp_substring" nil))
(def string-downcase (bind "lisp_string_downcase" nil))

// Definition and control vocabulary

(def defmacro
  (macro (name params body)
    `(def ,name (macro ,params ,body))))

(defmacro defun (name params body)
  `(def ,name (lambda ,params ,body)))

(defmacro if (test ontrue onfalse)
  `(cond (,test ,ontrue) (true ,onfalse)))

(defun list (. values) values)
(def equal? eq?)

(defmacro and (. forms)
  (if (null? forms)
      true
      (if (null? (cdr forms))
          (car forms)
          `(if ,(car forms) (and ,@(cdr forms)) false))))

(defmacro or (. forms)
  (if (null? forms)
      false
      (if (null? (cdr forms))
          (car forms)
          `((lambda (_or_value)
              (if _or_value _or_value (or ,@(cdr forms))))
            ,(car forms)))))

(def begin (bind "lisp_begin" nil))
(def append (bind "lisp_append" nil))

// These nine are variadic, and a variadic lambda cannot be prepared, so
// written in Lisp they would pull every arithmetic call in a compiled
// body back onto the evaluator.

(def + (bind "lisp_plus" nil))
(def - (bind "lisp_minus" nil))
(def * (bind "lisp_times" nil))
(def / (bind "lisp_divide" nil))

(def = (bind "lisp_eq_chain" nil))
(def < (bind "lisp_lt_chain" nil))
(def <= (bind "lisp_le_chain" nil))
(def > (bind "lisp_gt_chain" nil))
(def >= (bind "lisp_ge_chain" nil))

(def string-append (bind "lisp_string_append_all" nil))

(defmacro let (bindings body)
  `((lambda ,(map car bindings) ,body) ,@(map cadr bindings)))

(defmacro let* (bindings body)
  (if (null? bindings)
      body
      `(let (,(car bindings)) (let* ,(cdr bindings) ,body))))

// Tries each clause's pattern against subject in order and evaluates the
// first body whose pattern matches, with that pattern's binders in scope.
// A final (else body) clause runs when nothing matched.
(defmacro match-case (subject . clauses)
  (foldl
    (lambda (rest clause)
      (if (equal? (car clause) 'else) (cadr clause)
        `(let ((_match-case-subject ,subject))
           (let ((_match-case-bindings
                   (match _match-case-subject ',(car clause))))
             (cond (_match-case-bindings
                     (let ,(_binder-lets '_match-case-bindings
                                         (_binders (car clause)))
                       ,(cadr clause)))
                   (true ,rest))))))
    nil
    (reverse clauses)))

// Short aliases for common operations

(def add _add)
(def len length)
(def lower string-downcase)

// Standard algorithms from lib/lisp-init.x.

(def last (bind "lisp_last" nil))
(def member (bind "lisp_member" nil))
(def assoc (bind "lisp_assoc" nil))
(def not (bind "lisp_not" nil))
(def null? (bind "lisp_null" nil))
(def sub (bind "lisp_sub" nil))
(def mul (bind "lisp_mul" nil))
(def div (bind "lisp_div" nil))
(def mod (bind "lisp_mod" nil))
(def % mod)
(def caar (bind "lisp_caar" nil))
(def cadr (bind "lisp_cadr" nil))
(def cdar (bind "lisp_cdar" nil))
(def cddr (bind "lisp_cddr" nil))
(def caaar (bind "lisp_caaar" nil))
(def caadr (bind "lisp_caadr" nil))
(def cadar (bind "lisp_cadar" nil))
(def caddr (bind "lisp_caddr" nil))
(def cdaar (bind "lisp_cdaar" nil))
(def cdadr (bind "lisp_cdadr" nil))
(def cddar (bind "lisp_cddar" nil))
(def cdddr (bind "lisp_cdddr" nil))
(def match (bind "lisp_match" nil))
(def bound (bind "lisp_bound" nil))
(def search-replace (bind "lisp_search_replace" nil))
(def binder? (bind "lisp_binder" nil))
(def _binders (bind "lisp_binders" nil))
(def _binder-lets (bind "lisp_binder_lets" nil))

// These callbacks run before the Func runtime is installed. They read
// through private names so a session that redefines car, cdr, or cons
// keeps them working.
(def List_car car)
(def List_cdr cdr)
(def Var_cons cons)
(defun filter (keep values)
  (if (equal? values nil) values
      ((lambda (value)
         (if (equal? (keep value) nil)
             (filter keep (List_cdr values))
             (Var_cons value (filter keep (List_cdr values)))))
       (List_car values))))
(defun map (procedure values)
  (if (equal? values nil) values
      (Var_cons (procedure (List_car values))
                (map procedure (List_cdr values)))))
(defun foldl (procedure initial values)
  (if (equal? values nil) initial
      (foldl procedure (procedure initial (List_car values))
             (List_cdr values))))
(def reduce foldl)
