<!DOCTYPE HTML>
<html lang="{{ language }}" class="{{ default_theme }} sidebar-visible" dir="{{ text_direction }}">
    <head>
        <!-- Book generated using mdBook -->
        <meta charset="UTF-8">
        <title>{{#if (eq chapter_title book_title)}}{{ book_title }}{{else}}{{ title }}{{/if}}</title>
        {{#if is_print }}
        <meta name="robots" content="noindex">
        {{/if}}
        {{#if base_url}}
        <base href="{{ base_url }}">
        {{/if}}


        <!-- Custom HTML head -->
        {{> head}}

        <meta name="description" content="{{ description }}">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <meta name="theme-color" content="#ffffff">

        {{#if favicon_svg}}
        <link rel="icon" href="{{ resource "favicon.svg" }}">
        {{/if}}
        {{#if favicon_png}}
        <link rel="shortcut icon" href="{{ resource "favicon.png" }}">
        {{/if}}
        <link rel="stylesheet" href="{{ resource "css/variables.css" }}">
        <link rel="stylesheet" href="{{ resource "css/general.css" }}">
        <link rel="stylesheet" href="{{ resource "css/chrome.css" }}">
        {{#if print_enable}}
        <link rel="stylesheet" href="{{ resource "css/print.css" }}" media="print">
        {{/if}}

        <!-- Fonts -->
        <link rel="stylesheet" href="{{ resource "fonts/fonts.css" }}">

        <!-- Highlight.js Stylesheets -->
        <link rel="stylesheet" id="mdbook-highlight-css" href="{{ resource "highlight.css" }}">
        <link rel="stylesheet" id="mdbook-tomorrow-night-css" href="{{ resource "tomorrow-night.css" }}">
        <link rel="stylesheet" id="mdbook-ayu-highlight-css" href="{{ resource "ayu-highlight.css" }}">

        <!-- Custom theme stylesheets -->
        {{#each additional_css}}
        <link rel="stylesheet" href="{{ resource this }}">
        {{/each}}

        {{#if mathjax_support}}
        <!-- MathJax -->
        <script async src="https://cdnjs.cloudflare.com/ajax/libs/mathjax/2.7.1/MathJax.js?config=TeX-AMS-MML_HTMLorMML"></script>
        {{/if}}

        <!-- Provide site root and default themes to javascript -->
        <script>
            const path_to_root = "{{ path_to_root }}";
            const default_light_theme = "{{ default_theme }}";
            const default_dark_theme = "{{ preferred_dark_theme }}";
        {{#if search_js}}
            window.path_to_searchindex_js = "{{ resource "searchindex.js" }}";
        {{/if}}
        </script>
        <!-- Start loading toc.js asap -->
        <script src="{{ resource "toc.js" }}"></script>
    </head>
    <body>
    <div id="mdbook-help-container">
        <div id="mdbook-help-popup">
            <h2 class="mdbook-help-title">Keyboard shortcuts</h2>
            <div>
                <p>Press <kbd>←</kbd> or <kbd>→</kbd> to navigate between chapters</p>
                {{#if search_enabled}}
                <p>Press <kbd>S</kbd> or <kbd>/</kbd> to search in the book</p>
                {{/if}}
                <p>Press <kbd>?</kbd> to show this help</p>
                <p>Press <kbd>Esc</kbd> to hide this help</p>
            </div>
        </div>
    </div>
    <div id="mdbook-body-container">
        <!-- Work around some values being stored in localStorage wrapped in quotes -->
        <script>
            try {
                let theme = localStorage.getItem('mdbook-theme');
                let sidebar = localStorage.getItem('mdbook-sidebar');

                if (theme.startsWith('"') && theme.endsWith('"')) {
                    localStorage.setItem('mdbook-theme', theme.slice(1, theme.length - 1));
                }

                if (sidebar.startsWith('"') && sidebar.endsWith('"')) {
                    localStorage.setItem('mdbook-sidebar', sidebar.slice(1, sidebar.length - 1));
                }
            } catch (e) { }
        </script>

        <!-- Set the theme before any content is loaded, prevents flash -->
        <script>
            const default_theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? default_dark_theme : default_light_theme;
            let theme;
            try { theme = localStorage.getItem('mdbook-theme'); } catch(e) { }
            if (theme === null || theme === undefined) { theme = default_theme; }
            const html = document.documentElement;
            html.classList.remove('{{ default_theme }}')
            html.classList.add(theme);
            html.classList.add("js");
        </script>

        <input type="checkbox" id="mdbook-sidebar-toggle-anchor" class="hidden">

        <!-- Hide / unhide sidebar before it is displayed -->
        <script>
            /* Sidebar bootstrap */
            document.documentElement.classList.add('js');
            let sidebar = 'hidden';
            const sidebar_toggle = document.getElementById("mdbook-sidebar-toggle-anchor");
            if (document.body.clientWidth >= 1080) {
                try { sidebar = localStorage.getItem('mdbook-sidebar') || 'visible'; }
                catch { sidebar = 'visible'; }
            }
            try {
                const width = Number(localStorage.getItem('mdbook-sidebar-width'));
                if (width >= 150) {
                    document.documentElement.style.setProperty('--sidebar-target-width', width + 'px');
                }
            } catch {}
            sidebar_toggle.checked = sidebar === 'visible';
            document.documentElement.classList.toggle('sidebar-visible', sidebar_toggle.checked);
            /* End sidebar bootstrap */
        </script>

        <nav id="mdbook-sidebar" class="sidebar" aria-label="Table of contents">
            <!-- populated by js -->
            <mdbook-sidebar-scrollbox class="sidebar-scrollbox"></mdbook-sidebar-scrollbox>
            <noscript>
                <iframe class="sidebar-iframe-outer" src="{{ path_to_root }}toc.html"></iframe>
            </noscript>
            <div id="mdbook-sidebar-resize-handle" class="sidebar-resize-handle">
                <div class="sidebar-resize-indicator"></div>
            </div>
        </nav>

        <div id="mdbook-page-wrapper" class="page-wrapper">

            <div class="page">
                <div id="mdbook-menu-bar" class="hidden"></div>
                <header class="landing-header x2c-header">
                    <label id="mdbook-sidebar-toggle" class="sidebar-toggle" tabindex="0" role="button" for="mdbook-sidebar-toggle-anchor" title="Toggle Table of Contents" aria-label="Toggle Table of Contents" aria-controls="mdbook-sidebar">
                                <svg aria-hidden="true" width="16" height="16" viewBox="0 0 16 16"><path d="M1 3h14M1 8h14M1 13h14" fill="none" stroke="currentColor" /></svg>
                            </label>
                    <div class="landing-header-inner">
                        <div class="landing-branding">
                            <a class="landing-brand" href="{{ path_to_root }}../" aria-label="x2c home">
                                <svg viewBox="0 0 100 100" width="22" height="22" aria-hidden="true"><g fill="none" stroke="#da291c" stroke-width="17" stroke-linecap="butt"><path d="M9 16 A34.5 34.5 0 0 1 9 84"></path><path d="M91 16 A34.5 34.5 0 0 0 91 84"></path></g></svg>
                                <span class="x2c-wordmark landing-wordmark">x2c</span>
                            </a>
                            {{#if search_enabled}}
                            <form id="mdbook-searchbar-outer" class="searchbar-outer" role="search">
                                <div class="search-wrapper">
                                    <span class="x2c-search-icon" aria-hidden="true">{{fa "solid" "magnifying-glass"}}</span>
                                    <input type="search" id="mdbook-searchbar" name="searchbar" placeholder="search the docs" aria-controls="mdbook-searchresults-outer" aria-label="Search The x2c Book" aria-describedby="mdbook-searchresults-header">
                                    <div class="spinner-wrapper">
                                        {{fa "solid" "spinner" "fa-spin"}}
                                    </div>
                                </div>
                            </form>
                            {{else}}
                            <span class="landing-tagline">{{ book_title }}</span>
                            {{/if}}
                        </div>
                        <nav class="landing-nav" aria-label="x2c website">
                            <div class="landing-site-nav">
                                <a href="{{ path_to_root }}../#install">install</a>
                                <a href="{{ path_to_root }}../#packages">packages</a>
                            </div>
                            <div class="landing-reference-nav">
                                <a href="{{ path_to_root }}../examples/">examples</a>
                                <a href="{{ path_to_root }}" aria-current="page">docs</a>
                                <a href="{{ path_to_root }}../about/">about</a>
                                <a href="https://github.com/gwf/x2c">source</a>
                            </div>
                        </nav>
                    </div>
                </header>
                <!-- mdBook requires these hooks for its built-in controls. -->
                <div hidden>
                    <span class="menu-title">{{ book_title }}</span>
                            <button id="mdbook-theme-toggle" class="icon-button" type="button" title="Change theme" aria-label="Change theme" aria-haspopup="true" aria-expanded="false" aria-controls="mdbook-theme-list">
                                {{fa "solid" "circle-half-stroke"}}
                            </button>
                            <ul id="mdbook-theme-list" class="theme-popup" aria-label="Themes" role="menu">
                                <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-default_theme">Auto</button></li>
                                <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-light">Light</button></li>
                                <li role="none"><button role="menuitem" class="theme" id="mdbook-theme-ayu">Dark</button></li>
                            </ul>
                    <button id="mdbook-search-toggle" type="button" tabindex="-1" aria-expanded="false" aria-controls="mdbook-searchbar"></button>
                </div>
                <script>
                    document.getElementById('mdbook-searchbar')?.addEventListener('focus', () => {
                        if (document.getElementById('mdbook-search-wrapper').classList.contains('hidden'))
                            document.getElementById('mdbook-search-toggle').click();
                    });
                    const bookHeader = document.querySelector('.x2c-header');
                    new ResizeObserver(() => {
                        document.documentElement.style.setProperty(
                            '--menu-bar-height', `${bookHeader.getBoundingClientRect().height}px`);
                    }).observe(bookHeader);
                </script>

                {{#if search_enabled}}
                <div id="mdbook-search-wrapper" class="hidden">
                    <div id="mdbook-searchresults-outer" class="searchresults-outer hidden">
                        <div id="mdbook-searchresults-header" class="searchresults-header"></div>
                        <ul id="mdbook-searchresults">
                        </ul>
                    </div>
                </div>
                {{/if}}

                <!-- Apply ARIA attributes after the sidebar and the sidebar toggle button are added to the DOM -->
                <script>
                    document.getElementById('mdbook-sidebar-toggle').setAttribute('aria-expanded', sidebar === 'visible');
                    document.getElementById('mdbook-sidebar').setAttribute('aria-hidden', sidebar !== 'visible');
                    Array.from(document.querySelectorAll('#mdbook-sidebar a')).forEach(function(link) {
                        link.setAttribute('tabIndex', sidebar === 'visible' ? 0 : -1);
                    });
                </script>

                <div id="mdbook-content" class="content">
                    <main>
                        {{{ content }}}
                    </main>
                    <script>
                        // A generated page is edited through its generator.
                        if ([...document.querySelector('#mdbook-content main').childNodes]
                                .some(node => node.nodeType === Node.COMMENT_NODE &&
                                      node.textContent.includes('Do not edit by hand'))) {
                            document.querySelector('a[rel="edit"]')?.remove();
                        }
                    </script>

                    <nav class="x2c-pager" aria-label="Page navigation">
                        {{#if previous}}
                        <a rel="prev" href="{{ path_to_root }}{{previous.link}}" class="x2c-pager-prev" aria-keyshortcuts="Left">
                            <span class="x2c-pager-label">previous</span>
                            <span class="x2c-pager-title">{{previous.title}}</span>
                        </a>
                        {{else}}<span></span>{{/if}}
                        {{#if next}}
                        <a rel="next prefetch" href="{{ path_to_root }}{{next.link}}" class="x2c-pager-next" aria-keyshortcuts="Right">
                            <span class="x2c-pager-label">next</span>
                            <span class="x2c-pager-title">{{next.title}}</span>
                        </a>
                        {{/if}}
                    </nav>
                    <footer class="x2c-footer">
                        &copy; 2025&ndash;2026
                        <a href="https://flake.org">GWF</a>
                        &middot;
                        <a href="https://github.com/gwf/x2c/blob/main/LICENSE">Apache 2.0</a>
                        &middot;
                        <a href="https://github.com/gwf/x2c/blob/main/TRADEMARKS.md">Trademarks</a>
                    </footer>
                </div>
            </div>


        </div>

        <template id=fa-eye>{{fa "solid" "eye"}}</template>
        <template id=fa-eye-slash>{{fa "solid" "eye-slash"}}</template>
        <template id=fa-copy>{{fa "regular" "copy"}}</template>
        <template id=fa-play>{{fa "solid" "play"}}</template>
        <template id=fa-clock-rotate-left>{{fa "solid" "clock-rotate-left"}}</template>

        {{#if live_reload_endpoint}}
        <!-- Livereload script (if served using the cli tool) -->
        <script>
            const wsProtocol = location.protocol === 'https:' ? 'wss:' : 'ws:';
            const wsAddress = wsProtocol + "//" + location.host + "/" + "{{{live_reload_endpoint}}}";
            const socket = new WebSocket(wsAddress);
            socket.onmessage = function (event) {
                if (event.data === "reload") {
                    socket.close();
                    location.reload();
                }
            };

            window.onbeforeunload = function() {
                socket.close();
            }
        </script>
        {{/if}}

        {{#if playground_line_numbers}}
        <script>
            window.playground_line_numbers = true;
        </script>
        {{/if}}

        {{#if playground_copyable}}
        <script>
            window.playground_copyable = true;
        </script>
        {{/if}}

        {{#if playground_js}}
        <script src="{{ resource "ace.js" }}"></script>
        <script src="{{ resource "mode-rust.js" }}"></script>
        <script src="{{ resource "editor.js" }}"></script>
        <script src="{{ resource "theme-dawn.js" }}"></script>
        <script src="{{ resource "theme-tomorrow_night.js" }}"></script>
        {{/if}}

        {{#if search_js}}
        <script src="{{ resource "elasticlunr.min.js" }}"></script>
        <script src="{{ resource "mark.min.js" }}"></script>
        <script src="{{ resource "searcher.js" }}"></script>
        {{/if}}

        <script src="{{ resource "clipboard.min.js" }}"></script>
        <script src="{{ resource "highlight.js" }}"></script>
        <script src="{{ resource "book.js" }}"></script>

        <script>
            /* Sidebar interactions */
            document.addEventListener('DOMContentLoaded', () => {
                const sidebar = document.querySelector('#mdbook-sidebar');
                sidebar.querySelectorAll('ol').forEach(list => {
                    const numbers = list.querySelectorAll(
                        ':scope > li > .chapter-link-wrapper > a > strong, :scope > li > a > strong');
                    if (numbers.length) {
                        const width = Math.max(...Array.from(numbers,
                            number => number.textContent.trim().length));
                        list.style.setProperty('--chapter-number-width', width + 'ch');
                    }
                });
                const revealChapter = link => {
                    let item = link.closest('li');
                    while (item && sidebar.contains(item)) {
                        item.classList.add('expanded');
                        item.querySelector(':scope > .chapter-link-wrapper > .chapter-fold-toggle')
                            ?.setAttribute('aria-expanded', 'true');
                        item = item.parentElement.closest('li');
                    }
                };
                sidebar.querySelectorAll('a.active').forEach(revealChapter);
                const scrollbox = sidebar.querySelector('.sidebar-scrollbox');
                let followedLink;
                const followCurrentSection = () => {
                    const link = sidebar.querySelector('a.current-header') ||
                        sidebar.querySelector('a.active');
                    if (!link || link === followedLink || !link.getClientRects().length) return;
                    followedLink = link;
                    const bounds = scrollbox.getBoundingClientRect();
                    const row = link.getBoundingClientRect();
                    const padding = 12;
                    if (row.top < bounds.top + padding) {
                        scrollbox.scrollTop += row.top - bounds.top - padding;
                    } else if (row.bottom > bounds.bottom - padding) {
                        scrollbox.scrollTop += row.bottom - bounds.bottom + padding;
                    }
                };
                new MutationObserver(followCurrentSection).observe(sidebar, {
                    subtree: true, attributes: true, attributeFilter: ['class'],
                });
                requestAnimationFrame(followCurrentSection);

                sidebar.addEventListener('click', event => {
                    const link = event.target.closest('a');
                    if (!link || link.classList.contains('chapter-fold-toggle')) return;
                    const target = new URL(link.href);
                    const pagePath = path => path.replace(/index\.html$/, '').replace(/\/$/, '');
                    const toggle = link.parentElement.querySelector('.chapter-fold-toggle');
                    if (toggle && !target.hash && target.origin === location.origin &&
                        pagePath(target.pathname) === pagePath(location.pathname)) {
                        event.preventDefault();
                        toggle.click();
                    } else {
                        revealChapter(link);
                    }
                });
                const chapter = sidebar.querySelector('a.active');
                const item = chapter?.closest('.chapter-item');
                if (item?.querySelector(':scope > .on-this-page')) {
                    const row = chapter.parentElement;
                    if (!row.querySelector('.chapter-fold-toggle')) {
                        const toggle = document.createElement('button');
                        toggle.type = 'button';
                        toggle.className = 'chapter-fold-toggle';
                        toggle.appendChild(document.createElement('div'));
                        toggle.addEventListener('click', () => {
                            item.classList.toggle('expanded');
                        });
                        row.appendChild(toggle);
                    }
                }
                sidebar.querySelectorAll('.chapter-fold-toggle').forEach(toggle => {
                    const row = toggle.parentElement;
                    const item = row.parentElement;
                    const title = row.querySelector('a').textContent.trim();
                    toggle.setAttribute('aria-label', 'Toggle ' + title);
                    const update = () => toggle.setAttribute('aria-expanded',
                        String(item.classList.contains('expanded')));
                    update();
                    toggle.addEventListener('click', update);
                    if (toggle.tagName === 'A') {
                        toggle.setAttribute('role', 'button');
                        toggle.tabIndex = 0;
                        toggle.addEventListener('keydown', event => {
                            if (event.key === 'Enter' || event.key === ' ') {
                                event.preventDefault();
                                toggle.click();
                            }
                        });
                    }
                });
                const checkbox = document.getElementById('mdbook-sidebar-toggle-anchor');
                const button = document.getElementById('mdbook-sidebar-toggle');
                const resize = document.getElementById('mdbook-sidebar-resize-handle');
                button.tabIndex = 0;
                button.setAttribute('role', 'button');
                button.addEventListener('keydown', event => {
                    if (event.key === 'Enter' || event.key === ' ') {
                        event.preventDefault();
                        button.click();
                    }
                });
                const updateFocus = () => {
                    const visible = checkbox.checked;
                    sidebar.setAttribute('aria-hidden', String(!visible));
                    if (visible) {
                        followedLink = null;
                        requestAnimationFrame(followCurrentSection);
                    }
                    button.setAttribute('aria-expanded', String(visible));
                    sidebar.querySelectorAll('a, button').forEach(control => {
                        control.tabIndex = visible ? 0 : -1;
                    });
                };
                checkbox.addEventListener('change', updateFocus);
                updateFocus();
                sidebar.addEventListener('click', event => {
                    if (!event.defaultPrevented && innerWidth < 1080 &&
                        event.target.closest('a:not(.chapter-fold-toggle)') && checkbox.checked) {
                        button.click();
                    }
                });
                addEventListener('keydown', event => {
                    if (event.key === 'Escape' && checkbox.checked) {
                        button.click();
                        button.focus();
                    }
                });
                resize.addEventListener('mousedown', () => {
                    window.addEventListener('mouseup', () => {
                        checkbox.checked = document.documentElement.classList.contains('sidebar-visible');
                        updateFocus();
                        const width = parseFloat(document.documentElement.style.getPropertyValue('--sidebar-target-width'));
                        if (width >= 150) {
                            try { localStorage.setItem('mdbook-sidebar-width', String(width)); } catch {}
                        }
                    }, { once: true });
                });
            });
            /* End sidebar interactions */
        </script>

        <!-- Custom JS scripts -->
        {{#each additional_js}}
        <script src="{{ resource this}}"></script>
        {{/each}}

        {{#if is_print}}
        {{#if mathjax_support}}
        <script>
        window.addEventListener('load', function() {
            MathJax.Hub.Register.StartupHook('End', function() {
                window.setTimeout(window.print, 100);
            });
        });
        </script>
        {{else}}
        <script>
        window.addEventListener('load', function() {
            window.setTimeout(window.print, 100);
        });
        </script>
        {{/if}}
        {{/if}}

        {{#if fragment_map}}
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                const fragmentMap =
                    {{{fragment_map}}}
                ;
                const target = fragmentMap[window.location.hash];
                if (target) {
                    let url = new URL(target, window.location.href);
                    window.location.replace(url.href);
                }
            });
        </script>
        {{/if}}

    </div>
    </body>
</html>
