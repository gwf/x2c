#!/usr/bin/env -S x2c script
#pragma indent
/*  gen-api-reference -- generate the library and compiler API reference

    Pages come from what the compiler says each `lib/*.x` and `src/*.x`
    unit defines (see `definitions.x`): signatures, lines, and doc
    comments. Non-primary library API tiers come from
    `docs/library-api-tiers.txt`. This tool owns `docs/src/library/modules/`,
    `docs/src/internals/compiler-api/`, and their sections of
    `docs/src/SUMMARY.md`; `docs/src/library/overview.md` is authored prose.

    `--check-path` audits the public documentation of one or more assigned
    compiler or library sources without generating pages.

        tools/gen-api-reference --write
        tools/gen-api-reference --check
        tools/gen-api-reference --check-path src/compiler.x
*/
#include "definitions.x"

static Path root, pages_dir, compiler_dir, summary_path, x2c
static Regex whitespace, plain_id, private_pragma
static Map see_index, evidence
static const String library_section = "# Libraries and Packages"
static const String compiler_section = "# Compiler API (provisional)"
static const String internals_section =
  "# Compiler and contributor internals"
static const String banner =
  "<!-- Generated by `make doc-generate` from\n"
  "     lib/*.x and the compiler's definitions. Do not edit by hand. -->"
static const String compiler_banner =
  "<!-- Generated by `make doc-generate` from\n"
  "     src/*.x and the compiler's definitions. Do not edit by hand. -->"
static const String mixed_banner =
  "<!-- Generated by `make doc-generate` from\n"
  "     lib/*.x, src/utils.x, and the compiler's definitions. Do not edit "
  "by hand. -->"
static const String provisional =
  "> **Provisional API:** This reference documents current compiler "
  "behavior.\n> Compatibility is not yet promised."

static List _tiers(void) => %("primary" "advanced" "compatibility" "internal")

static String _tier_heading(String tier):
  if tier == "primary": return "Primary API"
  if tier == "advanced": return "Advanced and interop API"
  if tier == "compatibility": return "Convenience API"
  return "Runtime-internal callables"

static void _fatal(String why):
  raise %(api-fatal (why $why))

static String _flat(String text) =>
  text ? whitespace.replace_all(text, " ").strip(NULL) : NULL

static String _relative(Path path):
  String text = path
  return text[root.len() + 1:]

/* The first sentence outside code spans and ellipses, or NULL. */
static String _first_sentence(String doc):
  String flat = _flat(doc)
  int ticks = 0, at = 0, length = flat ? flat.len() : 0
  while at < length:
    if flat[at] == '`':
      int end = at
      while end < length && flat[end] == '`': end++
      if !ticks: ticks = end - at
      else if ticks == end - at: ticks = 0
      at = end
      continue
    char mark = flat[at]
    if !ticks && (mark == '.' || mark == '!' || mark == '?'):
      int ellipsis = mark == '.' && ((at && flat[at - 1] == '.') ||
                                     (at + 1 < length && flat[at + 1] == '.'))
      if !ellipsis && (at + 1 == length || flat[at + 1] == ' '):
        return flat[:at + 1]
    at++
  return NULL

static void _flush_section(Array sections, String kind, Array lines):
  while lines.len() && !lines[-1].string().strip(NULL): lines.pop()
  while lines.len() && !lines[0].string().strip(NULL): lines.remove(0)
  if lines.len():
    sections.push(%($kind ${String.join("\n", lines)}))

/* Keyed sections of a doc comment as `(kind text)`, where kind is NULL for
   ordinary prose. Blank lines carry no meaning. */
static List _doc_sections(String doc):
  Array sections = [], lines = []
  String kind = NULL
  int fenced = 0
  foreach String line in doc.split("\n"):
    String stripped = line.lstrip(NULL)
    if stripped && stripped.startswith("```"): fenced = !fenced
    String key = NULL
    if !fenced && stripped:
      foreach String candidate in %("Raises" "See" "API"):
        if !key && stripped.startswith(candidate + ":"): key = candidate
    if key:
      _flush_section(sections, kind, lines)
      kind = key
      lines = [stripped[key.len() + 1:].lstrip(NULL)]
    else: lines.push(line)
  _flush_section(sections, kind, lines)
  return sections.list_free()

/* The minimum source-owned public documentation contract. */
static String _public_doc(String label, String name, int line, String doc):
  if !doc:
    _fatal(%"$label $name at line $line has no doc comment; every public " +
           "declaration needs prose")
  if !_first_sentence(doc):
    _fatal(%"$label $name at line $line needs a punctuated first-sentence " +
           "summary outside code spans and ellipses")
  return doc

static String _api_doc(String name, int line, String doc, String tier):
  doc = _public_doc("lib API", name, line, doc)
  foreach List section in _doc_sections(doc):
    if section.car() == "API":
      _fatal(%"lib API $name at line $line carries a source-level API " +
             "tier; classify non-primary callables in " +
             "docs/library-api-tiers.txt")
  if tier == "compatibility":
    String flat = _flat(doc).lower()
    if !flat.contains("prefer ") && !flat.contains("preferred"):
      _fatal(%"lib API $name at line $line is compatibility-tiered but " +
             "does not name a preferred operation")
  return doc

/* One documented callable: `name`, `receiver`, `method`, `signature`,
   `line`, `doc`, `summary`, and `tier` (NULL for the compiler API). */
static Map _item(List definition, String tier, String label):
  (String name, String signature, int line, String doc) = definition
  Map item = {}
  List parts = name.partition(".")
  item["name"] = name
  item["receiver"] = parts.cadr() ? parts.car() : ""
  item["method"] = parts.cadr() ? parts.caddr() : name
  item["signature"] = signature
  item["line"] = line
  item["tier"] = tier
  item["doc"] = tier ? _api_doc(name, line, doc, tier)
                     : _public_doc(label, name, line, doc)
  item["summary"] = _first_sentence(item["doc"])
  return item

static int _future_public(String name) =>
  !name.startswith("_") && !name.contains("__")

/* The public types written in `unit`, as the reference has always listed
   them: typedef and class statements before the first `#pragma private`,
   a class completion replacing its forward declaration. */
static List _declarations(Unit unit):
  Path source = root.join(unit["path"])
  int cut = 0, number = 0
  foreach String line in source.read_text().split("\n"):
    number++
    if private_pragma.match(line):
      cut = number
      break
  Array found = []
  Map classes = {}
  foreach Map row in unit["types"].array():
    String text = row["text"]
    int line = row["line"].integer()
    if !row["span"] || (cut && line > cut): continue
    if row["name"].str().startswith("x2c_var_abi_"): continue
    if row["kind"] != <class>:
      found.push(row)
      continue
    String name = row["name"]
    if !classes.contains(name):
      classes[name] = found.len()
      found.push(row)
    else if text != %"class $name": found[classes[name].integer()] = row
  return found.list_free()

/* Validates and returns the public callables and types of one unit. */
static List _public_surface(Unit unit, int compiler):
  String path = unit["path"]
  String label = compiler ? %"$path compiler API" : %"$path API"
  Array callables = [], declarations = []
  foreach List definition in unit.callables():
    (String name, String signature, int line, String doc) = definition
    if !_future_public(name):
      if doc:
        _fatal(%"$path:$line: $name carries a doc comment but is excluded " +
               "from the public API")
      continue
    _public_doc(label, name, line, doc)
    callables.push(definition)
  foreach Map row in _declarations(unit):
    String name = row["name"]
    int line = row["line"].integer()
    String doc = Prose.normalize(row["doc"])
    if !_future_public(name):
      if doc:
        _fatal(%"$path:$line: $name carries a doc comment but is excluded " +
               "from the public API")
      continue
    Map item = {}
    item["name"] = name
    item["kind"] = row["kind"].str()
    item["signature"] = row["text"]
    item["line"] = line
    item["doc"] = _public_doc(label, name, line, doc)
    item["summary"] = _first_sentence(doc)
    declarations.push(item)
  return %(${callables.list_free()} ${declarations.list_free()})

// Ledgers

static Array _ledger_rows(Path path, String expected):
  Array rows = []
  int number = 0
  foreach String line in path.read_text().split("\n"):
    number++
    if !line.strip(NULL) || line.startswith("#"): continue
    Array parts = line.split("|")
    if parts.len() != 3:
      _fatal(%"${_relative(path)}:$number: expected $expected")
    rows.push(%($number ${parts[0].string().strip(NULL)}
                ${parts[1].string().strip(NULL)}
                ${parts[2].string().strip(NULL)}))
  return rows

/* `path` to `(visibility note)` for every library module. */
static Map _manifest(int validate):
  Map rows = {}
  String where = "docs/library-manifest.txt"
  foreach List row in _ledger_rows(root.join(where), "path|visibility|note"):
    (int number, String path, String visibility, String note) = row
    if !%("api" "contract" "optional" "internal").contains(visibility):
      _fatal(%"$where:$number: visibility '$visibility' is not one of " +
             "api, contract, optional, internal")
    if rows.contains(path):
      _fatal(%"$where:$number: duplicate row for $path")
    rows[path] = %($visibility $note)
  if !validate: return rows
  Map present = {}
  foreach Path source in root.join("lib/*.x").glob():
    String path = _relative(source)
    if path != "lib/x2c.x": present[path] = 1
  foreach String path in present.keys().list().sort():
    if !rows.contains(path):
      _fatal(%"$path is not classified in $where; add a row marking it " +
             "api, contract, optional, internal")
  foreach String path in rows.keys().list().sort():
    if !present.contains(path):
      _fatal(%"$where lists $path, which does not exist")
  return rows

/* `path|name` to tier for every non-primary callable. */
static Map _tier_ledger(void):
  Map tiers = {}
  String where = "docs/library-api-tiers.txt"
  foreach List row in _ledger_rows(
      root.join(where), "path|tier|comma-separated callables"):
    (int number, String path, String tier, String names) = row
    if !%("advanced" "compatibility" "internal").contains(tier):
      _fatal(%"$where:$number: tier '$tier' must be one of advanced, " +
             "compatibility, internal; unlisted callables are primary")
    foreach String raw in names.split(","):
      String name = raw.strip(NULL)
      if !name:
        _fatal(%"$where:$number: expected at least one comma-separated " +
               "callable")
      String key = %"$path|$name"
      if tiers.contains(key):
        _fatal(%"$where:$number: duplicate classification for $name in " +
               path)
      tiers[key] = tier
  return tiers

// Collection

static Map _module(Unit unit, String visibility, String note):
  String path = unit["path"]
  String summary = unit.summary()
  if summary.startswith("Current source module"):
    _fatal(%"$path has no module comment to summarize; add a " +
           "`/*  <file>.x -- <summary>` header")
  Array prose = []
  List paragraphs = Prose.paragraphs(unit["module"])
  if paragraphs:
    foreach String paragraph in paragraphs.cdr():
      if !paragraph.lstrip(NULL).startswith("Copyright"):
        prose.push(paragraph)
  Map module = {}
  module["path"] = path
  module["stem"] = Path.new(path).stem()
  module["visibility"] = visibility
  module["note"] = note
  module["summary"] = summary
  module["prose"] = prose
  module["items"] = []
  module["declarations"] = []
  return module

static Array _collect(Map units):
  Map manifest = _manifest(1), remaining = _tier_ledger()
  Array modules = []
  foreach String path in manifest.keys().list().sort():
    (String visibility, String note) = manifest[path].list()
    Unit unit = units[path]
    Map module = _module(unit, visibility, note)
    if visibility == "api" || visibility == "optional":
      (List callables, List declarations) = _public_surface(unit, 0)
      foreach List definition in callables:
        String key = %"$path|${definition.car()}"
        String tier = "primary"
        if remaining.contains(key):
          tier = remaining[key]
          remaining.del(key)
        module["items"].array().push(_item(definition, tier, NULL))
      foreach Map item in declarations:
        module["declarations"].array().push(item)
    else:
      foreach Map row in unit["functions"].array():
        if row["static"].integer() || !Prose.normalize(row["doc"]): continue
        if row["origin"] == <macro> && row["line"].integer() == 1: continue
        _fatal(%"$path:${row["line"]}: ${row["display"]} carries a doc " +
               %"comment but $path is marked $visibility")
    modules.push(module)
  if remaining.len():
    (String path, String name) =
      remaining.keys().list().sort().car().str().partition("|")
    _fatal(%"docs/library-api-tiers.txt classifies $name in $path, but " +
           "that name is not a published callable in that module")
  foreach Map module in modules:
    int primary = 0
    foreach Map item in module["items"].array():
      if item["tier"] == "primary": primary = 1
    if primary && !evidence.contains(module["stem"]):
      _fatal(%"${module["path"]} has primary API but no executable " +
             "evidence mapping")
  return modules

static Array _collect_compiler(Map units, List paths):
  Array modules = []
  foreach String path in paths:
    Unit unit = units[path]
    Map module = _module(unit, "compiler", "")
    (List callables, List declarations) = _public_surface(unit, 1)
    foreach List definition in callables:
      module["items"].array().push(
        _item(definition, NULL, %"$path compiler API"))
    foreach Map item in declarations:
      module["declarations"].array().push(item)
    modules.push(module)
  return modules

// Rendering

static void _add(Array lines, List more):
  foreach String line in more: lines.push(line ? line : "")

static void _heading(Array lines, String name, int level):
  if !plain_id.match(name): lines.push(%"<a id=\"$name\"></a>")
  lines.push(%"${"#".repeat(level)} $name")

static String _see_link(Map module, Map item, String target):
  String where = %"${module["path"]}:${item["line"]}: ${item["name"]}"
  if target.endswith(".md") || target.contains("/"):
    if !pages_dir.join(target).exists():
      _fatal(%"$where has 'See: $target', which does not resolve to a page")
    return %"[${Path.new(target).stem()}]($target)"
  if !target.contains("."):
    _fatal(%"$where has 'See: $target'; expected a Type.method reference " +
           "or a page path")
  if !see_index.contains(target):
    _fatal(%"$where has 'See: $target', which is not a documented public " +
           "function")
  String stem = see_index[target]
  if stem == module["stem"]: return %"[`$target`](#$target)"
  return %"[`$target`]($stem.md#$target)"

/* A doc comment with its recognized keyed sections promoted. */
static void _doc(Array lines, Map module, Map item):
  foreach List section in _doc_sections(item["doc"]):
    (String kind, String text) = section
    if kind == "Raises": lines.push("**Raises:** " + text)
    else if kind == "See":
      Array links = []
      foreach String raw in _flat(text).split(","):
        String target = raw.strip(NULL)
        if target: links.push(_see_link(module, item, target))
      String linked = "**See:** " + String.join(", ", links.list_free())
      lines.push(String.join("\n", Prose.wrap(linked, 79)))
    else: lines.push(text)
    lines.push("")

static void _entry(Array lines, Map module, Map item, int level):
  _heading(lines, item["name"], level)
  _add(lines, %("" ${%"`${item["signature"]}`"} ""))
  _doc(lines, module, item)
  _add(lines, %(${%"Source: `${module["path"]}:${item["line"]}`"} ""))

static List _by_name(Array items) =>
  items.list().sort_by(%!(Map item) => item["name"])

static void _types(Array lines, Map module):
  Array declarations = module["declarations"]
  if !declarations.len(): return
  _add(lines, %("## Public types" "" "| Type | Kind | Summary |"
                "| --- | --- | --- |"))
  foreach Map item in _by_name(declarations):
    lines.push(%"| [`${item["name"]}`](#${item["name"]}) | " +
               %"${item["kind"]} | ${item["summary"]} |")
  lines.push("")
  foreach Map item in _by_name(declarations): _entry(lines, module, item, 3)

/* The summary table of `items`, then their entries grouped by receiver. */
static void _callables(Array lines, Map module, List items):
  _add(lines, %("| Function | Summary |" "| --- | --- |"))
  foreach Map item in
      items.sort_by(%!(Map item) => %(${item["receiver"]} ${item["method"]})):
    lines.push(%"| [`${item["name"]}`](#${item["name"]}) | " +
               %"${item["summary"]} |")
  lines.push("")
  Array receivers = []
  foreach Map item in items:
    if !receivers.contains(item["receiver"]): receivers.push(item["receiver"])
  foreach String receiver in receivers.list().sort():
    lines.push(receiver ? %"### `$receiver`" : "### Functions")
    lines.push("")
    List owned = items.filter(%!(Map item) => item["receiver"] == receiver)
    foreach Map item in owned.sort_by(%!(Map item) => item["method"]):
      _entry(lines, module, item, 4)

static void _prose(Array lines, Map module):
  Array prose = module["prose"]
  if !prose.len(): return
  _add(lines, %("## Design notes" ""))
  foreach String paragraph in prose: _add(lines, %($paragraph ""))

static String _text(Array lines) =>
  String.join("\n", lines).rstrip(NULL) + "\n"

static String _lead(Map module):
  String summary = module["summary"]
  return summary[:1].upper() + summary[1:]

static String _page(Map module):
  Array lines = [banner, "", %"# `${module["path"]}`", "", _lead(module), ""]
  List items = module["items"].array()
  int primary = 0
  foreach String tier in _tiers():
    List tiered = items.filter(%!(Map item) => item["tier"] == tier)
    if !tiered: continue
    if tier == "primary": primary = 1
    _add(lines, %(${%"## ${_tier_heading(tier)}"} ""))
    if tier == "internal":
      _add(lines, %(
        "These callables connect runtime translation units. They are documented"
        "for source readers but are not supported as user API." ""))
    _callables(lines, module, tiered)
  _types(lines, module)
  _prose(lines, module)
  if primary:
    _add(lines, %("## Tests and examples" "" ${evidence[module["stem"]]} ""))
  return _text(lines)

static String _compiler_page(Map module):
  Array lines = [compiler_banner, "", provisional, "",
                 %"# `${module["path"]}`", "", _lead(module), ""]
  List items = module["items"].array()
  if items:
    _add(lines, %("## Functions" ""))
    _callables(lines, module, items)
  _types(lines, module)
  _prose(lines, module)
  return _text(lines)

static int _published(Map module) =>
  module["visibility"] == "api" || module["visibility"] == "optional"

static List _visible(Array modules, String visibility) =>
  modules.list().filter(%!(Map module) => module["visibility"] == visibility)

static String _note(Map module):
  String note = module["note"]
  return note ? note : module["summary"]

static void _module_list(
  Array lines, Array modules, String visibility, List intro):
  List group = _visible(modules, visibility)
  if !group: return
  _add(lines, %("" @intro ""))
  foreach Map module in group:
    lines.push(%"- `${module["path"]}` - ${_note(module)}")

static String _index(Array modules):
  Array lines = [
    banner, "", "# Module Reference", "",
    "Reference pages list the functions and types in each runtime module.",
    "Start with the [standard library overview](../overview.md) to choose",
    "a type or find a function for a particular task.", "",
    "The [x2c C API](x2c-c-api.md) collects the stable `x2c_*` entry",
    "points used by generated code, native callers, and compiler setup.", "",
    "## Modules", "", "| Module | Description |", "| --- | --- |"]
  foreach Map module in modules:
    if _published(module):
      lines.push(%"| [`${module["path"]}`](${module["stem"]}.md) | " +
                 %"${module["summary"]} |")
  _module_list(lines, modules, "contract", %(
    "## Described by the overview" ""
    "These modules provide shared types and declarations. See the"
    "[standard library overview](../overview.md) for their use."))
  List optional = _visible(modules, "optional")
  if optional:
    _add(lines, %("" "## Optional x2c modules" ""
      "These modules ship with x2c but are not loaded by the standard"
      "prelude. Include one explicitly to use its declarations." ""))
    foreach Map module in optional:
      lines.push(%"- [`${module["path"]}`](${module["stem"]}.md) - " +
                 _note(module))
  _module_list(lines, modules, "internal", %(
    "## Runtime-internal" ""
    "These modules implement the runtime and are not public APIs."))
  return _text(lines)

static String _compiler_index(Array modules):
  Array lines = [compiler_banner, "", provisional, "",
                 "# Compiler API (provisional)", "",
                 "Functions and types exposed by each compiler module.", "",
                 "| Module | Description |", "| --- | --- |"]
  foreach Map module in modules:
    lines.push(%"| [`${module["path"]}`](${module["stem"]}.md) | " +
               %"${module["summary"]} |")
  return _text(lines)

static String _c_api(Array modules, Unit utils):
  Array rows = []
  foreach Map module in modules:
    foreach Map item in module["items"].array():
      if item["name"].str().startswith("x2c_"):
        rows.push(%(${module["path"]} ${module["stem"]} $item))
  foreach List definition in utils.callables():
    (String name, String signature, int line, String doc) = definition
    if !name.startswith("x2c_"): continue
    if !doc: _fatal(%"src/utils.x:$line: $name has no doc comment")
    rows.push(%("src/utils.x" "" ${_item(definition, "advanced", NULL)}))
  Array lines = [
    mixed_banner, "", "# x2c C API", "",
    "The `x2c_*` prefix is reserved for stable C entry points used by",
    "generated code, native callers, or process-wide compiler setup.",
    "Typed operations use methods such as `Atom.promote`",
    "and `Lisp.program`; their generated C spellings are not part of this",
    "prefix.", "", "| Function | Source | Signature |", "| --- | --- | --- |"]
  foreach List row in
      rows.list().sort_by(%!(List row) => row.caddr().map()["name"]):
    (String path, String stem, Map item) = row
    String name = item["name"]
    String function = stem ? %"[`$name`]($stem.md#$name)" : %"`$name`"
    lines.push(%"| $function | `$path` | `${item["signature"]}` |")
  _add(lines, %("" ${%"Total: ${rows.len()} functions."} ""))
  return String.join("\n", lines)

/* Replaces one generated section of SUMMARY.md, or inserts it before the
   `before` heading. */
static int _line(Array lines, String text):
  for (int at = 0; at < lines.len(); at++):
    if lines[at].string() == text: return at
  return -1

static Array _replace_section(
  Array lines, String heading, Array section, String before):
  int start = _line(lines, heading), end = -1
  if start >= 0:
    end = start + 1
    while end < lines.len() && !lines[end].string().startswith("# "): end++
  else:
    start = before ? _line(lines, before) : -1
    if start < 0:
      String destination = before ? %" before '$before'" : ""
      _fatal(%"docs/src/SUMMARY.md has no '$heading' heading and no " +
             %"stable insertion point$destination")
    end = start
  Array result = []
  for (int at = 0; at < start; at++): result.push(lines[at])
  foreach String line in section: result.push(line)
  for (int at = end; at < lines.len(); at++): result.push(lines[at])
  return result

static String _summary(Array modules, Array compiler, String current):
  Array standard = [
    library_section, "", "- [Standard Library](library/index.md)",
    "  - [Overview](library/overview.md)",
    "  - [Module Reference](library/modules/index.md)",
    "    - [x2c C API](library/modules/x2c-c-api.md)"]
  foreach Map module in modules:
    if _published(module):
      standard.push(%"    - [${module["path"]}](library/modules/" +
                    %"${module["stem"]}.md)")
  _add(standard, %(
    "- [Advanced Topics](library/advanced-topics.md)"
    "  - [Automatic Differentiation](guide/autodiff.md)"
    "  - [Verifying Functions with C*](guide/verification.md)"
    "  - [Training and Inference with torch](guide/torch.md)"
    "  - [The Region Model](guide/regions.md)" ""))
  Array lines = current.split("\n")
  String heading = lines.contains(library_section)
                 ? library_section : "# Standard library"
  lines = _replace_section(lines, heading, standard, NULL)
  Array section = [compiler_section, "",
                   "- [Compiler API (provisional)](internals/compiler-api/" +
                   "index.md)"]
  foreach Map module in compiler:
    section.push(%"  - [${module["path"]}](internals/compiler-api/" +
                 %"${module["stem"]}.md)")
  section.push("")
  lines = _replace_section(lines, compiler_section, section, internals_section)
  return String.join("\n", lines)

static List _sources(String pattern):
  Array paths = []
  foreach Path source in root.join(pattern).glob():
    String path = _relative(source)
    if path != "lib/x2c.x": paths.push(path)
  return paths.list_free()

static Map _load(List paths):
  Map units = {}
  foreach Unit unit in Unit.load(x2c, root, paths): units[unit["path"]] = unit
  return units

/* Every page as `(path text)`, then SUMMARY.md's text. */
static List _build(void):
  List compiler_paths = _sources("src/*.x")
  Map units = _load(_sources("lib/*.x").append(compiler_paths))
  Array modules = _collect(units)
  Array compiler = _collect_compiler(units, compiler_paths)
  see_index = {}
  foreach Map module in modules:
    if !_published(module): continue
    foreach Map item in module["items"].array():
      see_index[item["name"]] = module["stem"]
  Array pages = [
    %(${pages_dir.join("index.md")} ${_index(modules)}),
    %(${pages_dir.join("x2c-c-api.md")}
      ${_c_api(modules, units["src/utils.x"])}),
    %(${compiler_dir.join("index.md")} ${_compiler_index(compiler)})]
  foreach Map module in modules:
    if _published(module):
      pages.push(%(${pages_dir.join(%"${module["stem"]}.md")}
                   ${_page(module)}))
  foreach Map module in compiler:
    pages.push(%(${compiler_dir.join(%"${module["stem"]}.md")}
                 ${_compiler_page(module)}))
  String summary = _summary(modules, compiler, summary_path.read_text())
  return %(${pages.list_free()} $summary)

static List _stale(List pages):
  Map generated = {}
  foreach List entry in pages: generated[entry.car().str()] = 1
  Array stale = []
  foreach Path directory in %($pages_dir $compiler_dir):
    foreach Path page in directory.join("*.md").glob():
      if !generated.contains(page): stale.push(page)
  return stale.list_free()

static int _write(List pages, String summary):
  foreach List entry in pages:
    (Path path, String text) = entry
    path.dirname().make_dirs()
    Path temporary = path + ".tmp"
    temporary.write_text(text)
    temporary.move_to(path)
  foreach Path page in _stale(pages): page.remove_file()
  summary_path.write_text(summary)
  printf("wrote %d API pages and updated docs/src/SUMMARY.md\n", pages.len())
  return 0

static int _check(List pages, String summary):
  int problems = 0
  foreach List entry in pages:
    (Path path, String text) = entry
    String actual = path.exists() ? path.read_text() : ""
    String difference =
      Diff.unified(actual, text, _relative(path), "generated")
    if difference:
      Stderr.printf("%s", difference)
      problems++
  foreach Path page in _stale(pages):
    Stderr.printf("%s: page is no longer generated and should be removed\n",
                  _relative(page))
    problems++
  String difference = Diff.unified(
    summary_path.read_text(), summary, "docs/src/SUMMARY.md", "generated")
  if difference:
    Stderr.printf("%s", difference)
    problems++
  if problems:
    Stderr.printf("run 'make doc-generate' and review the API reference " +
                  "diff\n")
    return 1
  printf("API reference is current (%d pages)\n", pages.len())
  return 0

/* Audits assigned source paths without generating pages. */
static int _check_paths(List requested):
  Array paths = []
  Map manifest = NULL
  foreach String argument in requested:
    Path source = argument.startswith("/") ? Path.new(argument)
                                           : root.join(argument)
    String absolute = source.absolute()
    if !absolute.startswith(root + "/"):
      _fatal(%"$argument: path is outside $root")
    String path = absolute[root.len() + 1:]
    List parts = path.split("/")
    if parts.len() != 2 || !(parts.car() == "src" || parts.car() == "lib") ||
       !path.endswith(".x"):
      _fatal(%"$path: expected one hand-authored src/*.x or lib/*.x file")
    if !source.is_file() || path == "lib/x2c.x":
      _fatal(%"$path: source file does not exist or is generated")
    if parts.car() == "lib":
      if !manifest: manifest = _manifest(0)
      if !manifest.contains(path):
        _fatal(%"$path: not classified in the library manifest")
      String visibility = manifest[path].list().car()
      if visibility != "api" && visibility != "optional":
        _fatal(%"$path: $visibility library modules do not publish a " +
               "callable or type surface")
    paths.push(path)
  Map units = _load(paths)
  int callables = 0, declarations = 0
  foreach String path in paths:
    (List found, List types) =
      _public_surface(units[path], path.startswith("src/"))
    callables += found.len()
    declarations += types.len()
  printf("public documentation is complete for %d paths (%d callables, " +
         "%d types)\n", paths.len(), callables, declarations)
  return 0

