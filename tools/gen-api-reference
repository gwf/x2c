Array requested = []
int write = 0, check = 0
for (List rest = args; rest; rest = rest.cdr()):
  String argument = rest.car()
  if argument == "--write": write = 1
  else if argument == "--check": check = 1
  else if argument == "--check-path" && rest.cdr():
    rest = rest.cdr()
    requested.push(rest.car())
  else:
    Stderr.printf("%s%s: error: unrecognized arguments: %s\n", usage,
                  self.basename(), argument)
    return 2
