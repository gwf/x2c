#!/bin/sh
# pre-push -- shared worktree delivery policy for pushes to dev or main.
#
# Explicit roles apply to any worktree name. Legacy agent-* worktrees retain
# their worker restriction when no delivery context exists.
root=$(git rev-parse --show-toplevel) || exit 1
python3 "$root/tools/agent_context.py" blocked --root "$root"
policy=$?
case "$policy" in
  1) exit 0 ;;
  0) ;;
  *) echo "pre-push: cannot establish worktree delivery policy" >&2; exit 1 ;;
esac
while read -r _ _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/dev|refs/heads/main)
      echo "pre-push: this worktree does not publish to" \
        "${remote_ref#refs/heads/}; its integration owner lands the work" >&2
      exit 1 ;;
  esac
done
