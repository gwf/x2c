#!/bin/sh
# pre-push -- shared worktree delivery policy for pushes.
#
# A worker hands its commits to its orchestrator and pushes nothing. Other
# contexts that do not deliver directly push work branches but not dev or
# main. Explicit roles apply to any worktree name. Legacy agent-* worktrees
# retain the dev and main restriction when no delivery context exists.
root=$(git rev-parse --show-toplevel) || exit 1
policy=$(python3 "$root/tools/agent_context.py" pushes --root "$root")
case "$policy" in
  all) exit 0 ;;
  work) ;;
  none)
    echo "pre-push: this worker hands its commits to its orchestrator;" \
      "it does not push" >&2
    exit 1 ;;
  *) echo "pre-push: cannot establish worktree delivery policy" >&2; exit 1 ;;
esac
while read -r _ _ remote_ref _; do
  case "$remote_ref" in
    refs/heads/dev|refs/heads/main)
      echo "pre-push: this worktree does not publish to" \
        "${remote_ref#refs/heads/}; its integration owner lands the work" >&2
      exit 1 ;;
  esac
done
