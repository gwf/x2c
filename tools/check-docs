#!/usr/bin/env -S x2c script
#pragma indent
/*  check-docs -- read-only checks for the documentation truth surface

    The entry-point pages are audited for repository paths, cited line
    numbers, compiler flags, workflows, example classifications, module
    counts, and the project name. Links are resolved without their anchors in
    those pages and in the Markdown below agents/skills, plans, and packages.
    `site/` is absent on purpose: its links are URLs on the rendered site,
    which `make site-check` resolves against the built output.
*/
static Path root
static Array docs, link_docs, errors
static Regex link, flag, whitespace

/* Pages whose repository paths and cited line numbers are audited. */
static List _path_audit(void) => %(
  "AGENTS.md"
  "README.md"
  "agents/AGENTS.md"
  "agents/adapters-macros-decorators.md"
  "agents/logger-and-diagnostics-guide.md"
  "agents/quick-start.md"
  "agents/replacing-manual-ast-walks-with-match.md"
  "agents/x2c-code-organization-guide.md"
  "agents/x2c-debugging-guide.md"
  "agents/x2c-development-guide.md"
  "agents/x2c-docs-drift-report.md"
  "agents/x2c-module-catalog.md"
  "agents/x2c-philosophy.md"
  "docs/src/guide/idioms.md"
  "docs/src/internals/architecture.md"
  "docs/src/internals/implementation-map.md"
  "docs/src/library/overview.md"
  "docs/src/reference/cli.md"
  "docs/src/reference/language.md")

/* Pages whose `--flags` must be compiler options. */
static List _flag_audit(void) => %(
  "README.md"
  "agents/quick-start.md"
  "agents/x2c-debugging-guide.md"
  "agents/x2c-philosophy.md"
  "docs/src/guide/idioms.md"
  "docs/src/internals/architecture.md"
  "docs/src/internals/implementation-map.md"
  "docs/src/library/overview.md"
  "docs/src/reference/cli.md"
  "docs/src/reference/language.md")

/* These pages also run other programs, so only lines that name x2c count. */
static List _line_flag_audit(void) => %("docs/src/guide/scripting.md")

static List _workflow_audit(void) => %(
  "AGENTS.md"
  "README.md"
  "agents/AGENTS.md"
  "agents/quick-start.md"
  "agents/x2c-debugging-guide.md"
  "agents/x2c-development-guide.md"
  "docs/src/guide/idioms.md"
  "docs/src/internals/architecture.md"
  "docs/src/internals/implementation-map.md"
  "docs/src/library/overview.md"
  "docs/src/reference/language.md")

static List _example_audit(void) => %(
  "docs/src/guide/idioms.md"
  "docs/src/internals/implementation-map.md"
  "docs/src/library/overview.md"
  "docs/src/reference/language.md")

/* Each page's `(start end)` markers around its list of src modules. */
static List _src_module_lists(void) => %(
  ("AGENTS.md" "- `src/` - the compiler" "- `lib/` -")
  ("docs/src/internals/architecture.md" "## Module ownership"
   "## The runtime boundary"))

static String _relative(Path path):
  String text = path
  return text[root.len() + 1:]

static String _read(String relative) => root.join(relative).read_text()

static String _where(String relative, String text, int offset) =>
  %"$relative:${text[:offset].count("\n") + 1}"

static int _start(RegexMatch found) => found.capture(0).start()

/* Fetched, installed, or rendered trees grow inside the link-checked
   directories and carry Markdown that is not ours to repair. */
static int _untracked(String relative):
  foreach String part in relative.split("/"):
    if %("build" "builds" "deps" "dist" "node_modules").contains(part):
      return 1
  return 0

/* Appends the Markdown files below `directory` in path-component order. */
static void _markdown_below(String directory, int tracked, Array into):
  foreach Path path in root.join(directory).walk():
    String relative = _relative(path)
    if relative.endswith(".md") && !(tracked && _untracked(relative)):
      into.push(relative)

static void _markdown_in(String directory, Array into):
  foreach String name in root.join(directory).list_dir():
    if name.endswith(".md"): into.push(%"$directory/$name")

/* Collapses `.` and `..` the way resolving the path would. */
static String _normalized(String path):
  Array parts = []
  foreach String part in path.split("/"):
    if !part || part == ".": continue
    if part == ".." && parts.len(): parts.pop()
    else: parts.push(part)
  return String.join("/", parts.list_free())

static int _line_count(Path path) => path.read_text().split_lines(0).len()

static void _check_links(void):
  Regex word = Regex.compile("\\S+")
  foreach String relative in link_docs:
    String text = _read(relative)
    String directory = relative.rpartition("/").car()
    foreach RegexMatch found in link.find_all(text):
      RegexMatch first = word.match(found[1].strip(NULL).strip("<>"))
      String target = first ? first[0] : ""
      if target.startswith("#") || target.startswith("http://") ||
          target.startswith("https://"):
        continue
      target = target.partition("#").car()
      String joined = directory ? %"$directory/$target" : target
      if !target || !root.join(_normalized(joined)).exists():
        errors.push(%"${_where(relative, text, _start(found))}: " +
                    %"missing link $target")

/* Paths below generated trees may be cited before they exist. */
static int _generated(String path):
  Array parts = []
  foreach String part in path.split("/"):
    if part && part != ".": parts.push(part)
  String clean = String.join("/", parts.list_free())
  foreach String tree in %("unittest/build" "docs/book" "site/dist"):
    if clean == tree || clean.startswith(tree + "/"): return 1
  return 0

static void _check_paths(void):
  Regex cited_path = Regex.compile(
    "`((?:src|lib|docs|agents|plans|tools|unittest|examples|etc|packages|"
    "site)/[^`\\s]+)`")
  Regex cited_lines = Regex.compile(":(\\d+(?:\\s*[-,]\\s*\\d+)*)$")
  Regex digits = Regex.compile("\\d+")
  Map counts = {}
  foreach String relative in _path_audit():
    String text = _read(relative)
    foreach RegexMatch found in cited_path.find_all(text):
      String raw = found[1].rstrip(".,;:)")
      int cited = 0
      RegexMatch lines = cited_lines.match(raw)
      if lines:
        foreach RegexMatch number in digits.find_all(lines[1]):
          cited = atoi(number[0])
        raw = raw[:_start(lines)]
      if strpbrk(raw, "*?[<"): continue
      Path resolved = root.join(raw)
      String where = _where(relative, text, _start(found))
      if !resolved.exists():
        if !_generated(raw): errors.push(%"$where: missing path $raw")
        continue
      if !cited || !resolved.is_file(): continue
      if !counts.contains(raw): counts[raw] = _line_count(resolved)
      int count = counts[raw]
      if cited > count:
        errors.push(%"$where: $raw has $count lines, so line $cited does " +
                    "not exist")

/* The `--flags` of `text`, excluding those glued to a preceding word. */
static List _flags(String text):
  Array flags = []
  foreach RegexMatch found in flag.find_all(text):
    int start = _start(found)
    int before = start ? text[start - 1] : 0
    if !scan_ascii_alpha(before) && !scan_ascii_digit(before) &&
        before != '-':
      flags.push(found)
  return flags.list_free()

static void _check_flags(void):
  String source = _read("src/cli.x")
  String table = source.partition("static CliOption cli_options[] = {")
                   .caddr()
  table = table.partition("\n};").car()
  Map valid = {}
  foreach RegexMatch found in _flags(table): valid[found[0]] = 1
  List pages = _flag_audit().append(_line_flag_audit())
  foreach String relative in pages:
    String text = _read(relative)
    int every_line = _flag_audit().contains(relative), offset = 0
    foreach String line in text.split_lines(1):
      /* Words after a lone `--` belong to the program being run. */
      String options = line.partition(" -- ").car()
      if every_line || options.contains("x2c"):
        foreach RegexMatch found in _flags(options):
          if !valid.contains(found[0]):
            errors.push(%"${_where(relative, text, offset + _start(found))}" +
                        %": unknown flag ${found[0]}")
      offset += line.len()

static void _check_workflows(void):
  Regex verbose = Regex.compile("make build-safe[^\\n]*\\bV=1\\b")
  Regex include = Regex.compile("\\bcc\\s+-I\\s+include\\b")
  foreach String relative in _workflow_audit():
    String text = _read(relative)
    int offset = text.find("OVERVIEW.md")
    if offset >= 0:
      errors.push(%"${_where(relative, text, offset)}: missing OVERVIEW.md " +
                  "entry page")
    RegexMatch found = verbose.match(text)
    if found:
      errors.push(%"${_where(relative, text, _start(found))}: unsupported " +
                  "V=1 workflow")
    found = include.match(text)
    if found:
      errors.push(%"${_where(relative, text, _start(found))}: use -iquote " +
                  "include so runtime headers do not shadow system headers")
    Array lines = text.split_lines(0)
    for (int index = 0; index < lines.len(); index++):
      String line = lines[index]
      if !line.contains("make build-safe") || !line.contains("debug/") ||
          !line.contains(">") || line.contains("mkdir -p debug"):
        continue
      int prior = 0
      for (int at = index < 3 ? 0 : index - 3; at < index; at++):
        if lines[at].str().contains("mkdir -p debug"): prior = 1
      if !prior:
        errors.push(%"$relative:${index + 1}: create debug/ before " +
                    "redirecting bootstrap output")

static void _check_example_claims(void):
  Map manifest = {}
  foreach String line in _read("examples/manifest.txt").split_lines(0):
    if line && !line.startswith("#"):
      List fields = line.split("|")
      manifest[fields.car()] = fields.cdr()
  Regex example = Regex.compile("`(examples/([a-zA-Z0-9_/-]+)\\.x)`")
  foreach String relative in _example_audit():
    String text = _read(relative)
    foreach RegexMatch found in example.find_all(text):
      String raw = found[1], where = _where(relative, text, _start(found))
      if !manifest.contains(found[2]):
        errors.push(%"$where: unclassified example $raw")
        continue
      (String category, String action) = manifest[found[2]].list()
      if action == "run" || action == "build": continue
      String marker = %"(${category.replace("-", " ")})"
      int end = found.capture(0).end(), stop = end + marker.len() + 1
      String after = text[end:stop < text.len() ? stop : text.len()]
      if !after.lstrip(NULL).startswith(marker):
        errors.push(%"$where: $raw is $category, not checked; " +
                    %"label it $marker")

/* Python's spelling of a list of names, as the old checker printed it. */
static String _name_list(Array names):
  Array quoted = []
  foreach String name in names.sort(): quoted.push(%"'$name'")
  return "[" + String.join(", ", quoted.list_free()) + "]"

static void _check_module_counts(void):
  Array sources = []
  foreach String name in root.join("src").list_dir():
    if name.endswith(".x"): sources.push(name.remove_suffix(".x"))
  int src_count = sources.len(), lib_count = 0
  foreach String name in root.join("lib").list_dir():
    if name.endswith(".x") && name != "x2c.x": lib_count++
  Regex counted = Regex.compile(
    "\\b(\\d+|sixteen|eighteen|twenty)([ -]\\w+)*[ -]modules\\b")
  foreach String relative in docs:
    String text = _read(relative)
    foreach RegexMatch found in counted.find_all(text):
      int start = _start(found)
      String word = found[1]
      int count = word == "sixteen" ? 16 : word == "eighteen" ? 18 :
                  word == "twenty" ? 20 : atoi(word)
      String context = text[start < 40 ? 0 : start - 40:start].lower()
      int expected = context.contains("runtime") ? lib_count : src_count
      if count != expected:
        errors.push(%"${_where(relative, text, start)}: '${found[0]}' says " +
                    %"$count but expected $expected")
  Regex quoted = Regex.compile("`([^`]+)`")
  Regex module = Regex.compile("^(?:src/)?([a-z][a-z0-9-]*)(?:\\.x)?$")
  foreach List entry in _src_module_lists():
    (String relative, String start_marker, String end_marker) = entry
    String text = _read(relative)
    int start = text.find(start_marker)
    int end = start < 0 ? -1 : text.find_within(end_marker, start, -1)
    if end < 0:
      errors.push(%"$relative: missing the src module list markers")
      continue
    Map listed = {}
    foreach RegexMatch found in quoted.find_all(text[start:end]):
      RegexMatch name = module.match(found[1])
      if name: listed[name[1]] = 1
    Array missing = [], extra = []
    foreach String name in sources:
      if !listed.contains(name): missing.push(name)
    foreach String name in listed.keys():
      if name != "src" && !sources.contains(name): extra.push(name)
    if missing.len() || extra.len():
      errors.push(%"${_where(relative, text, start)}: src module list " +
                  %"differs from src/*.x; missing=${_name_list(missing)}, " +
                  %"extra=${_name_list(extra)}")

static String _collapsed(String text) =>
  whitespace.replace_all(text.lower(), " ")

/* Each `(name status)` row of the philosophy guide's contract ledger. */
static List _ledger_rows(String text):
  Regex row = Regex.compile(
    "(?m)^\\|\\s*([^|]+?)\\s*\\|\\s*([^|]+?)\\s*\\|")
  int start = text.find("## Contract ledger")
  int stop = text.find("## Verified contracts")
  Array rows = []
  foreach RegexMatch found in row.find_all(text[start:stop]):
    String name = found[1]
    if name == "Contract" || name == "---": continue
    rows.push(%(${_collapsed(name.replace("`", ""))} ${found[2]}))
  return rows.list_free()

static void _check_ledger_placement(void):
  String relative = "agents/x2c-philosophy.md", text = _read(relative)
  List rows = _ledger_rows(text)
  int start = text.find("## Partial contracts and open decisions")
  int stop = text.find("## Working rules")
  List sections = Regex.compile("(?m)^### ").split(text[start:stop]).cdr()
  foreach String section in sections:
    (String heading, String mark, String body) = section.partition("\n")
    heading = heading.strip(NULL)
    String full = _collapsed(heading + " " + body).replace("**", "")
    int open = 0
    foreach List entry in rows:
      (String name, String status) = entry
      if full.contains(name) && status != "verified": open = 1
    if !open:
      errors.push(%"$relative:section '$heading': no non-verified ledger " +
                  "row found for this 'Partial contracts' section; move it " +
                  "under 'Verified contracts' or name its open ledger row")

static Job _generator(String script) =>
  %(python3 $script --check).job()
    .options({dir: root, stderr: <capture>}).start()

static void _check_generator(Job job, String what):
  if !job.status(): return
  String detail = job.errors() ? job.errors().strip(NULL) : NULL
  if !detail:
    try detail = job.output()
    catch %(cmd-fail *failure): detail = %"${failure.assoc(<output>)}"
    detail = detail ? detail.strip(NULL) : ""
  errors.push(%"$what is stale\n$detail")

static void _check_banned_name(void):
  /* The project is named "x2c" only. It is pronounced like a certain drug,
     and voice-to-text keeps introducing that spelling; it must never reach
     the tree. */
  Regex banned = Regex.compile("(?i)\\becstas(?:y|ies)\\b")
  foreach String relative in docs:
    String text = _read(relative)
    foreach RegexMatch found in banned.find_all(text):
      errors.push(%"${_where(relative, text, _start(found))}: the project " +
                  "is named x2c; do not spell out the word it is pronounced " +
                  "like")

/* Every book page is reachable from SUMMARY.md, and every entry exists. */
static void _check_summary(void):
  String relative = "docs/src/SUMMARY.md", text = _read(relative)
  Map listed = {}
  foreach RegexMatch found in link.find_all(text):
    String target = found[1].strip(NULL).partition("#").car()
    if !target || target.startswith("http://") ||
        target.startswith("https://"):
      continue
    String page = _normalized(%"docs/src/$target")
    listed[page] = 1
    if !root.join(page).exists():
      errors.push(%"${_where(relative, text, _start(found))}: SUMMARY.md " +
                  %"entry has no file $target")
  Array pages = []
  _markdown_below("docs/src", 0, pages)
  foreach String page in pages:
    if page != relative && !listed.contains(page):
      errors.push(%"$page: page is not reachable from docs/src/SUMMARY.md")

root = Path.new(argv[0]).absolute().dirname().dirname()
/* The generated references are rendered from the stage's unit interfaces. */
if !root.join("builds/0/*/*.xi").glob().len():
  Stderr.printf("documentation audit needs the unit interfaces under "
                "builds/0; run 'make build'\n")
  return 1
link = Regex.compile("!?\\[[^]]*\\]\\(([^)]+)\\)")
flag = Regex.compile("--[a-zA-Z][a-zA-Z0-9-]*")
whitespace = Regex.compile("\\s+")
docs = ["README.md", "AGENTS.md"]
_markdown_in("agents", docs)
_markdown_in("docs", docs)
_markdown_below("docs/src", 0, docs)
link_docs = []
foreach String relative in docs: link_docs.push(relative)
foreach String directory in %("agents/skills" "packages" "plans"):
  _markdown_below(directory, 1, link_docs)
errors = []

Job catalog = _generator("tools/gen-module-catalog.py")
Job reference = _generator("tools/gen-api-reference.py")
_check_generator(catalog, "module catalog")
_check_generator(reference, "library reference")
_check_summary()
_check_banned_name()
_check_links()
_check_paths()
_check_flags()
_check_workflows()
_check_example_claims()
_check_module_counts()
_check_ledger_placement()
if errors.len():
  Stderr.printf("documentation audit failed:\n")
  foreach String error in errors: Stderr.printf("- %s\n", error)
  return 1
printf("documentation audit passed: %d files, %d link-checked files, "
       "%d path-audited entry points\n", (int) docs.len(),
       (int) link_docs.len(), _path_audit().len())
