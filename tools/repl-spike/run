#!/bin/sh
set -eu
cd "$(dirname "$0")/../.."
build=unittest/build/repl-spike
mkdir -p "$build"
objects=
for object in builds/0/src/*.o; do
  case "$object" in */main.o) ;; *) objects="$objects $object" ;; esac
done
builds/0/x2c build --plain --kind static-library \
  --output "$build/compiler.a" $objects
builds/0/x2c build --plain --build-dir "$build/native" --output "$build/repl" \
  --x-include-dir src --c-include-dir builds/0/src \
  tools/repl-spike/repl.x tools/repl-spike/session.x "$build/compiler.a"
printf '%s\n' '$(begin)' > "$build/seed.x"
if [ "${1-}" = --build-only ]; then exit 0; fi
exec "$build/repl" "$build/seed.x" "$@"
