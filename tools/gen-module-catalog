#!/usr/bin/env -S x2c script
#pragma indent
/*  gen-module-catalog -- generate the module and public-function catalog

    Lists every `src/*.x` and `lib/*.x` module with its summary and the
    non-static functions the compiler says it defines, in source order.
*/
#include "definitions.x"

static Path root, output

/* The functions of one module as backquoted names wrapped at 79 columns
   without breaking a name. */
static void _names(Array lines, List callables):
  if !callables:
    lines.push("None. This module has no non-static function definitions.")
    return
  Array names = []
  foreach List definition in callables: names.push(%"`${definition.car()}`")
  foreach String line in Prose.wrap(String.join(", ", names.list_free()), 79):
    lines.push(line)

static String _render(Array units):
  int compiler = 0
  foreach Unit unit in units:
    if unit["path"].str().startswith("src/"): compiler++
  Array lines = [
    "# X2C Module and API Catalog", "",
    "> Generated by `make doc-generate` from",
    "> current `src/*.x` and `lib/*.x` sources. Do not edit by hand.", "",
    "The catalog lists every authoritative source module and every",
    "non-static function definition discovered in source order. It does",
    "not claim that partial runtime contracts are complete; consult",
    "`agents/x2c-philosophy.md` for contract status.", "",
    %"- Compiler modules: $compiler",
    %"- Runtime modules: ${units.len() - compiler}",
    "- Generated runtime aggregator: `lib/x2c.x` (`lib/Makefile` owns it)",
    ""]
  String group = NULL
  foreach Unit unit in units:
    String path = unit["path"]
    String title = path.startswith("src/") ? "Compiler modules"
                                           : "Runtime modules"
    if title != group:
      lines.push(%"## $title")
      lines.push("")
      group = title
    lines.push(%"### [$path](../$path)")
    lines.push("")
    lines.push(unit.summary())
    lines.push("")
    lines.push("Public functions:")
    lines.push("")
    _names(lines, unit.callables())
    lines.push("")
  return String.join("\n", lines).rstrip(NULL) + "\n"

Path self = String.new(argv[0])
root = self.absolute().dirname().dirname()
output = root.join("agents/x2c-module-catalog.md")
Path x2c = root.join("builds/0/x2c")
if !x2c.exists():
  Stderr.printf("builds/0/x2c is missing; run 'make build' first\n")
  return 1
String usage = %"usage: ${self.basename()} [-h] [--write | --check]\n"
if args.contains("-h") || args.contains("--help"):
  printf("%s\noptions:\n  -h, --help  show this help message and exit\n"
         "  --write\n  --check\n", usage)
  return 0
Map options = NULL
try options = Args.parse(args, %((--write) (--check)))
catch %(bad-arg *detail):
  Stderr.printf("%s%s: error: %s\n", usage, self.basename(),
                detail.assoc(<why>))
  return 2
int write = options["write"].integer(), check = options["check"].integer()
if write && check:
  Stderr.printf("%s%s: error: argument --check: not allowed with argument "
                "--write\n", usage, self.basename())
  return 2

Array paths = []
foreach String pattern in %("src/*.x" "lib/*.x"):
  foreach Path source in root.join(pattern).glob():
    String path = source
    path = path[root.len() + 1:]
    if path != "lib/x2c.x": paths.push(path)
String text = _render(Unit.load(x2c, root, paths))
if write:
  output.write_text(text)
  printf("wrote agents/x2c-module-catalog.md\n")
  return 0
if check:
  String actual = output.exists() ? output.read_text() : ""
  if actual == text:
    printf("module catalog is current\n")
    return 0
  Stderr.printf("%s", Diff.unified(actual, text, "agents/x2c-module-catalog.md",
                                   "generated catalog"))
  Stderr.printf("run 'make doc-generate' and review the catalog diff\n")
  return 1
printf("%s", text)
