#!/usr/bin/env -S x2c script
/*  syntax-spec -- inspect syntax data and render its documentation */
#include "../etc/syntax/grammar.x"
#include "../etc/syntax/lexical.x"
#include "../etc/syntax/extensions.x"

static Path root;
static List grammar, lexical, extensions;

static List section(List record, String key) {
    foreach (List row, record.cdr())
        if (row.car().str() == key) return row.cdr();
    return NULL;
}

static void fail(String reason) {
    raise %(syn-error (reason ${reason}));
}

static Map rules(void) {
    Map result = {};
    foreach (List row, section(grammar, "rules"))
        result[row.cadr().str()] = row.caddr();
    return result;
}

static void references(Var node, String tag, Map result) {
    if (node is not <list>) return;
    match (node) {
        case %(?kind ?name):
            if (kind.str() == tag) { result[name.str()] = 1; return; }
    }
    foreach (Var child, node.list()) references(child, tag, result);
}

static List sorted_keys(Map values) => values.keys().list().sort();

static String ebnf_group(Array parts, String separator) {
    List items = parts.list_free();
    String flat = String.join(separator, items);
    if (flat.len() <= 88) return "( " + flat + " )";
    return "( " + String.join(separator.rstrip(NULL) + "\n    ", items) + " )";
}

static String ebnf(List node) {
    match (node) {
        case %(ref ?name): return name.str();
        case %(token ?spelling): return spelling.repr();
        case %(external ?contract): return "? " + contract.str() + " ?";
        case %(optional ?body): return "[ " + ebnf(body) + " ]";
        case %(repeat 0 ?body): return "{ " + ebnf(body) + " }";
        case %(seq *items): {
            Array parts = [];
            foreach (List item, items) parts.push(ebnf(item));
            return ebnf_group(parts, " , ");
        }
        case %(choice *items): {
            Array parts = [];
            foreach (List item, items) parts.push(ebnf(item));
            return ebnf_group(parts, " | ");
        }
        default: fail("unknown grammar expression: " + node.repr());
    }
    return NULL;
}

static String grammar_text(void) {
    Array lines = [];
    lines.push("(* Generated by tools/syntax-spec write from etc/syntax/grammar.x.\n"
               "   Read grammar.md and lexical.md for contextual contracts.\n"
               "   Strings are token spellings; ? ... ? marks external recognition. *)\n");
    foreach (List row, section(grammar, "rules"))
        lines.push(row.cadr().str() + " = " + ebnf(row.caddr()) + " ;");
    return String.join("\n", lines.list_free()) + "\n";
}

static String clean_repr(List value) {
    Array lines = [];
    foreach (String line, value.repr().lines()) lines.push(line.rstrip(NULL));
    return String.join("\n", lines.list_free());
}

static String lexical_text(void) {
    Array lines = [];
    lines.push("# Lexical data inventory\n\n"
               "Generated by `tools/syntax-spec write` from `etc/syntax/lexical.x`.\n"
               "See [the lexical specification](lexical.md) for explanations and\n"
               "[the data model](data.md) for notation and consumption.\n");
    foreach (List group, lexical.cdr()) {
        String name = group.car().str();
        lines.push("## " + name + "\n");
        lines.push("```text\n" + clean_repr(group) + "\n```\n");
    }
    return String.join("\n", lines.list_free());
}

static String cell(String text) => text.replace("|", "&#124;").replace("\n", " ");

static String extension_table(void) {
    Array lines = [];
    lines.push("| Extension family | Grammar additions | Lexical changes |\n"
               "| --- | --- | --- |");
    foreach (List feature, section(extensions, "features")) {
        String title = section(feature, "title").car().str();
        String link = section(feature, "reference").car().str();
        String syntax = section(feature, "grammar-note").car().str();
        String lexing = section(feature, "lexical-note").car().str();
        lines.push("| [" + cell(title) + "](" + link + ") | " + cell(syntax) +
                   " | " + cell(lexing) + " |");
    }
    return String.join("\n", lines.list_free());
}

static String extension_text(void) {
    Path path = root.join("docs/src/guide/x2c-syntax-map.md");
    String text = path.read_text();
    String start = "<!-- syntax-extensions:start -->";
    String end = "<!-- syntax-extensions:end -->";
    List before = text.partition(start), after = before.caddr().str().partition(end);
    if (!before.cadr().str() || !after.cadr().str()) fail("missing extension table markers");
    return before.car().str() + start + "\n\n" + extension_table() + "\n\n" +
           end + after.caddr().str();
}

static Map lexical_names(String group, String tag) {
    Map names = {};
    foreach (List row, section(lexical, group)) {
        if (row.car().str() != tag) continue;
        String name = row.cadr().str();
        if (names.contains(name)) fail("duplicate lexical " + tag + " " + name);
        names[name] = 1;
    }
    return names;
}

static void mode_targets(void) {
    Map names = lexical_names("modes", "mode");
    foreach (List row, section(lexical, "transitions")) {
        foreach (Var name, section(row, "from"))
            if (!names.contains(name.str())) fail("unknown source mode " + name.str());
        foreach (Var name, section(row, "push"))
            if (!names.contains(name.str())) fail("unknown pushed mode " + name.str());
    }
    foreach (List pair, %(("transitions" "transition") ("predicates" "predicate"))) {
        String tag = pair.cadr().str();
        Map known = lexical_names(pair.car().str(), tag), used = {};
        references(lexical, tag, used);
        foreach (String name, sorted_keys(used))
            if (!known.contains(name)) fail("unknown lexical " + tag + " " + name);
    }
}

static void lexical_references(void) {
    Map known = {}, used = {};
    foreach (String group, %("classes" "rules"))
        foreach (List row, section(lexical, group)) {
            String name = row.cadr().str();
            if (known.contains(name)) fail("duplicate lexical rule " + name);
            known[name] = 1;
        }
    references(lexical, "ref", used);
    foreach (String name, sorted_keys(used))
        if (!known.contains(name)) fail("unknown lexical reference " + name);
    foreach (List mode, section(lexical, "modes"))
        foreach (Var name, mode.caddr().list().cdr())
            if (!known.contains(name.str())) fail("unknown mode rule " + name.str());
}

static void validate(void) {
    lexical_references();
    mode_targets();
    Map known = rules(), lexical_ids = {};
    if (known.len() != section(grammar, "rules").len()) fail("duplicate grammar name");
    String start = section(grammar, "start").car().str();
    if (!known.contains(start)) fail("unknown grammar entry: " + start);
    foreach (String name, sorted_keys(known)) {
        Map used = {};
        references(known[name], "ref", used);
        foreach (String target, sorted_keys(used))
            if (!known.contains(target)) fail(name + " references unknown rule " + target);
    }
    foreach (List group, lexical.cdr()) {
        lexical_ids[group.car().str()] = 1;
        foreach (Var item, group.cdr())
            if (item is <list>) {
                List row = item;
                List named = %("class" "rule" "mode" "transition" "predicate"
                               "token-set" "pass" "keyword" "operator" "external");
                if (named.contains(row.car().str())) lexical_ids[row.cadr().str()] = 1;
            }
    }
    foreach (List feature, section(extensions, "features")) {
        foreach (Var name, section(feature, "grammar"))
            if (!known.contains(name.str())) fail("unknown extension grammar rule " + name.str());
        foreach (Var name, section(feature, "lexical"))
            if (!lexical_ids.contains(name.str())) fail("unknown extension lexical record " + name.str());
    }
}

static int outputs(int write) {
    List files = %(
      ("docs/src/reference/syntax/x2c.ebnf" ${grammar_text()})
      ("docs/src/reference/syntax/lexical-data.md" ${lexical_text()})
      ("docs/src/guide/x2c-syntax-map.md" ${extension_text()}));
    int changed = 0;
    foreach (List row, files) {
        Path path = root.join(row.car().str());
        String content = row.cadr().str();
        if (path.exists() && path.read_text() == content) continue;
        if (write) path.write_text(content);
        else Stderr.printf("stale: %s\n", row.car());
        ++changed;
    }
    printf("%s: %d output(s) %s\n", write ? "write" : "check", changed,
           write ? "updated" : "stale");
    return !write && changed ? 1 : 0;
}

static void summary(void) {
    printf("grammar: %d rules; entry %s\n", section(grammar, "rules").len(),
           section(grammar, "start").car());
    foreach (List group, lexical.cdr())
        printf("lexical %s: %d records\n", group.car(), group.cdr().len());
    printf("extensions: %d families; baseline %s\n",
           section(extensions, "features").len(), section(extensions, "baseline").car());
}

static void dependencies(String command, String name) {
    Map known = rules();
    if (!known.contains(name)) fail("unknown grammar rule: " + name);
    if (command == "uses") {
        foreach (String candidate, sorted_keys(known)) {
            Map used = {};
            references(known[candidate], "ref", used);
            if (used.contains(name)) printf("%s\n", candidate);
        }
        return;
    }
    Map used = {};
    references(known[name], "ref", used);
    printf("flowchart LR\n  root[\"%s\"]\n", name);
    int index = 0;
    foreach (String target, sorted_keys(used))
        printf("  root --> n%d[\"%s\"]\n", index++, target);
}

static void modes(void) {
    printf("flowchart LR\n");
    foreach (List mode, section(lexical, "modes")) {
        String name = mode.cadr().str();
        printf("  %s[\"%s\"]\n", name.replace("-", "_"), name);
    }
    foreach (List row, section(lexical, "transitions")) {
        if (row.car() != <transition>) continue;
        List push = section(row, "push");
        if (!push) continue;
        String target = push.car().str();
        String label = section(row, "on").car().str().replace("&", "&amp;")
            .replace("\"", "&quot;");
        foreach (Var source, section(row, "from"))
            printf("  %s -->|\"%s\"| %s\n", source.str().replace("-", "_"),
                   label, target.replace("-", "_"));
    }
    printf("  %%%% Push transitions only; pop returns to the previous stack mode.\n"
           "  %%%% Ordered dispatch and predicates still govern each transition.\n");
}

Path self = String.new(argv[0]);
root = self.absolute().dirname().dirname();
grammar = syntax_grammar();
lexical = syntax_lexical();
extensions = syntax_extensions();
String command = args.car().str();
String operand = args.cadr().str();
try {
    validate();
    if (command == "write" || command == "check") return outputs(command == "write");
    if (command == "summary") { summary(); return 0; }
    if (command == "modes") { modes(); return 0; }
    if (command == "ebnf") { printf("%s", grammar_text()); return 0; }
    if (command == "uses" || command == "graph") { dependencies(command, operand); return 0; }
    if (command == "dump") {
        if (operand == "grammar") { printf("%s\n", grammar.repr()); return 0; }
        if (operand == "lexical") { printf("%s\n", lexical.repr()); return 0; }
        if (operand == "extensions") { printf("%s\n", extensions.repr()); return 0; }
    }
    printf("usage: tools/syntax-spec summary | check | write | ebnf | modes\n"
           "       tools/syntax-spec dump grammar|lexical|extensions\n"
           "       tools/syntax-spec uses RULE | graph RULE\n");
    return command == "--help" || command == "-h" ? 0 : 2;
} catch %(syn-error (reason ?reason)): {
    Stderr.printf("syntax-spec: %s\n", reason);
    return 1;
}
