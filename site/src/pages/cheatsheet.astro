---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { inlineMarkdown } from "../lib/inline-markdown";
import { Code } from "astro:components";
import grammar from "../../../etc/vsc-extension/syntaxes/x2c.tmLanguage.json";
import { x2cLightTheme } from "../../shiki-x2c-theme.mjs";
import { sheet } from "../content/cheatsheet";
import "../styles/cheatsheet.css";

const columns = await Promise.all([1, 2, 3].map(async (column) =>
  Promise.all(sheet.filter((section) => section.column === column).map(async (section) => ({
    title: section.title,
    rows: await Promise.all(section.rows.map(async ([code, note]) => ({
      code,
      shell: /^(x2c |#!)/.test(code),
      note: await inlineMarkdown(note),
    }))),
  })))));
const titleHtml = await inlineMarkdown("x2c on one page.");
const language = { ...grammar, name: "x2c" };
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Cheat sheet — x2c"
  description="x2c on one printable page for people who already know C: values, flow, memory, errors, types, concurrency, compile time, and the library."
>
  <Fragment slot="header"><SiteHeader /></Fragment>
  <div class="cheat-page">
    <header class="cheat-heading">
      <p class="about-eyebrow">cheat sheet</p>
      <h1 set:html={titleHtml} />
      <p class="cheat-intro">
        One landscape letter-size page for readers who know C.{" "}
        <a href={`${base}docs/guide/from-c.html`}>Start from C</a> to begin, or
        the <a href={`${base}docs/`}>book</a> when a line needs more than a line.{" "}
        <a href={`${base}x2c-cheatsheet.pdf`} download>Download PDF</a>
        <button type="button" id="print" class="cheat-print">Print</button>
      </p>
    </header>
    <div class="sheet">
      <article class="sheet-page" aria-label="x2c cheat sheet">
        <header class="sheet-head">
          <span class="x2c-wordmark sheet-wordmark">x2c</span>
          <span class="sheet-title">The syntax on one page.</span>
          <span class="sheet-site">x2c-lang.dev</span>
        </header>
        <div class="sheet-columns">
          {columns.map((sections) => (
            <div class="sheet-column" style={`--code-chars: ${Math.max(
              ...sections.flatMap((section) => section.rows.map((row) => row.code.length)))}`}>
              {sections.map((section) => (
                <section class="sheet-section" style={`--rows: ${section.rows.length}`}>
                  <h2>{section.title}</h2>
                  <dl>
                    {section.rows.map((row) => (
                      <div class="sheet-row">
                        <dt>{row.shell ? <code>{row.code}</code>
                          : <Code code={row.code} lang={language} theme={x2cLightTheme} inline />}</dt>
                        <dd set:html={row.note} />
                      </div>
                    ))}
                  </dl>
                </section>
              ))}
            </div>
          ))}
        </div>
      </article>
    </div>
  </div>
  <SiteFooter />
</BaseLayout>

<script>
  document.getElementById("print")?.addEventListener("click", () => window.print());
</script>
