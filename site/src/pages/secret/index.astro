---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sitePath } from "../../../site-config.mjs";
---

<BaseLayout title="x2c previews" description="Work-in-progress x2c interface demos."
  robots="noindex" canonical={false}>
  <section class="previews">
    <p class="eyebrow">x2c / previews</p>
    <h1>A couple of things to try.</h1>
    <p>Work-in-progress interfaces, built in x2c and running in your browser.</p>
    <ul>
      <li>
        <a href={sitePath("/secret/gallery/")}>Component gallery <span aria-hidden="true">&rarr;</span></a>
        <p>Explore all 27 pages of controls and displays. The new Instruments page is at the bottom of the sidebar.</p>
      </li>
      <li>
        <a href={sitePath("/secret/stress/")}>Stress test <span aria-hidden="true">&rarr;</span></a>
        <p>Adjust the workload and watch frame timing. Browser and display pacing can limit FPS; this is not an uncapped native benchmark.</p>
      </li>
    </ul>
    <p class="note">Use a current Chromium-based browser with WebGL 2, Memory64,
      and JavaScript Promise Integration. Each demo opens as a standalone page.
      The stress test pauses while its tab is hidden.</p>
  </section>
</BaseLayout>

<style>
  .previews { max-width: 42rem; margin: 0 auto; padding: clamp(2rem, 8vw, 6rem) 1.5rem; }
  .eyebrow { font-family: monospace; font-size: .8rem; letter-spacing: .08em; }
  h1 { font-size: clamp(2.5rem, 6vw, 4rem); line-height: 1.1; margin: 1.5rem 0; }
  p { line-height: 1.65; }
  ul { list-style: none; padding: 0; margin: 3rem 0; }
  li { border-top: 1px solid currentColor; padding: 1.5rem 0; }
  li a { display: flex; justify-content: space-between; font-size: 1.4rem; }
  li p { margin-bottom: 0; }
  .note { font-size: .9rem; opacity: .75; }
</style>
