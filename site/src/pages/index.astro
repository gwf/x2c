---
import { Code } from "astro:components";
import { execFileSync } from "node:child_process";
import { absoluteSiteUrl } from "../../site-config.mjs";
import { destination, installExample } from "../../release-destination.mjs";
import { coreSetup, corePrerequisites } from "../content/core-setup";
import { x2cDarkTheme } from "../../shiki-x2c-theme.mjs";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FeatureCarousel from "../components/FeatureCarousel.astro";
import HeroTitle from "../components/HeroTitle.astro";
import CopyButton from "../components/CopyButton.astro";
import { inSection } from "../lib/examples";
import { inlineMarkdown } from "../lib/inline-markdown";
import HomeIntroduction from "../components/HomeIntroduction.astro";
import { frontmatter as home } from "../content/home.md";
import { Content as LoveCopy, frontmatter as love } from "../content/love.md";
import {
  Content as PackagesCopy,
  frontmatter as packages,
} from "../content/packages.md";
import {
  compiledContent as packageBuildCode,
} from "../content/packages-build.md";
import {
  Content as PowerCopy,
  frontmatter as power,
} from "../content/power.md";
import {
  Content as MagicCopy,
  frontmatter as magic,
} from "../content/magic.md";
import {
  frontmatter as install,
} from "../content/install.md";

const base = import.meta.env.BASE_URL;
const local = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const statistics = JSON.parse(execFileSync(
  "python3", ["tools/repo-metrics.py", "--summary-json"],
  { cwd: import.meta.env.X2C_REPOSITORY_ROOT, encoding: "utf8" }
));
const releaseInstall = installExample(install.run.trim());
const sourceInstall = `${coreSetup}\n${install.source.trim()}`;
const number = (value: number) => value.toLocaleString("en-US");
const sourceLines = (name: string) =>
  `${number(statistics.source[name].code)} / ` +
  number(statistics.source[name].comments);

const [titleHtml, kickerHtml] = await Promise.all([
  inlineMarkdown(home.title),
  inlineMarkdown(home.kicker),
]);
---

<BaseLayout
  title="x2c — love, power, magic"
  description="The love child of C and Lisp with superpowers. Keep C's types, layouts, headers, libraries, ABI, and tools; lose the boilerplate."
>
  <Fragment slot="header">
    <SiteHeader home />
  </Fragment>
  <div class="landing">
    <section id="top" class="landing-hero">
      <header class="hero-heading">
        <HeroTitle html={titleHtml} />
        <p set:html={kickerHtml} />
      </header>
      <HomeIntroduction />
    </section>
  </div>

  <section id="love" class="landing-section idea-section">
    <div class="section-shell">
      <div class="idea-gallery">
        <header class="section-heading idea-heading">
          <h2>{love.title}</h2>
          <div class="section-overview"><LoveCopy /></div>
        </header>
        <FeatureCarousel
          name="love"
          label="Love examples"
          slides={inSection("love")}
        />
        <p class="section-exit">
          More in the docs:{" "}
          <a href={local("docs/guide/values.html")}>values</a>,{" "}
          <a href={local("docs/guide/symbols.html")}>symbols</a>,{" "}
          <a href={local("docs/guide/collections.html")}>collections and literals</a>,{" "}
          <a href={local("docs/library/overview.html#read-or-write-a-file")}>files</a>,{" "}
          and{" "}
          <a href={local("docs/guide/from-c.html#types-methods-and-references")}>methods</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="power" class="landing-section idea-section">
    <div class="section-shell">
      <div class="idea-gallery">
        <header class="section-heading idea-heading">
          <h2>{power.title}</h2>
          <div class="section-overview"><PowerCopy /></div>
        </header>
        <FeatureCarousel
          name="power"
          label="Power examples"
          slides={inSection("power")}
        />
        <p class="section-exit">
          More in the docs:{" "}
          <a href={local("docs/guide/collections.html")}>collections</a>,{" "}
          <a href={local("docs/guide/iteration.html")}>iteration</a>,{" "}
          <a href={local("docs/guide/memory.html")}>scopes</a>,{" "}
          <a href={local("docs/guide/match.html")}>match</a>,{" "}
          <a href={local("docs/guide/contexts-and-threads.html")}>threads</a>,{" "}
          <a href={local("docs/guide/exceptions.html")}>exceptions</a>,{" "}
          and{" "}
          <a href={local("docs/guide/packages.html")}>packages</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="magic" class="landing-section idea-section">
    <div class="section-shell">
      <div class="idea-gallery">
        <header class="section-heading idea-heading">
          <h2>{magic.title}</h2>
          <div class="section-overview"><MagicCopy /></div>
        </header>
        <FeatureCarousel
          name="magic"
          label="Magic examples"
          slides={inSection("magic")}
        />
        <p class="section-exit">
          More in the docs:{" "}
          <a href={local("docs/guide/protocols.html")}>protocols</a>,{" "}
          <a href={local("docs/guide/macros.html")}>macros and meta functions</a>,{" "}
          <a href={local("docs/library/overview.html#embed-lisp")}>runtime Lisp</a>,{" "}
          <a href={local("docs/internals/building.html")}>self-hosting</a>,{" "}
          <a href={local("docs/reference/cli.html")}>compiler inspection</a>,{" "}
          and{" "}
          <a href={local("docs/internals/architecture.html")}>architecture</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="install" class="landing-section landing-action">
    <div class="deal-grid">
      <div class="deal-copy">
        <header class="section-heading install-heading">
          <h2>Install x2c</h2>
          <div class="install-actions">
            <a class="button button-primary"
              href="https://github.com/gwf/x2c/archive/refs/heads/main.zip">
              Download ZIP
            </a>
            <a class="button button-secondary"
              href="https://github.com/gwf/x2c">View on GitHub</a>
          </div>
        </header>
        <p>
          <strong>Platforms.</strong>{" "}
          macOS 15 or later (arm64, x86_64); Linux with glibc 2.38 or later
          (x86_64, aarch64); Windows through WSL2.
        </p>
        <p>
          <strong>Install a release.</strong>{" "}
          One command downloads the compiler, runtime, headers, and
          examples for your platform into <code>{destination.staging
            ? "$X2C_PREFIX" : "~/.local/x2c"}</code>{destination.staging
            ? ", ideally a fresh scratch directory." : "."}{" "}
          Then add packages from the{" "}
          <a href={local("docs/guide/packages.html#install-packages")}>
            package index</a> with{" "}
          <code>{destination.staging
            ? "x2c install <package> --index " +
              absoluteSiteUrl("/packages/index.txt")
            : "x2c install <package>"}</code>.{" "}
          The <a href={local("docs/reference/release-notes.html")}>release
          notes</a> list what changed and how to upgrade.
        </p>
        <p>
          <strong>Or build from source.</strong>{" "}
          Clone the repository, build the compiler from its checked-in C,
          and run one of the included examples. The compiler handles
          translation, native compilation, and execution.
        </p>
        <p>
          {corePrerequisites}{" "}
          See the <a href={local("docs/internals/building.html")}>build
          instructions</a> for the self-hosting process.
        </p>
      </div>
      <figure class="install-window">
        <figcaption class="install-label">
          <span>{install.caption}</span>
          <CopyButton text={releaseInstall} label="Copy commands"
            action="copy-run" />
        </figcaption>
        <div class="install-code">
          <Code code={releaseInstall} lang="sh" theme={x2cDarkTheme} />
        </div>
        <div class="install-label install-source">
          <span>or build from a source checkout</span>
          <CopyButton text={sourceInstall} label="Copy commands"
            action="copy-run" />
        </div>
        <div class="install-code">
          <Code code={sourceInstall} lang="sh" theme={x2cDarkTheme} />
        </div>
      </figure>
    </div>
  </section>

  <section id="packages" class="landing-section landing-action">
    <div class="section-shell">
      <div class="package-intro">
        <div>
          <header class="section-heading">
            <h2>{packages.title}</h2>
            <div class="section-overview"><PackagesCopy /></div>
          </header>
          <div class="section-exit">
            <p>
              <a href="https://github.com/gwf/x2c/blob/main/packages/README.md">
                Browse packages</a> or learn how to{" "}
              <a href={local("docs/guide/packages.html#using-one")}>import one</a>.
            </p>
          </div>
        </div>
        <div class="package-setup">
          <figure class="install-window package-build">
            <figcaption>Build and run the chart example</figcaption>
            <div class="install-code" set:html={await packageBuildCode()} />
          </figure>
          <p class="package-note">
            Packages need their native libraries prepared first. Release
            bundles cover macOS and Linux on arm64 and x86_64; torch bundles
            cover macOS arm64 and Linux x86_64 only. raylib and SQLite have
            no release bundle and build from a source checkout.
          </p>
        </div>
      </div>
      <FeatureCarousel
        name="packages"
        label="Package examples"
        codeLabel="Source excerpt"
        slides={inSection("packages")}
      />
    </div>
  </section>

  <section id="source" class="landing-section numbers-section">
    <div class="docs-shell">
      <div class="docs-grid">
        <header class="docs-copy">
          <small>about, docs, and source</small>
          <h2>Go further.</h2>
          <p>
            <a href={local("about/")}>About x2c</a> tells its story.{" "}
            <a href={local("docs/")}>Read the docs</a> to learn the language
            and look up its library. <a href="https://github.com/gwf/x2c"
              >Browse the source</a> to see how it works or make it your own.
          </p>
          <p class="repository-counts">
            Repository counts from <code>make stats</code>.
          </p>
        </header>
        <div class="docs-cards number-stats">
          <div class="docs-card stat-card">
            <small>compiler</small>
            <strong>{sourceLines("src")}</strong>
            <p>code / comment lines in the compiler, including all nested modules
              and language components. Command programs are counted separately.</p>
          </div>
          <div class="docs-card stat-card">
            <small>library</small>
            <strong>{sourceLines("lib")}</strong>
            <p>code / comment lines in the library source.</p>
          </div>
          <div class="docs-card stat-card">
            <small>compiler commands</small>
            <strong>{sourceLines("commands")}</strong>
            <p>{number(statistics.inventory.commands)} command programs,
              including build/run, lint, graph analysis, and the language server.
              Code / comment lines; excludes command tests.</p>
          </div>
          <div class="docs-card stat-card">
            <small>language components</small>
            <strong>{sourceLines("components")}</strong>
            <p>{number(statistics.inventory.components)} components implementing
              language features with macros and rewrite rules. Code / comment
              lines, already included in the compiler total.</p>
          </div>
          <div class="docs-card stat-card">
            <small>tests</small>
            <strong>{number(statistics.tests.unit_tests)}</strong>
            <p>unit tests.</p>
          </div>
          <div class="docs-card stat-card">
            <small>fixtures</small>
            <strong>{number(statistics.tests.compiler_fixtures)}</strong>
            <p>compiler fixtures.</p>
          </div>
          <div class="docs-card stat-card">
            <small>examples</small>
            <strong>{number(statistics.tests.showcase_examples)}</strong>
            <p>showcase examples.</p>
          </div>
          <div class="docs-card stat-card">
            <small>packages</small>
            <strong><a href="#packages">{number(inSection("packages").length)}</a></strong>
            <p>
              packages demonstrated with working examples in the gallery.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter home />
</BaseLayout>

<script>
  import "../lib/carousel";
</script>
