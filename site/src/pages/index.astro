---
import { Code } from "astro:components";
import { coreSetup, corePrerequisites } from "../content/core-setup";
import { x2cDarkTheme } from "../../shiki-x2c-theme.mjs";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FeatureCarousel from "../components/FeatureCarousel.astro";
import FeatureTable from "../components/FeatureTable.astro";
import HeroTitle from "../components/HeroTitle.astro";
import { inSection } from "../lib/examples";
import { inlineMarkdown } from "../lib/inline-markdown";
import { Content as HomeCopy, frontmatter as home } from "../content/home.md";
import { Content as LoveCopy, frontmatter as love } from "../content/love.md";
import {
  Content as PackagesCopy,
  frontmatter as packages,
} from "../content/packages.md";
import {
  compiledContent as packageBuildCode,
} from "../content/packages-build.md";
import {
  Content as PowerCopy,
  frontmatter as power,
} from "../content/power.md";
import {
  Content as MagicCopy,
  frontmatter as magic,
} from "../content/magic.md";
import {
  frontmatter as install,
} from "../content/install.md";

const base = import.meta.env.BASE_URL;
const local = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const [titleHtml, kickerHtml] = await Promise.all([
  inlineMarkdown(home.title),
  inlineMarkdown(home.kicker),
]);
---

<BaseLayout
  title="x2c — love, power, magic"
  description="The love child of C and Lisp with superpowers. Keep C's types, layouts, headers, libraries, ABI, and tools; lose the boilerplate."
>
  <Fragment slot="header">
    <SiteHeader home />
  </Fragment>
  <div class="landing">
    <section id="top" class="landing-hero">
      <header class="hero-heading">
        <HeroTitle html={titleHtml} />
        <p set:html={kickerHtml} />
        <nav class="hero-examples" aria-label="Featured examples">
          <span>Try an example:</span>
          <a href={local("examples/torch/")} data-example="torch"
            data-surface="hero" data-section="packages" data-example-action="explore">
            Recognize handwritten digits</a>
          <a href={local("examples/embedded-lisp/")} data-example="embedded-lisp"
            data-surface="hero" data-section="magic" data-example-action="explore">
            Embed Lisp in your program</a>
          <a href={local("examples/game-of-life/")} data-example="game-of-life"
            data-surface="hero" data-section="packages" data-example-action="explore">
            Run Game of Life</a>
        </nav>
      </header>
      <FeatureTable intro={home.featureIntro} features={home.features} />
      <div class="hero-prose">
        <HomeCopy />
      </div>
    </section>
  </div>

  <section id="love" class="landing-section">
    <div class="section-shell">
      <div class="section-feature-grid">
        <header class="section-heading">
          <h2>{love.title}</h2>
          <div class="section-overview"><LoveCopy /></div>
        </header>
        <FeatureCarousel
          name="love"
          label="Love examples"
          tone="dark"
          slides={inSection("love")}
        />
        <p class="section-exit">
          Explore the essentials:{" "}
          <a href={local("docs/guide/values.html")}>values</a>,{" "}
          <a href={local("docs/guide/symbols.html")}>symbols</a>,{" "}
          <a href={local("docs/guide/collections.html")}>collections and literals</a>,{" "}
          <a href={local("docs/library/overview.html#read-or-write-a-file")}>files</a>,{" "}
          and{" "}
          <a href={local("docs/reference/language.html#c-foundation")}>methods</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="power" class="landing-section">
    <div class="section-shell">
      <div class="section-feature-grid">
        <header class="section-heading">
          <h2>{power.title}</h2>
          <div class="section-overview"><PowerCopy /></div>
        </header>
        <FeatureCarousel
          name="power"
          label="Power examples"
          tone="dark"
          slides={inSection("power")}
        />
        <p class="section-exit">
          Put the pieces together:{" "}
          <a href={local("docs/guide/collections.html")}>collections</a>,{" "}
          <a href={local("docs/guide/iteration.html")}>iteration</a>,{" "}
          <a href={local("docs/guide/memory.html")}>scopes</a>,{" "}
          <a href={local("docs/guide/match.html")}>match</a>,{" "}
          <a href={local("docs/guide/contexts-and-threads.html")}>threads</a>,{" "}
          <a href={local("docs/guide/exceptions.html")}>exceptions</a>,{" "}
          and{" "}
          <a href={local("docs/guide/packages.html")}>packages</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="magic" class="landing-section">
    <div class="section-shell">
      <div class="section-feature-grid">
        <header class="section-heading">
          <h2>{magic.title}</h2>
          <div class="section-overview"><MagicCopy /></div>
        </header>
        <FeatureCarousel
          name="magic"
          label="Magic examples"
          tone="dark"
          slides={inSection("magic")}
        />
        <p class="section-exit">
          Explore the language itself:{" "}
          <a href={local("docs/guide/protocols.html")}>protocols</a>,{" "}
          <a href={local("docs/guide/macros.html")}>macros and compile-time Lisp</a>,{" "}
          <a href={local("docs/library/overview.html#embed-lisp")}>runtime Lisp</a>,{" "}
          <a href={local("docs/internals/building.html")}>self-hosting</a>,{" "}
          <a href={local("docs/reference/cli.html")}>compiler inspection</a>,{" "}
          and{" "}
          <a href={local("docs/internals/architecture.html")}>architecture</a>.
        </p>
      </div>
    </div>
  </section>

  <section id="install" class="landing-section landing-action">
    <div class="deal-grid">
      <div class="deal-copy">
        <header class="section-heading">
          <h2>Install x2c</h2>
        </header>
        <p>
          <strong>Run your first x2c program.</strong>{" "}
          Clone the repository, build the compiler from its checked-in C,
          and run one of the included examples. The compiler handles
          translation, native compilation, and execution.
        </p>
        <p>
          {corePrerequisites}{" "}
          See the <a href={local("docs/internals/building.html")}>build
          instructions</a> for the self-hosting process.
        </p>
        <p class="install-note">
          Just experimenting? The <a
            href={local("docs/reference/cli.html#bootstrap-a-native-installation")}
            >Cosmopolitan executable</a> bootstraps a minimal compiler and
          runtime for fun, without examples, the book, or packages.
        </p>
      </div>
      <figure class="install-window">
        <figcaption>{install.caption}</figcaption>
        <div class="install-code">
          <Code code={`${coreSetup}\n\n${install.run.trim()}`} lang="sh"
            theme={x2cDarkTheme} />
        </div>
      </figure>
    </div>
  </section>

  <section id="packages" class="landing-section landing-action">
    <div class="section-shell">
      <div class="package-intro">
        <div>
          <header class="section-heading">
            <h2>{packages.title}</h2>
            <div class="section-overview"><PackagesCopy /></div>
          </header>
          <div class="section-exit">
            <p>
              <a href="https://github.com/gwf/x2c/blob/main/packages/README.md">
                Browse packages</a> or learn how to{" "}
              <a href={local("docs/guide/packages.html#using-one")}>import one</a>.
            </p>
          </div>
        </div>
        <div class="package-setup">
          <figure class="install-window package-build">
            <figcaption>Build and run the chart example</figcaption>
            <div class="install-code" set:html={await packageBuildCode()} />
          </figure>
          <p class="package-note">
            Packages need separate dependency preparation. Builds are currently
            tested on macOS.
          </p>
        </div>
      </div>
      <FeatureCarousel
        name="packages"
        label="Package examples"
        codeLabel="Source excerpt"
        tone="dark"
        slides={inSection("packages")}
      />
    </div>
  </section>

  <section id="source" class="landing-section numbers-section">
    <div class="docs-shell">
      <div class="docs-grid">
        <header class="docs-copy">
          <small>keep exploring</small>
          <h2>Go further.</h2>
          <p>
            <a href={local("about/")}>About x2c</a> tells its story.{" "}
            <a href={local("docs/")}>Read the docs</a> to learn the language
            and look up its library. <a href="https://github.com/gwf/x2c"
              >Browse the source</a> to see how it works or make it your own.
          </p>
          <p class="repository-counts">
            Repository counts from <code>make stats</code>.
          </p>
        </header>
        <div class="docs-cards number-stats">
          <div class="docs-card stat-card">
            <small>compiler</small>
            <strong>22,551 / 2,766</strong>
            <p>code / comment lines in the compiler source.</p>
          </div>
          <div class="docs-card stat-card">
            <small>library</small>
            <strong>15,643 / 6,715</strong>
            <p>code / comment lines in the library source.</p>
          </div>
          <div class="docs-card stat-card">
            <small>tests</small>
            <strong>730</strong>
            <p>unit tests.</p>
          </div>
          <div class="docs-card stat-card">
            <small>fixtures</small>
            <strong>555</strong>
            <p>compiler fixtures.</p>
          </div>
          <div class="docs-card stat-card">
            <small>examples</small>
            <strong>32</strong>
            <p>showcase examples.</p>
          </div>
          <div class="docs-card stat-card">
            <small>packages</small>
            <strong><a href="#packages">Build something.</a></strong>
            <p>
              Explore C libraries through working x2c examples.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter home />
</BaseLayout>

<script>
  import "../lib/carousel";
</script>
