---
import { Code } from "astro:components";
import { execFileSync } from "node:child_process";
import { absoluteSiteUrl } from "../../site-config.mjs";
import { destination, installExample } from "../../release-destination.mjs";
import { coreSetup, corePrerequisites } from "../content/core-setup";
import { x2cDarkTheme } from "../../shiki-x2c-theme.mjs";
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import FeatureCarousel from "../components/FeatureCarousel.astro";
import FiveIdeas from "../components/FiveIdeas.astro";
import HeroTitle from "../components/HeroTitle.astro";
import {
  articles, inSection, playgroundExamples, slides,
} from "../lib/examples";
import { inlineMarkdown } from "../lib/inline-markdown";
import { Content as HomeCopy, frontmatter as home } from "../content/home.md";
import { Content as LoveCopy, frontmatter as love } from "../content/love.md";
import {
  Content as PackagesCopy,
  frontmatter as packages,
} from "../content/packages.md";
import {
  compiledContent as packageBuildCode,
} from "../content/packages-build.md";
import {
  Content as PowerCopy,
  frontmatter as power,
} from "../content/power.md";
import {
  Content as MagicCopy,
  frontmatter as magic,
} from "../content/magic.md";
import { Content as TryCopy, frontmatter as tryIt } from "../content/try.md";

const base = import.meta.env.BASE_URL;
const local = (path: string) =>
  /^https?:/.test(path) ? path : `${base}${path.replace(/^\/+/, "")}`;
const statistics = JSON.parse(execFileSync(
  "python3", ["tools/repo-metrics.py", "--summary-json"],
  { cwd: import.meta.env.X2C_REPOSITORY_ROOT, encoding: "utf8" }
));
const number = (value: number) => value.toLocaleString("en-US");
const sourceLines = (name: string) =>
  `${number(statistics.source[name].code)} / ` +
  number(statistics.source[name].comments);

const [titleHtml, kickerHtml] = await Promise.all([
  inlineMarkdown(home.title),
  inlineMarkdown(home.kicker),
]);

const sectionOf = (slug: string) =>
  slides.find((slide) => slide.frontmatter.slug === slug)!.frontmatter.section;
const sections = [
  { id: "love", meta: love, Copy: LoveCopy, label: "Love ideas",
    more: [
      ["docs/guide/values.html", "values"],
      ["docs/guide/collections.html", "collections and literals"],
      ["docs/guide/symbols.html", "symbols"],
      ["docs/guide/iteration.html", "iteration"],
      ["docs/guide/scripting.html", "files and commands"],
      ["docs/reference/cli.html", "the command line"],
    ] },
  { id: "power", meta: power, Copy: PowerCopy, label: "Power ideas",
    more: [
      ["docs/guide/system-macros.html", "classes"],
      ["docs/guide/protocols.html", "protocols"],
      ["docs/guide/deriving-records.html", "derive"],
      ["docs/guide/packages.html", "packages"],
      ["docs/guide/memory.html", "scopes"],
      ["docs/guide/exceptions.html", "exceptions"],
      ["docs/guide/channels.html", "channels"],
      ["docs/guide/networking.html", "sockets and HTTP"],
      ["docs/guide/from-c.html", "from C to x2c"],
      ["https://github.com/gwf/x2c/blob/main/examples/shootout/README.md",
        "the language shootout"],
    ] },
  { id: "magic", meta: magic, Copy: MagicCopy, label: "Magic ideas",
    more: [
      ["docs/guide/match.html", "match"],
      ["docs/guide/meta-functions.html", "meta functions"],
      ["docs/guide/macros.html", "macros"],
      ["docs/guide/generating-code.html", "generating code"],
      ["docs/library/overview.html#embed-lisp", "runtime Lisp"],
      ["docs/internals/architecture.html", "the compiler"],
    ] },
];
---

<BaseLayout
  title="x2c — love, power, magic"
  description="C with batteries, without bullshit. Four ideas: still C, with less of it; one data model, two speeds; lifetime by scope; and its own metalanguage."
>
  <Fragment slot="header">
    <SiteHeader home />
  </Fragment>
  <div class="landing">
    <section id="top" class="landing-hero">
      <header class="hero-heading">
        <HeroTitle html={titleHtml} />
        <p set:html={kickerHtml} />
      </header>
      <FiveIdeas intro={home.ideasIntro} ideas={home.ideas} />
      <div class="hero-prose">
        <HomeCopy />
      </div>
    </section>
  </div>

  {sections.map(({ id, meta, Copy, label, more }) => (
    <section id={id} class="landing-section idea-section">
      <div class="section-shell">
        <header class="section-heading idea-heading">
          <h2>{meta.title}</h2>
          <div class="section-overview">
            <p class="section-lede">{meta.lede}</p>
            <Copy />
          </div>
        </header>
        <FeatureCarousel name={id} label={label} slides={inSection(id)} />
        <p class="section-exit">
          More in the docs:{" "}
          {more.map(([href, text], index) => (
            <Fragment>
              {index === more.length - 1 && "and "}
              <a href={local(href)}>{text}</a>{index < more.length - 1 ? ", " : "."}
            </Fragment>
          ))}
        </p>
      </div>
    </section>
  ))}

  <section id="install" class="landing-section landing-action">
    <div class="deal-grid">
      <div class="deal-copy">
        <header class="section-heading install-heading">
          <h2>{tryIt.title}</h2>
          <div class="install-actions">
            <a class="button button-primary" href={local("examples/")}>
              Run it in your browser
            </a>
            <a class="button button-secondary"
              href="https://github.com/gwf/x2c">View on GitHub</a>
          </div>
        </header>
        <TryCopy />
        <p>
          <strong>Install a release.</strong>{" "}
          One command downloads the compiler, runtime, headers, and
          examples for your platform into <code>{destination.staging
            ? "$X2C_PREFIX" : "~/.local/x2c"}</code>{destination.staging
            ? ", ideally a fresh scratch directory." : "."}{" "}
          Then add packages from the{" "}
          <a href={local("docs/guide/packages.html#install-packages")}>
            package index</a> with{" "}
          <code>{destination.staging
            ? "x2c install <package> --index " +
              absoluteSiteUrl("/packages/index.txt")
            : "x2c install <package>"}</code>.{" "}
          The <a href={local("docs/reference/release-notes.html")}>release
          notes</a> list what changed and how to upgrade.
        </p>
        <p>
          <strong>Or build from source.</strong>{" "}
          Clone the repository, build the compiler from its checked-in C,
          and run one of the included examples. {corePrerequisites}{" "}
          The <a href={local("docs/internals/building.html")}>build
          instructions</a> cover the self-hosting process.
        </p>
      </div>
      <figure class="install-window">
        <figcaption>{tryIt.caption}</figcaption>
        <div class="install-code">
          <Code code={`${coreSetup}\n\n${installExample(tryIt.run.trim())}`} lang="sh"
            theme={x2cDarkTheme} />
        </div>
      </figure>
    </div>
  </section>

  <section id="packages" class="landing-section landing-action">
    <div class="section-shell">
      <div class="package-intro">
        <div>
          <header class="section-heading">
            <h2>{packages.title}</h2>
            <div class="section-overview"><PackagesCopy /></div>
          </header>
          <div class="section-exit">
            <p>
              <a href="https://github.com/gwf/x2c/blob/main/packages/README.md">
                Browse packages</a> or learn how to{" "}
              <a href={local("docs/guide/packages.html#using-one")}>import one</a>.
            </p>
          </div>
        </div>
        <div class="package-setup">
          <figure class="install-window package-build">
            <figcaption>Build and run the chart example</figcaption>
            <div class="install-code" set:html={await packageBuildCode()} />
          </figure>
          <p class="package-note">
            Packages need their native libraries prepared first. Release bundles are
            built on macOS and Linux, on both arm64 and x86_64.
          </p>
        </div>
      </div>
      <FeatureCarousel
        name="packages"
        label="Package examples"
        codeLabel="Source excerpt"
        slides={inSection("packages")}
      />
    </div>
  </section>

  <section id="examples" class="landing-section examples-section">
    <div class="docs-shell">
      <div class="docs-grid">
        <header class="docs-copy">
          <small>examples</small>
          <h2>Every example, one page.</h2>
          <p>
            The gallery programs from the sections above, six larger
            programs with walkthroughs, and two tours, each with its full
            source on the <a href={local("examples/")}>examples page</a>.
            The small ones run in your browser with a Run button. The big
            ones come with a recipe.
          </p>
        </header>
        <div class="docs-cards example-cards">
          {articles.map(({ frontmatter: example }) => (
            <a class="docs-card"
              href={local(`examples/?example=programs/${example.slug}`)}
              data-example={example.slug} data-surface="hero"
              data-section={sectionOf(example.slide)}
              data-example-action="explore">
              <small>{sectionOf(example.slide)} / program</small>
              <h3>{example.title}</h3>
              <p>{example.description}</p>
            </a>
          ))}
          <div class="docs-card runnable-card">
            <small>run in your browser</small>
            <h3>Pick a gallery program.</h3>
            <ul class="runnable-list">
              {playgroundExamples.map((entry) => (
                <li>
                  <a href={local(`examples/?example=${encodeURIComponent(entry.id)}`)}
                    data-example={entry.slug} data-surface="hero"
                    data-section={entry.id.split("/")[0]}
                    data-example-action="run">{entry.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section id="source" class="landing-section numbers-section">
    <div class="docs-shell">
      <div class="docs-grid">
        <header class="docs-copy">
          <small>about, docs, and source</small>
          <h2>Go further.</h2>
          <p>
            <a href={local("about/")}>About x2c</a> tells its story.{" "}
            <a href={local("docs/")}>Read the book</a> to learn the language
            and look up its library. <a href="https://github.com/gwf/x2c"
              >Browse the source</a> to see how it works or make it your own.
          </p>
          <p class="repository-counts">
            Repository counts from <code>make stats</code>.
          </p>
        </header>
        <div class="docs-cards number-stats">
          <div class="docs-card stat-card">
            <small>compiler</small>
            <strong>{sourceLines("src")}</strong>
            <p>code / comment lines in the compiler source.</p>
          </div>
          <div class="docs-card stat-card">
            <small>library</small>
            <strong>{sourceLines("lib")}</strong>
            <p>code / comment lines in the library source.</p>
          </div>
          <div class="docs-card stat-card">
            <small>X Lisp</small>
            <strong>{sourceLines("xlisp")}</strong>
            <p>code / comment lines in hand-written X Lisp source.</p>
          </div>
          <div class="docs-card stat-card">
            <small>compiler support</small>
            <strong>{sourceLines("etc")}</strong>
            <p>code / comment lines in compiler support modules.</p>
          </div>
          <div class="docs-card stat-card">
            <small>tests</small>
            <strong>{number(statistics.tests.unit_tests)}</strong>
            <p>unit tests.</p>
          </div>
          <div class="docs-card stat-card">
            <small>fixtures</small>
            <strong>{number(statistics.tests.compiler_fixtures)}</strong>
            <p>compiler fixtures.</p>
          </div>
          <div class="docs-card stat-card">
            <small>examples</small>
            <strong>{number(statistics.tests.showcase_examples)}</strong>
            <p>showcase examples.</p>
          </div>
          <div class="docs-card stat-card">
            <small>quick start</small>
            <strong><a href={local("quickstart/")}>Start here.</a></strong>
            <p>A fast track for people who already know C, with the one-page cheat sheet.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SiteFooter home />
</BaseLayout>

<script>
  import "../lib/carousel";
</script>
