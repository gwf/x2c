---
// The playground moved into the examples page; keep old ?example= links working.
const target = `${import.meta.env.BASE_URL}examples/`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <title>Moved</title>
    <script is:inline define:vars={{ target }}>
      location.replace(target + location.search + location.hash);
    </script>
  </head>
  <body>
    <p>The playground is now part of the <a href={target}>examples page</a>.</p>
  </body>
</html>
