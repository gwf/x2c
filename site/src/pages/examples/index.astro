---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ExamplesShell from "../../components/ExamplesShell.astro";
import ExamplesTopic from "../../components/ExamplesTopic.astro";
import { exampleEntries } from "../../lib/example-catalog";
const routes = Object.fromEntries(exampleEntries.map(entry => [entry.id, entry.article ? `${entry.article.frontmatter.slug}/` : entry.section === "programs" ? `${entry.id.split("/").pop()}/` : `${entry.section}/#${entry.id.replaceAll("/", "-")}`]));
---
<BaseLayout title="Examples - x2c" description="Browse x2c examples, from everyday values to complete programs.">
<Fragment slot="header"><SiteHeader examples /></Fragment>
<ExamplesShell current="love"><ExamplesTopic topic="love" /></ExamplesShell>
<SiteFooter />
<script is:inline define:vars={{routes, base: import.meta.env.BASE_URL}}>
  const requested = new URL(location.href).searchParams.get("example");
  if (requested && routes[requested]) location.replace(`${base}examples/${routes[requested]}`);
</script>
</BaseLayout>
