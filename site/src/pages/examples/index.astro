---
import BaseLayout from "../../layouts/BaseLayout.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import SiteFooter from "../../components/SiteFooter.astro";
import ExamplesShell from "../../components/ExamplesShell.astro";
import { exampleRoutes as routes } from "../../lib/example-catalog";
---
<BaseLayout title="Examples — x2c" description="Browse x2c examples, from everyday values to complete programs.">
<Fragment slot="header"><SiteHeader examples /></Fragment>
<ExamplesShell current="essentials">
  <h1>Learn x2c by example.</h1>
  <p>Start with <a href={`${import.meta.env.BASE_URL}examples/essentials/`}>x2c essentials</a>,
    then read the <a href={`${import.meta.env.BASE_URL}examples/language/`}>language walkthrough</a>.</p>
</ExamplesShell>
<SiteFooter slot="footer" />
<script is:inline define:vars={{routes, base: import.meta.env.BASE_URL}}>
  const requested = new URL(location.href).searchParams.get("example");
  location.replace(`${base}examples/${requested && routes[requested] || "essentials/"}`);
</script>
</BaseLayout>
