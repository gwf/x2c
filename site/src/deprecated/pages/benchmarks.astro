---
import BaseLayout from "../layouts/BaseLayout.astro";
// Inline the checked-in shootout result rather than transcribing it, so this
// page cannot drift from `make shoot-update`.
import result from "../../../examples/shootout/results/current.md?raw";

const base = import.meta.env.BASE_URL;
const local = (path: string) => `${base}${path.replace(/^\/+/, "")}`;

const field = (name: string) => {
  const match = result.match(new RegExp(`^- ${name}: (.+)$`, "m"));
  return match ? match[1].replace(/`/g, "") : "";
};

const cells = (line: string) =>
  line
    .trim()
    .slice(1, -1)
    .split("|")
    .map((cell) => cell.trim().replace(/\*\*/g, ""));

const table = result
  .split("\n")
  .filter((line) => line.trim().startsWith("|"));
const header = cells(table[0]);
const rows = table.slice(2).map(cells);
const total = rows.pop() as string[];
---

<BaseLayout
  title="Benchmarks - x2c"
  description="Fourteen idiomatic x2c programs measured against equivalent C and Python references: execution time relative to C, source size relative to Python."
>
  <section class="story-hero">
    <div>
      <p class="story-index">the shootout</p>
      <h1>Fourteen programs, against C and against Python.</h1>
      <p class="story-deck">
        The same algorithms, inputs, and output contracts in x2c, C, and
        Python, without forcing x2c into a C-shaped representation. Time uses
        C as the implicit 1.00 baseline; source size uses Python. Larger
        always means more cost.
      </p>
    </div>
  </section>

  <section class="story-section">
    <table class="shootout">
      <thead>
        <tr>{header.map((cell) => <th>{cell}</th>)}</tr>
      </thead>
      <tbody>
        {rows.map((row) => (
          <tr>{row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
        ))}
      </tbody>
      <tfoot>
        <tr>{total.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}</tr>
      </tfoot>
    </table>

    <p class="run-meta">
      run {field("Run")} &middot; baseline {field("Baseline")} &middot;
      profile {field("Profile")} &middot; {field("Samples").toLowerCase()}
    </p>

    <p>
      The arithmetic mean is an orientation aid, not a composite score. Only
      hand-written <code>main.x</code>, <code>main.c</code>, and{" "}
      <code>main.py</code> are counted; generated C and launchers are not.
      SLOC means nonblank lines after C-style comments are removed.
    </p>

    <p>
      An ordinary run rebuilds and measures only the x2c programs and compares
      their medians with the pinned C and Python statistics. The C and Python
      sources are checked in beside each <code>main.x</code> for review. All
      three are rebuilt and rotated through each order position only when the
      reference sources, machine, toolchain, or methodology needs a new
      calibration.
    </p>

    <div class="actions">
      <a class="button button-secondary" href="https://github.com/gwf/x2c/tree/main/examples/shootout">read the benchmark sources <span aria-hidden="true">&rarr;</span></a>
      <a class="button button-primary" href={local("install/")}>install x2c <span aria-hidden="true">&rarr;</span></a>
    </div>
  </section>
</BaseLayout>

<style>
  .story-hero {
    grid-template-columns: minmax(0, 1fr);
  }

  .story-section > p {
    max-width: 74ch;
    line-height: 1.68;
  }

  .shootout {
    width: 100%;
    margin-bottom: 18px;
    border-collapse: collapse;
    font: 400 14px/1.4 var(--font-mono);
  }

  .shootout th,
  .shootout td {
    padding: 10px 14px;
    border-bottom: 1px solid var(--hairline);
  }

  .shootout thead th {
    border-bottom-color: var(--red);
    color: var(--muted);
    font-weight: 600;
    text-align: right;
  }

  .shootout thead th:first-child,
  .shootout tbody th,
  .shootout tfoot th {
    text-align: left;
  }

  .shootout td {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  .shootout tfoot th,
  .shootout tfoot td {
    border-bottom: 0;
    border-top: 1px solid var(--red);
    font-weight: 600;
  }

  .run-meta {
    color: var(--muted);
    font: 400 12px/1.6 var(--font-mono);
  }
</style>
