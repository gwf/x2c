---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  eyebrow?: string;
}

const { title, description, eyebrow = "a self-hosting superset of c" } = Astro.props;
const base = import.meta.env.BASE_URL;
const local = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { href: "intro/", label: "intro" },
  { href: "docs/", label: "docs" },
  { href: "benchmarks/", label: "benchmarks" },
  { href: "packages/", label: "packages" },
  { href: "install/", label: "install" },
  { href: "about/", label: "about" }
];
const currentPath = Astro.url.pathname.slice(base.length).replace(/^\/+|\/+$/g, "");
const current = currentPath ? `${currentPath}/` : "";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#171717" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={local("x2c-boxed-red.svg")} type="image/svg+xml" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>

    <header class="site-header">
      <div class="site-header-inner">
        <a class="wordmark" href={local("")} aria-label="x2c home">
          <img src={local("x2c-boxed-red.svg")} width="38" height="38" alt="" />
          <span>x2c</span>
        </a>
        <nav aria-label="Primary navigation">
          {nav.map((item) => (
            <a
              href={local(item.href)}
              aria-current={current === item.href ? "page" : undefined}
            >{item.label}</a>
          ))}
          <a class="nav-icon" href="https://github.com/gwf/x2c" aria-label="x2c on GitHub">
            <svg viewBox="0 0 16 16" width="18" height="18" aria-hidden="true" focusable="false">
              <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.4 7.4 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" />
            </svg>
          </a>
        </nav>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer>
      <a class="footer-mark" href={local("")} aria-label="x2c home">
        <img src={local("x2c-boxed-red.svg")} width="30" height="30" alt="" />
        <span>x2c</span>
      </a>
      <p>{eyebrow}</p>
      <div>
        <a href={local("intro/")}>intro</a>
        <a href={local("docs/")}>docs</a>
        <a href={local("install/")}>install</a>
        <a href={local("about/")}>about</a>
        <a href="https://github.com/gwf/x2c">github</a>
      </div>
    </footer>
  </body>
</html>
