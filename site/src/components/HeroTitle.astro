---
const { subject, opening, ending } = Astro.props;
---

<h1>
  <button class="hero-title" type="button" aria-label={`${subject} ${opening} Click to change the title.`} data-title>
    <span class="title-track" aria-hidden="true">
      <span class="title-prefix">{ending}&nbsp;</span>
      <span class="title-subject">{subject}<span class="title-ending">&nbsp;{opening}</span></span>
    </span>
  </button>
</h1>

<script>
  const title = document.querySelector<HTMLButtonElement>("[data-title]")!;
  const prefix = title.querySelector<HTMLElement>(".title-prefix")!;
  const subject = title.querySelector<HTMLElement>(".title-subject")!;
  const openingLabel = title.getAttribute("aria-label")!;
  const finalLabel = `${prefix.textContent!.trim()} ${subject.firstChild!.textContent}. Click to change the title.`;
  let alive = false;
  let enteredAt = -Infinity;

  function measure() {
    const shift = prefix.getBoundingClientRect().width;
    title.style.setProperty("--title-shift", `${shift}px`);
    title.style.setProperty("--title-width", `${shift + subject.getBoundingClientRect().width}px`);
  }
  function toggle() {
    alive = !alive;
    title.classList.toggle("is-alive", alive);
    title.setAttribute("aria-label", alive ? finalLabel : openingLabel);
  }
  title.addEventListener("pointerenter", (event) => {
    if (event.pointerType !== "mouse") return;
    enteredAt = performance.now();
    toggle();
  });
  title.addEventListener("click", (event) => {
    // A click immediately following mouse entry belongs to the same gesture.
    if (event.detail && performance.now() - enteredAt < 900) return;
    toggle();
  });
  new ResizeObserver(measure).observe(prefix);
  document.fonts.ready.then(measure);
  measure();
</script>
