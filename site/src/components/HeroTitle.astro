---
const { subject, opening, ending } = Astro.props;
---

<h1>
  <button class="hero-title" type="button"
    aria-label={`${subject} ${opening} ${ending} ${subject}!`}
    aria-description="Activate to change the visible title."
    data-title data-subject={subject} data-opening={opening} data-ending={ending}>
    <span class="title-animation">
      <span class="title-text" aria-hidden="true">{subject} {opening}</span>
      <span class="title-exclamation" aria-hidden="true">!</span>
      <span class="title-question" aria-hidden="true">?</span>
    </span>
  </button>
</h1>

<script>
  const title = document.querySelector<HTMLButtonElement>("[data-title]")!;
  const animation = title.querySelector<HTMLElement>(".title-animation")!;
  const text = title.querySelector<HTMLElement>(".title-text")!;
  const subject = title.dataset.subject!;
  const exclamation = title.querySelector<HTMLElement>(".title-exclamation")!;
  const prefix = `${title.dataset.ending} `;
  const suffix = ` ${title.dataset.opening}`;
  const steps = prefix.length;
  const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
  const duration = 400;
  const shotDuration = 100;
  const popDuration = 180;
  const shiftPause = 10;
  const letters = [...suffix].map((char) => {
    const letter = document.createElement("span");
    letter.textContent = char;
    letter.className = char === "."
      ? "title-falling-letter title-period" : "title-falling-letter";
    letter.setAttribute("aria-hidden", "true");
    animation.append(letter);
    return letter;
  });
  const arrivals = [...prefix].map((char) => {
    const letter = document.createElement("span");
    letter.textContent = char;
    letter.className = "title-falling-letter";
    letter.setAttribute("aria-hidden", "true");
    animation.append(letter);
    return letter;
  });
  type Spot = { x: number; width: number; fits: boolean };
  type Shot = { start: number; end: number; x: number; distance: number };
  let frames: Spot[][] = [];
  let shifts: number[] = [];
  let arrivalDuration = 0;
  let arrivalDistances: number[] = [];
  let shots: (Shot | undefined)[] = [];
  let elapsed = 0;
  let end = 0;
  let popStart = 0;
  let forward = false;
  let frame = 0;
  let lastTime: number | null = null;
  let enteredAt = -Infinity;
  let tilt = 18;

  const question = title.querySelector<HTMLElement>(".title-question")!;
  let inviting = false;
  let danceTimer = 0;

  function scheduleDance() {
    danceTimer = window.setTimeout(() => {
      question.classList.add("is-dancing");
    }, 2500 + Math.random() * 2500);
  }

  function setInvitation(active: boolean) {
    active = active && !reducedMotion.matches;
    if (active === inviting) return;
    inviting = active;
    clearTimeout(danceTimer);
    question.classList.remove("is-dancing");
    if (inviting) scheduleDance();
  }

  question.addEventListener("animationend", () => {
    question.classList.remove("is-dancing");
    if (inviting) scheduleDance();
  });
  reducedMotion.addEventListener("change", () => {
    if (reducedMotion.matches) {
      cancelAnimationFrame(frame);
      frame = 0;
      elapsed = forward ? end : 0;
      render();
    }
    setInvitation(!forward && elapsed === 0);
  });

  function measure() {
    const progress = end ? elapsed / end : 0;
    animation.style.transform = "none";
    exclamation.style.transform = "none";
    const bounds = animation.getBoundingClientRect();
    const style = getComputedStyle(title);
    const available = title.clientWidth
      - parseFloat(style.paddingLeft) - parseFloat(style.paddingRight);
    text.textContent = prefix + subject;
    const textWidth = text.getBoundingClientRect().width;
    const scale = available / (textWidth + exclamation.getBoundingClientRect().width);
    exclamation.style.left = `${textWidth}px`;
    const right = bounds.left + available / scale;
    frames = Array.from({ length: steps + 1 }, (_, step) => {
      const leading = prefix.slice(prefix.length - step);
      text.textContent = leading + subject + suffix;
      const range = document.createRange();
      return [...suffix].map((_, index) => {
        const offset = leading.length + subject.length + index;
        range.setStart(text.firstChild!, offset);
        range.setEnd(text.firstChild!, offset + 1);
        const rect = range.getBoundingClientRect();
        return { x: rect.left - bounds.left, width: rect.width, fits: rect.right <= right };
      });
    });
    shifts = [0];
    shots = [];
    // Give the first character a flight in; later arrivals overlap the exits.
    end = shotDuration;
    // Start each glyph just beyond the viewport, matching the right-hand exits.
    arrivalDistances = arrivals.map(letter =>
      bounds.left / scale + letter.getBoundingClientRect().width);
    for (let step = 1; step <= steps; step++) {
      end += shiftPause;
      shifts.push(end);
      // Finish each rejected letter's flight before the next shift or shot.
      for (let index = letters.length - 1; index >= 0; index--) {
        if (shots[index] || (step < steps && frames[step][index].fits)) continue;
        const spot = frames[step][index];
        const distance = Math.max(0, (document.documentElement.clientWidth - bounds.left) / scale - spot.x + spot.width);
        const flight = suffix[index].trim()
          ? shotDuration : 0;
        shots[index] = { start: end, end: end + flight, x: spot.x, distance };
        end += flight;
      }
    }
    popStart = end;
    end += popDuration;
    const rate = duration / end;
    arrivalDuration = shotDuration * rate;
    shifts = shifts.map((time) => time * rate);
    shots.forEach((shot) => {
      if (!shot) return;
      shot.start *= rate;
      shot.end *= rate;
    });
    popStart *= rate;
    end = duration;
    elapsed = progress * end;
    animation.style.transform = `scaleX(${scale})`;
    render();
  }

  function render() {
    if (!frames.length) return;
    let step = 0;
    while (step < steps && elapsed >= shifts[step + 1]) step++;
    const atStart = !forward && elapsed === 0;
    if (atStart) step = 0;
    setInvitation(atStart);
    const period = frames[0][suffix.length - 1];
    question.style.left = `${Math.round(period.x)}px`;
    text.textContent = prefix.slice(prefix.length - step)
      + subject;
    arrivals.forEach((letter, index) => {
      const landing = shifts[steps - index];
      const p = (elapsed - (landing - arrivalDuration)) / arrivalDuration;
      letter.style.visibility = p >= 0 && p < 1 ? "visible" : "hidden";
      // Reverse the outgoing acceleration: enter quickly, then settle at the left edge.
      letter.style.left = `${-arrivalDistances[index] * (1 - Math.max(0, Math.min(1, p))) ** 2}px`;
    });
    const pop = Math.max(0, Math.min(1, (elapsed - popStart) / (end - popStart)));
    exclamation.style.opacity = `${pop}`;
    const wag = Math.sin(pop * Math.PI * 3) * (1 - pop) * tilt;
    exclamation.style.transform = `translateY(${(1 - pop) ** 2 * 0.35}em) rotate(${wag}deg)`;
    letters.forEach((letter, index) => {
      const shot = shots[index];
      const fired = !atStart && shot && elapsed >= shot.start;
      const finished = fired && elapsed >= shot.end;
      const p = fired && shot.end > shot.start
        ? (elapsed - shot.start) / (shot.end - shot.start) : 0;
      const eased = Math.min(1, p) ** 2;
      const x = fired ? shot.x + shot.distance * eased : frames[step][index].x;
      letter.style.left = `${Math.round(x)}px`;
      letter.style.visibility = finished ? "hidden" : "visible";
    });
  }

  function advance(now: number) {
    const delta = lastTime === null ? 0 : now - lastTime;
    lastTime = now;
    elapsed = forward ? Math.min(end, elapsed + delta) : Math.max(0, elapsed - delta);
    render();
    frame = elapsed !== (forward ? end : 0) ? requestAnimationFrame(advance) : 0;
  }

  function toggle() {
    cancelAnimationFrame(frame);
    frame = 0;
    forward = !forward;
    tilt = (Math.random() < 0.5 ? -1 : 1) * (12 + Math.random() * 16);
    setInvitation(false);
    if (reducedMotion.matches) {
      elapsed = forward ? end : 0;
      render();
    } else {
      lastTime = performance.now();
      frame = requestAnimationFrame(advance);
    }
  }
  new ResizeObserver(measure).observe(title);
  document.fonts.ready.then(measure);
  title.addEventListener("pointerenter", (event) => {
    if (event.pointerType !== "mouse") return;
    enteredAt = performance.now();
    toggle();
  });
  title.addEventListener("click", (event) => {
    // A click immediately following mouse entry belongs to the same gesture.
    if (event.detail && performance.now() - enteredAt < 900) return;
    toggle();
  });
</script>
