---
// Each letter is a span so the lift below can move a copy of it. The spans
// are inline, so kerning and the fitted line widths are unchanged.
const { html } = Astro.props;
const lines = html.split(/<br\s*\/?>/i).map((line: string) => [...line]);
---

<h1 data-lift>{lines.map((chars) =>
  <span class="hero-title-line">{chars.map((c) =>
    c === " " ? " " : <span class="ch" data-g={c}>{c}</span>
  )}</span>
)}</h1>

<script>
  // Lift: letters within 80px of a mouse pointer rise up to 5px and ease
  // back as it moves. Copies of the letters move; the letters themselves
  // stay in place, so the layout never changes. Touch and reduced motion
  // get the static title.
  const title = document.querySelector<HTMLElement>("[data-lift]")!;
  const able = matchMedia(
    "(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)");
  const chars = [...title.querySelectorAll<HTMLElement>(".ch")];
  type Spot = { ch: HTMLElement; x: number; top: number; bottom: number; rise: number };
  let spots: Spot[] = [];
  let last: PointerEvent | null = null;
  let frame = 0;
  let timer = 0;

  function place() {
    frame = 0;
    if (!last) return;
    for (const s of spots) {
      const dy = Math.max(0, s.top - last.pageY, last.pageY - s.bottom);
      const d = Math.hypot(last.pageX - s.x, dy);
      const rise = d < 80 ? 2.5 + 2.5 * Math.cos((Math.PI * d) / 80) : 0;
      if (rise !== s.rise) {
        s.rise = rise;
        s.ch.style.setProperty("--lift", rise.toFixed(2));
      }
    }
  }

  function enter(e: PointerEvent) {
    if (e.pointerType !== "mouse" || !able.matches) return;
    clearTimeout(timer);
    spots = chars.map((ch) => {
      const r = ch.getBoundingClientRect();
      return { ch, x: r.left + r.width / 2 + scrollX,
        top: r.top + scrollY, bottom: r.bottom + scrollY, rise: 0 };
    });
    title.classList.add("is-live");
  }

  function move(e: PointerEvent) {
    if (e.pointerType !== "mouse" || !able.matches) return;
    if (!spots.length) enter(e);
    last = e;
    frame ||= requestAnimationFrame(place);
  }

  function leave() {
    if (!spots.length) return;
    cancelAnimationFrame(frame);
    frame = 0;
    for (const s of spots) s.ch.style.setProperty("--lift", "0");
    spots = [];
    timer = window.setTimeout(() => title.classList.remove("is-live"), 340);
  }

  title.addEventListener("pointerenter", enter);
  title.addEventListener("pointermove", move);
  title.addEventListener("pointerleave", leave);
  able.addEventListener("change", () => { if (!able.matches) leave(); });
</script>
