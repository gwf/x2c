---
import ExamplePanel from "./ExamplePanel.astro";
import CopyButton from "./CopyButton.astro";
import { articleFor } from "../lib/examples";
import { absoluteSiteUrl, sitePath } from "../../site-config.mjs";

interface Props {
  name: string;
  label: string;
  tone: "dark" | "light";
  slides: any[];
  codeLabel?: string;
}

const { name, label, tone, slides, codeLabel } = Astro.props;
const count = String(slides.length).padStart(2, "0");
---

<div class={`feature-carousel feature-carousel-${tone}`} data-carousel>
  <div class={`carousel-toolbar${tone === "dark" ? " carousel-toolbar-dark" : ""}`}>
    <div role="tablist" aria-label={label} class="carousel-tabs">
      {slides.map((slide, position) => (
        <button
          type="button"
          role="tab"
          id={`example-tab-${slide.frontmatter.slug}`}
          aria-controls={`example-${slide.frontmatter.slug}`}
          data-carousel-tab
          aria-selected={position === 0 ? "true" : "false"}
          tabindex={position === 0 ? 0 : -1}
        >{slide.frontmatter.tab}</button>
      ))}
    </div>
    <div class="carousel-controls">
      <span data-carousel-count
        class={`carousel-count${tone === "dark" ? " carousel-count-dark" : ""}`}
        >01 / {count}</span>
      <button type="button" data-carousel-prev aria-label="previous"
        class="carousel-arrow">&#8592;</button>
      <button type="button" data-carousel-next aria-label="next"
        class="carousel-arrow">&#8594;</button>
    </div>
  </div>
  <div class="carousel-viewport">
    <div data-carousel-track class="carousel-track">
      {slides.map((slide) => {
        const { slug } = slide.frontmatter;
        const anchor = `#example-${slug}`;
        const article = articleFor(slug);
        return (
          <div class="carousel-slide" id={`example-${slug}`}
            role="tabpanel" aria-labelledby={`example-tab-${slug}`}
            data-example={slug} data-section={name} data-surface="home">
            <ExamplePanel slide={slide} codeLabel={codeLabel} />
            <div class="example-actions">
              <CopyButton text={`${absoluteSiteUrl("/")}${anchor}`}
                label="Copy permalink" />
              {article && (
                <a href={sitePath(`/examples/${article.frontmatter.slug}/`)}
                  data-example-action="explore">Explore this example</a>
              )}
            </div>
          </div>
        );
      })}
    </div>
  </div>
</div>
