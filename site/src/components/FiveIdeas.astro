---
import { Code } from "astro:components";
import { inlineMarkdown } from "../lib/inline-markdown";
import { x2cLang, x2cDarkTheme } from "../../shiki-x2c.mjs";

interface Idea {
  name: string;
  detail: string;
  code: string;
}

interface Props {
  intro: string;
  ideas: Idea[];
}

const { intro, ideas } = Astro.props;
const introHtml = await inlineMarkdown(intro);
const items = await Promise.all(
  ideas.map(async (idea) => ({
    name: await inlineMarkdown(idea.name),
    detail: await inlineMarkdown(idea.detail),
    code: idea.code.trim(),
  }))
);
---

<aside class="hero-ideas" aria-labelledby="ideas-title">
  <h2 id="ideas-title" set:html={introHtml} />
  <ol class="idea-list">
    {items.map((idea) => (
      <li>
        <p>
          <strong class="idea-title" set:html={`${idea.name}.`} />{" "}
          <Fragment set:html={idea.detail} />
        </p>
        <div class="idea-code">
          <Code code={idea.code} lang={x2cLang} theme={x2cDarkTheme} />
        </div>
      </li>
    ))}
  </ol>
</aside>
