---
import { Code } from "astro:components";
import CopyButton from "./CopyButton.astro";
import { coreSetup, corePrerequisites } from "../content/core-setup";
import { x2cDarkTheme } from "../../shiki-x2c-theme.mjs";

interface Props {
  run?: string;
}

const { run = "" } = Astro.props;
const commands = run.trim();
const recipe = commands ? `${coreSetup}\n\n${commands}` : coreSetup;
const buildGuide = `${import.meta.env.BASE_URL}docs/internals/building.html`;
---

<div class="core-setup">
  <p class="setup-prerequisites">
    {corePrerequisites} The <a href={buildGuide}
      data-example-action="guide">build guide</a> covers setup in detail.
  </p>
  <figure class="setup-recipe">
    <figcaption>
      <span>From a new checkout</span>
      <CopyButton text={recipe} label="Copy commands" action="copy-run" />
    </figcaption>
    <Code code={recipe} lang="sh" theme={x2cDarkTheme} />
  </figure>
</div>

<style>
  .core-setup { min-width: 0; }
  .setup-prerequisites {
    margin: 0 0 22px;
    color: var(--muted-dark);
    font-size: 15px;
    line-height: 1.65;
  }
  .setup-prerequisites a { text-decoration: underline; }
  .setup-recipe { margin: 0; background: var(--code); }
  .setup-recipe figcaption {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding: 14px 22px;
    border-bottom: 1px solid rgba(244, 241, 236, 0.16);
    color: var(--muted-light);
    font: 500 11px/1.5 "JetBrains Mono", monospace;
  }
  .core-setup :global(pre) {
    margin: 0;
    padding: 22px;
    overflow-x: auto;
    font: 12px/1.9 "JetBrains Mono", monospace;
  }
  @media (max-width: 639px) {
    .core-setup :global(pre) { padding: 16px; font-size: 11px; }
    .setup-recipe figcaption { padding: 12px 16px; }
  }
</style>
