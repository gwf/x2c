---
interface Props {
  card: any;
}

const { card } = Astro.props;
const html = await card.compiledContent();
// Everything through the last code block is code; the rest is notes.
const at = html.lastIndexOf("</pre>");
const code = at === -1 ? "" : html.slice(0, at + "</pre>".length);
const notes = at === -1 ? html : html.slice(at + "</pre>".length);
const id = card.file.split("/").pop().replace(/^\d+-|\.md$/g, "");
---

<article class="cheat-card" id={id}>
  <h3><a href={`#${id}`}>{card.frontmatter.title}</a></h3>
  <div class="cheat-code" set:html={code} />
  <div class="cheat-notes" set:html={notes} />
</article>
