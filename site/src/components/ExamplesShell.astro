---
import { exampleEntries, exampleSections, exampleRoute, tourSections } from "../lib/example-catalog";
import "../styles/examples-reading.css";
import { fromCNavigation } from "../lib/from-c-examples";
import { shootoutNavigation } from "../lib/shootout-examples";
import { mdbookSidebarAssets } from "../../mdbook-sidebar.mjs";
const sidebar = mdbookSidebarAssets();
const { current = "essentials" } = Astro.props;
const sidebarGroups = [
  { title: "Start here", sections: Object.keys(tourSections) },
  { title: "Site Examples", sections: exampleSections.filter(section => section !== "programs") },
  { title: "Complete programs", sections: ["programs"] },
  { title: "Progressions and comparisons", sections: ["from-c", "shootout"] },
];
const sectionNumbers = new Map(sidebarGroups.flatMap(group => group.sections)
  .map((section, index) => [section, index + 1]));
const base = import.meta.env.BASE_URL;
const href = (entry) => `${base}examples/${exampleRoute(entry)}`;
const sectionLabel = (section: string) => ({
  ...tourSections,
  "from-c": "From C to x2c", shootout: "Programming language shootout",
}[section] ?? section[0].toUpperCase() + section.slice(1));
const startsExpanded = (section: string) =>
  section === "programs" || (section === current && section in tourSections);
const sectionLinks = (section: string) => {
  const navigation = section === "from-c" ? fromCNavigation
    : section === "shootout" ? shootoutNavigation : null;
  return navigation
    ? navigation.map(item => ({label: item.label, href: `${base}examples/${section}/#${item.anchor}`, active: false}))
    : exampleEntries.filter(entry => entry.section === section).map(entry => ({
      label: entry.label, href: href(entry),
      active: current === (entry.article?.frontmatter.slug ?? entry.id.split("/").pop()),
    }));
};
---
<style is:inline set:html={sidebar.css} />
<div class="examples-shell" data-examples-shell>
  <input type="checkbox" id="mdbook-sidebar-toggle-anchor" hidden />
  <script is:inline set:html={sidebar.init} />
  <nav id="mdbook-sidebar" class="sidebar examples-index" aria-label="Example index">
    <div class="sidebar-scrollbox">
      <ol class="chapter">
        {sidebarGroups.map(group => <>
        <li class="part-title">{group.title}</li>
        {group.sections.map(section => <li class:list={["chapter-item", {expanded: startsExpanded(section)}]} data-example-section={section} data-track-example-sections={current === section ? "" : undefined}>
          <span class="chapter-link-wrapper"><a href={`${base}examples/${section}/`} class:list={{active: current === section}}><strong>{sectionNumbers.get(section)}.</strong> {sectionLabel(section)}</a>{sectionLinks(section).length > 0 && <button class="chapter-fold-toggle" aria-label={`Toggle ${sectionLabel(section)}`} aria-expanded={String(startsExpanded(section))} type="button"><div aria-hidden="true">&#10097;</div></button>}</span>
          <ol class="section">{sectionLinks(section).map((entry, index) =>
            <li class="chapter-item"><a href={entry.href} data-index-link class:list={{active: entry.active}}><strong>{sectionNumbers.get(section)}.{index + 1}.</strong> {entry.label}</a></li>)}</ol>
        </li>)}
        </>)}
      </ol>
    </div>
    <div id="mdbook-sidebar-resize-handle" class="sidebar-resize-handle"><div class="sidebar-resize-indicator"></div></div>
  </nav>
  <script is:inline>
    try {
      if (!sessionStorage.getItem("examples-visited") && document.body.clientWidth >= 1080) {
        document.getElementById("mdbook-sidebar-toggle-anchor").checked = true;
        document.documentElement.classList.add("sidebar-visible");
      }
      // The entry route redirects; initialize the session on its destination.
      if (!/\/examples\/(?:index.html)?$/.test(location.pathname)) {
        sessionStorage.setItem("examples-visited", "true");
      }
    } catch {}
    for (const item of document.querySelectorAll("[data-example-section]")) {
      const key = `examples-section-${item.dataset.exampleSection}`;
      try {
        const saved = sessionStorage.getItem(key);
        if (saved !== null) item.classList.toggle("expanded", saved === "open");
      } catch {}
      item.querySelector(".chapter-fold-toggle")?.setAttribute(
        "aria-expanded", String(item.classList.contains("expanded")));
    }
  </script>
  <div class="page-wrapper examples-reading"><slot /></div>
</div>
<script is:inline set:html={sidebar.script} />
<script is:inline set:html={sidebar.tracking} />
<script>
  const index = document.querySelector<HTMLElement>("#mdbook-sidebar")!;
  const scrollbox = index.querySelector<HTMLElement>(".sidebar-scrollbox")!;
  scrollbox.scrollTop = Number(sessionStorage.getItem("examples-index-scroll") || 0);
  index.addEventListener("click", (event) => {
    const toggle = (event.target as Element).closest(".chapter-fold-toggle");
    const item = toggle?.closest<HTMLElement>("[data-example-section]");
    if (item) {
      try {
        sessionStorage.setItem(`examples-section-${item.dataset.exampleSection}`,
          item.classList.contains("expanded") ? "open" : "closed");
      } catch {}
    }
    sessionStorage.setItem("examples-index-scroll", String(scrollbox.scrollTop));
  });
  addEventListener("pagehide", () => {
    for (const item of index.querySelectorAll<HTMLElement>("[data-example-section]")) {
      try {
        sessionStorage.setItem(`examples-section-${item.dataset.exampleSection}`,
          item.classList.contains("expanded") ? "open" : "closed");
      } catch {}
    }
  });

</script>
