---
import "../styles/global.css";
import { analyticsSnippet } from "../../analytics-snippet.mjs";

interface Props {
  title: string;
  description: string;
  robots?: string;
  canonical?: boolean;
  socialImage?: string;
  socialImageAlt?: string;
}

const {
  title, description, robots, canonical = true,
  socialImage = "x2c-social.png",
  socialImageAlt = "x2c: C with batteries, without bullshit.",
} = Astro.props;
const base = import.meta.env.BASE_URL;
const local = (path: string) => `${base}${path.replace(/^\/+/, "")}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL(local(socialImage), Astro.site);
const analytics = analyticsSnippet(process.env, import.meta.env.DEV);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f4f1ec" />
    <meta name="description" content={description} />
    {robots && <meta name="robots" content={robots} />}
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonicalUrl} />}
    {canonical && <meta property="og:image" content={socialImageUrl} />}
    {canonical && <meta property="og:image:alt" content={socialImageAlt} />}
    {canonical && <meta property="og:image:width" content="1200" />}
    {canonical && <meta property="og:image:height" content="630" />}
    {canonical && <meta name="twitter:card" content="summary_large_image" />}
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {canonical && <meta name="twitter:image" content={socialImageUrl} />}
    {canonical && <meta name="twitter:image:alt" content={socialImageAlt} />}
    {canonical && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" href={local("x2c-naked.svg")} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Archivo:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
    <Fragment set:html={analytics} />
  </head>
  <body>
    <a class="skip-link" href="#main">skip to content</a>
    <slot name="header" />
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>

<script>
  import { trackExampleAction } from "../lib/analytics";

  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const link = event.target.closest<HTMLAnchorElement>(
      "a[data-example-action]"
    );
    if (link) trackExampleAction(link, link.dataset.exampleAction!);
  });
</script>
