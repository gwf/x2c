{
  "schema": 1,
  "name": "yyjson",
  "version": "0.12.0",
  "profile": "static-default",
  "sources": [
    {
      "name": "yyjson",
      "url": "https://github.com/ibireme/yyjson/archive/refs/tags/0.12.0.tar.gz",
      "sha256": "b16246f617b2a136c78d73e5e2647c6f1de1313e46678062985bdcf1f40bb75d",
      "root": "yyjson-0.12.0"
    }
  ],
  "steps": [
    {
      "cwd": "{work}",
      "argv": [
        "{cc}", "-O2", "-std=c99", "-I{source_yyjson}/src", "-c",
        "{source_yyjson}/src/yyjson.c", "-o", "yyjson.o"
      ]
    },
    {
      "cwd": "{work}",
      "argv": ["{ar}", "rcs", "{prefix}/lib/libyyjson.a", "yyjson.o"]
    }
  ],
  "copies": [
    {
      "from": "{source_yyjson}/src/yyjson.h",
      "to": "{prefix}/include/yyjson.h"
    }
  ],
  "receipts": [
    "{prefix}/include/yyjson.h",
    "{prefix}/lib/libyyjson.a"
  ]
}
