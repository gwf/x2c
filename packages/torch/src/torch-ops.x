List Tensor.nonzero_numpy(Tensor self) {
  xt_tensor *items = NULL;
  int64_t count = xt_nonzero_numpy(_native(self), &items);
  if (count < 0) Torch.check(1, "nonzero_numpy");
  List result = %();
  for (int64_t i = 0; i < count; i++) {
    Tensor item = Tensor.adopt(items[i], "nonzero_numpy");
    result = result.append(%($item));
  }
  xt_free_handles(items);
  return result;
}

