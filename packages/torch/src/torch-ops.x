List Tensor.unsafe_split(Tensor self, int64_t split_size, int64_t dim) {
  xt_tensor *items = NULL;
  int64_t count = xt_unsafe_split_tensor(_native(self), split_size, dim,
      &items);
  if (count < 0) Torch.check(1, "unsafe_split");
  List result = %();
  for (int64_t i = 0; i < count; i++) {
    Tensor item = Tensor.adopt(items[i], "unsafe_split");
    result = result.append(%($item));
  }
  xt_free_handles(items);
  return result;
}

List Tensor.split(Tensor self, int64_t split_size, int64_t dim) {
  xt_tensor *items = NULL;
  int64_t count = xt_split_tensor(_native(self), split_size, dim, &items);
  if (count < 0) Torch.check(1, "split");
  List result = %();
  for (int64_t i = 0; i < count; i++) {
    Tensor item = Tensor.adopt(items[i], "split");
    result = result.append(%($item));
  }
  xt_free_handles(items);
  return result;
}

List Tensor.split_sizes(Tensor self, List split_size, int64_t dim) {
  int64_t split_size_n = 0;
  int64_t *split_size_dims = _dims(split_size, &split_size_n);
  xt_tensor *items = NULL;
  int64_t count = xt_split_sizes(_native(self), split_size_dims, split_size_n,
      dim, &items);
  if (count < 0) Torch.check(1, "split");
  List result = %();
  for (int64_t i = 0; i < count; i++) {
    Tensor item = Tensor.adopt(items[i], "split");
    result = result.append(%($item));
  }
  xt_free_handles(items);
  return result;
}

