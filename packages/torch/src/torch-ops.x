List Tensor.unbind(Tensor self, int64_t dim) {
  xt_tensor *items = NULL;
  int64_t count = xt_unbind_int(_native(self), dim, &items);
  if (count < 0) Torch.check(1, "unbind");
  List result = %();
  for (int64_t i = 0; i < count; i++) {
    Tensor item = Tensor.adopt(items[i], "unbind");
    result = result.append(%($item));
  }
  xt_free_handles(items);
  return result;
}

