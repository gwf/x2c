List Tensor.native_batch_norm(Tensor input, Tensor weight, Tensor bias,
    Tensor running_mean, Tensor running_var, int training, double momentum,
    double eps) {
  xt_tensor out0 = NULL, out1 = NULL, out2 = NULL;
  Torch.check(xt_native_batch_norm(_native(input), _native(weight),
      _native(bias), _native(running_mean), _native(running_var), training,
      momentum, eps, &out0, &out1, &out2), "native_batch_norm");
  List result = %();
  Tensor out0_t = Tensor.adopt(out0, "native_batch_norm");
  result = result.append(%($out0_t));
  Tensor out1_t = Tensor.adopt(out1, "native_batch_norm");
  result = result.append(%($out1_t));
  Tensor out2_t = Tensor.adopt(out2, "native_batch_norm");
  result = result.append(%($out2_t));
  return result;
}

List Tensor.batch_norm_stats(Tensor input, double eps) {
  xt_tensor out0 = NULL, out1 = NULL;
  Torch.check(xt_batch_norm_stats(_native(input), eps, &out0, &out1),
      "batch_norm_stats");
  return _pair(out0, out1, "batch_norm_stats");
}

