List Tensor.unbind_copy(Tensor self, int64_t dim) {
  xt_tensor *items = NULL;
  int64_t count = xt_unbind_copy_int(_native(self), dim, &items);
  if (count < 0) Torch.check(1, "unbind_copy");
  List result = %();
  for (int64_t i = 0; i < count; i++) {
    Tensor item = Tensor.adopt(items[i], "unbind_copy");
    result = result.append(%($item));
  }
  xt_free_handles(items);
  return result;
}

Tensor Tensor.view_copy(Tensor self, List size) {
  int64_t size_n = 0;
  int64_t *size_dims = _dims(size, &size_n);
  return Tensor.adopt(xt_view_copy(_native(self), size_dims, size_n),
      "view_copy");
}

Tensor Tensor.view_copy_dtype(Tensor self, int dtype) =>
  Tensor.adopt(xt_view_copy_dtype(_native(self), dtype), "view_copy");

Tensor Tensor.unfold_copy(Tensor self, int64_t dimension, int64_t size,
