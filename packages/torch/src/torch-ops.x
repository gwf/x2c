      _native(bias), eps, cudnn_enabled), "group_norm");

List Tensor.native_group_norm(Tensor input, Tensor weight, Tensor bias,
    int64_t N, int64_t C, int64_t HxW, int64_t group, double eps) {
  xt_tensor out0 = NULL, out1 = NULL, out2 = NULL;
  Torch.check(xt_native_group_norm(_native(input), _native(weight),
      _native(bias), N, C, HxW, group, eps, &out0, &out1, &out2),
      "native_group_norm");
  List result = %();
  Tensor out0_t = Tensor.adopt(out0, "native_group_norm");
  result = result.append(%($out0_t));
  Tensor out1_t = Tensor.adopt(out1, "native_group_norm");
  result = result.append(%($out1_t));
  Tensor out2_t = Tensor.adopt(out2, "native_group_norm");
  result = result.append(%($out2_t));
  return result;
}

