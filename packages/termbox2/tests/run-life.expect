#!/usr/bin/expect -f

set timeout 10
set env(TERM) xterm-256color
set env(LC_ALL) C.UTF-8
set env(LC_CTYPE) C.UTF-8

spawn -noecho sh -c \
  {stty rows 12 columns 32; exec ./builds/game-of-life}
fconfigure $spawn_id -translation binary -encoding binary
expect {
  "#" {}
  timeout { exit 1 }
  eof { exit 1 }
}
send -- "q"
expect {
  eof {}
  timeout { exit 1 }
}
set result [wait]
if {[lindex $result 2] != 0 || [lindex $result 3] != 0} {
  exit 1
}
exit 0
