  },
  "lookup.closed" :
  macro Statement() {
    raise %(bad-state (library "libuv") (operation "lookup_start")
            (reason "the lookup loop is closed"));
  },
  "lookup.hints.args" :
  macro Statement() {
    raise %(bad-arg (library "libuv") (operation "lookup_hints")
