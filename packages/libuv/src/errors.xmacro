  },
  "stream.args" :
  macro Statement(Expr $operation) {
    raise %(bad-arg (library "libuv") (operation ${$operation})
            (reason "a live loop is required"));
  },
  "stream.listen.args" :
  macro Statement() {
    raise %(bad-arg (library "libuv") (operation "listen")
