meta static List _uv_error_expand(String key, List arguments) {
  Map rows = _uv_error_rows();
  Var row = rows[key];
  if (row is void) x2c_diagnostic_fail(%"unknown libuv error '$key'", %());
  Macro selected = row;
  if (arguments.len() != selected.assoc(<parameters>).list().len())
    x2c_diagnostic_fail(%"wrong argument count for libuv error '$key'", %());
  return %(${Macro_apply(selected, arguments)});
}

macro Statement $uv.error(Literal $key, Expr $arguments...) {
  $(_uv_error_expand (x2c.literal.value $key) $arguments)...
}
