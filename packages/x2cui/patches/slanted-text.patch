+
+void cui_draw_text_slanted(cui_ctx *ui, cui_font font, float size, cui_vec2 pos, cui_color color, const char *text, int len, float shear) {
+    int v0 = ui->dl.vtx_count;
+    cui__draw_text_line(ui, font, size, pos.x, pos.y, color, text, len, false);
+    cui_xform x = ui->dl.xform_stack[ui->dl.xform_depth - 1];
+    float by = (pos.y + cui__font_ascent(ui, font, size)) * ui->scale * x.scale + x.oy;
+    for (int v = v0; v < ui->dl.vtx_count; v++) ui->dl.vtx[v].x += shear * (by - ui->dl.vtx[v].y);
+}
