/*  proof-source.xmacro -- generated proof program wrapper */

macro Stmt $source.proof.header(Expr $text, Expr $input) {
  {
    String source = %"/*  Generated by cstar-verify from ${$input}.\n" +
      "    Do not edit; every run renders it again. */\n";
    $text.push(source);
  }
}

macro Stmt $source.proof.runtime_import(Expr $text) {
  $text.push("import \"cstar\" with Cstar;\n");
}

macro Stmt $source.proof.main(Expr $text) {
  $text.push("int main(void) {");
}

macro Stmt $source.proof.open(Expr $text, Expr $count, Expr $input) {
  {
    String source = %"  Cstar cstar = Cstar.open(${$count}, " +
      %"\"${$input}\");";
    $text.push(source);
  }
}

macro Stmt $source.proof.arrays(Expr $text) {
  $text.push("  cstar.load_arrays();");
}

macro Stmt $source.proof.verify(Expr $text, Expr $name) {
  {
    String source = %"  _verify_${$name}(cstar);";
    $text.push(source);
  }
}

macro Stmt $source.proof.finish(Expr $text) {
  $text.push("  return cstar.finish();");
}

macro Stmt $source.proof.close(Expr $text) {
  $text.push("}");
}
