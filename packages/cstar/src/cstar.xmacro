// cstar.xmacro -- C* verification annotations for x2c.
//
// Annotations record themselves in the per-unit compile-time Lisp session
// under the global `cstar.records` and leave a `cstar_marker(id)` call where
// they were written. `$cstar.verify` records the function with both bodies:
// the captured one, whose markers place the annotations, and the erased one,
// which is what the compiler goes on to translate. `cstar-verify` reads the
// records; ordinary compilation discards them.

$(def cstar.records nil)
$(def cstar.next-id 0)

$(defun cstar._next-id ()
   (begin
     (def cstar.next-id (+ cstar.next-id 1))
     cstar.next-id))

$(defun cstar._record (record)
   (begin
     (def cstar.records (cons record cstar.records))
     record))

$(defun cstar._where ()
   (list (x2c.invocation.file)
         (x2c.invocation.line)
         (x2c.invocation.column)))

// A captured string-literal argument arrives as typed syntax. Read the
// literal spelling out of the AST and drop the surrounding quotes; the
// elements of a `...` sequence hole are not accepted by x2c.source.text.
$(defun cstar._unquote (spelling)
   (if (and (> (string-length spelling) 1)
            (equal? (substring spelling 0 1) "\""))
       (substring spelling 1 (- (string-length spelling) 1))
       spelling))

$(defun cstar._text (syntax)
   (match-case syntax
     ((expr ? (literal ? ?spelling)) (cstar._unquote ?spelling))
     (else (x2c.diagnostic.fail
             "cstar: expected a string literal argument" nil))))

$(defun cstar._marker? (node)
   (and (list? node)
        (match node
          '(stmnt (expr ?
                    (call (expr ? (ident (binding ? "cstar_marker")))
                          (args *)))))))

$(defun cstar._erase (node)
   (cond ((not (list? node)) node)
         ((cstar._marker? node) '(empty))
         (true (map cstar._erase node))))

$(defun cstar._record-inner (kind text)
   (let ((id (cstar._next-id)))
     (begin
       (cstar._record
         (append (list kind id (cstar._text text)) (cstar._where)))
       (x2c.literal.int id))))

$(defun cstar._record-proof (kind helper arguments)
   (let ((id (cstar._next-id)))
     (begin
       (cstar._record
         (append (list kind id (x2c.binding.spelling helper)
                       (map cstar._text arguments))
                 (cstar._where)))
       (x2c.literal.int id))))

$(defun cstar._record-function (function ghosts pre post)
   (let ((body (x2c.function.body function)))
     (let ((erased (cstar._erase body)))
       (begin
         (cstar._record
           (append (list 'function (x2c.function.name function)
                         (cstar._text pre) (cstar._text post) ghosts)
                   (cstar._where)
                   (list body erased)))
         erased))))

/** Verifies the decorated function against `pre` and `post`, which are
    assertions in the pinned backend's logical syntax. Must be the outermost
    decorator: a later one rewrites a body this record no longer describes,
    and `cstar-verify` refuses the file. */
macro Decorator $cstar.verify(
  Function $function,
  Expr $pre,
  Expr $post
) => {
  $(cstar._record-function $function "" $pre $post)...
}

/** Verifies the decorated function with logical ghost parameters, written as
    one comma-separated list such as `"a_v:int, b_v:int"`. */
macro Decorator $cstar.verify_with(
  Function $function,
  Expr $ghosts,
  Expr $pre,
  Expr $post
) => {
  $(cstar._record-function $function (cstar._text $ghosts) $pre $post)...
}

/** Records an intermediate assertion at this program point. */
macro Statement $cstar.assert(Expr $text) => {
  cstar_marker($(cstar._record-inner 'assert $text));
}

/** Runs one of the session's own proof steps, such as the array-fill steps
    the package ships, with logical term arguments. */
macro Statement $cstar.proof(Name $step, Expr $arguments...) => {
  cstar_marker($(cstar._record-proof 'proof $step $arguments));
}

/** Runs a proof helper from the companion `<stem>.proofs.x` file, which
    receives the session and then the logical term arguments. The helper is
    resolved when the generated proof program is compiled; the verified unit
    needs no declaration of it. */
macro Statement $cstar.helper(Name $helper, Expr $arguments...) => {
  cstar_marker($(cstar._record-proof 'helper $helper $arguments));
}

/** Records the invariant of the decorated loop as a proposition over program
    variables; each named variable contributes its own ownership frame. */
macro Decorator $cstar.invariant(Statement $target, Expr $text) => {
  {
    cstar_marker($(cstar._record-inner 'invariant $text));
    $target
  }
}

/** Records the invariant of the decorated loop as a complete separation-logic
    assertion, which states its own ownership and may bind existentials. It
    cuts the state only partially, so the surrounding frame survives. */
macro Decorator $cstar.invariant_sl(Statement $target, Expr $text) => {
  {
    cstar_marker($(cstar._record-inner 'invariant_sl $text));
    $target
  }
}
