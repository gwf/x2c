// cstar.xmacro -- C*-style verification annotations for x2c.
//
// Annotations record themselves in the per-unit compile-time Lisp session
// under the global `cstar.records` and leave a `cstar_marker(id)` call in
// the compiled body.  The `$cstar.verify` function decorator records the
// function contract, erases every marker in the captured body, and returns
// the erased body, so the compiled program contains no annotation code.

$(def cstar.records nil)
$(def cstar.next-id 0)

$(defun cstar._next-id ()
   (begin
     (def cstar.next-id (+ cstar.next-id 1))
     cstar.next-id))

$(defun cstar._record (record)
   (begin
     (def cstar.records (cons record cstar.records))
     record))

$(defun cstar._where ()
   (list (x2c.invocation.file)
         (x2c.invocation.line)
         (x2c.invocation.column)))

// A captured string-literal argument arrives as typed syntax.  Read the
// literal spelling out of the AST and drop the surrounding quotes; the
// elements of a `...` sequence hole are not accepted by x2c.source.text.
$(defun cstar._unquote (spelling)
   (if (and (> (string-length spelling) 1)
            (equal? (substring spelling 0 1) "\""))
       (substring spelling 1 (- (string-length spelling) 1))
       spelling))

$(defun cstar._text (syntax)
   (match-case syntax
     ((expr ? (literal ? ?spelling)) (cstar._unquote ?spelling))
     (else (x2c.diagnostic.fail
             "cstar: expected a string literal argument" nil))))

$(defun cstar._marker? (node)
   (and (list? node)
        (match node
          '(stmnt (expr ?
                    (call (expr ? (ident (binding ? "cstar_marker")))
                          (args *)))))))

$(defun cstar._erase (node)
   (cond ((not (list? node)) node)
         ((cstar._marker? node) '(empty))
         (true (map cstar._erase node))))

$(defun cstar._record-assert (text)
   (let ((id (cstar._next-id)))
     (begin
       (cstar._record
         (append (list 'assert id (cstar._text text)) (cstar._where)))
       (x2c.literal.int id))))

$(defun cstar._record-invariant (text)
   (let ((id (cstar._next-id)))
     (begin
       (cstar._record
         (append (list 'invariant id (cstar._text text)) (cstar._where)))
       (x2c.literal.int id))))

$(defun cstar._record-proof (helper arguments)
   (let ((id (cstar._next-id)))
     (begin
       (cstar._record
         (append (list 'proof id (x2c.binding.spelling helper)
                       (map cstar._text arguments))
                 (cstar._where)))
       (x2c.literal.int id))))

$(defun cstar._record-function (function pre post)
   (let ((erased (cstar._erase (x2c.function.body function))))
     (begin
       (cstar._record
         (append (list 'function (x2c.function.name function)
                       (cstar._text pre) (cstar._text post))
                 (cstar._where)
                 (list erased)))
       erased)))

macro Decorator $cstar.verify(
  Function $function,
  Expr $pre,
  Expr $post
) => {
  $(cstar._record-function $function $pre $post)...
}

macro Statement $cstar.assert(Expr $text) => {
  cstar_marker($(cstar._record-assert $text));
}

macro Statement $cstar.proof(Name $helper, Expr $arguments...) => {
  cstar_marker($(cstar._record-proof $helper $arguments));
}

macro Decorator $cstar.invariant(Statement $target, Expr $text) => {
  cstar_marker($(cstar._record-invariant $text));
  $target
}
